)


for row_index, row in (
    FIGURE_6_MATRIX_DATA.iterrows()
):
    for column_index, specification in enumerate(
        matrix_column_specs
    ):
        source_column = specification[
            "source"
        ]

        cell_type = specification[
            "type"
        ]

        if cell_type == "ae1":
            face_color = (
                AE1_NEUTRAL_COLOR
            )

            text_value = str(
                int(
                    row[
                        source_column
                    ]
                )
            )

            text_color = "black"
            font_weight = "bold"

        elif cell_type == "count_confirmatory":
            count_value = int(
                row[
                    source_column
                ]
            )

            face_color = (
                CONFIRMATORY_COLOR
                if count_value > 0
                else NO_EVIDENCE_COLOR
            )

            text_value = str(
                count_value
            )

            text_color = (
                "white"
                if count_value > 0
                else "black"
            )

            font_weight = (
                "bold"
                if count_value > 0
                else "normal"
            )

        elif cell_type == "count_exploratory":
            count_value = int(
                row[
                    source_column
                ]
            )

            face_color = (
                EXPLORATORY_COLOR
                if count_value > 0
                else NO_EVIDENCE_COLOR
            )

            text_value = str(
                count_value
            )

            text_color = "black"

            font_weight = (
                "bold"
                if count_value > 0
                else "normal"
            )

        elif cell_type == "boolean_exploratory":
            flag = parse_yes_no(
                row[
                    source_column
                ]
            )

            face_color = (
                EXPLORATORY_COLOR
                if flag
                else NO_EVIDENCE_COLOR
            )

            text_value = (
                "Yes"
                if flag
                else "No"
            )

            text_color = "black"

            font_weight = (
                "bold"
                if flag
                else "normal"
            )

        elif cell_type == "boolean_confirmatory":
            flag = parse_yes_no(
                row[
                    source_column
                ]
            )

            face_color = (
                CONFIRMATORY_COLOR
                if flag
                else NO_EVIDENCE_COLOR
            )

            text_value = (
                "Yes"
                if flag
                else "No"
            )

            text_color = (
                "white"
                if flag
                else "black"
            )

            font_weight = (
                "bold"
                if flag
                else "normal"
            )

        else:
            raise RuntimeError(
                f"Unsupported matrix cell type: {cell_type}"
            )

        rectangle = Rectangle(
