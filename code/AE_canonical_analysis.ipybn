# 7. FIGURE 3 — RETAIN VALIDATED ORIGINAL
# ============================================================

def detect_original_figure_3() -> Path | None:
    """Detect an explicitly named original Figure 3 asset."""
    if ORIGINAL_FIGURE_3_PATH is not None:
        explicit_path = Path(
            ORIGINAL_FIGURE_3_PATH
        )

        if explicit_path.is_file():
            return explicit_path

        raise FileNotFoundError(
            "ORIGINAL_FIGURE_3_PATH was defined but does not exist:\n"
            f"{explicit_path}"
        )

    supported_extensions = [
        "png",
        "jpg",
        "jpeg",
        "tif",
        "tiff",
        "pdf",
        "svg",
        "eps",
    ]

    candidate_directories = [
        Path(
            "/content"
        ),
        RUN_DIR,
        RUN_DIR.parent,
        Path(
            "/content/drive/MyDrive"
        ),
    ]

    candidate_stems = [
        "Figure_3_original",
        "Figure3_original",
        "Fig_3_original",
        "Fig3_original",
        "Figure_3_AE1_original",
        "Figure3_AE1_original",
    ]

    candidates: list[
        Path
    ] = []

    for directory in candidate_directories:
        if not directory.exists():
            continue

        for stem in candidate_stems:
            for extension in supported_extensions:
                candidates.extend(
                    Path(
                        path
                    )
                    for path in glob.glob(
                        str(
                            directory
                            / f"{stem}.{extension}"
                        )
                    )
                )

                candidates.extend(
                    Path(
                        path
                    )
                    for path in glob.glob(
                        str(
                            directory
                            / f"{stem}.{extension.upper()}"
                        )
                    )
                )

    filtered_candidates = [
        path
        for path in candidates
        if (
            path.is_file()
            and "08_figures" not in str(
                path
            )
        )
    ]

    if not filtered_candidates:
        return None

    filtered_candidates = sorted(
        set(
            filtered_candidates
        ),
        key=lambda path: (
            path.stat().st_mtime,
            path.stat().st_size,
        ),
        reverse=True,
    )

    return filtered_candidates[
        0
    ]


ORIGINAL_FIGURE_3_SOURCE = (
    detect_original_figure_3()
)

ORIGINAL_FIGURE_3_CANONICAL_PATH: Path | None = None

FIGURE_3_STATUS = (
    "retained_in_manuscript_not_copied"
)

if ORIGINAL_FIGURE_3_SOURCE is not None:
    ORIGINAL_FIGURE_3_CANONICAL_PATH = (
        INHERITED_FIGURE_DIR
        / (
            "Figure_3_inherited_original"
            + ORIGINAL_FIGURE_3_SOURCE.suffix.lower()
        )
    )

    shutil.copy2(
        ORIGINAL_FIGURE_3_SOURCE,
        ORIGINAL_FIGURE_3_CANONICAL_PATH,
    )

    FIGURE_3_STATUS = (
        "original_asset_copied"
    )

else:
    figure_3_notice_path = (
