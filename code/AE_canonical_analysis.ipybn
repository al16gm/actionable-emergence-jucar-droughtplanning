)
print(
    "[NOTICE] AE1 KGE and NSE were not recomputed because observed "
    "hindcasts are not present in the available input."
)
print(
    "[PASS] No pseudo-observations or artificial skill metrics were "
    "generated."
)
print(
    "[READY] The canonical forecast is ready for a complete "
    "recalculation of AE2 and AE3."
)

print("\nOUTPUTS")
print("-" * 100)
