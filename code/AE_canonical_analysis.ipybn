    )
)

y_positions = {
    component: index
    for index, component in enumerate(
        COMPONENT_ORDER[
            ::-1
        ]
    )
}

for component in COMPONENT_ORDER:
    horizon = EXPECTED_HORIZONS[
        component
    ]

    component_dates = (
        FIGURE_3_DATA.loc[
