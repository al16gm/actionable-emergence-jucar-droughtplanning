    ),

    "monthly_aggregation": (
        "Mean paired point-level rank-score difference"
    ),

    "secondary_binary_sensitivity": {
        "enabled": True,
        "lower_tail_quantile": AE2_BINARY_TAIL_QUANTILE,
        "strict_operator": "<",
        "inclusive_operator": "<=",
        "role": "secondary_sensitivity_only",
    },

    "bootstrap": {
        "method": (
            "Paired trajectory bootstrap over complete control points"
        ),
        "replicates": AE2_BOOTSTRAP_REPLICATES,
        "seed": AE2_BOOTSTRAP_SEED,
        "confidence_level": AE2_CONFIDENCE_LEVEL,
        "resampling_unit": "complete_control_point_trajectory",
        "same_sample_all_months": True,
        "same_sample_both_scenarios": True,
        "execution_cell": "Cell 03",
    },

    "effect_thresholds_pp": EFFECT_THRESHOLDS_PP,
    "persistence_months": PERSISTENCE_MONTHS,
    "expected_direction": EXPECTED_DIRECTION,

    "interpretation": (
        "Forecast-relative displacement within each point's "
        "seasonally adjusted Base distribution. Not a calibrated "
        "future drought probability."
    ),

    "unsupported_claims": {
        "calibrated_probability": False,
        "hindcast_residual_uncertainty": False,
        "rmse_gaussian_probability": False,
        "full_climate_ensemble_sensitivity": False,
        "block_bootstrap_by_exploitation_system": False,
    },
}

CONFIG = CONFIG_AMENDED


# ============================================================
# 5. HELPERS
# ============================================================

def utc_now_iso() -> str:
    """Return the current UTC timestamp."""
    return datetime.now(
        timezone.utc
    ).isoformat(timespec="seconds")


def display_frame(
    frame: pd.DataFrame,
    n: int = 50,
) -> None:
    """Display a DataFrame with a text fallback."""
    try:
        display(
            frame.head(n)
        )
    except NameError:
        print(
            frame.head(n).to_string(
                index=False
            )
        )


def sha256_json(
    payload: dict[str, Any],
) -> str:
    """Return a deterministic SHA-256 hash for JSON content."""
    serialized = json.dumps(
        payload,
        sort_keys=True,
        ensure_ascii=False,
        separators=(",", ":"),
        default=str,
    ).encode("utf-8")

    return hashlib.sha256(
        serialized
    ).hexdigest()


def update_json_file(
    path: Path,
    updates: dict[str, Any],
) -> None:
    """Update a JSON file while preserving existing content."""
    if path.exists():
        with path.open(
            "r",
            encoding="utf-8",
        ) as handle:
            payload = json.load(
                handle
            )
    else:
        payload = {}

    payload.update(
        updates
    )

    with path.open(
        "w",
        encoding="utf-8",
    ) as handle:
        json.dump(
            payload,
            handle,
            ensure_ascii=False,
            indent=2,
            sort_keys=True,
            default=str,
        )


def coerce_boolean(
    values: pd.Series,
) -> pd.Series:
    """Normalize Boolean-like columns after CSV reload."""
    if pd.api.types.is_bool_dtype(
        values
    ):
        return values.astype(bool)

    mapping = {
        "true": True,
        "false": False,
        "1": True,
        "0": False,
    }

    normalized = (
        values.astype(str)
        .str.strip()
        .str.lower()
        .map(mapping)
    )

    if normalized.isna().any():
        raise ValueError(
            "Could not convert all values to Boolean."
        )

    return normalized.astype(bool)


def serialize_integer_list(
    values: list[int],
) -> str:
    """Serialize an integer list for CSV output."""
    return ",".join(
        str(int(value))
        for value in values
    )


def build_midrank_reference(
    reference_values: np.ndarray,
) -> dict[str, Any]:
    """
    Build a tie-aware empirical CDF reference.

    At each unique value x:

        F_mid(x)
        =
        [N(reference < x) + 0.5 N(reference = x)] / N
    """
    reference = np.asarray(
        reference_values,
        dtype=float,
    )

    reference = reference[
        np.isfinite(reference)
    ]

    if reference.size == 0:
        raise ValueError(
            "Cannot build a CDF from an empty reference sample."
        )

    unique_values, counts = np.unique(
        reference,
        return_counts=True,
    )

    cumulative_before = np.concatenate(
        [
            np.array([0], dtype=int),
            np.cumsum(counts)[:-1],
        ]
    )

    midrank_probabilities = (
        cumulative_before
        + 0.5 * counts
    ) / reference.size

    reference_min = float(
        unique_values.min()
    )

    reference_max = float(
        unique_values.max()
    )

    reference_range = (
        reference_max
        - reference_min
    )

    reference_scale = max(
        abs(reference_min),
        abs(reference_max),
        1.0,
    )

    flat_reference = bool(
        np.isclose(
            reference_range,
            0.0,
            atol=NUMERICAL_ATOL,
            rtol=NUMERICAL_RTOL,
        )
        or (
            reference_range
            <= NUMERICAL_RTOL
            * reference_scale
        )
    )

    return {
        "unique_values": unique_values,
        "counts": counts,
        "midrank_probabilities": midrank_probabilities,
        "n_reference": int(
            reference.size
        ),
        "n_unique": int(
            unique_values.size
        ),
        "maximum_tie_count": int(
            counts.max()
        ),
        "maximum_tie_fraction": float(
            counts.max()
            / reference.size
        ),
        "has_ties": bool(
            np.any(
                counts > 1
            )
        ),
        "flat_reference": flat_reference,
        "reference_min": reference_min,
        "reference_max": reference_max,
        "reference_range": float(
            reference_range
        ),
    }


def evaluate_midrank_cdf(
    evaluation_values: np.ndarray,
    reference: dict[str, Any],
) -> np.ndarray:
    """
    Evaluate observations against a non-flat midrank CDF.

    Linear interpolation is used between unique Base values.
    Values below and above the Base range receive 0 and 1.
    """
    if reference["flat_reference"]:
        raise ValueError(
            "A flat reference must not enter the primary rank metric."
        )

    values = np.asarray(
        evaluation_values,
        dtype=float,
    )

    unique_values = np.asarray(
        reference["unique_values"],
        dtype=float,
    )

    probabilities = np.asarray(
        reference["midrank_probabilities"],
        dtype=float,
    )

    return np.interp(
        values,
        unique_values,
        probabilities,
        left=0.0,
        right=1.0,
    )


def safe_correlation(
    x: pd.Series,
    y: pd.Series,
) -> float:
    """Return Pearson correlation when both variables vary."""
    x_values = pd.to_numeric(
        x,
        errors="coerce",
    ).to_numpy(dtype=float)

    y_values = pd.to_numeric(
        y,
        errors="coerce",
    ).to_numpy(dtype=float)

    valid = (
        np.isfinite(x_values)
        & np.isfinite(y_values)
    )

    x_values = x_values[
        valid
    ]

    y_values = y_values[
        valid
    ]

    if (
        x_values.size < 2
        or np.std(x_values) <= NUMERICAL_ATOL
        or np.std(y_values) <= NUMERICAL_ATOL
    ):
        return np.nan

    return float(
        np.corrcoef(
            x_values,
            y_values,
        )[0, 1]
    )


def minimum_nonzero_absolute(
    values: pd.Series,
) -> float:
    """Return the smallest observed non-zero absolute value."""
    numeric_values = np.abs(
        pd.to_numeric(
            values,
            errors="coerce",
        ).to_numpy(dtype=float)
    )

    numeric_values = numeric_values[
        np.isfinite(numeric_values)
        & (
            numeric_values
            > NUMERICAL_ATOL
        )
    ]

    if numeric_values.size == 0:
        return np.nan

    return float(
        numeric_values.min()
    )


# ============================================================
# 6. NORMALIZE AND SELECT EXOG FORECASTS
# ============================================================

forecast = FC_CANONICAL.copy()

forecast["target_date"] = pd.to_datetime(
    forecast["target_date"],
    errors="raise",
)

forecast["lead_months"] = pd.to_numeric(
    forecast["lead_months"],
    errors="raise",
).astype(int)

forecast["y_hat"] = pd.to_numeric(
    forecast["y_hat"],
    errors="raise",
)

for identifier_column in [
    "point_id",
    "series_id",
    "input_kind",
    "scenario",
    "model_family",
]:
    forecast[
        identifier_column
    ] = (
        forecast[
            identifier_column
        ]
        .astype(str)
        .str.strip()
    )

forecast["model_family"] = (
    forecast["model_family"]
    .str.upper()
)

for boolean_column in [
    "AE1_gate_pass",
    "within_inherited_AE1_horizon",
]:
    if boolean_column in forecast.columns:
        forecast[
            boolean_column
        ] = coerce_boolean(
            forecast[
                boolean_column
            ]
        )

forecast["calendar_year"] = (
    forecast["target_date"].dt.year
)

forecast["calendar_month"] = (
    forecast["target_date"].dt.month
)

AE2_SOURCE = forecast.loc[
    forecast[
        "model_family"
    ].eq(
        AE2_MODEL_FAMILY
    ),
    [
        "target_date",
        "lead_months",
        "point_id",
        "series_id",
        "input_kind",
        "scenario",
        "model_family",
        "model",
        "feature_set",
        "y_hat",
        "calendar_year",
        "calendar_month",
        "trustworthy_horizon_months",
        "within_inherited_AE1_horizon",
        "AE1_gate_pass",
    ],
].copy()

if AE2_SOURCE["y_hat"].isna().any():
    raise ValueError(
        "The AE2 source contains missing y_hat values."
    )


# ============================================================
# 7. COMPLETE-TRAJECTORY PANEL
# ============================================================

complete_panel_records: list[
    dict[str, Any]
] = []

for (
    input_kind,
    point_id,
    series_id,
), point_frame in AE2_SOURCE.groupby(
    [
        "input_kind",
        "point_id",
        "series_id",
    ],
    dropna=False,
):
    record: dict[str, Any] = {
        "input_kind": input_kind,
        "point_id": point_id,
        "series_id": series_id,
    }

    complete_flags = []

    for scenario in EXPECTED_SCENARIOS:
        scenario_frame = point_frame[
            point_frame["scenario"].eq(
                scenario
            )
        ]

        observed_leads = set(
            scenario_frame[
                "lead_months"
            ].astype(int)
        )

        missing_leads = sorted(
            EXPECTED_LEAD_SET
            - observed_leads
        )

        n_duplicate_leads = int(
            scenario_frame[
                "lead_months"
            ].duplicated().sum()
        )

        complete = bool(
            observed_leads
            == EXPECTED_LEAD_SET
            and n_duplicate_leads == 0
        )

        complete_flags.append(
            complete
        )

        scenario_token = (
            scenario.lower()
        )

        record[
            f"n_leads_{scenario_token}"
        ] = int(
            len(observed_leads)
        )

        record[
            f"n_missing_leads_{scenario_token}"
        ] = int(
            len(missing_leads)
        )

        record[
            f"missing_leads_{scenario_token}"
        ] = serialize_integer_list(
            missing_leads
        )

        record[
            f"complete_{scenario_token}"
        ] = complete

    record[
        "complete_all_scenarios"
    ] = bool(
        all(
            complete_flags
        )
    )

    complete_panel_records.append(
        record
    )

AE2_COMPLETE_PANEL_ELIGIBILITY = pd.DataFrame(
    complete_panel_records
)

complete_points = (
    AE2_COMPLETE_PANEL_ELIGIBILITY.loc[
        AE2_COMPLETE_PANEL_ELIGIBILITY[
            "complete_all_scenarios"
        ],
        [
            "input_kind",
            "point_id",
            "series_id",
        ],
    ]
    .copy()
)

AE2_COMPLETE_PANEL_SUMMARY = (
    AE2_COMPLETE_PANEL_ELIGIBILITY.groupby(
        "input_kind",
        dropna=False,
    )
    .agg(
        n_points_total=(
            "point_id",
            "nunique",
        ),
        n_complete_points=(
            "complete_all_scenarios",
            "sum",
        ),
        n_incomplete_points=(
            "complete_all_scenarios",
            lambda values: int(
                (~values).sum()
            ),
        ),
    )
    .reset_index()
)

observed_complete_sizes = {
    row.input_kind: int(
        row.n_complete_points
    )
    for row
    in AE2_COMPLETE_PANEL_SUMMARY.itertuples(
        index=False
    )
}

if (
    observed_complete_sizes
    != EXPECTED_COMPLETE_PANEL_SIZES
):
    raise RuntimeError(
        "Complete-panel sizes differ from Cell 01.\n"
        f"Expected: {EXPECTED_COMPLETE_PANEL_SIZES}\n"
        f"Observed: {observed_complete_sizes}"
    )

AE2_COMPLETE_PANEL = AE2_SOURCE.merge(
    complete_points,
    on=[
        "input_kind",
        "point_id",
        "series_id",
    ],
    how="inner",
    validate="many_to_one",
)

expected_complete_rows = (
    sum(
        EXPECTED_COMPLETE_PANEL_SIZES.values()
    )
    * 84
    * 3
)

if len(AE2_COMPLETE_PANEL) != expected_complete_rows:
    raise RuntimeError(
        "Unexpected complete-panel row count.\n"
        f"Expected: {expected_complete_rows:,}\n"
        f"Observed: {len(AE2_COMPLETE_PANEL):,}"
    )


# ============================================================
# 8. POINT-MONTH BASE SEASONAL CENTRES
# ============================================================

BASE_COMPLETE_PANEL = AE2_COMPLETE_PANEL[
    AE2_COMPLETE_PANEL[
        "scenario"
    ].eq(
        AE2_REFERENCE_SCENARIO
    )
].copy()

AE2_BASE_SEASONAL_CENTRES = (
    BASE_COMPLETE_PANEL.groupby(
        [
            "input_kind",
            "point_id",
            "series_id",
            "calendar_month",
        ],
        dropna=False,
    )
    .agg(
        base_calendar_month_median=(
            "y_hat",
            "median",
        ),
        base_calendar_month_mean=(
            "y_hat",
            "mean",
        ),
        base_calendar_month_min=(
            "y_hat",
            "min",
        ),
        base_calendar_month_max=(
            "y_hat",
            "max",
        ),
        n_base_years=(
            "calendar_year",
            "nunique",
        ),
    )
    .reset_index()
)

if not (
    AE2_BASE_SEASONAL_CENTRES[
        "n_base_years"
    ]
    == 7
).all():
    raise RuntimeError(
        "Each point-month seasonal centre must use seven Base years."
    )

AE2_COMPLETE_PANEL = AE2_COMPLETE_PANEL.merge(
    AE2_BASE_SEASONAL_CENTRES[
        [
            "input_kind",
            "point_id",
            "series_id",
            "calendar_month",
            "base_calendar_month_median",
        ]
    ],
    on=[
        "input_kind",
        "point_id",
        "series_id",
        "calendar_month",
    ],
    how="left",
    validate="many_to_one",
)

AE2_COMPLETE_PANEL[
    "seasonally_adjusted_residual"
] = (
    AE2_COMPLETE_PANEL["y_hat"]
    - AE2_COMPLETE_PANEL[
        "base_calendar_month_median"
    ]
)

if AE2_COMPLETE_PANEL[
    "seasonally_adjusted_residual"
].isna().any():
    raise RuntimeError(
        "Missing seasonal residuals were generated."
    )


# ============================================================
# 9. BUILD 84-MONTH BASE RESIDUAL REFERENCES
# ============================================================

BASE_RESIDUAL_PANEL = AE2_COMPLETE_PANEL[
    AE2_COMPLETE_PANEL[
        "scenario"
    ].eq(
        AE2_REFERENCE_SCENARIO
    )
].copy()

reference_diagnostic_records: list[
    dict[str, Any]
] = []

reference_lookup_all: dict[
    tuple[str, str, str],
    dict[str, Any],
] = {}

for (
    input_kind,
    point_id,
    series_id,
), point_frame in BASE_RESIDUAL_PANEL.groupby(
    [
        "input_kind",
        "point_id",
        "series_id",
    ],
    dropna=False,
):
    reference = build_midrank_reference(
        point_frame[
            "seasonally_adjusted_residual"
        ].to_numpy(dtype=float)
    )

    key = (
        str(input_kind),
        str(point_id),
        str(series_id),
    )

    reference_lookup_all[
        key
    ] = reference

    reference_diagnostic_records.append(
        {
            "input_kind": input_kind,
            "point_id": point_id,
            "series_id": series_id,
            "n_reference_values": int(
                reference[
                    "n_reference"
                ]
            ),
            "n_unique_values": int(
                reference[
                    "n_unique"
                ]
            ),
            "has_ties": bool(
                reference[
                    "has_ties"
                ]
            ),
            "maximum_tie_count": int(
                reference[
                    "maximum_tie_count"
                ]
            ),
            "maximum_tie_fraction": float(
                reference[
                    "maximum_tie_fraction"
                ]
            ),
            "flat_reference": bool(
                reference[
                    "flat_reference"
                ]
            ),
            "reference_min": float(
                reference[
                    "reference_min"
                ]
            ),
            "reference_max": float(
                reference[
                    "reference_max"
                ]
            ),
            "reference_range": float(
                reference[
                    "reference_range"
                ]
            ),
        }
    )

AE2_BASE_RESIDUAL_REFERENCE_DIAGNOSTIC = pd.DataFrame(
    reference_diagnostic_records
)

if not (
    AE2_BASE_RESIDUAL_REFERENCE_DIAGNOSTIC[
        "n_reference_values"
    ]
    == 84
).all():
    raise RuntimeError(
        "Each Base residual reference must contain 84 values."
    )


# ============================================================
# 10. EXCLUDE COMPLETELY FLAT REFERENCES
# ============================================================

informative_points = (
    AE2_BASE_RESIDUAL_REFERENCE_DIAGNOSTIC.loc[
        ~AE2_BASE_RESIDUAL_REFERENCE_DIAGNOSTIC[
            "flat_reference"
        ],
        [
            "input_kind",
            "point_id",
            "series_id",
        ],
    ]
    .copy()
)

AE2_REFERENCE_PANEL_SUMMARY = (
    AE2_BASE_RESIDUAL_REFERENCE_DIAGNOSTIC.groupby(
        "input_kind",
        dropna=False,
    )
    .agg(
        n_complete_points=(
            "point_id",
            "nunique",
        ),
        n_informative_points=(
            "flat_reference",
            lambda values: int(
                (~values).sum()
            ),
        ),
        n_flat_points=(
            "flat_reference",
            "sum",
        ),
        pct_flat_points=(
            "flat_reference",
            lambda values: float(
                100.0
                * values.mean()
            ),
        ),
        n_points_with_ties=(
            "has_ties",
            "sum",
        ),
        pct_points_with_ties=(
            "has_ties",
            lambda values: float(
                100.0
                * values.mean()
            ),
        ),
        minimum_unique_values=(
            "n_unique_values",
            "min",
        ),
        median_unique_values=(
            "n_unique_values",
            "median",
        ),
        maximum_unique_values=(
            "n_unique_values",
            "max",
        ),
        maximum_tie_fraction=(
            "maximum_tie_fraction",
            "max",
        ),
        minimum_reference_range=(
            "reference_range",
            "min",
        ),
        median_reference_range=(
            "reference_range",
            "median",
        ),
        maximum_reference_range=(
            "reference_range",
            "max",
        ),
    )
    .reset_index()
)

informative_panel_sizes = {
    row.input_kind: int(
        row.n_informative_points
    )
    for row
    in AE2_REFERENCE_PANEL_SUMMARY.itertuples(
        index=False
    )
}

components_below_minimum = {
    component: n_points
    for component, n_points
    in informative_panel_sizes.items()
    if n_points < MINIMUM_INFORMATIVE_POINTS
}

if components_below_minimum:
    raise RuntimeError(
        "Too few informative control points remain after "
        "excluding flat Base references:\n"
        f"{components_below_minimum}"
    )

AE2_POINT_STATES = AE2_COMPLETE_PANEL.merge(
    informative_points,
    on=[
        "input_kind",
        "point_id",
        "series_id",
    ],
    how="inner",
    validate="many_to_one",
)


# ============================================================
# 11. EVALUATE POINT-SPECIFIC RESIDUAL CDFS
# ============================================================

AE2_POINT_STATES[
    "base_residual_reference_cdf"
] = np.nan

for (
    input_kind,
    point_id,
    series_id,
), point_frame in AE2_POINT_STATES.groupby(
    [
        "input_kind",
        "point_id",
        "series_id",
    ],
    dropna=False,
):
    key = (
        str(input_kind),
        str(point_id),
        str(series_id),
    )

    reference = reference_lookup_all[
        key
    ]

    evaluated_cdf = evaluate_midrank_cdf(
        point_frame[
            "seasonally_adjusted_residual"
        ].to_numpy(dtype=float),
        reference,
    )

    AE2_POINT_STATES.loc[
        point_frame.index,
        "base_residual_reference_cdf",
    ] = evaluated_cdf

if AE2_POINT_STATES[
    "base_residual_reference_cdf"
].isna().any():
    raise RuntimeError(
        "Missing point-level empirical CDF values were generated."
    )

if not AE2_POINT_STATES[
    "base_residual_reference_cdf"
].between(
    0.0,
    1.0,
    inclusive="both",
).all():
    raise RuntimeError(
        "Empirical CDF values fall outside [0, 1]."
    )

AE2_POINT_STATES[
    "drought_rank_score"
] = (
    1.0
    - AE2_POINT_STATES[
        "base_residual_reference_cdf"
    ]
)

AE2_POINT_STATES[
    "binary_lower_tail_strict"
] = (
    AE2_POINT_STATES[
        "base_residual_reference_cdf"
    ]
    < AE2_BINARY_TAIL_QUANTILE
)

AE2_POINT_STATES[
    "binary_lower_tail_inclusive"
] = (
    AE2_POINT_STATES[
        "base_residual_reference_cdf"
    ]
    <= AE2_BINARY_TAIL_QUANTILE
)

AE2_POINT_STATES[
    "metric_name"
] = AE2_PRIMARY_METRIC

AE2_POINT_STATES[
    "probability_calibrated"
] = False


# ============================================================
# 12. VALIDATE BASE MIDRANK BEHAVIOUR
# ============================================================

base_rank_states = AE2_POINT_STATES[
    AE2_POINT_STATES[
        "scenario"
    ].eq("Base")
].copy()

AE2_BASE_MIDRANK_VALIDATION = (
    base_rank_states.groupby(
        [
            "input_kind",
            "point_id",
            "series_id",
        ],
        dropna=False,
    )
    .agg(
        n_base_values=(
            "y_hat",
            "size",
        ),
        mean_base_cdf=(
            "base_residual_reference_cdf",
            "mean",
        ),
        mean_base_drought_rank_score=(
            "drought_rank_score",
            "mean",
        ),
        minimum_base_score=(
            "drought_rank_score",
            "min",
        ),
        maximum_base_score=(
            "drought_rank_score",
            "max",
        ),
    )
    .reset_index()
)

maximum_base_cdf_deviation = float(
    np.max(
        np.abs(
            AE2_BASE_MIDRANK_VALIDATION[
                "mean_base_cdf"
            ]
            - 0.5
        )
    )
)

maximum_base_score_deviation = float(
    np.max(
        np.abs(
            AE2_BASE_MIDRANK_VALIDATION[
                "mean_base_drought_rank_score"
            ]
            - 0.5
        )
    )
)

if maximum_base_cdf_deviation > 1e-10:
    raise RuntimeError(
        "The mean Base CDF is not numerically equal to 0.5."
    )

if maximum_base_score_deviation > 1e-10:
    raise RuntimeError(
        "The mean Base drought-rank score is not numerically "
        "equal to 0.5."
    )


# ============================================================
# 13. CREATE PAIRED POINT-LEVEL DIFFERENCES
# ============================================================

PAIR_KEY = [
    "input_kind",
    "point_id",
    "series_id",
    "target_date",
    "lead_months",
    "calendar_year",
    "calendar_month",
    "trustworthy_horizon_months",
    "within_inherited_AE1_horizon",
    "AE1_gate_pass",
]

base_point_states = (
    AE2_POINT_STATES.loc[
        AE2_POINT_STATES[
            "scenario"
        ].eq("Base"),
        PAIR_KEY
        + [
            "y_hat",
            "base_calendar_month_median",
            "seasonally_adjusted_residual",
            "base_residual_reference_cdf",
            "drought_rank_score",
            "binary_lower_tail_strict",
            "binary_lower_tail_inclusive",
        ],
    ]
    .rename(
        columns={
            "y_hat": "base_y_hat",
            "seasonally_adjusted_residual": (
                "base_seasonally_adjusted_residual"
            ),
            "base_residual_reference_cdf": (
                "base_reference_cdf"
            ),
            "drought_rank_score": (
                "base_drought_rank_score"
            ),
            "binary_lower_tail_strict": (
                "base_binary_lower_tail_strict"
            ),
            "binary_lower_tail_inclusive": (
                "base_binary_lower_tail_inclusive"
            ),
        }
    )
)

paired_frames: list[
    pd.DataFrame
] = []

for scenario in [
    "Favorable",
    "Unfavorable",
]:
    scenario_point_states = (
        AE2_POINT_STATES.loc[
            AE2_POINT_STATES[
                "scenario"
            ].eq(scenario),
            PAIR_KEY
            + [
                "y_hat",
                "seasonally_adjusted_residual",
                "base_residual_reference_cdf",
                "drought_rank_score",
                "binary_lower_tail_strict",
                "binary_lower_tail_inclusive",
            ],
        ]
        .rename(
            columns={
                "y_hat": "scenario_y_hat",
                "seasonally_adjusted_residual": (
                    "scenario_seasonally_adjusted_residual"
                ),
                "base_residual_reference_cdf": (
                    "scenario_reference_cdf"
                ),
                "drought_rank_score": (
                    "scenario_drought_rank_score"
                ),
                "binary_lower_tail_strict": (
                    "scenario_binary_lower_tail_strict"
                ),
                "binary_lower_tail_inclusive": (
                    "scenario_binary_lower_tail_inclusive"
                ),
            }
        )
    )

    paired = base_point_states.merge(
        scenario_point_states,
        on=PAIR_KEY,
        how="inner",
        validate="one_to_one",
    )

    paired["scenario"] = scenario

    paired[
        "delta_y_hat"
    ] = (
        paired["scenario_y_hat"]
        - paired["base_y_hat"]
    )

    paired[
        "delta_seasonally_adjusted_residual"
    ] = (
        paired[
            "scenario_seasonally_adjusted_residual"
        ]
        - paired[
            "base_seasonally_adjusted_residual"
        ]
    )

    paired[
        "delta_drought_rank_score"
    ] = (
        paired[
            "scenario_drought_rank_score"
        ]
        - paired[
            "base_drought_rank_score"
        ]
    )

    paired[
        "delta_drought_rank_score_pp"
    ] = (
        100.0
        * paired[
            "delta_drought_rank_score"
        ]
    )

    paired[
        "delta_binary_lower_tail_strict"
    ] = (
        paired[
            "scenario_binary_lower_tail_strict"
        ].astype(int)
        - paired[
            "base_binary_lower_tail_strict"
        ].astype(int)
    )

    paired[
        "delta_binary_lower_tail_inclusive"
    ] = (
        paired[
            "scenario_binary_lower_tail_inclusive"
        ].astype(int)
        - paired[
            "base_binary_lower_tail_inclusive"
        ].astype(int)
    )

    paired[
        "point_direction_neutral"
    ] = np.isclose(
        paired[
            "delta_drought_rank_score"
        ],
        0.0,
        atol=NUMERICAL_ATOL,
        rtol=0.0,
    )

    if scenario == "Favorable":
        paired[
            "point_direction_consistent"
        ] = (
            paired[
                "delta_drought_rank_score"
            ]
            < 0
        )
    else:
        paired[
            "point_direction_consistent"
        ] = (
            paired[
                "delta_drought_rank_score"
            ]
            > 0
        )

    paired.loc[
        paired[
            "point_direction_neutral"
        ],
        "point_direction_consistent",
    ] = False

    paired_frames.append(
        paired
    )

AE2_PAIRED_DELTAS = pd.concat(
    paired_frames,
    ignore_index=True,
)

expected_paired_rows = (
    sum(
        informative_panel_sizes.values()
    )
    * 84
    * 2
)

if len(AE2_PAIRED_DELTAS) != expected_paired_rows:
    raise RuntimeError(
        "Unexpected paired-delta row count.\n"
        f"Expected: {expected_paired_rows:,}\n"
        f"Observed: {len(AE2_PAIRED_DELTAS):,}"
    )


# ============================================================
# 14. MONTHLY SCENARIO LEVELS
# ============================================================

AE2_MONTHLY_LEVELS = (
    AE2_POINT_STATES.groupby(
        [
            "input_kind",
            "scenario",
            "lead_months",
            "target_date",
            "calendar_year",
            "calendar_month",
            "trustworthy_horizon_months",
            "within_inherited_AE1_horizon",
            "AE1_gate_pass",
        ],
        dropna=False,
    )
    .agg(
        n_control_points=(
            "point_id",
            "nunique",
        ),
        mean_drought_rank_score=(
            "drought_rank_score",
            "mean",
        ),
        median_drought_rank_score=(
            "drought_rank_score",
            "median",
        ),
        mean_reference_cdf=(
            "base_residual_reference_cdf",
            "mean",
        ),
        strict_binary_tail_prevalence=(
            "binary_lower_tail_strict",
            "mean",
        ),
        inclusive_binary_tail_prevalence=(
            "binary_lower_tail_inclusive",
            "mean",
        ),
    )
    .reset_index()
)

AE2_MONTHLY_LEVELS[
    "mean_drought_rank_score_pp"
] = (
    100.0
    * AE2_MONTHLY_LEVELS[
        "mean_drought_rank_score"
    ]
)

AE2_MONTHLY_LEVELS[
    "strict_binary_tail_prevalence_pp"
] = (
    100.0
    * AE2_MONTHLY_LEVELS[
        "strict_binary_tail_prevalence"
    ]
)

AE2_MONTHLY_LEVELS[
    "inclusive_binary_tail_prevalence_pp"
] = (
    100.0
    * AE2_MONTHLY_LEVELS[
        "inclusive_binary_tail_prevalence"
    ]
)


# ============================================================
# 15. MONTHLY PAIRED CENTRAL DIFFERENCES
# ============================================================

AE2_DELTA_CENTRAL = (
    AE2_PAIRED_DELTAS.groupby(
        [
            "input_kind",
            "scenario",
            "lead_months",
            "target_date",
            "calendar_year",
            "calendar_month",
            "trustworthy_horizon_months",
            "within_inherited_AE1_horizon",
            "AE1_gate_pass",
        ],
        dropna=False,
    )
    .agg(
        n_control_points=(
            "point_id",
            "nunique",
        ),
        mean_delta_rank_score=(
            "delta_drought_rank_score",
            "mean",
        ),
        median_delta_rank_score=(
            "delta_drought_rank_score",
            "median",
        ),
        q05_delta_rank_score=(
            "delta_drought_rank_score",
            lambda values: float(
                values.quantile(0.05)
            ),
        ),
        q25_delta_rank_score=(
            "delta_drought_rank_score",
            lambda values: float(
                values.quantile(0.25)
            ),
        ),
        q75_delta_rank_score=(
            "delta_drought_rank_score",
            lambda values: float(
                values.quantile(0.75)
            ),
        ),
        q95_delta_rank_score=(
            "delta_drought_rank_score",
            lambda values: float(
                values.quantile(0.95)
            ),
        ),
        mean_absolute_point_delta=(
            "delta_drought_rank_score",
            lambda values: float(
                np.mean(
                    np.abs(values)
                )
            ),
        ),
        pct_points_positive=(
            "delta_drought_rank_score",
            lambda values: float(
                100.0
                * (values > 0).mean()
            ),
        ),
        pct_points_negative=(
            "delta_drought_rank_score",
            lambda values: float(
                100.0
                * (values < 0).mean()
            ),
        ),
        pct_points_neutral=(
            "point_direction_neutral",
            lambda values: float(
                100.0
                * values.mean()
            ),
        ),
        pct_points_direction_consistent=(
            "point_direction_consistent",
            lambda values: float(
                100.0
                * values.mean()
            ),
        ),
        mean_delta_binary_strict=(
            "delta_binary_lower_tail_strict",
            "mean",
        ),
        mean_delta_binary_inclusive=(
            "delta_binary_lower_tail_inclusive",
            "mean",
        ),
    )
    .reset_index()
)

AE2_DELTA_CENTRAL[
    "delta_rank_score_pp"
] = (
    100.0
    * AE2_DELTA_CENTRAL[
        "mean_delta_rank_score"
    ]
)

AE2_DELTA_CENTRAL[
    "median_delta_rank_score_pp"
] = (
    100.0
    * AE2_DELTA_CENTRAL[
        "median_delta_rank_score"
    ]
)

AE2_DELTA_CENTRAL[
    "mean_absolute_point_delta_pp"
] = (
    100.0
    * AE2_DELTA_CENTRAL[
        "mean_absolute_point_delta"
    ]
)

AE2_DELTA_CENTRAL[
    "delta_binary_strict_pp"
] = (
    100.0
    * AE2_DELTA_CENTRAL[
        "mean_delta_binary_strict"
    ]
)

AE2_DELTA_CENTRAL[
    "delta_binary_inclusive_pp"
] = (
    100.0
    * AE2_DELTA_CENTRAL[
        "mean_delta_binary_inclusive"
    ]
)

AE2_DELTA_CENTRAL[
    "abs_delta_rank_score_pp"
] = (
    AE2_DELTA_CENTRAL[
        "delta_rank_score_pp"
    ].abs()
)

AE2_DELTA_CENTRAL[
    "monthly_direction_neutral"
] = np.isclose(
    AE2_DELTA_CENTRAL[
        "delta_rank_score_pp"
    ],
    0.0,
    atol=NUMERICAL_ATOL,
    rtol=0.0,
)

AE2_DELTA_CENTRAL[
    "monthly_direction_consistent"
] = np.where(
    AE2_DELTA_CENTRAL[
        "scenario"
    ].eq("Favorable"),
    AE2_DELTA_CENTRAL[
        "delta_rank_score_pp"
    ] < 0,
    AE2_DELTA_CENTRAL[
        "delta_rank_score_pp"
    ] > 0,
)

AE2_DELTA_CENTRAL.loc[
    AE2_DELTA_CENTRAL[
        "monthly_direction_neutral"
    ],
    "monthly_direction_consistent",
] = False

AE2_DELTA_CENTRAL[
    "expected_direction"
] = (
    AE2_DELTA_CENTRAL[
        "scenario"
    ].map(
        EXPECTED_DIRECTION
    )
)

AE2_DELTA_CENTRAL[
    "metric_name"
] = AE2_PRIMARY_METRIC

AE2_DELTA_CENTRAL[
    "probability_calibrated"
] = False


# ============================================================
# 16. SUMMARY WITHIN AE1 HORIZONS
# ============================================================

within_ae1 = AE2_DELTA_CENTRAL[
    AE2_DELTA_CENTRAL[
        "AE1_gate_pass"
    ]
].copy()

summary_records: list[
    dict[str, Any]
] = []

for (
    input_kind,
    scenario,
), group in within_ae1.groupby(
    [
        "input_kind",
        "scenario",
    ],
    dropna=False,
):
    rank_values = group[
        "delta_rank_score_pp"
    ].to_numpy(dtype=float)

    binary_values = group[
        "delta_binary_strict_pp"
    ].to_numpy(dtype=float)

    maximum_index = group[
        "abs_delta_rank_score_pp"
    ].idxmax()

    maximum_row = group.loc[
        maximum_index
    ]

    rank_sign = np.sign(
        rank_values
    )

    binary_sign = np.sign(
        binary_values
    )

    nonzero_both = (
        rank_sign != 0
    ) & (
        binary_sign != 0
    )

    sign_agreement = (
        float(
            100.0
            * np.mean(
                rank_sign[
                    nonzero_both
                ]
                == binary_sign[
                    nonzero_both
                ]
            )
        )
        if np.any(
            nonzero_both
        )
        else np.nan
    )

    summary_records.append(
        {
            "input_kind": input_kind,
            "scenario": scenario,

            "Rk_months": int(
                group[
                    "trustworthy_horizon_months"
                ].iloc[0]
            ),

            "n_months_within_Rk": int(
                len(group)
            ),

            "n_control_points": int(
                group[
                    "n_control_points"
                ].iloc[0]
            ),

            "mean_delta_rank_score_pp": float(
                np.mean(
                    rank_values
                )
            ),

            "median_delta_rank_score_pp": float(
                np.median(
                    rank_values
                )
            ),

            "minimum_delta_rank_score_pp": float(
                np.min(
                    rank_values
                )
            ),

            "maximum_delta_rank_score_pp": float(
                np.max(
                    rank_values
                )
            ),

            "maximum_abs_delta_rank_score_pp": float(
                np.max(
                    np.abs(
                        rank_values
                    )
                )
            ),

            "observed_minimum_nonzero_abs_delta_pp": (
                minimum_nonzero_absolute(
                    group[
                        "delta_rank_score_pp"
                    ]
                )
            ),

            "lead_of_maximum_abs_delta": int(
                maximum_row[
                    "lead_months"
                ]
            ),

            "date_of_maximum_abs_delta": (
                maximum_row[
                    "target_date"
                ]
            ),

            "n_months_positive": int(
                np.sum(
                    rank_values > 0
                )
            ),

            "n_months_negative": int(
                np.sum(
                    rank_values < 0
                )
            ),

            "n_months_zero": int(
                np.sum(
                    np.isclose(
                        rank_values,
                        0.0,
                        atol=NUMERICAL_ATOL,
                        rtol=0.0,
                    )
                )
            ),

            "pct_months_direction_consistent": float(
                100.0
                * group[
                    "monthly_direction_consistent"
                ].mean()
            ),

            "pct_months_direction_neutral": float(
                100.0
                * group[
                    "monthly_direction_neutral"
                ].mean()
            ),

            "mean_pct_points_direction_consistent": float(
                group[
                    "pct_points_direction_consistent"
                ].mean()
            ),

            "mean_delta_binary_strict_pp": float(
                np.mean(
                    binary_values
                )
            ),

            "maximum_abs_delta_binary_strict_pp": float(
                np.max(
                    np.abs(
                        binary_values
                    )
                )
            ),

            "rank_binary_monthly_correlation": (
                safe_correlation(
                    group[
                        "delta_rank_score_pp"
                    ],
                    group[
                        "delta_binary_strict_pp"
                    ],
                )
            ),

            "rank_binary_sign_agreement_nonzero_pct": (
                sign_agreement
            ),
        }
    )

AE2_CENTRAL_SUMMARY = pd.DataFrame(
    summary_records
)


# ============================================================
# 17. METRIC RESOLUTION
# ============================================================

resolution_records: list[
    dict[str, Any]
] = []

for (
    input_kind,
    n_points,
) in informative_panel_sizes.items():
    reference_grid_step_pp = (
        100.0
        / (
            84
            * n_points
        )
    )

    observed_component_minimum = (
        minimum_nonzero_absolute(
            within_ae1.loc[
                within_ae1[
                    "input_kind"
                ].eq(
                    input_kind
                ),
                "delta_rank_score_pp",
            ]
        )
    )

    for threshold_pp in EFFECT_THRESHOLDS_PP:
        resolution_records.append(
            {
                "input_kind": input_kind,
                "n_control_points": int(
                    n_points
                ),
                "n_base_residuals_per_point": 84,

                "reference_grid_step_pp": float(
                    reference_grid_step_pp
                ),

                "observed_minimum_nonzero_monthly_delta_pp": (
                    observed_component_minimum
                ),

                "effect_threshold_pp": float(
                    threshold_pp
                ),

                "threshold_to_reference_grid_step_ratio": float(
                    threshold_pp
                    / reference_grid_step_pp
                ),

                "threshold_exceeds_reference_grid_step": bool(
                    threshold_pp
                    >= reference_grid_step_pp
                ),

                "linear_interpolation_enabled": True,

                "interpretation": (
                    "Threshold expressed in drought-rank-score "
                    "percentage points; not equivalent to the "
                    "former Gaussian probability difference."
                ),
            }
        )

AE2_METRIC_RESOLUTION = pd.DataFrame(
    resolution_records
)


# ============================================================
# 18. PRIMARY–BINARY COMPARISON
# ============================================================

binary_comparison_records: list[
    dict[str, Any]
] = []

for (
    input_kind,
    scenario,
), group in within_ae1.groupby(
    [
        "input_kind",
        "scenario",
    ],
    dropna=False,
):
    binary_comparison_records.append(
        {
            "input_kind": input_kind,
            "scenario": scenario,
            "n_months": int(
                len(group)
            ),

            "mean_delta_rank_score_pp": float(
                group[
                    "delta_rank_score_pp"
                ].mean()
            ),

            "mean_delta_binary_strict_pp": float(
                group[
                    "delta_binary_strict_pp"
                ].mean()
            ),

            "mean_delta_binary_inclusive_pp": float(
                group[
                    "delta_binary_inclusive_pp"
                ].mean()
            ),

            "correlation_rank_vs_binary_strict": (
                safe_correlation(
                    group[
                        "delta_rank_score_pp"
                    ],
                    group[
                        "delta_binary_strict_pp"
                    ],
                )
            ),

            "correlation_rank_vs_binary_inclusive": (
                safe_correlation(
                    group[
                        "delta_rank_score_pp"
                    ],
                    group[
                        "delta_binary_inclusive_pp"
                    ],
                )
            ),

            "maximum_abs_rank_delta_pp": float(
                group[
                    "delta_rank_score_pp"
                ].abs().max()
            ),

            "maximum_abs_binary_strict_delta_pp": float(
                group[
                    "delta_binary_strict_pp"
                ].abs().max()
            ),
        }
    )

AE2_BINARY_COMPARISON = pd.DataFrame(
    binary_comparison_records
)


# ============================================================
# 19. OUTPUT PATHS
# ============================================================

AE2_CONFIG_PATH = (
    Path(PATHS["provenance"])
    / "canonical_configuration_amended_cell02.json"
)

AE2_SCOPE_PATH = (
    Path(PATHS["provenance"])
    / "analysis_scope_amendment_cell02.json"
)

AE2_COMPLETE_ELIGIBILITY_PATH = (
    AE2_DIR
    / "AE2_complete_panel_eligibility.csv"
)

AE2_COMPLETE_SUMMARY_PATH = (
    AE2_DIR
    / "AE2_complete_panel_summary.csv"
)

AE2_SEASONAL_CENTRES_PATH = (
    AE2_DIR
    / "AE2_Base_point_month_seasonal_centres.csv"
)

AE2_REFERENCE_DIAGNOSTIC_PATH = (
    AE2_DIR
    / "AE2_Base_84month_residual_reference_diagnostic.csv"
)

AE2_REFERENCE_SUMMARY_PATH = (
    AE2_DIR
    / "AE2_84month_reference_panel_summary.csv"
