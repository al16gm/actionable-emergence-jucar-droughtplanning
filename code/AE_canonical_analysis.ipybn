# ============================================================
# CELL 04 — AE3 CROSS-VALIDATED DECISION VALUE
#           FOR AQUIFER, RESERVOIR, AND RIVER
#
# Primary objective
# -----------------
# Quantify whether scenario-conditioned drought-rank information
# improves a stylised management policy relative to a policy
# conditioned only on the Base trajectory.
#
# Components
# ----------
# - Aquifer
# - Reservoir
# - River
#
# State variable
# --------------
# q(i,t,s) = forecast-relative, seasonally adjusted drought-rank score
#
# q is bounded in [0, 1]:
#   low q  -> relatively wet / high-availability state
#   high q -> relatively dry / low-availability state
#
# Actions
# -------
# a in {0.00, 0.05, 0.10, 0.20}
#
# Loss
# ----
# L(q, a) = max(0, q - pi - eta*a)^2 + gamma*a^2
#
# Default parameters
# ------------------
# pi    = 0.70
# eta   = 1.00
# gamma = 1.00
#
# Cross-validation
# ----------------
# For every component, scenario, month, and held-out point:
#   1. Select the Base-conditioned action using the other n-1 points.
#   2. Select the scenario-conditioned action using the other n-1 points.
#   3. Evaluate both actions on the held-out scenario point.
#
# Primary value
# -------------
# Scenario-conditioning value:
#
#   SCV = loss(Base-policy action under scenario)
#         - loss(scenario-policy action under scenario)
#
# Positive SCV means scenario conditioning improves held-out utility.
#
# Inference
# ---------
# - 5,000 paired complete-trajectory bootstrap replicates.
# - Same resampled points for every month.
# - Same resampled points for Favorable and Unfavorable.
# - Pointwise percentile intervals.
# - Scenario-wise simultaneous bands.
# - Joint simultaneous bands across both scenarios.
#
# Important
# ---------
# This is a normalised decision experiment.
# It is not a component-specific operational optimisation model.
# ============================================================

from __future__ import annotations

import copy
import hashlib
import json
import shutil
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

import numpy as np
import pandas as pd


# ============================================================
