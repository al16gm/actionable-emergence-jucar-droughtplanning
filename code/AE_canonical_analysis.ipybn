# ============================================================
# 7. NORMALIZE SOURCES
# ============================================================

frames_with_dates = [
    point_states,
    ae2_monthly,
    ae2_peak_influence,
    negative_value_months,
    ae3_authoritative_monthly,
    cross_scenario_agreement_monthly,
    authoritative_intersection,
    authoritative_runs,
    authoritative_persistence,
    persistence_comparison,
]

for frame in frames_with_dates:
    for column in frame.columns:
        if (
            column == "target_date"
            or column.endswith(
                "_date"
            )
            or column in {
                "start_date",
                "end_date",
                "first_start_date",
                "first_end_date",
                "fixed_first_start_date",
                "fixed_first_end_date",
                "reselection_first_start_date",
                "reselection_first_end_date",
            }
        ):
            frame[
                column
            ] = pd.to_datetime(
                frame[
                    column
                ],
                errors="coerce",
            )


for frame in [
    point_states,
    ae2_monthly,
    ae2_summary,
    ae2_emergence_sensitivity,
    ae2_critical_values,
    ae2_peak_influence,
    ae2_tie_influence,
    ae2_point_influence,
    pooled_ruv,
    parameter_robustness,
    action_summary,
    action_transitions,
    negative_value_months,
    ae3_authoritative_monthly,
    fixed_vs_reselection,
    reselection_stability,
    reselection_critical_values,
    authoritative_intersection,
    authoritative_runs,
    authoritative_persistence,
    persistence_comparison,
]:
    for identifier_column in [
        "input_kind",
        "scenario",
    ]:
        if identifier_column in frame.columns:
            frame[
                identifier_column
            ] = (
                frame[
                    identifier_column
                ]
                .astype(str)
                .str.strip()
            )


boolean_columns_by_frame = {
    "ae3_authoritative_monthly": (
        ae3_authoritative_monthly,
        [
            "within_AE1_horizon",
            "scenario_value_pointwise_positive",
            "scenario_value_scenario_band_positive",
            "scenario_value_joint_band_positive",
            "AE3_exploratory_gate",
            "AE3_confirmatory_gate",
        ],
    ),
    "authoritative_persistence": (
        authoritative_persistence,
        [
            "emergence_detected",
        ],
    ),
    "authoritative_runs": (
        authoritative_runs,
        [
            "qualifies_r1",
            "qualifies_r3",
            "qualifies_r6",
        ],
    ),
}

for (
    frame_name,
    (
        frame,
        boolean_columns,
    ),
) in boolean_columns_by_frame.items():
    for boolean_column in boolean_columns:
        if boolean_column in frame.columns:
            frame[
                boolean_column
            ] = coerce_boolean(
                frame[
                    boolean_column
                ]
            )


# ============================================================
# 8. VALIDATE AUTHORITATIVE SOURCES
# ============================================================

expected_monthly_rows = (
    len(
        COMPONENT_ORDER
    )
    * len(
        SCENARIO_ORDER
    )
    * 84
)

if len(
    ae3_authoritative_monthly
) != expected_monthly_rows:
    raise RuntimeError(
        "Unexpected authoritative AE3 monthly row count.\n"
        f"Expected: {expected_monthly_rows}\n"
        f"Observed: {len(ae3_authoritative_monthly)}"
    )


expected_intersection_rows = (
    len(
        SCENARIO_ORDER
    )
    * sum(
        EXPECTED_HORIZONS.values()
    )
)

if len(
    authoritative_intersection
) != expected_intersection_rows:
    raise RuntimeError(
        "Unexpected authoritative full-AE intersection row count.\n"
        f"Expected: {expected_intersection_rows}\n"
        f"Observed: {len(authoritative_intersection)}"
    )


# ============================================================
# 9. SUPPLEMENTARY TABLE S01 — ANALYSIS POPULATION
# ============================================================

S01_ANALYSIS_POPULATION = (
    point_states.groupby(
        "input_kind",
        dropna=False,
    )
    .agg(
        n_control_points=(
            "point_id",
            "nunique",
        ),
        n_series=(
            "series_id",
            "nunique",
        ),
        n_scenarios=(
            "scenario",
            "nunique",
        ),
        n_forecast_months=(
            "lead_months",
            "nunique",
        ),
        forecast_start=(
            "target_date",
            "min",
        ),
        forecast_end=(
            "target_date",
            "max",
        ),
        n_point_scenario_months=(
            "point_id",
            "size",
        ),
    )
    .reset_index()
)

S01_ANALYSIS_POPULATION[
    "inherited_AE1_horizon_months"
] = (
    S01_ANALYSIS_POPULATION[
        "input_kind"
    ].map(
        EXPECTED_HORIZONS
    )
)

S01_ANALYSIS_POPULATION[
    "expected_control_points"
] = (
    S01_ANALYSIS_POPULATION[
        "input_kind"
    ].map(
        EXPECTED_CONTROL_POINTS
    )
)

S01_ANALYSIS_POPULATION[
    "control_point_count_valid"
] = (
    S01_ANALYSIS_POPULATION[
        "n_control_points"
    ]
    == S01_ANALYSIS_POPULATION[
        "expected_control_points"
    ]
)

S01_ANALYSIS_POPULATION = (
    S01_ANALYSIS_POPULATION.sort_values(
        "input_kind"
    )
    .reset_index(
        drop=True
    )
)


# ============================================================
# 10. MAIN TABLE 1 — HIERARCHICAL EVIDENCE
# ============================================================

base_grid = pd.DataFrame(
    [
        {
            "input_kind": component,
            "scenario": scenario,
        }
        for component, scenario
        in product(
            COMPONENT_ORDER,
            SCENARIO_ORDER,
        )
    ]
)


ae3_monthly_within_ae1 = (
    ae3_authoritative_monthly.loc[
        ae3_authoritative_monthly[
            "within_AE1_horizon"
        ]
    ]
    .copy()
)

ae3_authoritative_summary = (
    ae3_monthly_within_ae1.groupby(
        [
            "input_kind",
            "scenario",
        ],
        dropna=False,
    )
    .agg(
        mean_scenario_conditioning_value=(
            "scenario_conditioning_value",
            "mean",
        ),
        median_scenario_conditioning_value=(
            "scenario_conditioning_value",
            "median",
        ),
        n_AE3_pointwise_positive_months=(
            "scenario_value_pointwise_positive",
            "sum",
        ),
        n_AE3_joint_positive_months=(
            "scenario_value_joint_band_positive",
            "sum",
        ),
    )
    .reset_index()
)


persistence_r3 = (
    authoritative_persistence.loc[
        authoritative_persistence[
            "persistence_months"
        ].eq(
            DEFAULT_PERSISTENCE_MONTHS
        )
    ]
    .copy()
)

persistence_detected = (
    persistence_r3.pivot(
        index=[
            "input_kind",
            "scenario",
        ],
        columns="gate_type",
        values="emergence_detected",
    )
    .reset_index()
)

persistence_longest = (
    persistence_r3.pivot(
        index=[
            "input_kind",
            "scenario",
        ],
        columns="gate_type",
        values="longest_run_months",
    )
    .reset_index()
)


for gate_type in [
    "exploratory_magnitude",
    "exploratory_directional",
    "confirmatory_magnitude",
    "confirmatory_directional",
]:
    if gate_type not in persistence_detected.columns:
        persistence_detected[
            gate_type
        ] = False

    if gate_type not in persistence_longest.columns:
        persistence_longest[
            gate_type
        ] = 0


persistence_detected = persistence_detected.rename(
    columns={
        gate_type: (
            f"{gate_type}_detected"
        )
        for gate_type in [
            "exploratory_magnitude",
            "exploratory_directional",
            "confirmatory_magnitude",
            "confirmatory_directional",
        ]
    }
)

persistence_longest = persistence_longest.rename(
    columns={
        gate_type: (
            f"{gate_type}_longest"
        )
        for gate_type in [
            "exploratory_magnitude",
            "exploratory_directional",
            "confirmatory_magnitude",
            "confirmatory_directional",
        ]
    }
)


paper_table_1_internal = (
    base_grid.merge(
        ae2_summary[
            [
                "input_kind",
                "scenario",
                "Rk_months",
                "n_control_points",
                "mean_delta_rank_score_pp",
                "n_joint_simultaneous_significant_months",
                "pct_direction_consistent_months",
            ]
        ],
        on=[
            "input_kind",
            "scenario",
        ],
        how="left",
        validate="one_to_one",
    )
    .merge(
        ae3_authoritative_summary,
        on=[
            "input_kind",
            "scenario",
        ],
        how="left",
        validate="one_to_one",
    )
    .merge(
        persistence_detected,
        on=[
            "input_kind",
            "scenario",
        ],
        how="left",
        validate="one_to_one",
    )
    .merge(
        persistence_longest,
        on=[
            "input_kind",
            "scenario",
        ],
        how="left",
        validate="one_to_one",
    )
)


detection_columns = [
    "exploratory_magnitude_detected",
    "exploratory_directional_detected",
    "confirmatory_magnitude_detected",
    "confirmatory_directional_detected",
]

for column in detection_columns:
    paper_table_1_internal[
        column
    ] = (
        paper_table_1_internal[
            column
        ]
        .fillna(False)
        .astype(bool)
    )


longest_columns = [
    "exploratory_magnitude_longest",
    "exploratory_directional_longest",
    "confirmatory_magnitude_longest",
    "confirmatory_directional_longest",
]

for column in longest_columns:
    paper_table_1_internal[
        column
    ] = (
        paper_table_1_internal[
            column
        ]
        .fillna(0)
        .astype(int)
    )


paper_table_1_internal[
    "longest_exploratory_run"
] = (
    paper_table_1_internal[
        [
            "exploratory_magnitude_longest",
            "exploratory_directional_longest",
        ]
    ]
    .max(
        axis=1
    )
)

paper_table_1_internal[
    "longest_confirmatory_run"
] = (
    paper_table_1_internal[
        [
            "confirmatory_magnitude_longest",
            "confirmatory_directional_longest",
        ]
    ]
    .max(
        axis=1
    )
)

paper_table_1_internal[
    "evidence_class"
] = paper_table_1_internal.apply(
    evidence_class,
    axis=1,
)


PAPER_TABLE_1 = pd.DataFrame(
    {
        "Component": (
            paper_table_1_internal[
                "input_kind"
            ]
        ),
        "Scenario": (
            paper_table_1_internal[
                "scenario"
            ]
        ),
        "Control points": (
            paper_table_1_internal[
                "n_control_points"
            ].astype(int)
        ),
        "AE1 horizon (months)": (
            paper_table_1_internal[
                "Rk_months"
            ].astype(int)
        ),
        "Mean AE2 delta drought-rank (pp)": (
            paper_table_1_internal[
                "mean_delta_rank_score_pp"
            ]
        ),
        "AE2 joint-significant months": (
            paper_table_1_internal[
                "n_joint_simultaneous_significant_months"
            ].astype(int)
        ),
        "AE2 direction-consistent months (%)": (
            paper_table_1_internal[
                "pct_direction_consistent_months"
            ]
        ),
        "AE3 pointwise-positive months": (
            paper_table_1_internal[
                "n_AE3_pointwise_positive_months"
            ].astype(int)
        ),
        "AE3 joint-positive months": (
            paper_table_1_internal[
                "n_AE3_joint_positive_months"
            ].astype(int)
        ),
        "Persistent exploratory magnitude (r=3)": yes_no(
            paper_table_1_internal[
                "exploratory_magnitude_detected"
            ]
        ),
        "Persistent exploratory directional (r=3)": yes_no(
            paper_table_1_internal[
                "exploratory_directional_detected"
            ]
        ),
        "Persistent confirmatory magnitude (r=3)": yes_no(
            paper_table_1_internal[
                "confirmatory_magnitude_detected"
            ]
        ),
        "Persistent confirmatory directional (r=3)": yes_no(
            paper_table_1_internal[
                "confirmatory_directional_detected"
            ]
        ),
        "Longest exploratory run (months)": (
            paper_table_1_internal[
                "longest_exploratory_run"
            ]
        ),
        "Longest confirmatory run (months)": (
            paper_table_1_internal[
                "longest_confirmatory_run"
            ]
        ),
        "Final evidence class": (
            paper_table_1_internal[
                "evidence_class"
            ]
        ),
    }
)


# ============================================================
# 11. MAIN TABLE 2 — DECISION VALUE AND POLICY STABILITY
# ============================================================

agreement_small = (
    cross_scenario_agreement[
        [
            "input_kind",
            "mean_observed_action_agreement_fraction",
            "mean_bootstrap_action_agreement",
        ]
    ]
    .drop_duplicates(
        subset=[
            "input_kind",
        ]
    )
)


paper_table_2_internal = (
    base_grid.merge(
        pooled_ruv[
            [
                "input_kind",
                "scenario",
                "mean_scenario_conditioning_value_per_point_month",
                "pooled_ruv_scenario_conditioning",
                "pooled_ruv_policy_vs_no_action",
                "n_months_positive_mean_scenario_value",
                "n_months_negative_mean_scenario_value",
            ]
        ],
        on=[
            "input_kind",
            "scenario",
        ],
        how="left",
        validate="one_to_one",
    )
    .merge(
        reselection_stability[
            [
                "input_kind",
                "scenario",
                "mean_scenario_policy_reselection_fraction",
                "mean_bootstrap_action_changed_fraction",
            ]
        ],
        on=[
            "input_kind",
            "scenario",
        ],
        how="left",
        validate="one_to_one",
    )
    .merge(
        fixed_vs_reselection[
            [
                "input_kind",
                "scenario",
                "n_fixed_confirmatory_months",
                "n_reselection_confirmatory_months",
                "mean_fixed_joint_width",
                "mean_reselection_joint_width",
                "maximum_absolute_reselection_bootstrap_bias",
            ]
        ],
        on=[
            "input_kind",
            "scenario",
        ],
        how="left",
        validate="one_to_one",
    )
    .merge(
        agreement_small,
        on="input_kind",
        how="left",
        validate="many_to_one",
    )
)


paper_table_2_internal[
    "joint_width_inflation_factor"
] = [
    safe_ratio(
        numerator=reselection_width,
        denominator=fixed_width,
    )
    for (
        reselection_width,
        fixed_width,
    ) in zip(
        paper_table_2_internal[
            "mean_reselection_joint_width"
        ],
        paper_table_2_internal[
            "mean_fixed_joint_width"
        ],
    )
]


PAPER_TABLE_2 = pd.DataFrame(
    {
        "Component": (
            paper_table_2_internal[
                "input_kind"
            ]
        ),
        "Scenario": (
            paper_table_2_internal[
                "scenario"
            ]
        ),
        "Mean SCV per point-month": (
            paper_table_2_internal[
                "mean_scenario_conditioning_value_per_point_month"
            ]
        ),
        "Pooled RUV: scenario vs Base": (
            paper_table_2_internal[
                "pooled_ruv_scenario_conditioning"
            ]
        ),
        "Pooled RUV: policy vs no action": (
            paper_table_2_internal[
                "pooled_ruv_policy_vs_no_action"
            ]
        ),
        "Months with positive mean SCV": (
            paper_table_2_internal[
                "n_months_positive_mean_scenario_value"
            ].astype(int)
        ),
        "Months with negative mean SCV": (
            paper_table_2_internal[
                "n_months_negative_mean_scenario_value"
            ].astype(int)
        ),
        "Bootstrap action-change fraction (%)": (
            100.0
            * paper_table_2_internal[
                "mean_bootstrap_action_changed_fraction"
            ]
        ),
        "Scenario-policy reselection fraction (%)": (
            100.0
            * paper_table_2_internal[
                "mean_scenario_policy_reselection_fraction"
            ]
        ),
        "Observed Favorable-Unfavorable action agreement (%)": (
            100.0
            * paper_table_2_internal[
                "mean_observed_action_agreement_fraction"
            ]
        ),
        "Bootstrap Favorable-Unfavorable action agreement (%)": (
            100.0
            * paper_table_2_internal[
                "mean_bootstrap_action_agreement"
            ]
        ),
        "Fixed-bootstrap confirmatory months": (
            paper_table_2_internal[
                "n_fixed_confirmatory_months"
            ].astype(int)
        ),
        "Reselection-bootstrap confirmatory months": (
            paper_table_2_internal[
                "n_reselection_confirmatory_months"
            ].astype(int)
        ),
        "Mean fixed joint-band width": (
            paper_table_2_internal[
                "mean_fixed_joint_width"
            ]
        ),
        "Mean reselection joint-band width": (
            paper_table_2_internal[
                "mean_reselection_joint_width"
            ]
        ),
        "Joint-band width inflation factor": (
            paper_table_2_internal[
                "joint_width_inflation_factor"
            ]
        ),
        "Maximum absolute reselection bias": (
            paper_table_2_internal[
                "maximum_absolute_reselection_bootstrap_bias"
            ]
        ),
    }
)


# ============================================================
# 12. MAIN TABLE 3 — PERSISTENT FULL-AE WINDOWS
# ============================================================

persistent_runs = (
    authoritative_runs.loc[
        authoritative_runs[
            "length_months"
        ]
        >= DEFAULT_PERSISTENCE_MONTHS
    ]
    .copy()
)

if persistent_runs.empty:
    PAPER_TABLE_3 = pd.DataFrame(
        columns=[
            "Component",
            "Scenario",
            "Window",
            "Start lead",
            "End lead",
            "Start date",
            "End date",
            "Duration (months)",
            "Magnitude evidence",
            "Directional evidence",
            "Mean AE2 delta drought-rank (pp)",
            "Mean AE3 SCV",
            "Minimum AE3 pointwise lower bound",
            "Minimum AE3 joint lower bound",
        ]
    )

else:
    persistent_window_flags = (
        persistent_runs.assign(
            flag=True
        )
        .pivot_table(
            index=[
                "input_kind",
                "scenario",
                "start_lead",
                "end_lead",
                "start_date",
                "end_date",
                "length_months",
            ],
            columns="gate_type",
            values="flag",
            aggfunc="max",
            fill_value=False,
        )
        .reset_index()
    )

    for gate_type in [
        "exploratory_magnitude",
        "exploratory_directional",
        "confirmatory_magnitude",
        "confirmatory_directional",
    ]:
        if gate_type not in persistent_window_flags.columns:
            persistent_window_flags[
                gate_type
            ] = False

    persistent_window_flags = (
        persistent_window_flags.sort_values(
            [
                "input_kind",
                "scenario",
                "start_lead",
            ]
        )
        .reset_index(
            drop=True
        )
    )

    persistent_window_flags[
        "window_number"
    ] = (
        persistent_window_flags.groupby(
            [
                "input_kind",
                "scenario",
            ]
        )
        .cumcount()
        + 1
    )

    window_metric_records: list[
        dict[str, Any]
    ] = []

    for row in persistent_window_flags.itertuples(
        index=False
    ):
        ae2_window = ae2_monthly.loc[
            ae2_monthly[
                "input_kind"
            ].eq(
                row.input_kind
            )
            &
            ae2_monthly[
                "scenario"
            ].eq(
                row.scenario
            )
            &
            ae2_monthly[
                "lead_months"
            ].between(
                int(
                    row.start_lead
                ),
                int(
                    row.end_lead
                ),
                inclusive="both",
            )
        ]

        ae3_window = (
            ae3_authoritative_monthly.loc[
                ae3_authoritative_monthly[
                    "input_kind"
                ].eq(
                    row.input_kind
                )
                &
                ae3_authoritative_monthly[
                    "scenario"
                ].eq(
                    row.scenario
                )
                &
                ae3_authoritative_monthly[
                    "lead_months"
                ].between(
                    int(
                        row.start_lead
                    ),
                    int(
                        row.end_lead
                    ),
                    inclusive="both",
                )
            ]
        )

        magnitude_evidence = (
            "Confirmatory"
            if bool(
                row.confirmatory_magnitude
            )
            else (
                "Exploratory"
                if bool(
                    row.exploratory_magnitude
                )
                else "No"
            )
        )

        directional_evidence = (
            "Confirmatory"
            if bool(
                row.confirmatory_directional
            )
            else (
                "Exploratory"
                if bool(
                    row.exploratory_directional
                )
                else "No"
            )
        )

        window_metric_records.append(
            {
                "Component": (
                    row.input_kind
                ),
                "Scenario": (
                    row.scenario
                ),
                "Window": (
                    f"W{int(row.window_number)}"
                ),
                "Start lead": int(
                    row.start_lead
                ),
                "End lead": int(
                    row.end_lead
                ),
                "Start date": pd.Timestamp(
                    row.start_date
                ),
                "End date": pd.Timestamp(
                    row.end_date
                ),
                "Duration (months)": int(
                    row.length_months
                ),
                "Magnitude evidence": (
                    magnitude_evidence
                ),
                "Directional evidence": (
                    directional_evidence
                ),
                "Mean AE2 delta drought-rank (pp)": float(
                    ae2_window[
                        "delta_rank_score_pp"
                    ].mean()
                ),
                "Mean AE3 SCV": float(
                    ae3_window[
                        "scenario_conditioning_value"
                    ].mean()
                ),
                "Minimum AE3 pointwise lower bound": float(
                    ae3_window[
                        "reselection_pointwise_lower"
                    ].min()
                ),
                "Minimum AE3 joint lower bound": float(
                    ae3_window[
                        "reselection_joint_band_lower"
                    ].min()
                ),
            }
        )

    PAPER_TABLE_3 = pd.DataFrame(
        window_metric_records
    )


# ============================================================
# 13. PAPER TABLE DEFINITIONS
# ============================================================

