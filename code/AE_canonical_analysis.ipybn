# ============================================================
# 21. NORMALIZE AE2 SENSITIVITY FOR FIGURE 7
# ============================================================

def first_existing_column(
    frame: pd.DataFrame,
    candidates: list[str],
) -> str | None:
    """Return the first matching normalized column."""
    normalized_lookup = {
        normalize_name(
            column
        ): column
        for column in frame.columns
    }

    for candidate in candidates:
        normalized_candidate = normalize_name(
            candidate
        )

        if normalized_candidate in normalized_lookup:
            return normalized_lookup[
                normalized_candidate
            ]

    return None


def normalize_ae2_sensitivity(
    frame: pd.DataFrame,
) -> tuple[
    pd.DataFrame,
    str,
]:
    """
    Normalize the Cell 03 sensitivity table to:
        component, scenario, criterion,
        effect_threshold_pp, persistence_months,
        longest_run_months, emergence_detected.
    """
    data = frame.copy()

    component_column = first_existing_column(
        data,
        [
            "input_kind",
            "component",
        ],
    )

    scenario_column = first_existing_column(
        data,
        [
            "scenario",
        ],
    )

    threshold_column = first_existing_column(
        data,
        [
            "effect_threshold_pp",
            "practical_effect_threshold_pp",
            "delta_threshold_pp",
            "minimum_effect_pp",
            "delta_pp",
            "effect_size_threshold_pp",
        ],
    )

    if threshold_column is None:
        threshold_column = resolve_column(
            data,
            required_tokens=[
                "threshold",
                "pp",
            ],
            excluded_tokens=[
                "probability",
            ],
            required=False,
        )

    persistence_column = first_existing_column(
        data,
        [
            "persistence_months",
            "required_persistence_months",
            "persistence_requirement_months",
            "run_length_months",
        ],
    )

    if persistence_column is None:
        persistence_column = resolve_column(
            data,
            required_tokens=[
                "persistence",
            ],
            required=False,
        )

    if component_column is None:
        raise KeyError(
            "Could not resolve the sensitivity component column."
        )

    if scenario_column is None:
        raise KeyError(
            "Could not resolve the sensitivity scenario column."
        )

    if threshold_column is None:
        raise KeyError(
            "Could not resolve the AE2 effect-threshold column.\n"
            f"Available columns: {list(data.columns)}"
        )

    if persistence_column is None:
        raise KeyError(
            "Could not resolve the AE2 persistence column.\n"
            f"Available columns: {list(data.columns)}"
        )

    scope_column = first_existing_column(
        data,
        [
            "inference_scope",
            "scope",
            "band_scope",
            "inference_level",
        ],
    )

    criterion_column = first_existing_column(
        data,
        [
            "gate_type",
            "criterion",
            "emergence_type",
            "direction_mode",
            "effect_type",
        ],
    )

    if scope_column is not None:
        scope_values = (
            data[
                scope_column
            ]
            .astype(str)
            .str.lower()
        )

        joint_mask = scope_values.str.contains(
            "joint",
            na=False,
        )

        if joint_mask.any():
            data = data.loc[
                joint_mask
            ].copy()

            scope_label = (
                "Joint simultaneous AE2 inference"
            )

        else:
            pointwise_mask = scope_values.str.contains(
                "pointwise",
                na=False,
            )

            if pointwise_mask.any():
                data = data.loc[
                    pointwise_mask
                ].copy()

                scope_label = (
                    "Pointwise AE2 inference"
                )

            else:
                scope_label = (
                    "AE2 sensitivity inference"
                )

    else:
        if criterion_column is not None:
            criterion_values = (
                data[
                    criterion_column
                ]
                .astype(str)
                .str.lower()
            )

            joint_mask = criterion_values.str.contains(
                "joint",
                na=False,
            )

            if joint_mask.any():
                data = data.loc[
                    joint_mask
                ].copy()

                scope_label = (
                    "Joint simultaneous AE2 inference"
                )

            else:
                scope_label = (
                    "AE2 sensitivity inference"
                )

        else:
            scope_label = (
                "AE2 sensitivity inference"
            )

    longest_run_column = first_existing_column(
        data,
        [
            "longest_run_months",
            "maximum_run_months",
            "max_run_months",
            "longest_qualifying_run_months",
        ],
    )

    detected_column = first_existing_column(
        data,
        [
            "emergence_detected",
            "detected",
            "qualifying_run_detected",
        ],
    )

    if (
        criterion_column is not None
        and criterion_column
        in data.columns
    ):
        criterion_text = (
            data[
                criterion_column
            ]
            .astype(str)
            .str.lower()
        )

        data[
            "_criterion"
        ] = np.where(
            criterion_text.str.contains(
                "direction",
                na=False,
            ),
            "directional",
            "magnitude",
        )

        if longest_run_column is None:
            longest_run_column = resolve_column(
                data,
                required_tokens=[
                    "longest",
                    "run",
                ],
                required=False,
            )

        if longest_run_column is None:
            count_column = first_existing_column(
                data,
                [
                    "n_months_in_qualifying_runs",
                    "n_candidate_months",
                    "n_qualifying_months",
                ],
            )

            if count_column is not None:
                longest_run_column = count_column

        if longest_run_column is None:
            if detected_column is None:
                raise KeyError(
                    "Could not resolve a sensitivity result column.\n"
                    f"Available columns: {list(data.columns)}"
                )

            data[
                "_longest_run"
            ] = coerce_boolean(
                data[
                    detected_column
                ]
            ).astype(int)

            longest_run_column = (
                "_longest_run"
            )

        if detected_column is None:
            data[
                "_detected"
            ] = (
                pd.to_numeric(
                    data[
                        longest_run_column
                    ],
                    errors="raise",
                )
                > 0
            )

            detected_column = "_detected"

        output = pd.DataFrame(
            {
                "input_kind": (
                    data[
                        component_column
                    ]
                    .astype(str)
                    .str.strip()
                ),
                "scenario": (
                    data[
                        scenario_column
                    ]
                    .astype(str)
                    .str.strip()
                ),
                "criterion": (
                    data[
                        "_criterion"
                    ]
                ),
                "effect_threshold_pp": (
                    pd.to_numeric(
                        data[
                            threshold_column
                        ],
                        errors="raise",
                    )
                ),
                "persistence_months": (
                    pd.to_numeric(
                        data[
                            persistence_column
                        ],
                        errors="raise",
                    ).astype(int)
                ),
                "longest_run_months": (
                    pd.to_numeric(
                        data[
                            longest_run_column
                        ],
                        errors="raise",
                    )
                ),
                "emergence_detected": (
                    coerce_boolean(
                        data[
                            detected_column
                        ]
                    )
                ),
            }
        )

        return (
            output,
            scope_label,
        )

    # --------------------------------------------------------
    # Wide-format sensitivity table
    # --------------------------------------------------------

    magnitude_run_column = resolve_column(
        data,
        required_tokens=[
            "magnitude",
            "longest",
            "run",
        ],
        required=False,
    )

    directional_run_column = resolve_column(
        data,
        required_tokens=[
            "directional",
            "longest",
            "run",
        ],
        required=False,
    )

    if (
        magnitude_run_column is None
        or directional_run_column is None
    ):
        raise KeyError(
            "The AE2 sensitivity table could not be normalized.\n"
            "Expected either a criterion/gate column or separate "
            "magnitude/directional longest-run columns.\n"
            f"Available columns: {list(data.columns)}"
        )

    records = []

    for criterion_name, result_column in [
        (
            "magnitude",
            magnitude_run_column,
        ),
        (
            "directional",
            directional_run_column,
        ),
    ]:
        temporary = pd.DataFrame(
            {
                "input_kind": (
                    data[
                        component_column
                    ]
                    .astype(str)
                    .str.strip()
                ),
                "scenario": (
                    data[
                        scenario_column
                    ]
                    .astype(str)
                    .str.strip()
                ),
                "criterion": criterion_name,
                "effect_threshold_pp": (
                    pd.to_numeric(
                        data[
                            threshold_column
                        ],
                        errors="raise",
                    )
                ),
                "persistence_months": (
                    pd.to_numeric(
                        data[
                            persistence_column
                        ],
                        errors="raise",
                    ).astype(int)
                ),
                "longest_run_months": (
                    pd.to_numeric(
                        data[
                            result_column
                        ],
                        errors="raise",
                    )
                ),
            }
        )

        temporary[
            "emergence_detected"
        ] = (
            temporary[
                "longest_run_months"
            ]
            > 0
        )

        records.append(
            temporary
        )

    return (
        pd.concat(
            records,
            ignore_index=True,
        ),
        scope_label,
    )


(
    FIGURE_7_DATA,
    FIGURE_7_SCOPE_LABEL,
) = normalize_ae2_sensitivity(
    AE2_SENSITIVITY
)

FIGURE_7_DATA = FIGURE_7_DATA.loc[
    FIGURE_7_DATA[
        "input_kind"
    ].isin(
        COMPONENT_ORDER
    )
    &
    FIGURE_7_DATA[
        "scenario"
    ].isin(
        SCENARIO_ORDER
    )
    &
    FIGURE_7_DATA[
        "criterion"
    ].isin(
        [
            "magnitude",
            "directional",
        ]
    )
].copy()


# ============================================================
# 22. COMPLETE FIGURE 7 GRID
# ============================================================

effect_thresholds = sorted(
    FIGURE_7_DATA[
        "effect_threshold_pp"
    ].dropna().unique()
)

persistence_levels = sorted(
    FIGURE_7_DATA[
        "persistence_months"
    ].dropna().unique()
)

expected_thresholds = [
    0.5,
    1.0,
    1.5,
]

expected_persistence = [
    1,
    3,
    6,
]

if set(
    np.round(
        effect_thresholds,
        6,
    )
) != set(
    expected_thresholds
):
    print(
        "[NOTICE] Figure 7 uses the thresholds present in the "
        f"canonical sensitivity table: {effect_thresholds}"
    )

if set(
    persistence_levels
) != set(
    expected_persistence
):
    print(
        "[NOTICE] Figure 7 uses the persistence levels present in "
        f"the canonical sensitivity table: {persistence_levels}"
    )


row_keys = [
    (
        component,
        scenario,
    )
    for component in COMPONENT_ORDER
    for scenario in SCENARIO_ORDER
]

column_keys = [
    (
        float(
            threshold
        ),
        int(
            persistence
        ),
    )
    for threshold in effect_thresholds
    for persistence in persistence_levels
]


complete_records = []

for (
    component,
    scenario,
), (
    threshold,
    persistence,
), criterion in [
    (
        row_key,
        column_key,
        criterion_name,
    )
    for row_key in row_keys
    for column_key in column_keys
    for criterion_name in [
        "magnitude",
        "directional",
    ]
]:
    matches = FIGURE_7_DATA.loc[
        FIGURE_7_DATA[
            "input_kind"
        ].eq(component)
        &
        FIGURE_7_DATA[
            "scenario"
        ].eq(scenario)
        &
        np.isclose(
            FIGURE_7_DATA[
                "effect_threshold_pp"
            ],
            threshold,
            atol=NUMERICAL_ATOL,
            rtol=0.0,
        )
        &
        FIGURE_7_DATA[
            "persistence_months"
        ].eq(
            persistence
        )
        &
        FIGURE_7_DATA[
            "criterion"
        ].eq(
            criterion
        )
    ]

    if matches.empty:
        longest_run = 0.0
        emergence_detected = False

    else:
        longest_run = float(
            matches[
                "longest_run_months"
            ].max()
        )

        emergence_detected = bool(
            matches[
                "emergence_detected"
            ].any()
        )

    complete_records.append(
        {
            "input_kind": component,
            "scenario": scenario,
            "criterion": criterion,
            "effect_threshold_pp": threshold,
            "persistence_months": persistence,
            "longest_run_months": longest_run,
            "emergence_detected": (
                emergence_detected
            ),
            "inference_scope": (
                FIGURE_7_SCOPE_LABEL
            ),
        }
    )

FIGURE_7_DATA = pd.DataFrame(
    complete_records
)

FIGURE_7_DATA_PATH = (
    FIGURE_DATA_DIR
    / "Figure_7_AE2_sensitivity_data.csv"
)

FIGURE_7_DATA.to_csv(
    FIGURE_7_DATA_PATH,
    index=False,
)


# ============================================================
# 23. GENERATE FIGURE 7
# ============================================================

maximum_run = max(
    1.0,
    float(
        FIGURE_7_DATA[
            "longest_run_months"
        ].max()
    ),
)

sensitivity_cmap = LinearSegmentedColormap.from_list(
    "ae2_sensitivity",
    [
        "#F4F4F4",
        "#FDD49E",
        "#E69F00",
        "#8C510A",
    ],
)

figure_7, axes_7 = plt.subplots(
    nrows=1,
    ncols=2,
    figsize=FIGURE_SIZES[
        "Figure_7"
    ],
    sharey=True,
)

criterion_titles = {
    "magnitude": (
        "Magnitude-based AE2"
    ),
    "directional": (
        "Direction-consistent AE2"
    ),
}

row_labels_7 = [
    f"{component} — {scenario}"
    for component, scenario
    in row_keys
]

column_labels_7 = [
    (
        rf"$\delta={threshold:g}$ pp"
        "\n"
        rf"$r={persistence}$"
    )
    for threshold, persistence
    in column_keys
]

for axis_index, criterion in enumerate(
    [
        "magnitude",
        "directional",
    ]
):
    axis = axes_7[
        axis_index
    ]

    value_matrix = np.zeros(
        (
            len(
                row_keys
            ),
            len(
                column_keys
            ),
        ),
        dtype=float,
    )

    detected_matrix = np.zeros_like(
        value_matrix,
        dtype=bool,
    )

    for row_index, (
        component,
        scenario,
    ) in enumerate(
        row_keys
    ):
        for column_index, (
            threshold,
            persistence,
        ) in enumerate(
            column_keys
        ):
            match = FIGURE_7_DATA.loc[
                FIGURE_7_DATA[
                    "input_kind"
                ].eq(component)
                &
                FIGURE_7_DATA[
                    "scenario"
                ].eq(scenario)
                &
                FIGURE_7_DATA[
                    "criterion"
                ].eq(
                    criterion
                )
                &
                np.isclose(
                    FIGURE_7_DATA[
                        "effect_threshold_pp"
                    ],
                    threshold,
                    atol=NUMERICAL_ATOL,
                    rtol=0.0,
                )
                &
                FIGURE_7_DATA[
                    "persistence_months"
                ].eq(
                    persistence
                )
            ]

            if match.empty:
                continue

            value_matrix[
                row_index,
                column_index,
            ] = float(
                match[
                    "longest_run_months"
                ].iloc[
                    0
                ]
            )

            detected_matrix[
                row_index,
                column_index,
            ] = bool(
                match[
                    "emergence_detected"
                ].iloc[
                    0
                ]
            )

    image = axis.imshow(
        value_matrix,
        cmap=sensitivity_cmap,
        vmin=0,
        vmax=maximum_run,
        aspect="auto",
        interpolation="nearest",
    )

    axis.set_xticks(
        np.arange(
            len(
                column_keys
            )
        )
    )

    axis.set_xticklabels(
        column_labels_7,
        rotation=90,
        ha="center",
        va="top",
        fontsize=7,
    )

    axis.set_yticks(
        np.arange(
            len(
                row_keys
            )
        )
    )

    axis.set_yticklabels(
        row_labels_7,
        fontsize=7.7,
    )

    for row_index in range(
        value_matrix.shape[
            0
        ]
    ):
        for column_index in range(
            value_matrix.shape[
                1
            ]
        ):
            value = value_matrix[
                row_index,
                column_index,
            ]

            detected = detected_matrix[
                row_index,
                column_index,
            ]

            text = (
                f"{int(round(value))}"
                if detected
                else "0"
            )

            text_color = (
                "white"
                if value
                > 0.55
                * maximum_run
                else "black"
            )

            axis.text(
                column_index,
                row_index,
                text,
                ha="center",
                va="center",
                fontsize=7.3,
                color=text_color,
                fontweight=(
                    "bold"
                    if detected
                    else "normal"
                ),
            )

    axis.set_xticks(
        np.arange(
            -0.5,
            len(
                column_keys
            ),
            1,
        ),
        minor=True,
    )

    axis.set_yticks(
        np.arange(
            -0.5,
            len(
                row_keys
            ),
            1,
        ),
        minor=True,
    )

    axis.grid(
        which="minor",
        color="white",
        linestyle="-",
        linewidth=1.4,
    )

    axis.tick_params(
        which="minor",
        bottom=False,
        left=False,
    )

    axis.set_title(
        criterion_titles[
            criterion
        ],
        fontweight="bold",
    )

    axis.set_xlabel(
        "Effect threshold and persistence requirement"
    )

    add_panel_label(
        axis,
        (
            "a"
            if axis_index == 0
            else "b"
        ),
        x=-0.14,
        y=1.07,
    )

    for spine in axis.spines.values():
        spine.set_visible(
            False
        )


colorbar_axis = figure_7.add_axes(
    [
        0.92,
        0.23,
        0.018,
        0.53,
    ]
)

colorbar = figure_7.colorbar(
    image,
    cax=colorbar_axis,
)

colorbar.set_label(
    "Longest qualifying run (months)",
    fontsize=8,
)

figure_7.suptitle(
    (
        "AE2 emergence sensitivity to practical effect "
        "threshold and persistence"
    ),
    x=0.02,
    y=0.98,
    ha="left",
    fontweight="bold",
)

figure_7.text(
    0.02,
    0.03,
    (
        f"Inference source: {FIGURE_7_SCOPE_LABEL}. "
        "Cell values report the longest qualifying run; zero denotes "
        "no detected run under that configuration."
    ),
    ha="left",
    va="bottom",
    fontsize=7.3,
    color="#555555",
)

figure_7.subplots_adjust(
    left=0.23,
    right=0.89,
    top=0.88,
    bottom=0.25,
    wspace=0.12,
)

FIGURE_OUTPUT_RECORDS.extend(
    export_figure(
        figure=figure_7,
        figure_id="Figure 7",
        filename_stem=(
            "Figure_7_AE2_threshold_persistence_sensitivity"
        ),
    )
)

plt.close(
    figure_7
)


