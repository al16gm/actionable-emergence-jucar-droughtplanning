)


# ============================================================
# 15. GENERATE FIGURE 4
# ============================================================

ae2_y_limits = finite_axis_limits(
    arrays=[
        FIGURE_4_DATA[
            "pointwise_lower_pp"
        ].to_numpy(),
        FIGURE_4_DATA[
            "pointwise_upper_pp"
        ].to_numpy(),
        FIGURE_4_DATA[
            "joint_lower_pp"
        ].to_numpy(),
        FIGURE_4_DATA[
            "joint_upper_pp"
        ].to_numpy(),
    ],
    include_zero=True,
    padding_fraction=0.06,
)

figure_4, axes_4 = plt.subplots(
    nrows=2,
    ncols=3,
    figsize=FIGURE_SIZES[
        "Figure_4"
    ],
    sharex=True,
    sharey=True,
)

for row_index, scenario in enumerate(
    SCENARIO_ORDER
):
    for column_index, component in enumerate(
        COMPONENT_ORDER
    ):
        axis = axes_4[
            row_index,
            column_index,
        ]

        panel = (
            FIGURE_4_DATA.loc[
                FIGURE_4_DATA[
                    "input_kind"
                ].eq(component)
                &
                FIGURE_4_DATA[
                    "scenario"
                ].eq(scenario)
            ]
            .sort_values(
                "lead_months"
            )
            .reset_index(
                drop=True
            )
        )

        dates = pd.to_datetime(
            panel[
                "target_date"
            ]
        )

        component_color = COMPONENT_COLORS[
            component
        ]

        axis.fill_between(
            dates,
            panel[
                "pointwise_lower_pp"
            ],
            panel[
                "pointwise_upper_pp"
            ],
            color=component_color,
            alpha=0.18,
            linewidth=0,
            zorder=1,
        )

        axis.plot(
            dates,
            panel[
                "joint_lower_pp"
            ],
            color=JOINT_COLOR,
            linewidth=0.85,
            linestyle=(0, (3, 2)),
            alpha=0.95,
            zorder=2,
        )

        axis.plot(
            dates,
            panel[
                "joint_upper_pp"
            ],
            color=JOINT_COLOR,
            linewidth=0.85,
            linestyle=(0, (3, 2)),
            alpha=0.95,
            zorder=2,
        )

        axis.plot(
            dates,
            panel[
                "delta_drought_rank_pp"
            ],
            color=component_color,
            linewidth=1.5,
            zorder=4,
        )

        within_ae1 = panel[
            "within_AE1_horizon"
        ].to_numpy(
            dtype=bool
        )

        pointwise_mask = (
            panel[
                "pointwise_excludes_zero"
            ].to_numpy(
                dtype=bool
            )
            &
            within_ae1
        )

        joint_mask = (
            panel[
                "joint_excludes_zero"
            ].to_numpy(
                dtype=bool
            )
            &
            within_ae1
        )

        axis.scatter(
            dates.loc[
                pointwise_mask
            ],
            panel.loc[
                pointwise_mask,
                "delta_drought_rank_pp",
            ],
            s=13,
            facecolor="white",
            edgecolor=EXPLORATORY_COLOR,
            linewidth=0.8,
            zorder=6,
        )

        axis.scatter(
            dates.loc[
                joint_mask
            ],
            panel.loc[
                joint_mask,
                "delta_drought_rank_pp",
            ],
            s=18,
            marker="D",
            facecolor=CONFIRMATORY_COLOR,
            edgecolor="white",
            linewidth=0.4,
            zorder=7,
        )

        axis.axhline(
            0,
            color=ZERO_COLOR,
            linewidth=0.8,
            zorder=3,
        )

        axis.axhline(
            1.0,
            color="#999999",
            linewidth=0.6,
            linestyle=(0, (2, 2)),
            zorder=2,
        )

        axis.axhline(
            -1.0,
            color="#999999",
            linewidth=0.6,
            linestyle=(0, (2, 2)),
            zorder=2,
        )

        boundary_date = add_ae1_boundary(
            axis=axis,
            dates=dates,
            horizon=EXPECTED_HORIZONS[
                component
            ],
            shade_outside=True,
        )

        axis.set_ylim(
            ae2_y_limits
        )

        axis.grid(
            axis="y",
            color="#E1E1E1",
            linewidth=0.55,
            alpha=0.75,
        )

        if row_index == 0:
            axis.set_title(
                component,
                color=component_color,
                fontweight="bold",
            )

        if column_index == 0:
            axis.set_ylabel(
                (
                    f"{scenario}\n"
                    "Δ drought-rank (pp)"
                )
            )

        if row_index == 1:
            format_year_axis(
                axis
            )

            axis.set_xlabel(
                "Target month"
            )

        axis.text(
            0.02,
            0.96,
            (
                rf"$R_k={EXPECTED_HORIZONS[component]}$"
            ),
            transform=axis.transAxes,
            ha="left",
            va="top",
            fontsize=7.2,
            color="#444444",
        )


figure_4.suptitle(
    (
        "AE2 — Forecast-relative scenario separation "
        "within inherited reliability horizons"
    ),
    x=0.02,
    ha="left",
    fontweight="bold",
)

figure_4.legend(
    handles=[
        Line2D(
            [0],
            [0],
            color="#555555",
            linewidth=1.5,
            label="Monthly effect",
        ),
        Patch(
            facecolor="#888888",
            alpha=0.18,
            edgecolor="none",
            label="95% pointwise interval",
        ),
        Line2D(
            [0],
            [0],
            color=JOINT_COLOR,
            linestyle=(0, (3, 2)),
            linewidth=0.9,
            label="95% joint simultaneous band",
        ),
        Line2D(
            [0],
            [0],
            marker="o",
            markerfacecolor="white",
            markeredgecolor=EXPLORATORY_COLOR,
            linestyle="none",
            label="Pointwise interval excludes zero",
        ),
        Line2D(
            [0],
            [0],
            marker="D",
            markerfacecolor=CONFIRMATORY_COLOR,
            markeredgecolor="white",
            linestyle="none",
            label="Joint band excludes zero",
        ),
    ],
    loc="lower center",
    bbox_to_anchor=(
        0.5,
        -0.01,
    ),
    ncol=3,
    frameon=False,
)

figure_4.subplots_adjust(
    left=0.10,
    right=0.985,
    top=0.91,
    bottom=0.17,
    hspace=0.18,
    wspace=0.12,
)

FIGURE_OUTPUT_RECORDS.extend(
    export_figure(
        figure=figure_4,
        figure_id="Figure 4",
        filename_stem=(
            "Figure_4_AE2_scenario_separation"
        ),
    )
)

plt.close(
    figure_4
)


