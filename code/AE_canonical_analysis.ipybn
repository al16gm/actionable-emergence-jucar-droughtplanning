# ============================================================
# 6. HELPERS
# ============================================================

def utc_now_iso() -> str:
    """Return the current UTC timestamp."""
    return datetime.now(
        timezone.utc
    ).isoformat(timespec="seconds")


def display_frame(
    frame: pd.DataFrame,
    n: int = 50,
) -> None:
    """Display a DataFrame with a text fallback."""
    try:
        display(
            frame.head(n)
        )
    except NameError:
        print(
            frame.head(n).to_string(
                index=False
            )
        )


def sha256_json(
    payload: dict[str, Any],
) -> str:
    """Return a deterministic SHA-256 hash."""
    serialized = json.dumps(
        payload,
        ensure_ascii=False,
        sort_keys=True,
        separators=(",", ":"),
        default=str,
    ).encode("utf-8")

    return hashlib.sha256(
        serialized
    ).hexdigest()


def update_json_file(
    path: Path,
    updates: dict[str, Any],
) -> None:
    """Update a JSON file while preserving existing fields."""
    if path.exists():
        with path.open(
            "r",
            encoding="utf-8",
        ) as handle:
            payload = json.load(
                handle
            )
    else:
        payload = {}

    payload.update(
        updates
    )

    with path.open(
        "w",
        encoding="utf-8",
    ) as handle:
        json.dump(
            payload,
            handle,
            ensure_ascii=False,
            indent=2,
            sort_keys=True,
            default=str,
        )


def coerce_boolean(
    values: pd.Series,
) -> pd.Series:
    """Normalize Boolean-like values."""
    if pd.api.types.is_bool_dtype(
        values
    ):
        return values.astype(bool)

    mapping = {
        "true": True,
        "false": False,
        "1": True,
        "0": False,
    }

    normalized = (
        values.astype(str)
        .str.strip()
        .str.lower()
        .map(mapping)
    )

    if normalized.isna().any():
        raise ValueError(
            "Could not convert all values to Boolean."
        )

    return normalized.astype(bool)


def linear_quantile(
    values: np.ndarray,
    quantile: float,
    axis: int | None = None,
) -> np.ndarray | float:
    """Calculate reproducible linear quantiles."""
    try:
        return np.quantile(
            values,
            quantile,
            axis=axis,
            method="linear",
        )
    except TypeError:
        return np.quantile(
            values,
            quantile,
            axis=axis,
            interpolation="linear",
        )


def smallest_mode(
    values: pd.Series,
) -> float:
    """Return the smallest value among tied modes."""
    numeric = pd.to_numeric(
        values,
        errors="coerce",
    ).dropna()

    if numeric.empty:
        return np.nan

    counts = numeric.value_counts()
    maximum_count = counts.max()

    modes = counts[
        counts == maximum_count
    ].index.to_numpy(dtype=float)

    return float(
        np.min(
            modes
        )
    )


def safe_ratio(
    numerator: float,
    denominator: float,
) -> float:
    """Return an unbounded ratio for a positive denominator."""
    if (
        not np.isfinite(numerator)
        or not np.isfinite(denominator)
        or denominator <= NUMERICAL_ATOL
    ):
        return np.nan

    return float(
        numerator
        / denominator
    )


def decision_loss_matrix(
    drought_scores: np.ndarray,
    actions: np.ndarray,
    drought_score_threshold: float,
    action_effectiveness: float,
    action_cost_ratio: float,
) -> np.ndarray:
    """Calculate point-by-action decision losses."""
    scores = np.asarray(
        drought_scores,
        dtype=float,
    )

    actions = np.asarray(
        actions,
        dtype=float,
    )

    residual_pressure = np.maximum(
        0.0,
        scores[:, np.newaxis]
        - drought_score_threshold
        - action_effectiveness
        * actions[np.newaxis, :],
    )

    drought_loss = (
        residual_pressure**2
    )

    action_loss = (
        action_cost_ratio
        * actions[np.newaxis, :] ** 2
    )

    return (
        drought_loss
        + action_loss
    )


def leave_one_point_out_decision(
    base_scores: np.ndarray,
    scenario_scores: np.ndarray,
    actions: np.ndarray,
    drought_score_threshold: float,
    action_effectiveness: float,
    action_cost_ratio: float,
) -> dict[str, np.ndarray]:
    """
    Select actions on n-1 points and evaluate them on the held-out point.
    """
    base_scores = np.asarray(
        base_scores,
        dtype=float,
    )

    scenario_scores = np.asarray(
        scenario_scores,
        dtype=float,
    )

    if base_scores.shape != scenario_scores.shape:
        raise ValueError(
            "Base and scenario vectors have different shapes."
        )

    n_points = len(
        base_scores
    )

    if n_points < 3:
        raise ValueError(
            "At least three points are required."
        )

    base_losses = decision_loss_matrix(
        drought_scores=base_scores,
        actions=actions,
        drought_score_threshold=(
            drought_score_threshold
        ),
        action_effectiveness=(
            action_effectiveness
        ),
        action_cost_ratio=(
            action_cost_ratio
        ),
    )

    scenario_losses = decision_loss_matrix(
        drought_scores=scenario_scores,
        actions=actions,
        drought_score_threshold=(
            drought_score_threshold
        ),
        action_effectiveness=(
            action_effectiveness
        ),
        action_cost_ratio=(
            action_cost_ratio
        ),
    )

    base_training_mean_losses = (
        base_losses.sum(
            axis=0
        )[np.newaxis, :]
        - base_losses
    ) / (
        n_points - 1
    )

    scenario_training_mean_losses = (
        scenario_losses.sum(
            axis=0
        )[np.newaxis, :]
        - scenario_losses
    ) / (
        n_points - 1
    )

    # ACTION_LEVELS is ascending, so np.argmin implements
    # the predefined lowest-action tie-breaking rule.
    reference_action_indices = np.argmin(
        base_training_mean_losses,
        axis=1,
    )

    scenario_action_indices = np.argmin(
        scenario_training_mean_losses,
        axis=1,
    )

    perfect_action_indices = np.argmin(
        scenario_losses,
        axis=1,
    )

    row_indices = np.arange(
        n_points
    )

    reference_losses = scenario_losses[
        row_indices,
        reference_action_indices,
    ]

    scenario_policy_losses = scenario_losses[
        row_indices,
        scenario_action_indices,
    ]

    no_action_losses = scenario_losses[
        :,
        0,
    ]

    perfect_information_losses = scenario_losses[
        row_indices,
        perfect_action_indices,
    ]

    return {
        "reference_action": actions[
            reference_action_indices
        ],
        "scenario_action": actions[
            scenario_action_indices
        ],
        "perfect_action": actions[
            perfect_action_indices
        ],

        "reference_loss": reference_losses,
        "scenario_policy_loss": (
            scenario_policy_losses
        ),
        "no_action_loss": no_action_losses,
        "perfect_information_loss": (
            perfect_information_losses
        ),

        "scenario_conditioning_value": (
            reference_losses
            - scenario_policy_losses
        ),

        "policy_value_vs_no_action": (
            no_action_losses
            - scenario_policy_losses
        ),

        "reference_regret": (
            reference_losses
            - perfect_information_losses
        ),

        "scenario_policy_regret": (
            scenario_policy_losses
            - perfect_information_losses
        ),

        "no_action_regret": (
            no_action_losses
            - perfect_information_losses
        ),

        "action_changed": (
            reference_action_indices
            != scenario_action_indices
        ),
    }


def bootstrap_trajectory_means(
    matrix: np.ndarray,
    sampled_indices: np.ndarray,
    chunk_size: int,
) -> np.ndarray:
    """Bootstrap complete point trajectories in bounded-memory chunks."""
    matrix = np.asarray(
        matrix,
        dtype=float,
    )

    n_bootstrap = (
        sampled_indices.shape[0]
    )

    n_months = (
        matrix.shape[1]
    )

    output = np.empty(
        (
            n_bootstrap,
            n_months,
        ),
        dtype=float,
    )

    for start in range(
        0,
        n_bootstrap,
        chunk_size,
    ):
        stop = min(
            start + chunk_size,
            n_bootstrap,
        )

        sampled = matrix[
            sampled_indices[
                start:stop
            ],
            :,
        ]

        output[
            start:stop,
            :,
        ] = sampled.mean(
            axis=1
        )

    return output


def standardized_bootstrap_error(
    bootstrap_estimates: np.ndarray,
    observed_estimates: np.ndarray,
    standard_errors: np.ndarray,
) -> np.ndarray:
    """Calculate absolute standardized bootstrap deviations."""
    difference = np.abs(
        bootstrap_estimates
        - observed_estimates[
            np.newaxis,
            :,
        ]
    )

    output = np.zeros_like(
        difference,
        dtype=float,
    )

    positive_se = (
        standard_errors
        > NUMERICAL_ATOL
    )

    output[
        :,
        positive_se,
    ] = (
        difference[
            :,
            positive_se,
        ]
        / standard_errors[
            positive_se
        ]
    )

    zero_se = ~positive_se

    if zero_se.any():
        inconsistent = (
            difference[
                :,
                zero_se,
            ]
            > NUMERICAL_ATOL
        )

        if inconsistent.any():
            raise RuntimeError(
                "Non-zero deviations were found with a zero "
                "bootstrap standard error."
            )

    return output


# ============================================================
# 7. NORMALIZE INPUTS
# ============================================================

point_states["target_date"] = pd.to_datetime(
    point_states["target_date"],
    errors="raise",
)

point_states["lead_months"] = pd.to_numeric(
    point_states["lead_months"],
    errors="raise",
).astype(int)

point_states[
    "trustworthy_horizon_months"
] = pd.to_numeric(
    point_states[
        "trustworthy_horizon_months"
    ],
    errors="raise",
).astype(int)

point_states[
    "drought_rank_score"
] = pd.to_numeric(
    point_states[
        "drought_rank_score"
    ],
    errors="raise",
)

for identifier_column in [
    "input_kind",
    "scenario",
    "point_id",
    "series_id",
]:
    point_states[
        identifier_column
    ] = (
        point_states[
            identifier_column
        ]
        .astype(str)
        .str.strip()
    )

for boolean_column in [
    "AE1_gate_pass",
    "within_inherited_AE1_horizon",
]:
    if boolean_column in point_states.columns:
        point_states[
            boolean_column
        ] = coerce_boolean(
            point_states[
                boolean_column
            ]
        )

if not point_states[
    "drought_rank_score"
].between(
    0.0,
    1.0,
    inclusive="both",
).all():
    raise ValueError(
        "Drought-rank scores fall outside [0, 1]."
    )


ae2_default_gate[
    "target_date"
] = pd.to_datetime(
    ae2_default_gate[
        "target_date"
    ],
    errors="raise",
)

ae2_default_gate[
    "lead_months"
] = pd.to_numeric(
    ae2_default_gate[
        "lead_months"
    ],
    errors="raise",
).astype(int)

for identifier_column in [
    "input_kind",
    "scenario",
]:
    ae2_default_gate[
        identifier_column
    ] = (
        ae2_default_gate[
            identifier_column
        ]
        .astype(str)
        .str.strip()
    )

for boolean_column in [
    "joint_magnitude_qualifying_run_member",
    "joint_directional_qualifying_run_member",
    "pointwise_magnitude_qualifying_run_member",
    "pointwise_directional_qualifying_run_member",
]:
    if boolean_column in ae2_default_gate.columns:
        ae2_default_gate[
            boolean_column
        ] = coerce_boolean(
            ae2_default_gate[
                boolean_column
            ]
        )


required_state_columns = [
    "input_kind",
    "scenario",
    "point_id",
    "series_id",
    "target_date",
    "lead_months",
    "drought_rank_score",
    "trustworthy_horizon_months",
    "AE1_gate_pass",
]

missing_state_columns = [
    column
    for column in required_state_columns
    if column not in point_states.columns
]

if missing_state_columns:
    raise ValueError(
        "Point-state input is missing columns: "
        f"{missing_state_columns}"
    )

if point_states[
    required_state_columns
].isna().any().any():
    raise ValueError(
        "Point-state input contains missing required values."
    )


observed_components = sorted(
    point_states[
        "input_kind"
    ].unique()
)

observed_scenarios = sorted(
    point_states[
        "scenario"
    ].unique()
)

if observed_components != sorted(
    COMPONENT_ORDER
):
    raise ValueError(
        "Unexpected AE3 components.\n"
        f"Observed: {observed_components}"
    )

if observed_scenarios != sorted(
    SCENARIO_ORDER
):
    raise ValueError(
        "Unexpected AE3 scenarios.\n"
        f"Observed: {observed_scenarios}"
    )


# ============================================================
# 8. BUILD ALIGNED COMPONENT MATRICES
# ============================================================

component_data: dict[
    str,
    dict[str, Any],
] = {}

for component in COMPONENT_ORDER:
    component_frame = point_states[
        point_states[
            "input_kind"
        ].eq(component)
    ].copy()

    scenario_matrices: dict[
        str,
        np.ndarray,
    ] = {}

    scenario_indices: dict[
        str,
        pd.MultiIndex,
    ] = {}

    metadata_reference: pd.DataFrame | None = None

    for scenario in SCENARIO_ORDER:
        scenario_frame = component_frame[
            component_frame[
                "scenario"
            ].eq(scenario)
        ].copy()

        pivot = (
            scenario_frame.pivot(
                index=[
                    "point_id",
                    "series_id",
                ],
                columns="lead_months",
                values="drought_rank_score",
            )
            .reindex(
                columns=list(
                    range(1, 85)
                )
            )
            .sort_index()
        )

        if pivot.isna().any().any():
            raise RuntimeError(
                f"Incomplete AE3 matrix for "
                f"{component} / {scenario}."
            )

        scenario_indices[
            scenario
        ] = pivot.index

        scenario_matrices[
            scenario
        ] = pivot.to_numpy(
            dtype=float
        )

        scenario_metadata = (
            scenario_frame.groupby(
                "lead_months",
                dropna=False,
            )
            .agg(
                target_date=(
                    "target_date",
                    "first",
                ),
                trustworthy_horizon_months=(
                    "trustworthy_horizon_months",
                    "first",
                ),
                AE1_gate_pass=(
                    "AE1_gate_pass",
                    "first",
                ),
            )
            .reindex(
                range(1, 85)
            )
            .reset_index()
        )

        scenario_metadata[
            "target_date"
        ] = pd.to_datetime(
            scenario_metadata[
                "target_date"
            ]
        )

        scenario_metadata[
            "trustworthy_horizon_months"
        ] = pd.to_numeric(
            scenario_metadata[
                "trustworthy_horizon_months"
            ],
            errors="raise",
        ).astype(int)

        if metadata_reference is None:
            metadata_reference = (
                scenario_metadata
            )

        else:
            if not (
                metadata_reference[
                    "target_date"
                ].to_numpy()
                ==
                scenario_metadata[
                    "target_date"
                ].to_numpy()
            ).all():
                raise RuntimeError(
                    f"Target-date metadata differ for {component}."
                )

    reference_index = scenario_indices[
        "Base"
    ]

    for scenario in SCENARIO_ORDER:
        if not scenario_indices[
            scenario
        ].equals(
            reference_index
        ):
            raise RuntimeError(
                f"Point ordering differs across scenarios "
                f"for {component}."
            )

    assert metadata_reference is not None

    expected_horizon = int(
        EXPECTED_HORIZONS[
            component
        ]
    )

    observed_horizon = int(
        metadata_reference[
            "trustworthy_horizon_months"
        ].iloc[0]
    )

    if observed_horizon != expected_horizon:
        raise RuntimeError(
            f"Unexpected AE1 horizon for {component}. "
            f"Expected {expected_horizon}; "
            f"observed {observed_horizon}."
        )

    component_data[
        component
    ] = {
        "point_index": reference_index,
        "scores": scenario_matrices,
        "metadata": metadata_reference,
        "horizon": expected_horizon,
        "n_points": int(
            len(
                reference_index
            )
        ),
    }


# ============================================================
# 9. LEAVE-ONE-POINT-OUT DECISION EXPERIMENT
# ============================================================

point_contribution_records: list[
    dict[str, Any]
] = []

for component in COMPONENT_ORDER:
    data = component_data[
        component
    ]

    point_index = data[
        "point_index"
    ]

    base_matrix = data[
        "scores"
    ][
        "Base"
    ]

    metadata = data[
        "metadata"
    ]

    horizon = int(
        data[
            "horizon"
        ]
    )

    for scenario in SCENARIO_ORDER:
        scenario_matrix = data[
            "scores"
        ][
            scenario
        ]

        for month_index in range(84):
            lead = month_index + 1

            result = leave_one_point_out_decision(
                base_scores=(
                    base_matrix[
                        :,
                        month_index,
                    ]
                ),
                scenario_scores=(
                    scenario_matrix[
                        :,
                        month_index,
                    ]
                ),
                actions=ACTION_LEVELS,
                drought_score_threshold=(
                    DEFAULT_DROUGHT_SCORE_THRESHOLD
                ),
                action_effectiveness=(
                    DEFAULT_ACTION_EFFECTIVENESS
                ),
                action_cost_ratio=(
                    DEFAULT_ACTION_COST_RATIO
                ),
            )

            target_date = pd.Timestamp(
                metadata.loc[
                    month_index,
                    "target_date",
                ]
            )

            for point_position, (
                point_id,
                series_id,
            ) in enumerate(
                point_index
            ):
                point_contribution_records.append(
                    {
                        "input_kind": component,
                        "scenario": scenario,

                        "point_id": str(
                            point_id
                        ),
                        "series_id": str(
                            series_id
                        ),

                        "lead_months": int(
                            lead
                        ),
                        "target_date": target_date,

                        "trustworthy_horizon_months": (
                            horizon
                        ),
                        "within_AE1_horizon": bool(
                            lead <= horizon
                        ),

                        "drought_score_threshold": (
                            DEFAULT_DROUGHT_SCORE_THRESHOLD
                        ),
                        "action_effectiveness": (
                            DEFAULT_ACTION_EFFECTIVENESS
                        ),
                        "action_cost_ratio": (
                            DEFAULT_ACTION_COST_RATIO
                        ),

                        "base_drought_rank_score": float(
                            base_matrix[
                                point_position,
                                month_index,
                            ]
                        ),

                        "scenario_drought_rank_score": float(
                            scenario_matrix[
                                point_position,
                                month_index,
                            ]
                        ),

                        "reference_action": float(
                            result[
                                "reference_action"
                            ][
                                point_position
                            ]
                        ),

                        "scenario_action": float(
                            result[
                                "scenario_action"
                            ][
                                point_position
                            ]
                        ),

                        "perfect_action": float(
                            result[
                                "perfect_action"
                            ][
                                point_position
                            ]
                        ),

                        "action_changed": bool(
                            result[
                                "action_changed"
                            ][
                                point_position
                            ]
                        ),

                        "reference_loss": float(
                            result[
                                "reference_loss"
                            ][
                                point_position
                            ]
                        ),

                        "scenario_policy_loss": float(
                            result[
                                "scenario_policy_loss"
                            ][
                                point_position
                            ]
                        ),

                        "no_action_loss": float(
                            result[
                                "no_action_loss"
                            ][
                                point_position
                            ]
                        ),

                        "perfect_information_loss": float(
                            result[
                                "perfect_information_loss"
                            ][
                                point_position
                            ]
                        ),

                        "scenario_conditioning_value": float(
                            result[
                                "scenario_conditioning_value"
                            ][
                                point_position
                            ]
                        ),

                        "policy_value_vs_no_action": float(
                            result[
                                "policy_value_vs_no_action"
                            ][
                                point_position
                            ]
                        ),

                        "reference_regret": float(
                            result[
                                "reference_regret"
                            ][
                                point_position
                            ]
                        ),

                        "scenario_policy_regret": float(
                            result[
                                "scenario_policy_regret"
                            ][
                                point_position
                            ]
                        ),

                        "no_action_regret": float(
                            result[
                                "no_action_regret"
                            ][
                                point_position
                            ]
                        ),
                    }
                )

AE3_POINT_CONTRIBUTIONS = pd.DataFrame(
    point_contribution_records
)

required_contribution_columns = [
    "reference_loss",
    "scenario_policy_loss",
    "no_action_loss",
    "perfect_information_loss",
    "scenario_conditioning_value",
    "policy_value_vs_no_action",
]

if AE3_POINT_CONTRIBUTIONS[
    required_contribution_columns
].isna().any().any():
    raise RuntimeError(
        "Missing AE3 decision-value contributions were generated."
    )


expected_point_contribution_rows = (
    sum(
        component_data[
            component
        ][
            "n_points"
        ]
        for component in COMPONENT_ORDER
    )
    * 84
    * len(
        SCENARIO_ORDER
    )
)

if (
    len(
        AE3_POINT_CONTRIBUTIONS
    )
    != expected_point_contribution_rows
):
    raise RuntimeError(
        "Unexpected AE3 point-contribution row count.\n"
        f"Expected: {expected_point_contribution_rows:,}\n"
        f"Observed: {len(AE3_POINT_CONTRIBUTIONS):,}"
    )


# ============================================================
# 10. MONTHLY CENTRAL DECISION VALUES
# ============================================================

AE3_MONTHLY_DEFAULT = (
    AE3_POINT_CONTRIBUTIONS.groupby(
        [
            "input_kind",
            "scenario",
            "lead_months",
            "target_date",
            "trustworthy_horizon_months",
            "within_AE1_horizon",
            "drought_score_threshold",
            "action_effectiveness",
            "action_cost_ratio",
        ],
        dropna=False,
    )
    .agg(
        n_control_points=(
            "point_id",
            "nunique",
        ),

        mean_reference_action=(
            "reference_action",
            "mean",
        ),

        modal_reference_action=(
            "reference_action",
            smallest_mode,
        ),

        mean_scenario_action=(
            "scenario_action",
            "mean",
        ),

        modal_scenario_action=(
            "scenario_action",
            smallest_mode,
        ),

        mean_perfect_action=(
            "perfect_action",
            "mean",
        ),

        action_disagreement_fraction=(
            "action_changed",
            "mean",
        ),

        mean_reference_loss=(
            "reference_loss",
            "mean",
        ),

        mean_scenario_policy_loss=(
            "scenario_policy_loss",
            "mean",
        ),

        mean_no_action_loss=(
            "no_action_loss",
            "mean",
        ),

        mean_perfect_information_loss=(
            "perfect_information_loss",
            "mean",
        ),

        scenario_conditioning_value=(
            "scenario_conditioning_value",
            "mean",
        ),

        median_scenario_conditioning_value=(
            "scenario_conditioning_value",
            "median",
        ),

        policy_value_vs_no_action=(
            "policy_value_vs_no_action",
            "mean",
        ),

        mean_reference_regret=(
            "reference_regret",
            "mean",
        ),

        mean_scenario_policy_regret=(
            "scenario_policy_regret",
            "mean",
        ),

        mean_no_action_regret=(
            "no_action_regret",
            "mean",
        ),

        fraction_points_positive_scenario_value=(
            "scenario_conditioning_value",
            lambda values: float(
                np.mean(
                    values > 0
                )
            ),
        ),

        fraction_points_negative_scenario_value=(
            "scenario_conditioning_value",
            lambda values: float(
                np.mean(
                    values < 0
                )
            ),
        ),

        fraction_points_positive_policy_value=(
            "policy_value_vs_no_action",
            lambda values: float(
                np.mean(
                    values > 0
                )
            ),
        ),
    )
    .reset_index()
)

AE3_MONTHLY_DEFAULT[
    "ruv_scenario_conditioning_raw"
] = [
    safe_ratio(
        numerator=value,
        denominator=regret,
    )
    for value, regret in zip(
        AE3_MONTHLY_DEFAULT[
            "scenario_conditioning_value"
        ],
        AE3_MONTHLY_DEFAULT[
            "mean_reference_regret"
        ],
    )
]

AE3_MONTHLY_DEFAULT[
    "ruv_policy_vs_no_action_raw"
] = [
    safe_ratio(
        numerator=value,
        denominator=regret,
    )
    for value, regret in zip(
        AE3_MONTHLY_DEFAULT[
            "policy_value_vs_no_action"
        ],
        AE3_MONTHLY_DEFAULT[
            "mean_no_action_regret"
        ],
    )
]

AE3_MONTHLY_DEFAULT[
    "scenario_value_positive"
] = (
    AE3_MONTHLY_DEFAULT[
        "scenario_conditioning_value"
    ]
    > 0
)

AE3_MONTHLY_DEFAULT[
    "policy_value_positive"
] = (
    AE3_MONTHLY_DEFAULT[
        "policy_value_vs_no_action"
    ]
    > 0
)


expected_monthly_default_rows = (
    len(
        COMPONENT_ORDER
    )
    * len(
        SCENARIO_ORDER
    )
    * 84
)

if (
    len(
        AE3_MONTHLY_DEFAULT
    )
    != expected_monthly_default_rows
):
    raise RuntimeError(
        "Unexpected AE3 monthly central row count.\n"
        f"Expected: {expected_monthly_default_rows}\n"
        f"Observed: {len(AE3_MONTHLY_DEFAULT)}"
    )


# ============================================================
# 11. BOOTSTRAP CROSS-VALIDATED CONTRIBUTIONS
# ============================================================

bootstrap_records: list[
    dict[str, Any]
] = []

critical_value_records: list[
    dict[str, Any]
] = []

component_seed_map = {
    component: int(
        BOOTSTRAP_SEED
        + 100_003
        * component_index
    )
    for component_index, component
    in enumerate(
        COMPONENT_ORDER
    )
}

for component in COMPONENT_ORDER:
    component_contributions = (
        AE3_POINT_CONTRIBUTIONS[
            AE3_POINT_CONTRIBUTIONS[
                "input_kind"
            ].eq(component)
        ]
        .copy()
    )

    point_index = component_data[
        component
    ][
        "point_index"
    ]

    n_points = int(
        len(
            point_index
        )
    )

    horizon = int(
        component_data[
            component
        ][
            "horizon"
        ]
    )

    metadata = component_data[
        component
    ][
        "metadata"
    ]

    rng = np.random.default_rng(
        component_seed_map[
            component
        ]
    )

    sampled_indices = rng.integers(
        low=0,
        high=n_points,
        size=(
            BOOTSTRAP_REPLICATES,
            n_points,
        ),
        endpoint=False,
    )

    component_records: list[
        dict[str, Any]
    ] = []

    scenario_standardized_errors: dict[
        str,
        np.ndarray,
    ] = {}

    scenario_observed_values: dict[
        str,
        np.ndarray,
    ] = {}

    scenario_standard_errors: dict[
        str,
        np.ndarray,
    ] = {}

    for scenario in NON_BASE_SCENARIOS:
        scenario_frame = component_contributions[
            component_contributions[
                "scenario"
            ].eq(scenario)
        ].copy()

        scenario_value_pivot = (
            scenario_frame.pivot(
                index=[
                    "point_id",
                    "series_id",
                ],
                columns="lead_months",
                values=(
                    "scenario_conditioning_value"
                ),
            )
            .reindex(
                index=point_index,
                columns=list(
                    range(1, 85)
                ),
            )
        )

        policy_value_pivot = (
            scenario_frame.pivot(
                index=[
                    "point_id",
                    "series_id",
                ],
                columns="lead_months",
                values=(
                    "policy_value_vs_no_action"
                ),
            )
            .reindex(
                index=point_index,
                columns=list(
                    range(1, 85)
                ),
            )
        )

        if (
            scenario_value_pivot.isna().any().any()
            or policy_value_pivot.isna().any().any()
        ):
            raise RuntimeError(
                f"Incomplete AE3 bootstrap matrices for "
                f"{component} / {scenario}."
            )

        scenario_value_matrix = (
            scenario_value_pivot.to_numpy(
                dtype=float
            )
        )

        policy_value_matrix = (
            policy_value_pivot.to_numpy(
                dtype=float
            )
        )

        observed_scenario_value = (
            scenario_value_matrix.mean(
                axis=0
            )
        )

        observed_policy_value = (
            policy_value_matrix.mean(
                axis=0
            )
        )

        scenario_value_bootstrap = (
            bootstrap_trajectory_means(
                matrix=scenario_value_matrix,
                sampled_indices=(
                    sampled_indices
                ),
                chunk_size=(
                    BOOTSTRAP_CHUNK_SIZE
                ),
            )
        )

        policy_value_bootstrap = (
            bootstrap_trajectory_means(
                matrix=policy_value_matrix,
                sampled_indices=(
                    sampled_indices
                ),
                chunk_size=(
                    BOOTSTRAP_CHUNK_SIZE
                ),
            )
        )

        scenario_value_se = (
            scenario_value_bootstrap.std(
                axis=0,
                ddof=1,
            )
        )

        policy_value_se = (
            policy_value_bootstrap.std(
                axis=0,
                ddof=1,
            )
        )

        scenario_value_lower = linear_quantile(
            scenario_value_bootstrap,
            LOWER_QUANTILE,
            axis=0,
        )

        scenario_value_upper = linear_quantile(
            scenario_value_bootstrap,
            UPPER_QUANTILE,
            axis=0,
        )

        policy_value_lower = linear_quantile(
            policy_value_bootstrap,
            LOWER_QUANTILE,
            axis=0,
        )

        policy_value_upper = linear_quantile(
            policy_value_bootstrap,
            UPPER_QUANTILE,
            axis=0,
        )

        standardized_errors = (
            standardized_bootstrap_error(
                bootstrap_estimates=(
                    scenario_value_bootstrap
                ),
                observed_estimates=(
                    observed_scenario_value
                ),
                standard_errors=(
                    scenario_value_se
                ),
            )
        )

        scenario_standardized_errors[
            scenario
        ] = standardized_errors

        scenario_observed_values[
            scenario
        ] = observed_scenario_value

        scenario_standard_errors[
            scenario
        ] = scenario_value_se

        scenario_max_statistics = (
            standardized_errors[
                :,
                :horizon,
            ].max(
                axis=1
            )
        )

        scenario_critical_value = float(
            linear_quantile(
                scenario_max_statistics,
                CONFIDENCE_LEVEL,
            )
        )

        critical_value_records.append(
            {
                "input_kind": component,
                "scope": (
                    "scenario_within_component"
                ),
                "scenario": scenario,
                "Rk_months": horizon,
                "critical_value": (
                    scenario_critical_value
                ),
                "confidence_level": (
                    CONFIDENCE_LEVEL
                ),
                "n_bootstrap": (
                    BOOTSTRAP_REPLICATES
                ),
                "n_months_in_family": horizon,
                "n_scenarios_in_family": 1,
            }
        )

        for month_index in range(84):
            lead = month_index + 1

            component_records.append(
                {
                    "input_kind": component,
                    "scenario": scenario,
                    "lead_months": int(
                        lead
                    ),
                    "target_date": pd.Timestamp(
                        metadata.loc[
                            month_index,
                            "target_date",
                        ]
                    ),

                    "trustworthy_horizon_months": (
                        horizon
                    ),
                    "within_AE1_horizon": bool(
                        lead <= horizon
                    ),

                    "n_control_points": (
                        n_points
                    ),
                    "n_bootstrap": (
                        BOOTSTRAP_REPLICATES
                    ),
                    "component_bootstrap_seed": (
                        component_seed_map[
                            component
                        ]
                    ),

                    "scenario_conditioning_value": float(
                        observed_scenario_value[
                            month_index
                        ]
                    ),

                    "scenario_value_bootstrap_mean": float(
                        scenario_value_bootstrap[
                            :,
                            month_index,
                        ].mean()
                    ),

                    "scenario_value_bootstrap_bias": float(
                        scenario_value_bootstrap[
                            :,
                            month_index,
                        ].mean()
                        - observed_scenario_value[
                            month_index
                        ]
                    ),

                    "scenario_value_bootstrap_se": float(
                        scenario_value_se[
                            month_index
                        ]
                    ),

                    "scenario_value_pointwise_lower": float(
                        scenario_value_lower[
                            month_index
                        ]
                    ),

                    "scenario_value_pointwise_upper": float(
                        scenario_value_upper[
                            month_index
                        ]
                    ),

                    "scenario_value_scenario_band_lower": float(
                        observed_scenario_value[
                            month_index
                        ]
                        - scenario_critical_value
                        * scenario_value_se[
                            month_index
                        ]
                    ),

                    "scenario_value_scenario_band_upper": float(
                        observed_scenario_value[
                            month_index
                        ]
                        + scenario_critical_value
                        * scenario_value_se[
                            month_index
                        ]
                    ),

                    "policy_value_vs_no_action": float(
                        observed_policy_value[
                            month_index
                        ]
                    ),

                    "policy_value_bootstrap_mean": float(
                        policy_value_bootstrap[
                            :,
                            month_index,
                        ].mean()
                    ),

                    "policy_value_bootstrap_bias": float(
                        policy_value_bootstrap[
                            :,
                            month_index,
                        ].mean()
                        - observed_policy_value[
                            month_index
                        ]
                    ),

                    "policy_value_bootstrap_se": float(
                        policy_value_se[
                            month_index
                        ]
                    ),

                    "policy_value_pointwise_lower": float(
                        policy_value_lower[
                            month_index
                        ]
                    ),

                    "policy_value_pointwise_upper": float(
                        policy_value_upper[
                            month_index
                        ]
                    ),

                    "bootstrap_fraction_scenario_value_positive": float(
                        np.mean(
                            scenario_value_bootstrap[
                                :,
                                month_index,
                            ]
                            > 0
                        )
                    ),

                    "bootstrap_fraction_policy_value_positive": float(
                        np.mean(
                            policy_value_bootstrap[
                                :,
                                month_index,
                            ]
                            > 0
                        )
                    ),

                    "inference_scope": (
                        AE3_INFERENCE_SCOPE
                    ),
                }
            )

    joint_max_statistics = np.maximum(
        scenario_standardized_errors[
            "Favorable"
        ][
            :,
            :horizon,
        ].max(
            axis=1
        ),
        scenario_standardized_errors[
            "Unfavorable"
        ][
            :,
            :horizon,
        ].max(
            axis=1
        ),
    )

    joint_critical_value = float(
        linear_quantile(
            joint_max_statistics,
            CONFIDENCE_LEVEL,
        )
    )

    critical_value_records.append(
        {
            "input_kind": component,
            "scope": (
                "joint_scenarios_within_component"
            ),
            "scenario": (
                "Favorable_and_Unfavorable"
            ),
            "Rk_months": horizon,
            "critical_value": (
                joint_critical_value
            ),
            "confidence_level": (
                CONFIDENCE_LEVEL
            ),
            "n_bootstrap": (
                BOOTSTRAP_REPLICATES
            ),
            "n_months_in_family": horizon,
            "n_scenarios_in_family": 2,
        }
    )

    for record in component_records:
        scenario = str(
            record[
                "scenario"
            ]
        )

        month_index = (
            int(
                record[
                    "lead_months"
                ]
            )
            - 1
        )

        observed_value = (
            scenario_observed_values[
                scenario
            ][
                month_index
            ]
        )

        standard_error = (
            scenario_standard_errors[
                scenario
            ][
                month_index
            ]
        )

        record[
            "scenario_value_joint_band_lower"
        ] = float(
            observed_value
            - joint_critical_value
            * standard_error
        )

        record[
            "scenario_value_joint_band_upper"
        ] = float(
            observed_value
            + joint_critical_value
            * standard_error
        )

    bootstrap_records.extend(
        component_records
    )

AE3_BOOTSTRAP_INFERENCE = pd.DataFrame(
    bootstrap_records
)

AE3_BOOTSTRAP_CRITICAL_VALUES = pd.DataFrame(
    critical_value_records
)


expected_bootstrap_rows = (
    len(
        COMPONENT_ORDER
    )
    * len(
        NON_BASE_SCENARIOS
    )
    * 84
)

if (
    len(
        AE3_BOOTSTRAP_INFERENCE
    )
    != expected_bootstrap_rows
):
    raise RuntimeError(
        "Unexpected AE3 bootstrap row count.\n"
        f"Expected: {expected_bootstrap_rows}\n"
        f"Observed: {len(AE3_BOOTSTRAP_INFERENCE)}"
    )


# ============================================================
# 12. ROBUST STRUCTURAL-KEY MERGE
#
# Floating-point estimates are deliberately excluded from
# the merge keys.
# ============================================================

AE3_MONTHLY_CENTRAL_NON_BASE = (
    AE3_MONTHLY_DEFAULT.loc[
        AE3_MONTHLY_DEFAULT[
            "scenario"
        ].isin(
            NON_BASE_SCENARIOS
        )
    ]
    .copy()
)

AE3_MERGE_KEYS = [
    "input_kind",
    "scenario",
    "lead_months",
    "target_date",
    "trustworthy_horizon_months",
    "within_AE1_horizon",
    "n_control_points",
]

for frame_name, frame in {
    "central": AE3_MONTHLY_CENTRAL_NON_BASE,
    "bootstrap": AE3_BOOTSTRAP_INFERENCE,
}.items():
    frame["target_date"] = pd.to_datetime(
        frame["target_date"],
        errors="raise",
    )

    frame["lead_months"] = pd.to_numeric(
        frame["lead_months"],
        errors="raise",
    ).astype(int)

    frame[
        "trustworthy_horizon_months"
    ] = pd.to_numeric(
        frame[
            "trustworthy_horizon_months"
        ],
        errors="raise",
    ).astype(int)

    frame[
        "n_control_points"
    ] = pd.to_numeric(
        frame[
            "n_control_points"
        ],
        errors="raise",
    ).astype(int)

    frame[
        "within_AE1_horizon"
    ] = coerce_boolean(
        frame[
            "within_AE1_horizon"
        ]
    )

    if frame.duplicated(
        AE3_MERGE_KEYS
    ).any():
        duplicate_rows = (
            frame.loc[
                frame.duplicated(
                    AE3_MERGE_KEYS,
                    keep=False,
                ),
                AE3_MERGE_KEYS,
            ]
            .sort_values(
                AE3_MERGE_KEYS
            )
        )

        raise RuntimeError(
            f"The {frame_name} AE3 table is not unique by "
            "structural keys.\n"
            f"{duplicate_rows.head(20).to_string(index=False)}"
        )


AE3_MONTHLY_INFERENCE = (
    AE3_MONTHLY_CENTRAL_NON_BASE.merge(
        AE3_BOOTSTRAP_INFERENCE,
        on=AE3_MERGE_KEYS,
        how="inner",
        validate="one_to_one",
        suffixes=(
            "_central",
            "_bootstrap",
        ),
    )
)

expected_inference_rows = (
    len(
        COMPONENT_ORDER
    )
    * len(
        NON_BASE_SCENARIOS
    )
    * 84
)

if (
    len(
        AE3_MONTHLY_INFERENCE
    )
    != expected_inference_rows
):
    central_keys = (
        AE3_MONTHLY_CENTRAL_NON_BASE[
            AE3_MERGE_KEYS
        ]
        .drop_duplicates()
    )

    bootstrap_keys = (
        AE3_BOOTSTRAP_INFERENCE[
            AE3_MERGE_KEYS
        ]
        .drop_duplicates()
    )

    missing_from_bootstrap = (
        central_keys.merge(
            bootstrap_keys,
            on=AE3_MERGE_KEYS,
            how="left",
            indicator=True,
        )
        .loc[
            lambda frame: frame[
                "_merge"
            ].eq(
                "left_only"
            ),
            AE3_MERGE_KEYS,
        ]
    )

    missing_from_central = (
        bootstrap_keys.merge(
            central_keys,
            on=AE3_MERGE_KEYS,
            how="left",
            indicator=True,
        )
        .loc[
            lambda frame: frame[
                "_merge"
            ].eq(
                "left_only"
            ),
            AE3_MERGE_KEYS,
        ]
    )

    raise RuntimeError(
        "Unexpected number of AE3 monthly inference rows after "
        "structural-key merge.\n"
        f"Expected: {expected_inference_rows}\n"
        f"Observed: {len(AE3_MONTHLY_INFERENCE)}\n"
        f"Missing from bootstrap: {len(missing_from_bootstrap)}\n"
        f"Missing from central: {len(missing_from_central)}"
    )


# Validate, but do not merge on, floating-point values.
scenario_value_difference = (
    AE3_MONTHLY_INFERENCE[
        "scenario_conditioning_value_central"
    ]
    - AE3_MONTHLY_INFERENCE[
        "scenario_conditioning_value_bootstrap"
    ]
)

policy_value_difference = (
    AE3_MONTHLY_INFERENCE[
        "policy_value_vs_no_action_central"
    ]
    - AE3_MONTHLY_INFERENCE[
        "policy_value_vs_no_action_bootstrap"
    ]
)

maximum_scenario_value_reconstruction_difference = float(
    scenario_value_difference.abs().max()
)

maximum_policy_value_reconstruction_difference = float(
    policy_value_difference.abs().max()
)

if not np.allclose(
    AE3_MONTHLY_INFERENCE[
        "scenario_conditioning_value_central"
    ],
    AE3_MONTHLY_INFERENCE[
        "scenario_conditioning_value_bootstrap"
    ],
    atol=NUMERICAL_ATOL,
    rtol=NUMERICAL_RTOL,
    equal_nan=True,
):
    raise RuntimeError(
        "Central and bootstrap scenario-conditioning values "
        "differ beyond numerical tolerance.\n"
        "Maximum absolute difference: "
        f"{maximum_scenario_value_reconstruction_difference:.3e}"
    )

if not np.allclose(
    AE3_MONTHLY_INFERENCE[
        "policy_value_vs_no_action_central"
    ],
    AE3_MONTHLY_INFERENCE[
        "policy_value_vs_no_action_bootstrap"
    ],
    atol=NUMERICAL_ATOL,
    rtol=NUMERICAL_RTOL,
    equal_nan=True,
):
    raise RuntimeError(
        "Central and bootstrap policy values differ beyond "
        "numerical tolerance.\n"
        "Maximum absolute difference: "
        f"{maximum_policy_value_reconstruction_difference:.3e}"
    )


# The central groupby estimates are retained as authoritative.
AE3_MONTHLY_INFERENCE[
    "scenario_conditioning_value"
] = (
    AE3_MONTHLY_INFERENCE[
        "scenario_conditioning_value_central"
    ]
)

AE3_MONTHLY_INFERENCE[
    "policy_value_vs_no_action"
] = (
    AE3_MONTHLY_INFERENCE[
        "policy_value_vs_no_action_central"
    ]
)

AE3_MONTHLY_INFERENCE = (
    AE3_MONTHLY_INFERENCE.drop(
        columns=[
            "scenario_conditioning_value_central",
            "scenario_conditioning_value_bootstrap",
            "policy_value_vs_no_action_central",
            "policy_value_vs_no_action_bootstrap",
        ]
    )
    .sort_values(
        [
            "input_kind",
            "scenario",
            "lead_months",
        ]
    )
    .reset_index(
        drop=True
    )
)


# ============================================================
# 13. AE3 EVIDENCE FLAGS
# ============================================================

AE3_MONTHLY_INFERENCE[
    "scenario_value_pointwise_positive"
] = (
    AE3_MONTHLY_INFERENCE[
        "scenario_value_pointwise_lower"
    ]
    > 0
)

AE3_MONTHLY_INFERENCE[
    "scenario_value_scenario_band_positive"
] = (
    AE3_MONTHLY_INFERENCE[
        "scenario_value_scenario_band_lower"
    ]
    > 0
)

AE3_MONTHLY_INFERENCE[
    "scenario_value_joint_band_positive"
] = (
    AE3_MONTHLY_INFERENCE[
        "scenario_value_joint_band_lower"
    ]
    > 0
)

AE3_MONTHLY_INFERENCE[
    "policy_value_pointwise_positive"
] = (
    AE3_MONTHLY_INFERENCE[
        "policy_value_pointwise_lower"
    ]
    > 0
)

AE3_MONTHLY_INFERENCE[
    "AE3_exploratory_gate"
] = (
    AE3_MONTHLY_INFERENCE[
        "scenario_value_pointwise_positive"
    ]
)

AE3_MONTHLY_INFERENCE[
    "AE3_confirmatory_gate"
] = (
    AE3_MONTHLY_INFERENCE[
        "scenario_value_joint_band_positive"
    ]
)


# ============================================================
# 14. DEFAULT AE3 SUMMARY WITHIN AE1
# ============================================================

default_within_ae1 = (
    AE3_MONTHLY_INFERENCE[
        AE3_MONTHLY_INFERENCE[
            "within_AE1_horizon"
        ]
    ]
    .copy()
)

AE3_DEFAULT_SUMMARY = (
    default_within_ae1.groupby(
        [
            "input_kind",
            "scenario",
        ],
        dropna=False,
    )
    .agg(
        Rk_months=(
            "trustworthy_horizon_months",
            "first",
        ),

        n_months=(
            "lead_months",
            "size",
        ),

        n_control_points=(
            "n_control_points",
            "first",
        ),

        mean_scenario_conditioning_value=(
            "scenario_conditioning_value",
            "mean",
        ),

        median_scenario_conditioning_value=(
            "scenario_conditioning_value",
            "median",
        ),

        minimum_scenario_conditioning_value=(
            "scenario_conditioning_value",
            "min",
        ),

        maximum_scenario_conditioning_value=(
            "scenario_conditioning_value",
            "max",
        ),

        mean_policy_value_vs_no_action=(
            "policy_value_vs_no_action",
            "mean",
        ),

        minimum_policy_value_vs_no_action=(
            "policy_value_vs_no_action",
            "min",
        ),

        maximum_policy_value_vs_no_action=(
            "policy_value_vs_no_action",
            "max",
        ),

        mean_ruv_scenario_conditioning_raw=(
            "ruv_scenario_conditioning_raw",
            "mean",
        ),

        median_ruv_scenario_conditioning_raw=(
            "ruv_scenario_conditioning_raw",
            "median",
        ),

        mean_ruv_policy_vs_no_action_raw=(
            "ruv_policy_vs_no_action_raw",
            "mean",
        ),

        mean_action_disagreement_fraction=(
            "action_disagreement_fraction",
            "mean",
        ),

        n_months_action_differs=(
            "action_disagreement_fraction",
            lambda values: int(
                np.sum(
                    values > 0
                )
            ),
        ),

        n_months_scenario_value_positive=(
            "scenario_value_positive",
            "sum",
        ),

        n_months_policy_value_positive=(
            "policy_value_positive",
            "sum",
        ),

        n_pointwise_AE3_months=(
            "scenario_value_pointwise_positive",
            "sum",
        ),

        n_scenario_band_AE3_months=(
            "scenario_value_scenario_band_positive",
            "sum",
        ),

        n_joint_AE3_months=(
            "scenario_value_joint_band_positive",
            "sum",
        ),

        pct_pointwise_AE3_months=(
            "scenario_value_pointwise_positive",
            lambda values: float(
                100.0
                * values.mean()
            ),
        ),

        pct_joint_AE3_months=(
            "scenario_value_joint_band_positive",
            lambda values: float(
                100.0
                * values.mean()
            ),
        ),

        n_policy_value_pointwise_positive_months=(
            "policy_value_pointwise_positive",
            "sum",
        ),
    )
    .reset_index()
)


# ============================================================
# 15. PARAMETER SENSITIVITY
# ============================================================

sensitivity_monthly_records: list[
    dict[str, Any]
] = []

for drought_threshold in (
    DROUGHT_SCORE_THRESHOLD_GRID
):
    for action_cost_ratio in (
        ACTION_COST_RATIO_GRID
    ):
        for component in COMPONENT_ORDER:
            data = component_data[
                component
            ]

            point_index = data[
                "point_index"
            ]

            base_matrix = data[
                "scores"
            ][
                "Base"
            ]

            metadata = data[
                "metadata"
            ]

            horizon = int(
                data[
                    "horizon"
                ]
            )

            for scenario in NON_BASE_SCENARIOS:
                scenario_matrix = data[
                    "scores"
                ][
                    scenario
                ]

                for month_index in range(84):
                    result = leave_one_point_out_decision(
                        base_scores=(
                            base_matrix[
                                :,
                                month_index,
                            ]
                        ),
                        scenario_scores=(
                            scenario_matrix[
                                :,
                                month_index,
                            ]
                        ),
                        actions=ACTION_LEVELS,
                        drought_score_threshold=(
                            drought_threshold
                        ),
                        action_effectiveness=(
                            DEFAULT_ACTION_EFFECTIVENESS
                        ),
                        action_cost_ratio=(
                            action_cost_ratio
                        ),
                    )

                    mean_scenario_value = float(
                        np.mean(
                            result[
                                "scenario_conditioning_value"
                            ]
                        )
                    )

                    mean_policy_value = float(
                        np.mean(
                            result[
                                "policy_value_vs_no_action"
                            ]
                        )
                    )

                    mean_reference_regret = float(
                        np.mean(
                            result[
                                "reference_regret"
                            ]
                        )
                    )

                    mean_no_action_regret = float(
                        np.mean(
                            result[
                                "no_action_regret"
                            ]
                        )
                    )

                    sensitivity_monthly_records.append(
                        {
                            "input_kind": component,
                            "scenario": scenario,

                            "lead_months": int(
                                month_index + 1
                            ),

                            "target_date": pd.Timestamp(
                                metadata.loc[
                                    month_index,
                                    "target_date",
                                ]
                            ),

                            "trustworthy_horizon_months": (
                                horizon
                            ),

                            "within_AE1_horizon": bool(
                                month_index
                                < horizon
                            ),

                            "n_control_points": int(
                                len(
                                    point_index
                                )
                            ),

                            "drought_score_threshold": float(
                                drought_threshold
                            ),

                            "action_effectiveness": (
                                DEFAULT_ACTION_EFFECTIVENESS
                            ),

                            "action_cost_ratio": float(
                                action_cost_ratio
                            ),

                            "scenario_conditioning_value": (
                                mean_scenario_value
                            ),

                            "policy_value_vs_no_action": (
                                mean_policy_value
                            ),

                            "ruv_scenario_conditioning_raw": (
                                safe_ratio(
                                    mean_scenario_value,
                                    mean_reference_regret,
                                )
                            ),

                            "ruv_policy_vs_no_action_raw": (
                                safe_ratio(
                                    mean_policy_value,
                                    mean_no_action_regret,
                                )
                            ),

                            "mean_reference_action": float(
                                np.mean(
                                    result[
                                        "reference_action"
                                    ]
                                )
                            ),

                            "mean_scenario_action": float(
                                np.mean(
                                    result[
                                        "scenario_action"
                                    ]
                                )
                            ),

                            "action_disagreement_fraction": float(
                                np.mean(
                                    result[
                                        "action_changed"
                                    ]
                                )
                            ),

                            "scenario_value_positive": bool(
                                mean_scenario_value
                                > 0
                            ),

                            "policy_value_positive": bool(
                                mean_policy_value
                                > 0
                            ),
                        }
                    )

AE3_SENSITIVITY_MONTHLY = pd.DataFrame(
    sensitivity_monthly_records
)

expected_sensitivity_rows = (
    len(
        DROUGHT_SCORE_THRESHOLD_GRID
    )
    * len(
        ACTION_COST_RATIO_GRID
    )
    * len(
        COMPONENT_ORDER
    )
    * len(
        NON_BASE_SCENARIOS
    )
    * 84
)

if (
    len(
        AE3_SENSITIVITY_MONTHLY
    )
    != expected_sensitivity_rows
):
    raise RuntimeError(
        "Unexpected AE3 sensitivity row count.\n"
        f"Expected: {expected_sensitivity_rows}\n"
        f"Observed: {len(AE3_SENSITIVITY_MONTHLY)}"
    )


AE3_SENSITIVITY_SUMMARY = (
    AE3_SENSITIVITY_MONTHLY[
        AE3_SENSITIVITY_MONTHLY[
            "within_AE1_horizon"
        ]
    ]
    .groupby(
        [
            "drought_score_threshold",
            "action_cost_ratio",
            "input_kind",
            "scenario",
        ],
        dropna=False,
    )
    .agg(
        Rk_months=(
            "trustworthy_horizon_months",
            "first",
        ),

        n_months=(
            "lead_months",
            "size",
        ),

        n_control_points=(
            "n_control_points",
            "first",
        ),

        mean_scenario_conditioning_value=(
            "scenario_conditioning_value",
            "mean",
        ),

        median_scenario_conditioning_value=(
            "scenario_conditioning_value",
            "median",
        ),

        minimum_scenario_conditioning_value=(
            "scenario_conditioning_value",
            "min",
        ),

        maximum_scenario_conditioning_value=(
            "scenario_conditioning_value",
            "max",
        ),

        mean_policy_value_vs_no_action=(
            "policy_value_vs_no_action",
            "mean",
        ),

        mean_ruv_scenario_conditioning_raw=(
            "ruv_scenario_conditioning_raw",
            "mean",
        ),

        mean_ruv_policy_vs_no_action_raw=(
            "ruv_policy_vs_no_action_raw",
            "mean",
        ),

        mean_action_disagreement_fraction=(
            "action_disagreement_fraction",
            "mean",
        ),

        pct_months_scenario_value_positive=(
            "scenario_value_positive",
            lambda values: float(
                100.0
                * values.mean()
            ),
        ),

        pct_months_policy_value_positive=(
            "policy_value_positive",
            lambda values: float(
                100.0
                * values.mean()
            ),
        ),
    )
    .reset_index()
)


# ============================================================
# 16. DEFAULT AE1–AE2–AE3 INTERSECTION
# ============================================================

ae2_gate_for_synthesis = (
    ae2_default_gate[
        ae2_default_gate[
            "scenario"
        ].isin(
            NON_BASE_SCENARIOS
        )
    ][
        [
            "input_kind",
            "scenario",
            "lead_months",
            "target_date",
            "joint_magnitude_qualifying_run_member",
            "joint_directional_qualifying_run_member",
            "pointwise_magnitude_qualifying_run_member",
            "pointwise_directional_qualifying_run_member",
        ]
    ]
    .copy()
)

AE_FULL_SYNTHESIS_DEFAULT = (
    AE3_MONTHLY_INFERENCE.merge(
        ae2_gate_for_synthesis,
        on=[
            "input_kind",
            "scenario",
            "lead_months",
            "target_date",
        ],
        how="inner",
        validate="one_to_one",
    )
)

expected_synthesis_rows = (
    len(
        NON_BASE_SCENARIOS
    )
    * sum(
        EXPECTED_HORIZONS.values()
    )
)

if (
    len(
        AE_FULL_SYNTHESIS_DEFAULT
    )
    != expected_synthesis_rows
):
    raise RuntimeError(
        "Unexpected AE1–AE2–AE3 synthesis row count.\n"
        f"Expected: {expected_synthesis_rows}\n"
        f"Observed: {len(AE_FULL_SYNTHESIS_DEFAULT)}"
    )


AE_FULL_SYNTHESIS_DEFAULT[
    "full_AE_exploratory_magnitude"
] = (
    AE_FULL_SYNTHESIS_DEFAULT[
        "pointwise_magnitude_qualifying_run_member"
    ]
    & AE_FULL_SYNTHESIS_DEFAULT[
        "AE3_exploratory_gate"
    ]
)

AE_FULL_SYNTHESIS_DEFAULT[
    "full_AE_exploratory_directional"
] = (
    AE_FULL_SYNTHESIS_DEFAULT[
        "pointwise_directional_qualifying_run_member"
    ]
    & AE_FULL_SYNTHESIS_DEFAULT[
        "AE3_exploratory_gate"
    ]
)

AE_FULL_SYNTHESIS_DEFAULT[
    "full_AE_confirmatory_magnitude"
] = (
    AE_FULL_SYNTHESIS_DEFAULT[
        "joint_magnitude_qualifying_run_member"
    ]
    & AE_FULL_SYNTHESIS_DEFAULT[
        "AE3_confirmatory_gate"
    ]
)

AE_FULL_SYNTHESIS_DEFAULT[
    "full_AE_confirmatory_directional"
] = (
    AE_FULL_SYNTHESIS_DEFAULT[
        "joint_directional_qualifying_run_member"
    ]
    & AE_FULL_SYNTHESIS_DEFAULT[
        "AE3_confirmatory_gate"
    ]
)


full_ae_summary_records: list[
    dict[str, Any]
] = []

for (
    component,
    scenario,
), group in AE_FULL_SYNTHESIS_DEFAULT.groupby(
    [
        "input_kind",
        "scenario",
    ],
    dropna=False,
):
    group = group.sort_values(
        "lead_months"
    )

    record: dict[str, Any] = {
        "input_kind": component,
        "scenario": scenario,

        "Rk_months": int(
            group[
                "trustworthy_horizon_months"
            ].iloc[0]
        ),

        "n_control_points": int(
            group[
                "n_control_points"
            ].iloc[0]
        ),

        "n_months_within_AE1": int(
            len(group)
        ),

        "n_AE3_pointwise_positive_months": int(
            group[
                "AE3_exploratory_gate"
            ].sum()
        ),

        "n_AE3_joint_positive_months": int(
            group[
                "AE3_confirmatory_gate"
            ].sum()
        ),
    }

    for column in [
        "full_AE_exploratory_magnitude",
        "full_AE_exploratory_directional",
        "full_AE_confirmatory_magnitude",
        "full_AE_confirmatory_directional",
    ]:
        mask = group[
            column
        ].to_numpy(dtype=bool)

        record[
            f"{column}_detected"
        ] = bool(
            mask.any()
        )

        record[
            f"{column}_n_months"
        ] = int(
            mask.sum()
        )

        if mask.any():
            first_row = group.loc[
                group[
                    column
                ]
            ].iloc[0]

            record[
                f"{column}_first_lead"
            ] = int(
                first_row[
                    "lead_months"
                ]
            )

            record[
                f"{column}_first_date"
            ] = pd.Timestamp(
                first_row[
                    "target_date"
                ]
            )

        else:
            record[
                f"{column}_first_lead"
            ] = np.nan

            record[
                f"{column}_first_date"
            ] = pd.NaT

    full_ae_summary_records.append(
        record
    )

AE_FULL_SYNTHESIS_SUMMARY = pd.DataFrame(
    full_ae_summary_records
)


# ============================================================
# 17. NUMERICAL VALIDATION
# ============================================================

base_contributions = (
    AE3_POINT_CONTRIBUTIONS[
        AE3_POINT_CONTRIBUTIONS[
            "scenario"
        ].eq("Base")
    ]
)

maximum_absolute_base_scenario_value = float(
    base_contributions[
        "scenario_conditioning_value"
    ].abs().max()
)

if (
    maximum_absolute_base_scenario_value
    > NUMERICAL_ATOL
):
    raise RuntimeError(
        "Base scenario-conditioning value is not zero."
    )


minimum_reference_regret = float(
    AE3_POINT_CONTRIBUTIONS[
        "reference_regret"
    ].min()
)

minimum_scenario_policy_regret = float(
    AE3_POINT_CONTRIBUTIONS[
        "scenario_policy_regret"
    ].min()
)

minimum_no_action_regret = float(
    AE3_POINT_CONTRIBUTIONS[
        "no_action_regret"
    ].min()
)

if (
    minimum_reference_regret
    < -NUMERICAL_ATOL
    or minimum_scenario_policy_regret
    < -NUMERICAL_ATOL
    or minimum_no_action_regret
    < -NUMERICAL_ATOL
):
    raise RuntimeError(
        "A policy loss is lower than the corresponding "
        "perfect-information loss."
    )


maximum_bootstrap_bias = float(
    max(
        AE3_MONTHLY_INFERENCE[
            "scenario_value_bootstrap_bias"
        ].abs().max(),

        AE3_MONTHLY_INFERENCE[
            "policy_value_bootstrap_bias"
        ].abs().max(),
    )
)


# ============================================================
