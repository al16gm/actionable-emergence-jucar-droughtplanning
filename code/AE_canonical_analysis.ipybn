        "AE2_BOOTSTRAP_MONTHLY",
    ],
    candidate_paths=[
        AE2_INFERENCE_DIR
        / "AE2_bootstrap_monthly.csv",
        SUPPLEMENT_CSV_DIR
        / "Table_S22_AE2_monthly_inference.csv",
    ],
)

AE2_SENSITIVITY, AE2_SENSITIVITY_SOURCE = load_frame(
    global_names=[
        "AE2_SENSITIVITY",
        "AE2_EMERGENCE_SENSITIVITY",
    ],
    candidate_paths=[
        AE2_INFERENCE_DIR
        / "AE2_emergence_sensitivity.csv",
        SUPPLEMENT_CSV_DIR
        / "Table_S03_AE2_emergence_sensitivity.csv",
    ],
)

AE3_MONTHLY, AE3_MONTHLY_SOURCE = load_frame(
    global_names=[
        "AE3_AUTHORITATIVE_MONTHLY_INFERENCE",
        "AE3_RESELECTION_MONTHLY",
    ],
    candidate_paths=[
        RESELECTION_DIR
        / "AE3_policy_reselection_bootstrap_monthly.csv",
        SUPPLEMENT_CSV_DIR
        / "Table_S21_AE3_authoritative_monthly.csv",
    ],
)

PAPER_TABLE_1, PAPER_TABLE_1_SOURCE = load_frame(
    global_names=[
        "PAPER_TABLE_HIERARCHICAL_EVIDENCE",
    ],
    candidate_paths=[
        PAPER_CSV_DIR
        / "Table_1_hierarchical_evidence.csv",
    ],
)

PAPER_TABLE_3, PAPER_TABLE_3_SOURCE = load_frame(
    global_names=[
        "PAPER_TABLE_PERSISTENT_WINDOWS",
    ],
    candidate_paths=[
        PAPER_CSV_DIR
        / "Table_3_persistent_actionable_windows.csv",
    ],
)


# ============================================================
# 9. NORMALIZE CORE COLUMNS
# ============================================================

for frame_name, frame in {
    "AE2_MONTHLY": AE2_MONTHLY,
    "AE3_MONTHLY": AE3_MONTHLY,
}.items():
    required_columns = [
        "input_kind",
        "scenario",
        "lead_months",
        "target_date",
    ]

    missing_columns = [
        column
        for column in required_columns
        if column not in frame.columns
    ]

    if missing_columns:
        raise ValueError(
            f"{frame_name} is missing columns: {missing_columns}"
        )

    frame[
        "target_date"
    ] = pd.to_datetime(
        frame[
            "target_date"
        ],
        errors="raise",
    )

    frame[
        "lead_months"
    ] = pd.to_numeric(
        frame[
            "lead_months"
        ],
        errors="raise",
    ).astype(
        int
    )

    frame[
        "input_kind"
    ] = (
        frame[
            "input_kind"
        ]
        .astype(
            str
        )
        .str.strip()
    )

    frame[
        "scenario"
    ] = (
        frame[
            "scenario"
        ]
        .astype(
            str
        )
        .str.strip()
    )


# ============================================================
# 10. RESOLVE AE2 COLUMNS
# ============================================================

AE2_CENTRAL_COLUMN = resolve_column(
    AE2_MONTHLY,
    exact_candidates=[
        "delta_rank_score_pp",
        "mean_delta_rank_score_pp",
        "delta_drought_rank_pp",
    ],
)

AE2_POINTWISE_LOWER_COLUMN = resolve_column(
    AE2_MONTHLY,
    exact_candidates=[
        "pointwise_lower_pp",
        "delta_rank_score_pointwise_lower_pp",
        "pointwise_ci_lower_pp",
    ],
    required_tokens=[
        "pointwise",
        "lower",
    ],
    excluded_tokens=[
        "binary",
        "policy",
    ],
    prefer_tokens=[
        "pp",
        "rank",
    ],
)

AE2_POINTWISE_UPPER_COLUMN = resolve_column(
    AE2_MONTHLY,
    exact_candidates=[
        "pointwise_upper_pp",
        "delta_rank_score_pointwise_upper_pp",
        "pointwise_ci_upper_pp",
    ],
    required_tokens=[
        "pointwise",
        "upper",
    ],
    excluded_tokens=[
        "binary",
        "policy",
    ],
    prefer_tokens=[
        "pp",
        "rank",
    ],
)

AE2_JOINT_LOWER_COLUMN = resolve_column(
    AE2_MONTHLY,
    exact_candidates=[
        "joint_band_lower_pp",
        "joint_simultaneous_lower_pp",
        "delta_rank_score_joint_band_lower_pp",
    ],
    required_tokens=[
        "joint",
        "lower",
    ],
    excluded_tokens=[
        "binary",
        "policy",
    ],
    prefer_tokens=[
        "band",
        "pp",
        "rank",
    ],
)

AE2_JOINT_UPPER_COLUMN = resolve_column(
    AE2_MONTHLY,
    exact_candidates=[
        "joint_band_upper_pp",
        "joint_simultaneous_upper_pp",
        "delta_rank_score_joint_band_upper_pp",
    ],
    required_tokens=[
        "joint",
        "upper",
    ],
    excluded_tokens=[
        "binary",
        "policy",
    ],
    prefer_tokens=[
        "band",
        "pp",
        "rank",
    ],
)


for numeric_column in [
    AE2_CENTRAL_COLUMN,
    AE2_POINTWISE_LOWER_COLUMN,
    AE2_POINTWISE_UPPER_COLUMN,
    AE2_JOINT_LOWER_COLUMN,
    AE2_JOINT_UPPER_COLUMN,
]:
    AE2_MONTHLY[
        numeric_column
    ] = pd.to_numeric(
        AE2_MONTHLY[
            numeric_column
        ],
        errors="raise",
    )


AE2_MONTHLY[
    "pointwise_excludes_zero"
] = (
    (
        AE2_MONTHLY[
            AE2_POINTWISE_LOWER_COLUMN
        ]
        > 0
    )
    |
    (
        AE2_MONTHLY[
            AE2_POINTWISE_UPPER_COLUMN
        ]
        < 0
    )
)

AE2_MONTHLY[
    "joint_excludes_zero"
] = (
    (
        AE2_MONTHLY[
            AE2_JOINT_LOWER_COLUMN
        ]
        > 0
    )
    |
    (
        AE2_MONTHLY[
            AE2_JOINT_UPPER_COLUMN
        ]
        < 0
    )
)


# ============================================================
# 11. VALIDATE AE3 COLUMNS
# ============================================================

AE3_REQUIRED_COLUMNS = [
    "scenario_conditioning_value",
    "reselection_pointwise_lower",
    "reselection_pointwise_upper",
    "reselection_joint_band_lower",
    "reselection_joint_band_upper",
    "scenario_value_pointwise_positive",
    "scenario_value_joint_band_positive",
]

missing_ae3_columns = [
    column
    for column in AE3_REQUIRED_COLUMNS
    if column not in AE3_MONTHLY.columns
]

if missing_ae3_columns:
    raise ValueError(
        "AE3 authoritative data are missing columns: "
        f"{missing_ae3_columns}"
    )


for numeric_column in [
    "scenario_conditioning_value",
    "reselection_pointwise_lower",
    "reselection_pointwise_upper",
    "reselection_joint_band_lower",
    "reselection_joint_band_upper",
]:
    AE3_MONTHLY[
        numeric_column
    ] = pd.to_numeric(
        AE3_MONTHLY[
            numeric_column
        ],
        errors="raise",
    )


for boolean_column in [
    "scenario_value_pointwise_positive",
    "scenario_value_joint_band_positive",
]:
    AE3_MONTHLY[
        boolean_column
    ] = coerce_boolean(
        AE3_MONTHLY[
            boolean_column
        ]
    )


# ============================================================
# 12. VALIDATE MONTHLY STRUCTURE
# ============================================================

expected_rows = (
    len(
        COMPONENT_ORDER
    )
    * len(
        SCENARIO_ORDER
    )
    * TOTAL_FORECAST_MONTHS
)

for frame_name, frame in {
    "AE2_MONTHLY": AE2_MONTHLY,
    "AE3_MONTHLY": AE3_MONTHLY,
}.items():
    filtered = frame.loc[
        frame[
            "input_kind"
        ].isin(
            COMPONENT_ORDER
        )
        &
        frame[
            "scenario"
        ].isin(
            SCENARIO_ORDER
        )
    ].copy()

    if len(
        filtered
    ) != expected_rows:
        raise RuntimeError(
            f"{frame_name} has an unexpected row count.\n"
            f"Expected: {expected_rows}\n"
            f"Observed: {len(filtered)}"
        )

    duplicate_mask = filtered.duplicated(
        [
            "input_kind",
            "scenario",
            "lead_months",
            "target_date",
        ]
    )

    if duplicate_mask.any():
        raise RuntimeError(
            f"{frame_name} contains duplicate monthly keys."
        )


# ============================================================
# 13. FIGURE 4 SOURCE DATA
# ============================================================

FIGURE_4_DATA = (
    AE2_MONTHLY.loc[
        AE2_MONTHLY[
            "input_kind"
        ].isin(
            COMPONENT_ORDER
        )
        &
        AE2_MONTHLY[
            "scenario"
        ].isin(
            SCENARIO_ORDER
        ),
        [
            "input_kind",
            "scenario",
            "lead_months",
            "target_date",
            AE2_CENTRAL_COLUMN,
            AE2_POINTWISE_LOWER_COLUMN,
            AE2_POINTWISE_UPPER_COLUMN,
            AE2_JOINT_LOWER_COLUMN,
            AE2_JOINT_UPPER_COLUMN,
            "pointwise_excludes_zero",
            "joint_excludes_zero",
        ],
    ]
    .copy()
    .rename(
        columns={
            AE2_CENTRAL_COLUMN: (
                "delta_drought_rank_pp"
            ),
            AE2_POINTWISE_LOWER_COLUMN: (
                "pointwise_lower_pp"
            ),
            AE2_POINTWISE_UPPER_COLUMN: (
                "pointwise_upper_pp"
            ),
            AE2_JOINT_LOWER_COLUMN: (
                "joint_lower_pp"
            ),
            AE2_JOINT_UPPER_COLUMN: (
                "joint_upper_pp"
            ),
        }
    )
)

FIGURE_4_DATA[
    "trustworthy_horizon_months"
] = (
    FIGURE_4_DATA[
        "input_kind"
    ].map(
        EXPECTED_HORIZONS
    )
)

FIGURE_4_DATA[
    "within_AE1_horizon"
] = (
    FIGURE_4_DATA[
        "lead_months"
    ]
    <= FIGURE_4_DATA[
        "trustworthy_horizon_months"
    ]
)

FIGURE_4_DATA_PATH = (
    FIGURE_DATA_DIR
    / "Figure_4_AE2_monthly_data.csv"
)

FIGURE_4_DATA.to_csv(
    FIGURE_4_DATA_PATH,
    index=False,
    date_format="%Y-%m-%d",
)


# ============================================================
# 14. FIGURE 4 — AE2
# ============================================================

FIGURE_4_Y_LIMITS: dict[
    str,
    tuple[
        float,
        float,
    ],
] = {}

for component in COMPONENT_ORDER:
    component_data = FIGURE_4_DATA.loc[
        FIGURE_4_DATA[
            "input_kind"
        ].eq(
            component
        )
    ]

    FIGURE_4_Y_LIMITS[
        component
    ] = finite_axis_limits(
        arrays=[
            component_data[
                "pointwise_lower_pp"
            ].to_numpy(),
            component_data[
                "pointwise_upper_pp"
            ].to_numpy(),
            component_data[
                "joint_lower_pp"
            ].to_numpy(),
            component_data[
                "joint_upper_pp"
            ].to_numpy(),
        ],
        include_zero=True,
        padding_fraction=0.07,
    )


figure_4, axes_4 = plt.subplots(
    nrows=2,
    ncols=3,
    figsize=FIGURE_SIZES[
        "Figure_4"
    ],
    sharex=True,
    sharey="col",
)

panel_labels_4 = [
    "a",
    "b",
    "c",
    "d",
    "e",
    "f",
]


for row_index, scenario in enumerate(
    SCENARIO_ORDER
):
    for column_index, component in enumerate(
        COMPONENT_ORDER
    ):
        axis = axes_4[
            row_index,
            column_index,
        ]

        panel = (
            FIGURE_4_DATA.loc[
                FIGURE_4_DATA[
                    "input_kind"
                ].eq(
                    component
                )
                &
                FIGURE_4_DATA[
                    "scenario"
                ].eq(
                    scenario
                )
            ]
            .sort_values(
                "lead_months"
            )
            .reset_index(
                drop=True
            )
        )

        dates = pd.to_datetime(
            panel[
                "target_date"
            ]
        )

        component_color = COMPONENT_COLORS[
            component
        ]

        horizon = EXPECTED_HORIZONS[
            component
        ]

        boundary_date = pd.Timestamp(
            panel.loc[
                panel[
                    "lead_months"
                ].eq(
                    horizon
                ),
                "target_date",
            ].iloc[
                0
            ]
        )

        shade_start = (
            boundary_date
            + pd.offsets.MonthBegin(
                1
            )
        )

        shade_end = (
            pd.Timestamp(
                panel[
                    "target_date"
                ].max()
            )
            + pd.offsets.MonthEnd(
                1
            )
        )

        axis.axvspan(
            shade_start,
            shade_end,
            color=OUTSIDE_AE1_COLOR,
            alpha=0.75,
            linewidth=0,
            zorder=0,
        )

        axis.fill_between(
            dates,
            panel[
                "pointwise_lower_pp"
            ],
            panel[
                "pointwise_upper_pp"
            ],
            color=component_color,
            alpha=POINTWISE_SHADE_ALPHA,
            linewidth=0,
            zorder=1,
        )

        axis.plot(
            dates,
            panel[
                "joint_lower_pp"
            ],
            color=JOINT_BAND_COLOR,
            linewidth=1.0,
            linestyle=(
                0,
                (
                    3,
                    2,
                ),
            ),
            zorder=2,
        )

        axis.plot(
            dates,
            panel[
                "joint_upper_pp"
            ],
            color=JOINT_BAND_COLOR,
            linewidth=1.0,
            linestyle=(
                0,
                (
                    3,
                    2,
                ),
            ),
            zorder=2,
        )

        axis.plot(
            dates,
            panel[
                "delta_drought_rank_pp"
            ],
            color=component_color,
            linewidth=1.7,
            zorder=4,
        )

        within_ae1 = panel[
            "within_AE1_horizon"
        ].to_numpy(
            dtype=bool
        )

        pointwise_mask = (
            panel[
                "pointwise_excludes_zero"
            ].to_numpy(
                dtype=bool
            )
            &
            within_ae1
        )

        joint_mask = (
            panel[
                "joint_excludes_zero"
            ].to_numpy(
                dtype=bool
            )
            &
            within_ae1
        )

        axis.scatter(
            dates.loc[
                pointwise_mask
            ],
            panel.loc[
                pointwise_mask,
                "delta_drought_rank_pp",
            ],
            s=16,
            facecolor="white",
            edgecolor=EXPLORATORY_COLOR,
            linewidth=0.9,
            zorder=6,
        )

        axis.scatter(
            dates.loc[
                joint_mask
            ],
            panel.loc[
                joint_mask,
                "delta_drought_rank_pp",
            ],
            s=20,
            marker="D",
            facecolor=CONFIRMATORY_COLOR,
            edgecolor="white",
            linewidth=0.45,
            zorder=7,
        )

        axis.axhline(
            0,
            color=ZERO_COLOR,
            linewidth=0.9,
            zorder=3,
        )

        axis.axvline(
            boundary_date,
            color=REFERENCE_COLOR,
            linewidth=1.0,
            linestyle=(
                0,
                (
                    4,
                    3,
                ),
            ),
            zorder=5,
        )

        axis.set_ylim(
            FIGURE_4_Y_LIMITS[
                component
            ]
        )

        axis.grid(
            axis="y",
            color=GRIDLINE_COLOR,
            linewidth=0.6,
            alpha=0.75,
        )

        if row_index == 0:
            axis.set_title(
                component,
                color=component_color,
                fontweight="bold",
            )

        if column_index == 0:
            axis.set_ylabel(
                (
                    f"{scenario}\n"
                    "Δ drought-rank (pp)"
                )
            )

        if row_index == 1:
            axis.set_xlabel(
                "Target month"
            )

        format_biennial_year_axis(
            axis
        )

        axis.text(
            0.02,
            0.95,
            rf"$R_k={horizon}$",
            transform=axis.transAxes,
            ha="left",
            va="top",
            fontsize=7.4,
            color="#444444",
        )

        add_panel_label(
            axis,
            panel_labels_4[
                row_index
                * 3
                + column_index
            ],
            x=-0.20,
            y=1.09,
        )


figure_4.suptitle(
    "AE2 — Forecast-relative scenario separation",
    x=0.02,
    y=0.985,
    ha="left",
    fontweight="bold",
)

figure_4.legend(
    handles=[
        Line2D(
            [
                0
            ],
            [
                0
            ],
            color="#555555",
            linewidth=1.7,
            label="Central effect",
        ),
        Patch(
            facecolor="#888888",
            alpha=POINTWISE_SHADE_ALPHA,
            edgecolor="none",
            label="95% pointwise CI",
        ),
        Line2D(
            [
                0
            ],
            [
                0
            ],
            color=JOINT_BAND_COLOR,
            linewidth=1.0,
            linestyle=(
                0,
                (
                    3,
                    2,
                ),
            ),
            label="95% joint band",
        ),
        Line2D(
            [
                0
            ],
            [
                0
            ],
            marker="o",
            markerfacecolor="white",
            markeredgecolor=EXPLORATORY_COLOR,
            linestyle="none",
            label="Pointwise evidence",
        ),
        Line2D(
            [
                0
            ],
            [
                0
            ],
            marker="D",
            markerfacecolor=CONFIRMATORY_COLOR,
            markeredgecolor="white",
            linestyle="none",
            label="Joint evidence",
        ),
    ],
    loc="lower center",
    bbox_to_anchor=(
        0.5,
        -0.005,
    ),
    ncol=3,
    frameon=False,
)

figure_4.subplots_adjust(
    left=0.10,
    right=0.99,
    top=0.90,
    bottom=0.14,
    hspace=0.20,
    wspace=0.17,
)


