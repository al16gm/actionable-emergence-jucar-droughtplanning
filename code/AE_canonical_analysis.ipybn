# ============================================================

expected_full_rows = (
    len(
        COMPONENT_ORDER
    )
    * len(
        SCENARIO_ORDER
    )
    * TOTAL_FORECAST_MONTHS
)

for frame_name, frame in {
    "AE2_MONTHLY": AE2_MONTHLY,
    "AE3_MONTHLY": AE3_MONTHLY,
}.items():
    filtered = frame.loc[
        frame[
            "input_kind"
        ].isin(
            COMPONENT_ORDER
        )
        &
        frame[
            "scenario"
        ].isin(
            SCENARIO_ORDER
        )
    ]

    if len(
        filtered
    ) != expected_full_rows:
        raise RuntimeError(
            f"{frame_name} has an unexpected canonical row count.\n"
            f"Expected: {expected_full_rows}\n"
            f"Observed: {len(filtered)}"
        )

    duplicate_keys = filtered.duplicated(
        [
            "input_kind",
            "scenario",
            "lead_months",
            "target_date",
        ]
    )

    if duplicate_keys.any():
        raise RuntimeError(
            f"{frame_name} contains duplicate monthly keys."
        )


