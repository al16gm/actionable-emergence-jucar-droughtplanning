# ============================================================
# CELL 07 — CANONICAL PAPER AND SUPPLEMENTARY TABLE PACKAGE
#
# Purpose
# -------
# Produce the authoritative publication tables after completion of:
#   - AE1 horizon inheritance;
#   - AE2 forecast-relative emergence analysis;
#   - AE3 cross-validated decision analysis;
#   - AE3 bootstrap with policy reselection.
#
# Inferential hierarchy
# ----------------------
# AE3 central effect sizes:
#   Canonical leave-one-point-out estimates from Cell 04.
#
# AE3 confirmatory inference:
#   Policy-reselection bootstrap from Cell 06.
#
# Fixed-contribution bootstrap:
#   Retained only as a supplementary sensitivity analysis.
#
# Main-paper tables
# -----------------
# Table 1:
#   Hierarchical AE1–AE2–AE3 evidence.
#
# Table 2:
#   Decision value, policy instability, and interval inflation.
#
# Table 3:
#   Persistent full-AE windows after policy reselection.
#
# Supplementary tables
# --------------------
# Includes analysis population, AE2 diagnostics, AE3 inference,
# parameter sensitivity, action diagnostics, persistence,
# run catalogues, and monthly source tables.
#
# Outputs
# -------
# - Individual CSV files.
# - Main-paper Excel workbook.
# - Supplementary Excel workbook.
# - LaTeX files for main-paper tables.
# - Table manifests and data dictionaries.
# - SHA-256 output registry.
# - Reproducible ZIP package.
# ============================================================

from __future__ import annotations

import copy
import hashlib
import json
import math
import shutil
from datetime import datetime, timezone
from itertools import product
from pathlib import Path
from typing import Any

import numpy as np
import pandas as pd

from openpyxl import Workbook
from openpyxl.styles import (
    Alignment,
    Border,
    Font,
    PatternFill,
    Side,
)
from openpyxl.utils import get_column_letter


# ============================================================
# 1. REQUIRE CELLS 00–06
# ============================================================

REQUIRED_OBJECTS = [
    "PATHS",
    "RUN_DIR",
    "RUN_CONTEXT",
    "MANIFEST_PATH",
    "CONFIG",
    "FORECAST_SHA256",
    "AE2_INFERENCE_COMPLETED",
    "AE3_COMPLETED",
    "AE3_CONSOLIDATION_COMPLETED",
    "AE3_POLICY_RESELECTION_COMPLETED",
]

missing_objects = [
    name
    for name in REQUIRED_OBJECTS
    if name not in globals()
]

if missing_objects:
    raise RuntimeError(
        "Cells 00–06 must be executed before Cell 07. "
        f"Missing objects: {missing_objects}"
    )

if not bool(AE2_INFERENCE_COMPLETED):
    raise RuntimeError(
        "AE2 inference was not completed."
    )

if not bool(AE3_COMPLETED):
    raise RuntimeError(
        "AE3 was not completed."
    )

if not bool(AE3_CONSOLIDATION_COMPLETED):
    raise RuntimeError(
        "AE3 consolidation was not completed."
    )

if not bool(AE3_POLICY_RESELECTION_COMPLETED):
    raise RuntimeError(
        "AE3 policy-reselection inference was not completed."
    )


# ============================================================
# 2. PATHS
# ============================================================

RUN_DIR = Path(RUN_DIR)

AE2_DIR = Path(
    PATHS["ae2"]
)

AE2_INFERENCE_DIR = (
    AE2_DIR
    / "inference"
)

AE3_DIR = Path(
    PATHS.get(
        "ae3",
        RUN_DIR / "04_ae3",
    )
)

CONSOLIDATION_DIR = (
    RUN_DIR
    / "05_consolidation"
)

RESELECTION_DIR = (
    RUN_DIR
    / "06_policy_reselection"
)

TABLES_DIR = (
    RUN_DIR
    / "07_tables"
)

PAPER_DIR = (
    TABLES_DIR
    / "paper"
)

SUPPLEMENT_DIR = (
    TABLES_DIR
    / "supplementary"
)

PAPER_CSV_DIR = (
    PAPER_DIR
    / "csv"
)

PAPER_LATEX_DIR = (
    PAPER_DIR
    / "latex"
)

SUPPLEMENT_CSV_DIR = (
    SUPPLEMENT_DIR
    / "csv"
)

for directory in [
    TABLES_DIR,
    PAPER_DIR,
    SUPPLEMENT_DIR,
    PAPER_CSV_DIR,
    PAPER_LATEX_DIR,
    SUPPLEMENT_CSV_DIR,
]:
    directory.mkdir(
        parents=True,
        exist_ok=True,
    )


# ============================================================
# 3. ARCHIVE PREVIOUS CELL 07 OUTPUTS
# ============================================================

ARCHIVE_DIRECTORY: Path | None = None

existing_outputs = [
    path
    for path in TABLES_DIR.iterdir()
    if (
        path.is_file()
        or (
            path.is_dir()
            and path.name
            not in {
                "_superseded",
            }
        )
    )
]

if existing_outputs:
    archive_timestamp = datetime.now(
        timezone.utc
    ).strftime("%Y%m%dT%H%M%S%fZ")

    ARCHIVE_DIRECTORY = (
        TABLES_DIR
        / "_superseded"
        / archive_timestamp
    )

    ARCHIVE_DIRECTORY.mkdir(
        parents=True,
        exist_ok=False,
    )

    for old_output in existing_outputs:
        shutil.move(
            str(old_output),
            str(
                ARCHIVE_DIRECTORY
                / old_output.name
            ),
        )

    for directory in [
        PAPER_DIR,
        SUPPLEMENT_DIR,
        PAPER_CSV_DIR,
        PAPER_LATEX_DIR,
        SUPPLEMENT_CSV_DIR,
    ]:
        directory.mkdir(
            parents=True,
            exist_ok=True,
        )


