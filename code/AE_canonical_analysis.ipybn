    ),
]


# ============================================================
# 16. EXPORT INDIVIDUAL CSV AND LATEX FILES
# ============================================================

paper_manifest_records: list[
    dict[str, Any]
] = []

supplement_manifest_records: list[
    dict[str, Any]
] = []


for specification in paper_table_specs:
    csv_path = (
        PAPER_CSV_DIR
        / specification[
            "csv_name"
        ]
    )

    specification[
        "frame"
    ].to_csv(
        csv_path,
        index=False,
        date_format="%Y-%m-%d",
    )

    latex_path = (
        PAPER_LATEX_DIR
        / specification[
            "latex_name"
        ]
    )

    write_latex_table(
        frame=specification[
            "frame"
        ],
        output_path=latex_path,
        caption=specification[
            "caption"
        ],
        label=specification[
            "latex_label"
        ],
    )

    paper_manifest_records.append(
        {
            "table_id": specification[
                "table_id"
            ],
            "sheet_name": specification[
                "sheet_name"
            ],
            "title": specification[
                "title"
            ],
            "role": specification[
                "role"
            ],
            "source": specification[
                "source"
            ],
            "n_rows": int(
                len(
                    specification[
                        "frame"
                    ]
                )
            ),
            "n_columns": int(
                len(
                    specification[
                        "frame"
                    ].columns
                )
            ),
            "csv_path": str(
                csv_path
            ),
            "csv_sha256": sha256_file(
                csv_path
            ),
            "latex_path": str(
                latex_path
            ),
            "latex_sha256": sha256_file(
                latex_path
            ),
        }
    )


for specification in supplementary_table_specs:
    csv_path = (
        SUPPLEMENT_CSV_DIR
        / specification[
            "csv_name"
        ]
    )

    specification[
        "frame"
    ].to_csv(
        csv_path,
        index=False,
        date_format="%Y-%m-%d",
    )

    supplement_manifest_records.append(
        {
            "table_id": specification[
                "table_id"
            ],
            "sheet_name": specification[
                "sheet_name"
            ],
            "title": specification[
                "title"
            ],
            "role": specification[
                "role"
            ],
            "source": specification[
                "source"
            ],
            "n_rows": int(
                len(
                    specification[
                        "frame"
                    ]
                )
            ),
            "n_columns": int(
                len(
                    specification[
                        "frame"
                    ].columns
                )
            ),
            "csv_path": str(
                csv_path
            ),
            "csv_sha256": sha256_file(
                csv_path
            ),
        }
    )


PAPER_TABLE_MANIFEST = pd.DataFrame(
    paper_manifest_records
)

SUPPLEMENTARY_TABLE_MANIFEST = pd.DataFrame(
    supplement_manifest_records
)


