    ),

    "reference_sample_size_per_point": 84,

    "cdf_method": (
        "Tie-aware empirical midrank CDF with linear interpolation"
    ),

    "flat_reference_policy": (
        "Exclude points whose 84 Base seasonal residuals "
        "are numerically constant"
    ),

    "drought_rank_definition": (
        "1 minus point-specific Base residual CDF"
    ),

    "drought_rank_direction": (
