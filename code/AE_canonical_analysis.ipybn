# ============================================================
# 5. HELPER FUNCTIONS
# ============================================================

def utc_now_iso() -> str:
    """Return the current UTC timestamp."""
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def sha256_file(
    path: Path,
    chunk_size: int = 1024 * 1024,
) -> str:
    """Compute a SHA-256 digest without loading the whole file."""
    digest = hashlib.sha256()

    with path.open("rb") as handle:
        while True:
            chunk = handle.read(chunk_size)

            if not chunk:
                break

            digest.update(chunk)

    return digest.hexdigest()


def sha256_json(payload: dict[str, Any]) -> str:
    """Compute a deterministic hash of a JSON-serializable object."""
    serialized = json.dumps(
        payload,
        sort_keys=True,
        ensure_ascii=False,
        separators=(",", ":"),
        default=str,
    ).encode("utf-8")

    return hashlib.sha256(serialized).hexdigest()


def safe_git_commit() -> str | None:
    """Return the current Git commit when executed inside a repository."""
    try:
        result = subprocess.run(
            ["git", "rev-parse", "HEAD"],
            capture_output=True,
            text=True,
            check=True,
            timeout=5,
        )
        return result.stdout.strip() or None
    except Exception:
        return None


def try_mount_google_drive() -> bool:
    """Mount Google Drive only when running in Google Colab."""
    if not MOUNT_GOOGLE_DRIVE:
        return False

    try:
        from google.colab import drive  # type: ignore

        mount_root = Path("/content/drive")

        if not (mount_root / "MyDrive").exists():
            drive.mount("/content/drive")

        return (mount_root / "MyDrive").exists()

    except Exception:
        return False


def normalized_path_priority(path: Path) -> tuple[int, int, str]:
    """
    Rank file candidates.

    Priority:
      1. /content direct files
      2. known /content output folders
      3. Google Drive
      4. shallower paths before deeper paths
    """
    path_string = str(path.resolve())

    if path.parent == Path("/content"):
        root_priority = 0
    elif path_string.startswith("/content/"):
        root_priority = 1
    elif path_string.startswith("/content/drive/MyDrive/"):
        root_priority = 2
    else:
        root_priority = 3

    return (
        root_priority,
        len(path.parts),
        path_string,
    )


def discover_exact_filenames(
    filenames: Iterable[str],
    search_roots: Iterable[Path],
    recursive_drive: bool = True,
) -> list[Path]:
    """Find files using exact filenames only."""
    discovered: list[Path] = []

    for root in search_roots:
        if not root.exists():
            continue

        for filename in filenames:
            direct_candidate = root / filename

            if direct_candidate.is_file():
                discovered.append(direct_candidate.resolve())

        should_recurse = (
            not str(root).startswith("/content/drive/MyDrive")
            or recursive_drive
        )

        if not should_recurse:
            continue

        for filename in filenames:
            try:
                for match in root.rglob(filename):
                    if match.is_file():
                        discovered.append(match.resolve())
            except Exception:
                continue

    unique_paths = sorted(
        set(discovered),
        key=normalized_path_priority,
    )

    return unique_paths


def choose_file(
    label: str,
    candidates: list[Path],
    explicit_path: str | None = None,
    required: bool = False,
    expected_sha256: str | None = None,
) -> Path | None:
    """
    Choose a file deterministically.

    When expected_sha256 is provided, a matching file is preferred.
    """
    if explicit_path is not None:
        explicit = Path(explicit_path).expanduser().resolve()

        if not explicit.is_file():
            raise FileNotFoundError(
                f"Explicit {label} path does not exist: {explicit}"
            )

        candidates = [explicit]

    if not candidates:
        if required:
            raise FileNotFoundError(
                f"No candidate file was found for required input: {label}"
            )
        return None

    if expected_sha256 is not None:
        matching_candidates = []

        for candidate in candidates:
            try:
                candidate_hash = sha256_file(candidate)
            except Exception:
                continue

            if candidate_hash == expected_sha256:
                matching_candidates.append(candidate)

        if matching_candidates:
            return sorted(
                matching_candidates,
                key=normalized_path_priority,
            )[0]

    return sorted(
        candidates,
        key=normalized_path_priority,
    )[0]


def describe_input_file(
    label: str,
    path: Path | None,
    role: str,
) -> dict[str, Any]:
    """Build a provenance record for one input file."""
    if path is None:
        return {
            "label": label,
            "role": role,
            "available": False,
            "path": None,
            "filename": None,
            "size_bytes": None,
            "sha256": None,
            "modified_time_utc": None,
        }

    stat = path.stat()

    return {
        "label": label,
        "role": role,
        "available": True,
        "path": str(path),
        "filename": path.name,
        "size_bytes": int(stat.st_size),
        "sha256": sha256_file(path),
        "modified_time_utc": datetime.fromtimestamp(
            stat.st_mtime,
            tz=timezone.utc,
        ).isoformat(timespec="seconds"),
    }


def collect_package_versions() -> dict[str, str | None]:
    """Collect versions relevant to the analytical pipeline."""
    versions: dict[str, str | None] = {
        "python": sys.version.split()[0],
        "numpy": np.__version__,
        "pandas": pd.__version__,
    }

    optional_packages = [
        "scipy",
        "sklearn",
        "matplotlib",
        "xgboost",
    ]

    for package_name in optional_packages:
        try:
            module = __import__(package_name)
            versions[package_name] = getattr(
                module,
                "__version__",
                "unknown",
            )
        except Exception:
            versions[package_name] = None

    return versions


