    PAPER_DIR
    / "AE_main_paper_tables.xlsx"
)

SUPPLEMENT_WORKBOOK_PATH = (
    SUPPLEMENT_DIR
    / "AE_supplementary_tables.xlsx"
)


write_workbook(
    output_path=PAPER_WORKBOOK_PATH,
    workbook_title=(
        "Actionable Emergence — Main Paper Tables"
