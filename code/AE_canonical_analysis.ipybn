# ============================================================
# 14. VALIDATE THE GENERATED WORKBOOKS
# ============================================================

validation_records = []

for workbook_record in generated_workbook_records:
    workbook_path = Path(
        workbook_record[
            "path"
        ]
    )

    validation_workbook = load_workbook(
        workbook_path,
        read_only=True,
        data_only=False,
    )

    sheet_names = (
        validation_workbook.sheetnames
    )

    required_sheet_names = {
        "README",
        "CONTENTS",
        "SOURCE_MANIFEST",
    }

    missing_required_sheets = sorted(
        required_sheet_names
        - set(
            sheet_names
        )
    )

    if missing_required_sheets:
        raise RuntimeError(
            f"{workbook_path.name} is missing required sheets: "
            f"{missing_required_sheets}"
        )

    readme_title = (
        validation_workbook[
            "README"
        ][
            "A1"
        ].value
    )

    if not readme_title:
        raise RuntimeError(
            f"{workbook_path.name} has an empty README title."
        )

    empty_data_sheets = []

    for sheet_name in sheet_names:
        if sheet_name in {
            "README",
            "CONTENTS",
            "SOURCE_MANIFEST",
        }:
            continue

        worksheet = validation_workbook[
            sheet_name
        ]

        if worksheet.max_column < 1:
            empty_data_sheets.append(
                sheet_name
            )

    validation_records.append(
        {
            "package_id": workbook_record[
                "package_id"
            ],
            "filename": workbook_path.name,
            "n_sheets": int(
                len(
                    sheet_names
                )
            ),
            "readme_present": True,
            "contents_present": True,
            "source_manifest_present": True,
            "empty_data_sheets": (
                ", ".join(
                    empty_data_sheets
                )
            ),
            "validation_passed": bool(
                not missing_required_sheets
            ),
        }
    )

    validation_workbook.close()


WORKBOOK_VALIDATION = pd.DataFrame(
    validation_records
)

WORKBOOK_VALIDATION_PATH = (
    OUTPUT_DIR
    / "supplementary_workbook_validation.csv"
)

WORKBOOK_VALIDATION.to_csv(
