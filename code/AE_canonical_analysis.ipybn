    "Unfavorable": "positive",
}

EXPECTED_HORIZONS = {
    "Aquifer": 48,
    "Reservoir": 36,
    "River": 24,
}

NUMERICAL_ATOL = 1e-12
NUMERICAL_RTOL = 1e-10

ALPHA = 1.0 - CONFIDENCE_LEVEL
LOWER_QUANTILE = ALPHA / 2.0
UPPER_QUANTILE = 1.0 - ALPHA / 2.0

INFERENCE_SCOPE = (
    "Spatial control-point trajectory resampling uncertainty"
)

PRIMARY_EVIDENCE_MODE = (
    "pointwise_percentile_bootstrap_interval"
)

CONFIRMATORY_EVIDENCE_MODE = (
    "joint_component_max_standardized_deviation_band"
)


# ============================================================
# 4. OUTPUT DIRECTORY
# ============================================================

INFERENCE_DIR = (
    AE2_DIR
    / "inference"
)

ARCHIVE_DIRECTORY: Path | None = None

if INFERENCE_DIR.exists():
    existing_files = [
        path
        for path in INFERENCE_DIR.iterdir()
        if path.is_file()
    ]

    if existing_files:
        archive_timestamp = datetime.now(
            timezone.utc
        ).strftime("%Y%m%dT%H%M%S%fZ")

        ARCHIVE_DIRECTORY = (
            INFERENCE_DIR
            / "_superseded"
            / archive_timestamp
        )

        ARCHIVE_DIRECTORY.mkdir(
            parents=True,
            exist_ok=False,
        )

        for old_file in existing_files:
            shutil.move(
                str(old_file),
                str(
                    ARCHIVE_DIRECTORY
                    / old_file.name
                ),
            )

INFERENCE_DIR.mkdir(
    parents=True,
    exist_ok=True,
)


# ============================================================
# 5. HELPERS
# ============================================================

def utc_now_iso() -> str:
    """Return the current UTC timestamp."""
    return datetime.now(
        timezone.utc
    ).isoformat(timespec="seconds")


def display_frame(
    frame: pd.DataFrame,
    n: int = 50,
) -> None:
    """Display a DataFrame with a text fallback."""
    try:
        display(
            frame.head(n)
        )
    except NameError:
        print(
            frame.head(n).to_string(
                index=False
            )
        )


def sha256_json(
    payload: dict[str, Any],
) -> str:
    """Return a deterministic SHA-256 hash."""
    serialized = json.dumps(
        payload,
        sort_keys=True,
        ensure_ascii=False,
        separators=(",", ":"),
        default=str,
    ).encode("utf-8")

    return hashlib.sha256(
        serialized
    ).hexdigest()


def update_json_file(
    path: Path,
    updates: dict[str, Any],
) -> None:
    """Update a JSON file while preserving existing fields."""
    if path.exists():
        with path.open(
            "r",
            encoding="utf-8",
        ) as handle:
            payload = json.load(
                handle
            )
    else:
        payload = {}

    payload.update(
        updates
    )

    with path.open(
        "w",
        encoding="utf-8",
    ) as handle:
        json.dump(
            payload,
            handle,
            ensure_ascii=False,
            indent=2,
            sort_keys=True,
            default=str,
        )


def coerce_boolean(
    values: pd.Series,
) -> pd.Series:
    """Normalize bool-like columns."""
    if pd.api.types.is_bool_dtype(
        values
    ):
        return values.astype(bool)

    mapping = {
        "true": True,
        "false": False,
        "1": True,
        "0": False,
    }

    normalized = (
        values.astype(str)
        .str.strip()
        .str.lower()
        .map(mapping)
    )

    if normalized.isna().any():
        raise ValueError(
            "Could not convert all values to Boolean."
        )

    return normalized.astype(bool)


def linear_quantile(
    values: np.ndarray,
    quantile: float,
    axis: int | None = None,
) -> np.ndarray | float:
    """Calculate a reproducible linear quantile."""
    try:
        return np.quantile(
            values,
            quantile,
            axis=axis,
            method="linear",
        )
    except TypeError:
        return np.quantile(
            values,
            quantile,
            axis=axis,
            interpolation="linear",
        )


def safe_correlation(
    x: pd.Series,
    y: pd.Series,
    method: str = "pearson",
) -> float:
    """Calculate a correlation only when both variables vary."""
    frame = pd.DataFrame(
        {
            "x": pd.to_numeric(
                x,
                errors="coerce",
            ),
            "y": pd.to_numeric(
                y,
                errors="coerce",
            ),
        }
    ).dropna()

    if len(frame) < 3:
        return np.nan

    if (
        frame["x"].std(ddof=0)
        <= NUMERICAL_ATOL
        or frame["y"].std(ddof=0)
        <= NUMERICAL_ATOL
    ):
        return np.nan

    if method == "spearman":
        return float(
            frame["x"]
            .rank(method="average")
            .corr(
                frame["y"].rank(
                    method="average"
                )
            )
        )

    return float(
        frame["x"].corr(
            frame["y"]
        )
    )


def bootstrap_trajectory_means(
    matrix: np.ndarray,
    sampled_indices: np.ndarray,
    chunk_size: int,
) -> np.ndarray:
    """
    Calculate bootstrap trajectory means in bounded-memory chunks.

    Parameters
    ----------
    matrix
        Shape: n_points × n_months.
    sampled_indices
        Shape: B × n_points.
    """
    matrix = np.asarray(
        matrix,
        dtype=float,
    )

    n_bootstrap = sampled_indices.shape[0]
    n_months = matrix.shape[1]

    output = np.empty(
        (
            n_bootstrap,
            n_months,
        ),
        dtype=float,
    )

    for start in range(
        0,
        n_bootstrap,
        chunk_size,
    ):
        stop = min(
            start + chunk_size,
            n_bootstrap,
        )

        sampled = matrix[
            sampled_indices[
                start:stop
            ],
            :,
        ]

        output[
            start:stop,
            :,
        ] = sampled.mean(
            axis=1
        )

    return output


def standardized_bootstrap_error(
    bootstrap_estimates: np.ndarray,
    observed_estimates: np.ndarray,
    bootstrap_standard_error: np.ndarray,
) -> np.ndarray:
    """
    Calculate absolute standardized bootstrap deviations.

    Months with exactly zero bootstrap SE receive zero deviation
    only when all bootstrap estimates equal the observed estimate.
    """
    difference = np.abs(
        bootstrap_estimates
        - observed_estimates[
            np.newaxis,
            :,
        ]
    )

    output = np.zeros_like(
        difference,
        dtype=float,
    )

    positive_se = (
        bootstrap_standard_error
        > NUMERICAL_ATOL
    )

    output[
        :,
        positive_se,
    ] = (
        difference[
            :,
            positive_se,
        ]
        / bootstrap_standard_error[
            positive_se
        ]
    )

    zero_se = ~positive_se

    if zero_se.any():
        invalid_zero_se = (
            difference[
                :,
                zero_se,
            ]
            > NUMERICAL_ATOL
        )

        if invalid_zero_se.any():
            raise RuntimeError(
                "A zero bootstrap standard error was associated "
                "with non-zero bootstrap deviations."
            )

    return output


def run_statistics(
    mask: np.ndarray,
    leads: np.ndarray,
    dates: np.ndarray,
    minimum_run_length: int,
) -> dict[str, Any]:
    """Summarize consecutive True runs."""
    mask = np.asarray(
        mask,
        dtype=bool,
    )

    leads = np.asarray(
        leads,
        dtype=int,
    )

    dates = pd.to_datetime(
        dates
    ).to_numpy()

    if not (
        len(mask)
        == len(leads)
        == len(dates)
    ):
        raise ValueError(
            "Run inputs have inconsistent lengths."
        )

    order = np.argsort(
        leads
    )

    mask = mask[order]
    leads = leads[order]
    dates = dates[order]

    runs: list[
        dict[str, Any]
    ] = []

    start_index: int | None = None

    for index in range(
        len(mask)
    ):
        current_true = bool(
            mask[index]
        )

        previous_consecutive = (
            index > 0
            and leads[index]
            == leads[index - 1] + 1
        )

        if current_true:
            if (
                start_index is None
                or not previous_consecutive
            ):
                start_index = index
        else:
            if start_index is not None:
                end_index = index - 1

                runs.append(
                    {
                        "start_index": start_index,
                        "end_index": end_index,
                        "length": (
                            end_index
                            - start_index
                            + 1
                        ),
                    }
                )

                start_index = None

    if start_index is not None:
        end_index = len(mask) - 1

        runs.append(
            {
                "start_index": start_index,
                "end_index": end_index,
                "length": (
                    end_index
                    - start_index
                    + 1
                ),
            }
        )

    qualifying_runs = [
        run
        for run in runs
        if run["length"]
        >= minimum_run_length
    ]

    longest_run = max(
        (
            run["length"]
            for run in runs
        ),
        default=0,
    )

    result: dict[str, Any] = {
        "emergence_detected": bool(
            qualifying_runs
        ),
        "n_true_months": int(
            mask.sum()
        ),
        "n_all_runs": int(
            len(runs)
        ),
        "n_qualifying_runs": int(
            len(
                qualifying_runs
            )
        ),
        "longest_run_months": int(
            longest_run
        ),
        "first_start_lead": np.nan,
        "first_end_lead": np.nan,
        "first_start_date": pd.NaT,
        "first_end_date": pd.NaT,
    }

    if qualifying_runs:
        first_run = qualifying_runs[0]

        start = int(
            first_run[
                "start_index"
            ]
        )

        end = int(
            first_run[
                "end_index"
            ]
        )

        result.update(
            {
                "first_start_lead": int(
                    leads[start]
                ),
                "first_end_lead": int(
                    leads[end]
                ),
                "first_start_date": pd.Timestamp(
                    dates[start]
                ),
                "first_end_date": pd.Timestamp(
                    dates[end]
                ),
            }
        )

    return result


def qualifying_run_membership(
    mask: np.ndarray,
    leads: np.ndarray,
    minimum_run_length: int,
) -> tuple[np.ndarray, np.ndarray]:
    """
    Mark months belonging to runs of at least minimum_run_length.

    Returns
    -------
    membership
        Boolean array.
    run_ids
        Integer run identifier, zero outside qualifying runs.
    """
    mask = np.asarray(
        mask,
        dtype=bool,
    )

    leads = np.asarray(
        leads,
        dtype=int,
    )

    order = np.argsort(
        leads
    )

    sorted_mask = mask[order]
    sorted_leads = leads[order]

    sorted_membership = np.zeros(
        len(mask),
        dtype=bool,
    )

    sorted_run_ids = np.zeros(
        len(mask),
        dtype=int,
    )

    current_start: int | None = None
    qualifying_id = 0

    for index in range(
        len(sorted_mask) + 1
    ):
        is_true = (
            index < len(sorted_mask)
            and bool(
                sorted_mask[index]
            )
        )

        is_consecutive = (
            index > 0
            and index < len(sorted_mask)
            and sorted_leads[index]
            == sorted_leads[index - 1] + 1
        )

        if is_true:
            if (
                current_start is None
                or not is_consecutive
            ):
                current_start = index
        else:
            if current_start is not None:
                end = index - 1
                run_length = (
                    end
                    - current_start
                    + 1
                )

                if (
                    run_length
                    >= minimum_run_length
                ):
                    qualifying_id += 1

                    sorted_membership[
                        current_start:end + 1
                    ] = True

                    sorted_run_ids[
                        current_start:end + 1
                    ] = qualifying_id

                current_start = None

    membership = np.zeros_like(
        sorted_membership
    )

    run_ids = np.zeros_like(
        sorted_run_ids
    )

    membership[order] = (
        sorted_membership
    )

    run_ids[order] = (
        sorted_run_ids
    )

    return membership, run_ids


# ============================================================
# 6. NORMALIZE INPUTS
# ============================================================

paired_deltas["target_date"] = pd.to_datetime(
    paired_deltas["target_date"],
    errors="raise",
)

paired_deltas["lead_months"] = pd.to_numeric(
    paired_deltas["lead_months"],
    errors="raise",
).astype(int)

paired_deltas[
    "delta_drought_rank_score_pp"
] = pd.to_numeric(
    paired_deltas[
        "delta_drought_rank_score_pp"
    ],
    errors="raise",
)

for identifier_column in [
    "input_kind",
    "scenario",
    "point_id",
    "series_id",
]:
    paired_deltas[
        identifier_column
    ] = (
        paired_deltas[
            identifier_column
        ]
        .astype(str)
        .str.strip()
    )

for boolean_column in [
    "AE1_gate_pass",
    "within_inherited_AE1_horizon",
]:
    if boolean_column in paired_deltas.columns:
        paired_deltas[
            boolean_column
        ] = coerce_boolean(
            paired_deltas[
                boolean_column
            ]
        )

for identifier_column in [
    "input_kind",
    "point_id",
    "series_id",
]:
    reference_diagnostic[
        identifier_column
    ] = (
        reference_diagnostic[
            identifier_column
        ]
        .astype(str)
        .str.strip()
    )

for numeric_column in [
    "maximum_tie_fraction",
    "n_unique_values",
    "reference_range",
]:
    reference_diagnostic[
        numeric_column
    ] = pd.to_numeric(
        reference_diagnostic[
            numeric_column
        ],
        errors="raise",
    )

required_delta_columns = [
    "input_kind",
    "scenario",
    "point_id",
    "series_id",
    "target_date",
    "lead_months",
    "trustworthy_horizon_months",
    "AE1_gate_pass",
    "delta_drought_rank_score_pp",
]

missing_delta_columns = [
    column
    for column in required_delta_columns
    if column not in paired_deltas.columns
]

if missing_delta_columns:
    raise ValueError(
        "Paired delta input is missing columns: "
        f"{missing_delta_columns}"
    )

if paired_deltas[
    required_delta_columns
].isna().any().any():
    raise ValueError(
        "Paired delta input contains missing required values."
    )

observed_components = sorted(
    paired_deltas[
        "input_kind"
    ].unique()
)

observed_scenarios = sorted(
    paired_deltas[
        "scenario"
    ].unique()
)

if observed_components != sorted(
    COMPONENT_ORDER
):
    raise ValueError(
        "Unexpected components in paired AE2 input.\n"
        f"Observed: {observed_components}"
    )

if observed_scenarios != sorted(
    SCENARIO_ORDER
):
    raise ValueError(
        "Unexpected scenarios in paired AE2 input.\n"
        f"Observed: {observed_scenarios}"
    )


# ============================================================
# 7. CONFIGURATION AMENDMENT
# ============================================================

CONFIG_AMENDED = copy.deepcopy(
    CONFIG
)

CONFIG_AMENDED[
    "ae2"
][
    "bootstrap"
] = {
    "completed": True,
    "method": (
        "Paired complete-control-point trajectory bootstrap"
    ),
    "resampling_unit": (
        "Complete control-point trajectory"
    ),
    "replicates": BOOTSTRAP_REPLICATES,
    "seed": BOOTSTRAP_SEED,
    "confidence_level": CONFIDENCE_LEVEL,
    "same_indices_all_months": True,
    "same_indices_both_scenarios": True,
    "independent_resampling_between_components": True,
    "pointwise_interval": (
        "Percentile bootstrap interval"
    ),
    "simultaneous_interval": (
        "Max standardized bootstrap-deviation band"
    ),
    "inference_scope": INFERENCE_SCOPE,
}

CONFIG_AMENDED[
    "ae2"
][
    "emergence"
] = {
    "primary_evidence_mode": (
        PRIMARY_EVIDENCE_MODE
    ),
    "confirmatory_evidence_mode": (
        CONFIRMATORY_EVIDENCE_MODE
    ),
    "effect_thresholds_pp": (
        EFFECT_THRESHOLDS_PP
    ),
    "persistence_months": (
        PERSISTENCE_MONTHS
    ),
    "default_effect_threshold_pp": (
        DEFAULT_EFFECT_THRESHOLD_PP
    ),
    "default_persistence_months": (
        DEFAULT_PERSISTENCE_MONTHS
    ),
    "magnitude_and_direction_reported_separately": True,
    "expected_direction": EXPECTED_DIRECTION,
}

CONFIG = CONFIG_AMENDED


# ============================================================
# 8. TRAJECTORY BOOTSTRAP
# ============================================================

monthly_bootstrap_records: list[
    dict[str, Any]
] = []

critical_value_records: list[
    dict[str, Any]
] = []

bootstrap_arrays: dict[
    tuple[str, str],
    np.ndarray,
] = {}

observed_arrays: dict[
    tuple[str, str],
    np.ndarray,
] = {}

standard_error_arrays: dict[
    tuple[str, str],
    np.ndarray,
] = {}

component_seed_map = {
    component: int(
        BOOTSTRAP_SEED
        + component_index
        * 100_003
    )
    for component_index, component
    in enumerate(
        COMPONENT_ORDER
    )
}

for component in COMPONENT_ORDER:
    component_frame = paired_deltas[
        paired_deltas[
            "input_kind"
        ].eq(component)
    ].copy()

    horizon = int(
        EXPECTED_HORIZONS[
            component
        ]
    )

    point_indices_by_scenario: dict[
        str,
        pd.MultiIndex,
    ] = {}

    matrices: dict[
        str,
        np.ndarray,
    ] = {}

    lead_metadata: pd.DataFrame | None = None

    for scenario in SCENARIO_ORDER:
        scenario_frame = component_frame[
            component_frame[
                "scenario"
            ].eq(scenario)
        ].copy()

        pivot = scenario_frame.pivot(
            index=[
                "point_id",
                "series_id",
            ],
            columns="lead_months",
            values=(
                "delta_drought_rank_score_pp"
            ),
        )

        pivot = pivot.reindex(
            columns=list(
                range(1, 85)
            )
        )

        pivot = pivot.sort_index()

        if pivot.isna().any().any():
            raise RuntimeError(
                f"Incomplete bootstrap matrix for "
                f"{component} / {scenario}."
            )

        point_indices_by_scenario[
            scenario
        ] = pivot.index

        matrices[
            scenario
        ] = pivot.to_numpy(
            dtype=float
        )

        scenario_metadata = (
            scenario_frame.groupby(
                "lead_months",
                dropna=False,
            )
            .agg(
                target_date=(
                    "target_date",
                    "first",
                ),
                trustworthy_horizon_months=(
                    "trustworthy_horizon_months",
                    "first",
                ),
                AE1_gate_pass=(
                    "AE1_gate_pass",
                    "first",
                ),
            )
            .reindex(
                range(1, 85)
            )
            .reset_index()
        )

        if lead_metadata is None:
            lead_metadata = (
                scenario_metadata
            )
        else:
            metadata_check = (
                lead_metadata.merge(
                    scenario_metadata,
                    on="lead_months",
                    suffixes=(
                        "_reference",
                        "_scenario",
                    ),
                    validate="one_to_one",
                )
            )

            if not (
                pd.to_datetime(
                    metadata_check[
                        "target_date_reference"
                    ]
                )
                == pd.to_datetime(
                    metadata_check[
                        "target_date_scenario"
                    ]
                )
            ).all():
                raise RuntimeError(
                    "Scenario target-date metadata differ."
                )

    if not (
        point_indices_by_scenario[
            "Favorable"
        ].equals(
            point_indices_by_scenario[
                "Unfavorable"
            ]
        )
    ):
        raise RuntimeError(
            f"Point order differs between scenarios for {component}."
        )

    point_index = (
        point_indices_by_scenario[
            "Favorable"
        ]
    )

    n_points = len(
        point_index
    )

    rng = np.random.default_rng(
        component_seed_map[
            component
        ]
    )

    sampled_indices = rng.integers(
        low=0,
        high=n_points,
        size=(
            BOOTSTRAP_REPLICATES,
            n_points,
        ),
        endpoint=False,
    )

    scenario_standardized_errors: dict[
        str,
        np.ndarray,
    ] = {}

    for scenario in SCENARIO_ORDER:
        matrix = matrices[
            scenario
        ]

        observed = matrix.mean(
            axis=0
        )

        bootstrap_estimates = (
            bootstrap_trajectory_means(
                matrix=matrix,
                sampled_indices=(
                    sampled_indices
                ),
                chunk_size=(
                    BOOTSTRAP_CHUNK_SIZE
                ),
            )
        )

        bootstrap_standard_error = (
            bootstrap_estimates.std(
                axis=0,
                ddof=1,
            )
        )

        pointwise_lower = (
            linear_quantile(
                bootstrap_estimates,
                LOWER_QUANTILE,
                axis=0,
            )
        )

        pointwise_upper = (
            linear_quantile(
                bootstrap_estimates,
                UPPER_QUANTILE,
                axis=0,
            )
        )

        standardized_errors = (
            standardized_bootstrap_error(
                bootstrap_estimates=(
                    bootstrap_estimates
                ),
                observed_estimates=(
                    observed
                ),
                bootstrap_standard_error=(
                    bootstrap_standard_error
                ),
            )
        )

        within_horizon_indices = (
            np.arange(84)
            < horizon
        )

        scenario_max_statistics = (
            standardized_errors[
                :,
                within_horizon_indices,
            ].max(
                axis=1
            )
        )

        scenario_critical_value = float(
            linear_quantile(
                scenario_max_statistics,
                CONFIDENCE_LEVEL,
            )
        )

        scenario_lower = (
            observed
            - scenario_critical_value
            * bootstrap_standard_error
        )

        scenario_upper = (
            observed
            + scenario_critical_value
            * bootstrap_standard_error
        )

        bootstrap_arrays[
            (
                component,
                scenario,
            )
        ] = bootstrap_estimates

        observed_arrays[
            (
                component,
                scenario,
            )
        ] = observed

        standard_error_arrays[
            (
                component,
                scenario,
            )
        ] = bootstrap_standard_error

        scenario_standardized_errors[
            scenario
        ] = standardized_errors

        critical_value_records.append(
            {
                "input_kind": component,
                "scope": "scenario_within_component",
                "scenario": scenario,
                "Rk_months": horizon,
                "critical_value": (
                    scenario_critical_value
                ),
                "confidence_level": (
                    CONFIDENCE_LEVEL
                ),
                "method": (
                    "max_standardized_bootstrap_deviation"
                ),
                "n_bootstrap": (
                    BOOTSTRAP_REPLICATES
                ),
                "n_months_in_family": horizon,
                "n_scenarios_in_family": 1,
            }
        )

        assert lead_metadata is not None

        for month_index in range(84):
            lead = month_index + 1

            boot_month = (
                bootstrap_estimates[
                    :,
                    month_index,
                ]
            )

            observed_value = float(
                observed[
                    month_index
                ]
            )

            same_sign_probability = float(
                np.mean(
                    np.sign(
                        boot_month
                    )
                    == np.sign(
                        observed_value
                    )
                )
            )

            monthly_bootstrap_records.append(
                {
                    "input_kind": component,
                    "scenario": scenario,
                    "lead_months": lead,
                    "target_date": (
                        pd.Timestamp(
                            lead_metadata.loc[
                                month_index,
                                "target_date",
                            ]
                        )
                    ),
                    "trustworthy_horizon_months": horizon,
                    "within_AE1_horizon": bool(
                        lead <= horizon
                    ),
                    "n_control_points": int(
                        n_points
                    ),
                    "component_bootstrap_seed": int(
                        component_seed_map[
                            component
                        ]
                    ),
                    "n_bootstrap": int(
                        BOOTSTRAP_REPLICATES
                    ),

                    "delta_rank_score_pp": (
                        observed_value
                    ),
                    "bootstrap_mean_pp": float(
                        np.mean(
                            boot_month
                        )
                    ),
                    "bootstrap_bias_pp": float(
                        np.mean(
                            boot_month
                        )
                        - observed_value
                    ),
                    "bootstrap_se_pp": float(
                        bootstrap_standard_error[
                            month_index
                        ]
                    ),

                    "pointwise_ci_lower_pp": float(
                        pointwise_lower[
                            month_index
                        ]
                    ),
                    "pointwise_ci_upper_pp": float(
                        pointwise_upper[
                            month_index
                        ]
                    ),

                    "scenario_simultaneous_lower_pp": float(
                        scenario_lower[
                            month_index
                        ]
                    ),
                    "scenario_simultaneous_upper_pp": float(
                        scenario_upper[
                            month_index
                        ]
                    ),

                    "bootstrap_fraction_positive": float(
                        np.mean(
                            boot_month > 0
                        )
                    ),
                    "bootstrap_fraction_negative": float(
                        np.mean(
                            boot_month < 0
                        )
                    ),
                    "bootstrap_fraction_zero": float(
                        np.mean(
                            np.isclose(
                                boot_month,
                                0.0,
                                atol=(
                                    NUMERICAL_ATOL
                                ),
                                rtol=0.0,
                            )
                        )
                    ),
                    "bootstrap_fraction_same_sign_as_estimate": (
                        same_sign_probability
                    ),

                    "inference_scope": (
                        INFERENCE_SCOPE
                    ),
                }
            )

    joint_max_statistics = np.maximum(
        scenario_standardized_errors[
            "Favorable"
        ][
            :,
            :horizon,
        ].max(
            axis=1
        ),
        scenario_standardized_errors[
            "Unfavorable"
        ][
            :,
            :horizon,
        ].max(
            axis=1
        ),
    )

    joint_critical_value = float(
        linear_quantile(
            joint_max_statistics,
            CONFIDENCE_LEVEL,
        )
    )

    critical_value_records.append(
        {
            "input_kind": component,
            "scope": (
                "joint_scenarios_within_component"
            ),
            "scenario": (
                "Favorable_and_Unfavorable"
            ),
            "Rk_months": horizon,
            "critical_value": (
                joint_critical_value
            ),
            "confidence_level": (
                CONFIDENCE_LEVEL
            ),
            "method": (
                "joint_max_standardized_bootstrap_deviation"
            ),
            "n_bootstrap": (
                BOOTSTRAP_REPLICATES
            ),
            "n_months_in_family": horizon,
            "n_scenarios_in_family": 2,
        }
    )

    for record in monthly_bootstrap_records:
        if (
            record["input_kind"]
            != component
        ):
            continue

        scenario = str(
            record["scenario"]
        )

        month_index = (
            int(
                record[
                    "lead_months"
                ]
            )
            - 1
        )

        observed = observed_arrays[
            (
                component,
                scenario,
            )
        ][month_index]

        standard_error = (
            standard_error_arrays[
                (
                    component,
                    scenario,
                )
            ][month_index]
        )

        record[
            "joint_component_simultaneous_lower_pp"
        ] = float(
            observed
            - joint_critical_value
            * standard_error
        )

        record[
            "joint_component_simultaneous_upper_pp"
        ] = float(
            observed
            + joint_critical_value
            * standard_error
        )


AE2_BOOTSTRAP_MONTHLY = pd.DataFrame(
    monthly_bootstrap_records
)

AE2_BOOTSTRAP_CRITICAL_VALUES = (
    pd.DataFrame(
        critical_value_records
    )
)


# ============================================================
# 9. BOOTSTRAP VALIDATION AND EVIDENCE FLAGS
# ============================================================

AE2_BOOTSTRAP_MONTHLY[
    "pointwise_excludes_zero"
] = (
    (
        AE2_BOOTSTRAP_MONTHLY[
            "pointwise_ci_lower_pp"
        ]
        > 0
    )
    |
    (
        AE2_BOOTSTRAP_MONTHLY[
            "pointwise_ci_upper_pp"
        ]
        < 0
    )
)

AE2_BOOTSTRAP_MONTHLY[
    "scenario_simultaneous_excludes_zero"
] = (
    (
        AE2_BOOTSTRAP_MONTHLY[
            "scenario_simultaneous_lower_pp"
        ]
        > 0
    )
    |
    (
        AE2_BOOTSTRAP_MONTHLY[
            "scenario_simultaneous_upper_pp"
        ]
        < 0
    )
)

AE2_BOOTSTRAP_MONTHLY[
    "joint_component_simultaneous_excludes_zero"
] = (
    (
        AE2_BOOTSTRAP_MONTHLY[
            "joint_component_simultaneous_lower_pp"
        ]
        > 0
    )
    |
    (
        AE2_BOOTSTRAP_MONTHLY[
            "joint_component_simultaneous_upper_pp"
        ]
        < 0
    )
)

AE2_BOOTSTRAP_MONTHLY[
    "direction_consistent"
] = np.where(
    AE2_BOOTSTRAP_MONTHLY[
        "scenario"
    ].eq("Favorable"),
    AE2_BOOTSTRAP_MONTHLY[
        "delta_rank_score_pp"
    ] < 0,
    AE2_BOOTSTRAP_MONTHLY[
        "delta_rank_score_pp"
    ] > 0,
)

AE2_BOOTSTRAP_MONTHLY[
    "direction_neutral"
] = np.isclose(
    AE2_BOOTSTRAP_MONTHLY[
        "delta_rank_score_pp"
    ],
    0.0,
    atol=NUMERICAL_ATOL,
    rtol=0.0,
)

AE2_BOOTSTRAP_MONTHLY.loc[
    AE2_BOOTSTRAP_MONTHLY[
        "direction_neutral"
    ],
    "direction_consistent",
] = False

AE2_BOOTSTRAP_MONTHLY[
    "absolute_delta_rank_score_pp"
] = (
    AE2_BOOTSTRAP_MONTHLY[
        "delta_rank_score_pp"
    ].abs()
)

maximum_bootstrap_bias = float(
    AE2_BOOTSTRAP_MONTHLY[
        "bootstrap_bias_pp"
    ].abs().max()
)

central_check = (
    paired_deltas.groupby(
        [
            "input_kind",
            "scenario",
            "lead_months",
        ],
        dropna=False,
    )[
        "delta_drought_rank_score_pp"
    ]
    .mean()
    .reset_index(
        name="direct_mean_pp"
    )
)

central_check = central_check.merge(
    AE2_BOOTSTRAP_MONTHLY[
        [
            "input_kind",
            "scenario",
            "lead_months",
            "delta_rank_score_pp",
        ]
    ],
    on=[
        "input_kind",
        "scenario",
        "lead_months",
    ],
    how="inner",
    validate="one_to_one",
)

maximum_central_difference = float(
    (
        central_check[
            "direct_mean_pp"
        ]
        - central_check[
            "delta_rank_score_pp"
        ]
    )
    .abs()
    .max()
)

if (
    maximum_central_difference
    > 1e-10
):
    raise RuntimeError(
        "Bootstrap point estimates do not reproduce "
        "the direct point-level means."
    )


# ============================================================
# 10. BOOTSTRAP SUMMARY WITHIN AE1
# ============================================================

bootstrap_within_ae1 = (
    AE2_BOOTSTRAP_MONTHLY[
        AE2_BOOTSTRAP_MONTHLY[
            "within_AE1_horizon"
        ]
    ]
    .copy()
)

AE2_BOOTSTRAP_SUMMARY = (
    bootstrap_within_ae1.groupby(
        [
            "input_kind",
            "scenario",
        ],
        dropna=False,
    )
    .agg(
        Rk_months=(
            "trustworthy_horizon_months",
            "first",
        ),
        n_months=(
            "lead_months",
            "size",
        ),
        n_control_points=(
            "n_control_points",
            "first",
        ),

        mean_delta_rank_score_pp=(
            "delta_rank_score_pp",
            "mean",
        ),
        median_delta_rank_score_pp=(
            "delta_rank_score_pp",
            "median",
        ),
        minimum_delta_rank_score_pp=(
            "delta_rank_score_pp",
            "min",
        ),
        maximum_delta_rank_score_pp=(
            "delta_rank_score_pp",
            "max",
        ),
        maximum_abs_delta_rank_score_pp=(
            "absolute_delta_rank_score_pp",
            "max",
        ),

        mean_bootstrap_se_pp=(
            "bootstrap_se_pp",
            "mean",
        ),
        maximum_bootstrap_se_pp=(
            "bootstrap_se_pp",
            "max",
        ),

        n_pointwise_significant_months=(
            "pointwise_excludes_zero",
            "sum",
        ),
        n_scenario_simultaneous_significant_months=(
            "scenario_simultaneous_excludes_zero",
            "sum",
        ),
        n_joint_simultaneous_significant_months=(
            "joint_component_simultaneous_excludes_zero",
            "sum",
        ),

        pct_pointwise_significant_months=(
            "pointwise_excludes_zero",
            lambda values: float(
                100.0
                * values.mean()
            ),
        ),
        pct_joint_simultaneous_significant_months=(
            "joint_component_simultaneous_excludes_zero",
            lambda values: float(
                100.0
                * values.mean()
            ),
        ),

        pct_direction_consistent_months=(
            "direction_consistent",
            lambda values: float(
                100.0
                * values.mean()
            ),
        ),

        mean_bootstrap_same_sign_fraction=(
            "bootstrap_fraction_same_sign_as_estimate",
            "mean",
        ),
    )
    .reset_index()
)


# ============================================================
# 11. LEAVE-ONE-POINT-OUT INFLUENCE
# ============================================================

tie_metadata = (
    reference_diagnostic[
        [
            "input_kind",
            "point_id",
            "series_id",
            "maximum_tie_fraction",
            "n_unique_values",
            "reference_range",
        ]
    ]
    .drop_duplicates(
        subset=[
            "input_kind",
            "point_id",
            "series_id",
        ]
    )
)

loo_records: list[
    dict[str, Any]
] = []

for (
    component,
    scenario,
    lead,
), group in paired_deltas.groupby(
    [
        "input_kind",
        "scenario",
        "lead_months",
    ],
    dropna=False,
):
    group = group.sort_values(
        [
            "point_id",
            "series_id",
        ]
    )

    values = group[
        "delta_drought_rank_score_pp"
    ].to_numpy(dtype=float)

    n_points = len(
        values
    )

    if n_points <= 1:
        raise RuntimeError(
            "Leave-one-out analysis requires at least two points."
        )

    full_mean = float(
        values.mean()
    )

    leave_one_out_means = (
        (
            values.sum()
            - values
        )
        / (
            n_points
            - 1
        )
    )

    influence_change = (
        leave_one_out_means
        - full_mean
    )

    for row_position, row in enumerate(
        group.itertuples(
            index=False
        )
    ):
        loo_records.append(
            {
                "input_kind": component,
                "scenario": scenario,
                "lead_months": int(
                    lead
                ),
                "target_date": pd.Timestamp(
                    row.target_date
                ),
                "trustworthy_horizon_months": int(
                    row.trustworthy_horizon_months
                ),
                "within_AE1_horizon": bool(
                    row.AE1_gate_pass
                ),

                "point_id": str(
                    row.point_id
                ),
                "series_id": str(
                    row.series_id
                ),

                "n_control_points": int(
                    n_points
                ),
                "full_delta_rank_score_pp": (
                    full_mean
                ),
                "point_delta_rank_score_pp": float(
                    values[
                        row_position
                    ]
                ),
                "leave_one_out_delta_rank_score_pp": float(
                    leave_one_out_means[
                        row_position
                    ]
                ),
                "leave_one_out_change_pp": float(
                    influence_change[
                        row_position
                    ]
                ),
                "absolute_leave_one_out_change_pp": float(
                    abs(
                        influence_change[
                            row_position
                        ]
                    )
                ),
            }
        )

AE2_LEAVE_ONE_OUT = pd.DataFrame(
    loo_records
)

AE2_LEAVE_ONE_OUT = AE2_LEAVE_ONE_OUT.merge(
    tie_metadata,
    on=[
        "input_kind",
        "point_id",
        "series_id",
    ],
    how="left",
    validate="many_to_one",
)

if AE2_LEAVE_ONE_OUT[
    "maximum_tie_fraction"
].isna().any():
    raise RuntimeError(
        "Tie metadata could not be assigned to all points."
    )

monthly_max_indices = (
    AE2_LEAVE_ONE_OUT.groupby(
        [
            "input_kind",
            "scenario",
            "lead_months",
        ],
        dropna=False,
    )[
        "absolute_leave_one_out_change_pp"
    ]
    .idxmax()
)

AE2_MONTHLY_MAX_INFLUENCE = (
    AE2_LEAVE_ONE_OUT.loc[
        monthly_max_indices
    ]
    .sort_values(
        [
            "input_kind",
            "scenario",
            "lead_months",
        ]
    )
    .reset_index(drop=True)
)

AE2_MONTHLY_MAX_INFLUENCE = (
    AE2_MONTHLY_MAX_INFLUENCE.rename(
        columns={
            "point_id": (
                "most_influential_point_id"
            ),
            "series_id": (
                "most_influential_series_id"
            ),
            "point_delta_rank_score_pp": (
                "most_influential_point_delta_pp"
            ),
            "leave_one_out_delta_rank_score_pp": (
                "delta_without_most_influential_point_pp"
            ),
            "leave_one_out_change_pp": (
                "change_after_removing_most_influential_point_pp"
            ),
            "absolute_leave_one_out_change_pp": (
                "absolute_change_after_removal_pp"
            ),
            "maximum_tie_fraction": (
                "most_influential_point_maximum_tie_fraction"
            ),
            "n_unique_values": (
                "most_influential_point_n_unique_values"
            ),
            "reference_range": (
                "most_influential_point_reference_range"
            ),
        }
    )
)

most_influential_counts = (
    AE2_MONTHLY_MAX_INFLUENCE[
        AE2_MONTHLY_MAX_INFLUENCE[
            "within_AE1_horizon"
        ]
    ]
    .groupby(
        [
            "input_kind",
            "scenario",
            "most_influential_point_id",
            "most_influential_series_id",
        ],
        dropna=False,
    )
    .size()
    .reset_index(
        name=(
            "n_months_most_influential_within_AE1"
        )
    )
    .rename(
        columns={
            "most_influential_point_id": (
                "point_id"
            ),
            "most_influential_series_id": (
                "series_id"
            ),
        }
    )
)

AE2_POINT_INFLUENCE_SUMMARY = (
    AE2_LEAVE_ONE_OUT[
        AE2_LEAVE_ONE_OUT[
            "within_AE1_horizon"
        ]
    ]
    .groupby(
        [
            "input_kind",
            "scenario",
            "point_id",
            "series_id",
        ],
        dropna=False,
    )
    .agg(
        n_months=(
            "lead_months",
            "size",
        ),
        mean_signed_leave_one_out_change_pp=(
            "leave_one_out_change_pp",
            "mean",
        ),
        mean_absolute_leave_one_out_change_pp=(
            "absolute_leave_one_out_change_pp",
            "mean",
        ),
        maximum_absolute_leave_one_out_change_pp=(
            "absolute_leave_one_out_change_pp",
            "max",
        ),
        maximum_tie_fraction=(
            "maximum_tie_fraction",
            "first",
        ),
        n_unique_values=(
            "n_unique_values",
            "first",
        ),
        reference_range=(
            "reference_range",
            "first",
        ),
    )
    .reset_index()
)

AE2_POINT_INFLUENCE_SUMMARY = (
    AE2_POINT_INFLUENCE_SUMMARY.merge(
        most_influential_counts,
        on=[
            "input_kind",
            "scenario",
            "point_id",
            "series_id",
        ],
        how="left",
        validate="one_to_one",
    )
)

AE2_POINT_INFLUENCE_SUMMARY[
    "n_months_most_influential_within_AE1"
] = (
    AE2_POINT_INFLUENCE_SUMMARY[
        "n_months_most_influential_within_AE1"
    ]
    .fillna(0)
    .astype(int)
)


# ============================================================
# 12. TIE–INFLUENCE ASSOCIATION
# ============================================================

tie_influence_records: list[
    dict[str, Any]
] = []

for (
    component,
    scenario,
), group in AE2_POINT_INFLUENCE_SUMMARY.groupby(
    [
        "input_kind",
        "scenario",
    ],
    dropna=False,
):
    tie_influence_records.append(
        {
            "input_kind": component,
            "scenario": scenario,
            "n_control_points": int(
                len(group)
            ),

            "pearson_tie_fraction_vs_max_influence": (
                safe_correlation(
                    group[
                        "maximum_tie_fraction"
                    ],
                    group[
                        "maximum_absolute_leave_one_out_change_pp"
                    ],
                    method="pearson",
                )
            ),

            "spearman_tie_fraction_vs_max_influence": (
                safe_correlation(
                    group[
                        "maximum_tie_fraction"
                    ],
                    group[
                        "maximum_absolute_leave_one_out_change_pp"
                    ],
                    method="spearman",
                )
            ),

            "pearson_unique_values_vs_max_influence": (
                safe_correlation(
                    group[
                        "n_unique_values"
                    ],
                    group[
                        "maximum_absolute_leave_one_out_change_pp"
                    ],
                    method="pearson",
                )
            ),

            "spearman_unique_values_vs_max_influence": (
                safe_correlation(
                    group[
                        "n_unique_values"
                    ],
                    group[
                        "maximum_absolute_leave_one_out_change_pp"
                    ],
                    method="spearman",
                )
            ),

            "maximum_point_influence_pp": float(
                group[
                    "maximum_absolute_leave_one_out_change_pp"
                ].max()
            ),

            "median_maximum_point_influence_pp": float(
                group[
                    "maximum_absolute_leave_one_out_change_pp"
                ].median()
            ),
        }
    )

AE2_TIE_INFLUENCE_ASSOCIATION = (
    pd.DataFrame(
        tie_influence_records
    )
)


# ============================================================
# 13. PEAK-MONTH INFLUENCE DIAGNOSTIC
# ============================================================

peak_records: list[
    dict[str, Any]
] = []

for (
    component,
    scenario,
), group in bootstrap_within_ae1.groupby(
    [
        "input_kind",
        "scenario",
    ],
    dropna=False,
):
    peak_index = (
        group[
            "absolute_delta_rank_score_pp"
        ]
        .idxmax()
    )

    peak_row = group.loc[
        peak_index
    ]

    influence_row = (
        AE2_MONTHLY_MAX_INFLUENCE[
            (
                AE2_MONTHLY_MAX_INFLUENCE[
                    "input_kind"
                ].eq(component)
            )
            &
            (
                AE2_MONTHLY_MAX_INFLUENCE[
                    "scenario"
                ].eq(scenario)
            )
            &
            (
                AE2_MONTHLY_MAX_INFLUENCE[
                    "lead_months"
                ].eq(
                    int(
                        peak_row[
                            "lead_months"
                        ]
                    )
                )
            )
        ]
    )

    if len(influence_row) != 1:
        raise RuntimeError(
            "Peak influence row could not be identified uniquely."
        )

    influence_row = influence_row.iloc[0]

    full_delta = float(
        peak_row[
            "delta_rank_score_pp"
        ]
    )

    delta_without_point = float(
        influence_row[
            "delta_without_most_influential_point_pp"
        ]
    )

    absolute_change = float(
        influence_row[
            "absolute_change_after_removal_pp"
        ]
    )

    relative_change = (
        absolute_change
        / abs(full_delta)
        if abs(full_delta)
        > NUMERICAL_ATOL
        else np.nan
    )

    peak_records.append(
        {
            "input_kind": component,
            "scenario": scenario,
            "lead_months": int(
                peak_row[
                    "lead_months"
                ]
            ),
            "target_date": pd.Timestamp(
                peak_row[
                    "target_date"
                ]
            ),
            "full_delta_rank_score_pp": (
                full_delta
            ),
            "pointwise_ci_lower_pp": float(
                peak_row[
                    "pointwise_ci_lower_pp"
                ]
            ),
            "pointwise_ci_upper_pp": float(
                peak_row[
                    "pointwise_ci_upper_pp"
                ]
            ),
            "joint_simultaneous_lower_pp": float(
                peak_row[
                    "joint_component_simultaneous_lower_pp"
                ]
            ),
            "joint_simultaneous_upper_pp": float(
                peak_row[
                    "joint_component_simultaneous_upper_pp"
                ]
            ),

            "most_influential_point_id": (
                influence_row[
                    "most_influential_point_id"
                ]
            ),
            "most_influential_series_id": (
                influence_row[
                    "most_influential_series_id"
                ]
            ),

            "delta_without_most_influential_point_pp": (
                delta_without_point
            ),
            "absolute_change_after_removal_pp": (
                absolute_change
            ),
            "relative_absolute_change_after_removal": (
                relative_change
            ),
            "sign_changes_after_removal": bool(
                np.sign(
                    full_delta
                )
                != np.sign(
                    delta_without_point
                )
            ),

            "most_influential_point_maximum_tie_fraction": float(
                influence_row[
                    "most_influential_point_maximum_tie_fraction"
                ]
            ),
            "most_influential_point_n_unique_values": int(
                influence_row[
                    "most_influential_point_n_unique_values"
                ]
            ),
            "most_influential_point_reference_range": float(
                influence_row[
                    "most_influential_point_reference_range"
                ]
            ),
        }
    )

AE2_PEAK_INFLUENCE = pd.DataFrame(
    peak_records
)


# ============================================================
# 14. MONTHLY DEFAULT EMERGENCE CONDITIONS
# ============================================================

AE2_DEFAULT_MONTHLY_GATE = (
    bootstrap_within_ae1.copy()
)

AE2_DEFAULT_MONTHLY_GATE[
    "default_magnitude_pass"
] = (
    AE2_DEFAULT_MONTHLY_GATE[
        "absolute_delta_rank_score_pp"
    ]
    >= DEFAULT_EFFECT_THRESHOLD_PP
)

AE2_DEFAULT_MONTHLY_GATE[
    "pointwise_magnitude_candidate"
] = (
    AE2_DEFAULT_MONTHLY_GATE[
        "pointwise_excludes_zero"
    ]
    & AE2_DEFAULT_MONTHLY_GATE[
        "default_magnitude_pass"
    ]
)

AE2_DEFAULT_MONTHLY_GATE[
    "pointwise_directional_candidate"
] = (
    AE2_DEFAULT_MONTHLY_GATE[
        "pointwise_magnitude_candidate"
    ]
    & AE2_DEFAULT_MONTHLY_GATE[
        "direction_consistent"
    ]
)

AE2_DEFAULT_MONTHLY_GATE[
    "joint_magnitude_candidate"
] = (
    AE2_DEFAULT_MONTHLY_GATE[
        "joint_component_simultaneous_excludes_zero"
    ]
    & AE2_DEFAULT_MONTHLY_GATE[
        "default_magnitude_pass"
    ]
)

AE2_DEFAULT_MONTHLY_GATE[
    "joint_directional_candidate"
] = (
    AE2_DEFAULT_MONTHLY_GATE[
        "joint_magnitude_candidate"
    ]
    & AE2_DEFAULT_MONTHLY_GATE[
        "direction_consistent"
    ]
)

for (
    component,
    scenario,
), group in AE2_DEFAULT_MONTHLY_GATE.groupby(
    [
        "input_kind",
        "scenario",
    ],
    dropna=False,
):
    group_indices = (
        group.index.to_numpy()
    )

    leads = group[
        "lead_months"
    ].to_numpy(dtype=int)

    condition_columns = {
        "pointwise_magnitude": (
            "pointwise_magnitude_candidate"
        ),
        "pointwise_directional": (
            "pointwise_directional_candidate"
        ),
        "joint_magnitude": (
            "joint_magnitude_candidate"
        ),
        "joint_directional": (
            "joint_directional_candidate"
        ),
    }

    for prefix, column in (
        condition_columns.items()
    ):
        membership, run_ids = (
            qualifying_run_membership(
                mask=group[
                    column
                ].to_numpy(dtype=bool),
                leads=leads,
                minimum_run_length=(
                    DEFAULT_PERSISTENCE_MONTHS
                ),
            )
        )

        AE2_DEFAULT_MONTHLY_GATE.loc[
            group_indices,
            f"{prefix}_qualifying_run_member",
        ] = membership

        AE2_DEFAULT_MONTHLY_GATE.loc[
            group_indices,
            f"{prefix}_qualifying_run_id",
        ] = run_ids

run_id_columns = [
    column
    for column
    in AE2_DEFAULT_MONTHLY_GATE.columns
    if column.endswith(
        "_qualifying_run_id"
    )
]

for column in run_id_columns:
    AE2_DEFAULT_MONTHLY_GATE[
        column
    ] = (
        AE2_DEFAULT_MONTHLY_GATE[
            column
        ]
        .fillna(0)
        .astype(int)
    )


# ============================================================
# 15. EMERGENCE SENSITIVITY
# ============================================================

emergence_records: list[
    dict[str, Any]
] = []

for (
    component,
    scenario,
), group in bootstrap_within_ae1.groupby(
    [
        "input_kind",
        "scenario",
    ],
    dropna=False,
):
    group = group.sort_values(
        "lead_months"
    )

    leads = group[
        "lead_months"
    ].to_numpy(dtype=int)

    dates = group[
        "target_date"
    ].to_numpy()

    observed_delta = group[
        "delta_rank_score_pp"
    ].to_numpy(dtype=float)

    direction_consistent = group[
        "direction_consistent"
    ].to_numpy(dtype=bool)

    pointwise_statistical = group[
        "pointwise_excludes_zero"
    ].to_numpy(dtype=bool)

    joint_statistical = group[
        "joint_component_simultaneous_excludes_zero"
    ].to_numpy(dtype=bool)

    for threshold_pp in (
        EFFECT_THRESHOLDS_PP
    ):
        magnitude = (
            np.abs(
                observed_delta
            )
            >= threshold_pp
        )

        for persistence in (
            PERSISTENCE_MONTHS
        ):
            masks = {
                "pointwise_magnitude": (
                    pointwise_statistical
                    & magnitude
                ),
                "pointwise_directional": (
                    pointwise_statistical
                    & magnitude
                    & direction_consistent
                ),
                "joint_magnitude": (
                    joint_statistical
                    & magnitude
                ),
                "joint_directional": (
                    joint_statistical
                    & magnitude
                    & direction_consistent
                ),
            }

            record: dict[str, Any] = {
                "input_kind": component,
                "scenario": scenario,
                "Rk_months": int(
                    EXPECTED_HORIZONS[
                        component
                    ]
                ),
                "n_control_points": int(
                    group[
                        "n_control_points"
                    ].iloc[0]
                ),
                "effect_threshold_pp": float(
                    threshold_pp
                ),
                "persistence_months": int(
                    persistence
                ),
                "expected_direction": (
                    EXPECTED_DIRECTION[
                        scenario
                    ]
                ),
                "primary_evidence_mode": (
                    PRIMARY_EVIDENCE_MODE
                ),
                "confirmatory_evidence_mode": (
                    CONFIRMATORY_EVIDENCE_MODE
                ),
            }

            for prefix, mask in masks.items():
                stats = run_statistics(
                    mask=mask,
                    leads=leads,
                    dates=dates,
                    minimum_run_length=(
                        persistence
                    ),
                )

                for key, value in stats.items():
                    record[
                        f"{prefix}_{key}"
                    ] = value

            emergence_records.append(
                record
            )

AE2_EMERGENCE_SENSITIVITY = (
    pd.DataFrame(
        emergence_records
    )
)

AE2_DEFAULT_EMERGENCE_SUMMARY = (
    AE2_EMERGENCE_SENSITIVITY[
        np.isclose(
            AE2_EMERGENCE_SENSITIVITY[
                "effect_threshold_pp"
            ],
            DEFAULT_EFFECT_THRESHOLD_PP,
        )
        &
        (
            AE2_EMERGENCE_SENSITIVITY[
                "persistence_months"
            ]
            == DEFAULT_PERSISTENCE_MONTHS
        )
    ]
    .copy()
    .reset_index(drop=True)
)


# ============================================================
# 16. OUTPUT PATHS
# ============================================================

CONFIG_PATH = (
    Path(PATHS["provenance"])
    / "canonical_configuration_amended_cell03.json"
)

SCOPE_PATH = (
    Path(PATHS["provenance"])
    / "analysis_scope_amendment_cell03.json"
)

BOOTSTRAP_MONTHLY_PATH = (
    INFERENCE_DIR
