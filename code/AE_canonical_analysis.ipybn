FIGURE_CAPTIONS = {
    "Figure 3": (
        "Inherited AE1 trustworthy forecast horizons for Aquifer, "
        "Reservoir, and River. Coloured segments identify the fixed "
        "component-specific reliability domains used as external gates "
        "in the present analysis; grey segments lie beyond those horizons. "
        "The AE1 horizons are inherited from the previously validated "
        "multi-horizon forecasting analysis and are not re-estimated here."
    ),

    "Figure 4": (
        "Forecast-relative scenario separation (AE2) expressed as the "
        "difference in seasonally adjusted drought-rank score between each "
        "non-Base scenario and Base. Solid lines show monthly central "
        "effects, shaded regions show 95% pointwise bootstrap intervals, "
        "and dashed lines show 95% joint component-wise simultaneous bands. "
        "Circles identify months whose pointwise intervals exclude zero; "
        "diamonds identify months whose joint bands exclude zero. Vertical "
        "dashed lines delimit the inherited AE1 horizons, and grey regions "
        "show months outside the reliability domain. Positive values denote "
        "greater forecast-relative drought pressure."
    ),

    "Figure 5": (
        "Cross-validated scenario-conditioning value (AE3) after "
        "propagating discrete policy-selection uncertainty through the "
        "policy-reselection bootstrap. Positive values indicate lower "
        "held-out loss under the scenario-conditioned policy than under "
        "the Base-conditioned policy. Shaded regions show 95% pointwise "
        "bootstrap intervals and dashed lines show 95% joint component-wise "
        "simultaneous bands. Filled circles identify months with a positive "
        "pointwise lower bound. No month retains a positive joint lower "
        "bound. Grey regions lie outside the inherited AE1 horizons."
    ),

    "Figure 6": (
        "Integrated Actionable Emergence synthesis. Panel (a) summarises "
        "the hierarchical AE1, AE2, and AE3 evidence by component and "
        "scenario. Exploratory evidence is based on pointwise AE3 inference, "
        "whereas confirmatory evidence requires a positive joint "
        "simultaneous AE3 lower bound after policy reselection. Panel (b) "
        "shows the persistent full-AE windows that survive a three-month "
        "persistence requirement. Reservoir retains recurrent exploratory "
        "summer windows in 2025 and 2026; directional consistency is present "
        "under Unfavorable but not under Favorable. No family-wise "
        "confirmatory full-AE window survives."
    ),

    "Figure 7": (
        "Sensitivity of AE2 emergence to the practical effect threshold "
        "and persistence requirement. Panel (a) applies the magnitude "
        "criterion and panel (b) additionally requires the prespecified "
        "scenario-consistent direction. Cells report the longest qualifying "
        "run in months for each combination of effect threshold and "
        "persistence requirement. Zero denotes no qualifying run."
    ),
}


