    "AE2_INFERENCE_COMPLETED",
]

missing_objects = [
    name
    for name in REQUIRED_OBJECTS
    if name not in globals()
]

if missing_objects:
    raise RuntimeError(
        "Cells 00–03 must be executed before Cell 04. "
        f"Missing objects: {missing_objects}"
    )

if not bool(AE2_PREPARATION_COMPLETED):
    raise RuntimeError(
        "The canonical AE2 preparation was not completed."
    )

if not bool(AE2_INFERENCE_COMPLETED):
    raise RuntimeError(
        "The AE2 bootstrap inference was not completed."
    )


