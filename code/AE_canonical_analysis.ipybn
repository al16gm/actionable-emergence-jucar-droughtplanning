# ============================================================
# CELL 03 — AE2 TRAJECTORY BOOTSTRAP, INFLUENCE, AND EMERGENCE
#
# Purpose
# -------
# Perform the inferential stage of AE2 using the canonical
# point-level drought-rank differences generated in Cell 02.
#
# Main outputs
# ------------
# 1. Pointwise percentile bootstrap confidence intervals.
# 2. Scenario-wise simultaneous bands.
# 3. Joint component-wise simultaneous bands across:
#       - all months within the inherited AE1 horizon;
#       - Favorable and Unfavorable simultaneously.
# 4. Leave-one-control-point-out influence diagnostics.
# 5. Persistent-emergence sensitivity for:
#       delta = 0.5, 1.0, 1.5 rank-score percentage points
#       r     = 1, 3, 6 consecutive months
# 6. Separate magnitude-based and direction-consistent emergence.
#
# Bootstrap design
# ----------------
# - Resampling unit: complete control-point trajectory.
# - The same sampled point indices are used for:
#       * all monthly leads;
#       * Favorable and Unfavorable.
# - Resampling is independent between hydrological components.
#
# Inferential scope
# -----------------
# Confidence intervals quantify variation under spatial resampling
# of the available control-point trajectories.
#
# They do NOT quantify:
# - forecast-model predictive uncertainty;
# - hindcast residual uncertainty;
# - climate-ensemble uncertainty;
# - temporal sampling uncertainty;
# - observation error.
# ============================================================

from __future__ import annotations

import copy
import hashlib
import json
import shutil
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

import numpy as np
import pandas as pd


# ============================================================
# 1. REQUIRE CELLS 00–02
# ============================================================

REQUIRED_OBJECTS = [
    "PATHS",
    "RUN_CONTEXT",
    "MANIFEST_PATH",
    "CONFIG",
    "FORECAST_SHA256",
    "AE2_PREPARATION_COMPLETED",
]

missing_objects = [
    name
    for name in REQUIRED_OBJECTS
    if name not in globals()
]

if missing_objects:
    raise RuntimeError(
        "Cells 00, 01, and 02 must be executed before Cell 03. "
        f"Missing objects: {missing_objects}"
    )

if not bool(AE2_PREPARATION_COMPLETED):
    raise RuntimeError(
        "Cell 02 did not finish successfully."
    )


