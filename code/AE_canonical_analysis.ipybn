# ============================================================
# 6. HELPERS
# ============================================================

def utc_now_iso() -> str:
    """Return the current UTC timestamp."""
    return datetime.now(
        timezone.utc
    ).isoformat(timespec="seconds")


def display_frame(
    frame: pd.DataFrame,
    n: int = 50,
) -> None:
    """Display a DataFrame with a plain-text fallback."""
    try:
        display(
            frame.head(n)
        )
    except NameError:
        print(
            frame.head(n).to_string(
                index=False
            )
        )


def sha256_json(
    payload: dict[str, Any],
) -> str:
    """Return a deterministic SHA-256 hash."""
    serialized = json.dumps(
        payload,
        sort_keys=True,
        ensure_ascii=False,
        separators=(",", ":"),
        default=str,
    ).encode("utf-8")

    return hashlib.sha256(
        serialized
    ).hexdigest()


def sha256_file(
    path: Path,
    chunk_size: int = 1024 * 1024,
) -> str:
    """Return a file SHA-256 hash."""
    digest = hashlib.sha256()

    with path.open(
        "rb",
    ) as handle:
        while True:
            chunk = handle.read(
                chunk_size
            )

            if not chunk:
                break

            digest.update(
                chunk
            )

    return digest.hexdigest()


def update_json_file(
    path: Path,
    updates: dict[str, Any],
) -> None:
    """Update a JSON file while preserving existing fields."""
    if path.exists():
        with path.open(
            "r",
            encoding="utf-8",
        ) as handle:
            payload = json.load(
                handle
            )
    else:
        payload = {}

    payload.update(
        updates
    )

    with path.open(
        "w",
        encoding="utf-8",
    ) as handle:
        json.dump(
            payload,
            handle,
            ensure_ascii=False,
            indent=2,
            sort_keys=True,
            default=str,
        )


def coerce_boolean(
    values: pd.Series,
) -> pd.Series:
    """Normalize Boolean-like columns."""
    if pd.api.types.is_bool_dtype(
        values
    ):
        return values.astype(bool)

    mapping = {
        "true": True,
        "false": False,
        "1": True,
        "0": False,
    }

    normalized = (
        values.astype(str)
        .str.strip()
        .str.lower()
        .map(mapping)
    )

    if normalized.isna().any():
        raise ValueError(
            "Could not convert all values to Boolean."
        )

    return normalized.astype(bool)


def linear_quantile(
    values: np.ndarray,
    quantile: float,
    axis: int | None = None,
) -> np.ndarray | float:
    """Calculate reproducible linear quantiles."""
    try:
        return np.quantile(
            values,
            quantile,
            axis=axis,
            method="linear",
        )
    except TypeError:
        return np.quantile(
            values,
            quantile,
            axis=axis,
            interpolation="linear",
        )


def decision_loss_cube(
    drought_scores: np.ndarray,
    actions: np.ndarray,
    drought_score_threshold: float,
    action_effectiveness: float,
    action_cost_ratio: float,
) -> np.ndarray:
    """
    Calculate losses with shape:
        n_points × n_months × n_actions.
    """
    scores = np.asarray(
        drought_scores,
        dtype=float,
    )

    actions = np.asarray(
        actions,
        dtype=float,
    )

    if scores.ndim != 2:
        raise ValueError(
            "Drought-score input must be a two-dimensional matrix."
        )

    residual_pressure = np.maximum(
        0.0,
        scores[:, :, np.newaxis]
        - drought_score_threshold
        - action_effectiveness
        * actions[
            np.newaxis,
            np.newaxis,
            :,
        ],
    )

    drought_loss = (
        residual_pressure**2
    )

    action_loss = (
        action_cost_ratio
        * actions[
            np.newaxis,
            np.newaxis,
            :,
        ] ** 2
    )

    return (
        drought_loss
        + action_loss
    )


def actions_to_indices(
    action_matrix: np.ndarray,
    allowed_actions: np.ndarray,
) -> np.ndarray:
    """Map action values to their configured integer indices."""
    values = np.asarray(
        action_matrix,
        dtype=float,
    )

    output = np.full(
        values.shape,
        -1,
        dtype=np.int16,
    )

    for action_index, action_value in enumerate(
        allowed_actions
    ):
        match = np.isclose(
            values,
            action_value,
            atol=NUMERICAL_ATOL,
            rtol=0.0,
        )

        output[
            match
        ] = action_index

    if np.any(
        output < 0
    ):
        invalid_values = np.unique(
            values[
                output < 0
            ]
        )

        raise ValueError(
            "Observed actions could not be mapped to configured "
            f"levels: {invalid_values}"
        )

    return output


def generate_valid_multinomial_weights(
    rng: np.random.Generator,
    n_bootstrap: int,
    n_points: int,
) -> np.ndarray:
    """
    Generate multinomial point weights.

    Replicates containing only one unique sampled point are
    resampled because leave-one-point-out policy selection would
    otherwise have zero training mass.
    """
    probabilities = np.full(
        n_points,
        1.0 / n_points,
        dtype=float,
    )

    weights = rng.multinomial(
        n=n_points,
        pvals=probabilities,
        size=n_bootstrap,
    ).astype(
        np.int16
    )

    invalid = (
        np.count_nonzero(
            weights,
            axis=1,
        )
        < 2
    )

    while invalid.any():
        n_invalid = int(
            invalid.sum()
        )

        weights[
            invalid
        ] = rng.multinomial(
            n=n_points,
            pvals=probabilities,
            size=n_invalid,
        ).astype(
            np.int16
        )

        invalid = (
            np.count_nonzero(
                weights,
                axis=1,
            )
            < 2
        )

    return weights


def centered_standardized_errors(
    bootstrap_estimates: np.ndarray,
) -> tuple[
    np.ndarray,
    np.ndarray,
    np.ndarray,
]:
    """
    Return centered absolute standardized errors, means, and SEs.
    """
    estimates = np.asarray(
        bootstrap_estimates,
        dtype=float,
    )

    bootstrap_mean = estimates.mean(
        axis=0
    )

    bootstrap_se = estimates.std(
        axis=0,
        ddof=1,
    )

    difference = np.abs(
        estimates
        - bootstrap_mean[
            np.newaxis,
            :,
        ]
    )

    standardized = np.zeros_like(
        difference,
        dtype=float,
    )

    positive_se = (
        bootstrap_se
        > NUMERICAL_ATOL
    )

    standardized[
        :,
        positive_se,
    ] = (
        difference[
            :,
            positive_se,
        ]
        / bootstrap_se[
            positive_se
        ]
    )

    zero_se = ~positive_se

    if zero_se.any():
        inconsistent = (
            difference[
                :,
                zero_se,
            ]
            > NUMERICAL_ATOL
        )

        if inconsistent.any():
            raise RuntimeError(
                "Non-zero centered deviations were found with "
                "zero bootstrap standard error."
            )

    return (
        standardized,
        bootstrap_mean,
        bootstrap_se,
    )


def extract_consecutive_runs(
    mask: np.ndarray,
    leads: np.ndarray,
    dates: np.ndarray,
) -> list[dict[str, Any]]:
    """Extract all consecutive True runs."""
    mask = np.asarray(
        mask,
        dtype=bool,
    )

    leads = np.asarray(
        leads,
        dtype=int,
    )

    dates = pd.to_datetime(
        dates
    ).to_numpy()

    if not (
        len(mask)
        == len(leads)
        == len(dates)
    ):
        raise ValueError(
            "Run inputs have inconsistent lengths."
        )

    order = np.argsort(
        leads
    )

    sorted_mask = mask[
        order
    ]

    sorted_leads = leads[
        order
    ]

    sorted_dates = dates[
        order
    ]

    runs: list[
        dict[str, Any]
    ] = []

    index = 0
    run_id = 0

    while index < len(
        sorted_mask
    ):
        if not bool(
            sorted_mask[
                index
            ]
        ):
            index += 1
            continue

        start_index = index

        while (
            index + 1
            < len(
                sorted_mask
            )
            and bool(
                sorted_mask[
                    index + 1
                ]
            )
            and (
                sorted_leads[
                    index + 1
                ]
                == sorted_leads[
                    index
                ]
                + 1
            )
        ):
            index += 1

        end_index = index
        run_id += 1

        runs.append(
            {
                "run_id": int(
                    run_id
                ),

                "start_position": int(
                    start_index
                ),

                "end_position": int(
                    end_index
                ),

                "start_lead": int(
                    sorted_leads[
                        start_index
                    ]
                ),

                "end_lead": int(
                    sorted_leads[
                        end_index
                    ]
                ),

                "start_date": pd.Timestamp(
                    sorted_dates[
                        start_index
                    ]
                ),

                "end_date": pd.Timestamp(
                    sorted_dates[
                        end_index
                    ]
                ),

                "length_months": int(
                    end_index
                    - start_index
                    + 1
                ),
            }
        )

        index += 1

    return runs


def build_final_intersection(
    ae3_monthly: pd.DataFrame,
    ae2_candidates: pd.DataFrame,
    version_label: str,
) -> pd.DataFrame:
    """Build raw monthly AE2–AE3 intersections."""
    merged = (
        ae3_monthly.merge(
            ae2_candidates,
            on=[
                "input_kind",
                "scenario",
                "lead_months",
                "target_date",
            ],
            how="inner",
            validate="one_to_one",
        )
        .sort_values(
            [
                "input_kind",
                "scenario",
                "lead_months",
            ]
        )
        .reset_index(
            drop=True
        )
    )

    merged[
        "inference_version"
    ] = version_label

    for gate_name, gate_spec in (
        FULL_GATE_SPECS.items()
    ):
        merged[
            f"full_{gate_name}_candidate"
        ] = (
            merged[
                gate_spec[
                    "ae2_column"
                ]
            ]
            &
            merged[
                gate_spec[
                    "ae3_column"
                ]
            ]
        )

    return merged


def summarize_final_persistence(
    intersection: pd.DataFrame,
    version_label: str,
) -> tuple[
    pd.DataFrame,
    pd.DataFrame,
    pd.DataFrame,
]:
    """
    Calculate run catalog, persistence summary, and monthly
    qualifying-run membership.
    """
    run_records: list[
        dict[str, Any]
    ] = []

    summary_records: list[
        dict[str, Any]
    ] = []

    monthly_records: list[
        dict[str, Any]
    ] = []

    for (
        component,
        scenario,
    ), group in intersection.groupby(
        [
            "input_kind",
            "scenario",
        ],
        dropna=False,
    ):
        group = (
            group.sort_values(
                "lead_months"
            )
            .reset_index(
                drop=True
            )
        )

        leads = group[
            "lead_months"
        ].to_numpy(
            dtype=int
        )

        dates = group[
            "target_date"
        ].to_numpy()

        for gate_name in (
            FULL_GATE_SPECS
        ):
            candidate_column = (
                f"full_{gate_name}_candidate"
            )

            candidate_mask = group[
                candidate_column
            ].to_numpy(
                dtype=bool
            )

            runs = extract_consecutive_runs(
                mask=candidate_mask,
                leads=leads,
                dates=dates,
            )

            for run in runs:
                run_records.append(
                    {
                        "inference_version": (
                            version_label
                        ),

                        "input_kind": component,
                        "scenario": scenario,
                        "gate_type": gate_name,

                        "run_id": int(
                            run[
                                "run_id"
                            ]
                        ),

                        "start_lead": int(
                            run[
                                "start_lead"
                            ]
                        ),

                        "end_lead": int(
                            run[
                                "end_lead"
                            ]
                        ),

                        "start_date": (
                            run[
                                "start_date"
                            ]
                        ),

                        "end_date": (
                            run[
                                "end_date"
                            ]
                        ),

                        "length_months": int(
                            run[
                                "length_months"
                            ]
                        ),

                        "qualifies_r1": bool(
                            run[
                                "length_months"
                            ]
                            >= 1
                        ),

                        "qualifies_r3": bool(
                            run[
                                "length_months"
                            ]
                            >= 3
                        ),

                        "qualifies_r6": bool(
                            run[
                                "length_months"
                            ]
                            >= 6
                        ),
                    }
                )

            for persistence in (
                PERSISTENCE_LEVELS
            ):
                qualifying_runs = [
                    run
                    for run in runs
                    if run[
                        "length_months"
                    ]
                    >= persistence
                ]

                longest_run = max(
                    (
                        run[
                            "length_months"
                        ]
                        for run in runs
                    ),
                    default=0,
                )

                membership = np.zeros(
                    len(group),
                    dtype=bool,
                )

                run_ids = np.zeros(
                    len(group),
                    dtype=np.int16,
                )

                qualifying_id = 0

                for run in qualifying_runs:
                    qualifying_id += 1

                    start_position = int(
                        run[
                            "start_position"
                        ]
                    )

                    end_position = int(
                        run[
                            "end_position"
                        ]
                    )

                    membership[
                        start_position:end_position + 1
                    ] = True

                    run_ids[
                        start_position:end_position + 1
                    ] = qualifying_id

                first_run = (
                    qualifying_runs[0]
                    if qualifying_runs
                    else None
                )

                summary_records.append(
                    {
                        "inference_version": (
                            version_label
                        ),

                        "input_kind": component,
                        "scenario": scenario,
                        "gate_type": gate_name,

                        "persistence_months": int(
                            persistence
                        ),

                        "Rk_months": int(
                            EXPECTED_HORIZONS[
                                component
                            ]
                        ),

                        "n_candidate_months": int(
                            candidate_mask.sum()
                        ),

                        "n_all_runs": int(
                            len(runs)
                        ),

                        "n_qualifying_runs": int(
                            len(
                                qualifying_runs
                            )
                        ),

                        "longest_run_months": int(
                            longest_run
                        ),

                        "emergence_detected": bool(
                            qualifying_runs
                        ),

                        "n_months_in_qualifying_runs": int(
                            membership.sum()
                        ),

                        "first_start_lead": (
                            int(
                                first_run[
                                    "start_lead"
                                ]
                            )
                            if first_run
                            is not None
                            else np.nan
                        ),

                        "first_end_lead": (
                            int(
                                first_run[
                                    "end_lead"
                                ]
                            )
                            if first_run
                            is not None
                            else np.nan
                        ),

                        "first_start_date": (
                            first_run[
                                "start_date"
                            ]
                            if first_run
                            is not None
                            else pd.NaT
                        ),

                        "first_end_date": (
                            first_run[
                                "end_date"
                            ]
                            if first_run
                            is not None
                            else pd.NaT
                        ),
                    }
                )

                for row_position, row in (
                    group.iterrows()
                ):
                    monthly_records.append(
                        {
                            "inference_version": (
                                version_label
                            ),

                            "input_kind": component,
                            "scenario": scenario,
                            "gate_type": gate_name,

                            "persistence_months": int(
                                persistence
                            ),

                            "lead_months": int(
                                row[
                                    "lead_months"
                                ]
                            ),

                            "target_date": pd.Timestamp(
                                row[
                                    "target_date"
                                ]
                            ),

                            "candidate_month": bool(
                                candidate_mask[
                                    row_position
                                ]
                            ),

                            "qualifying_run_member": bool(
                                membership[
                                    row_position
                                ]
                            ),

                            "qualifying_run_id": int(
                                run_ids[
                                    row_position
                                ]
                            ),
                        }
                    )

    return (
        pd.DataFrame(
            run_records
        ),
        pd.DataFrame(
            summary_records
        ),
        pd.DataFrame(
            monthly_records
        ),
    )


# ============================================================
# 7. NORMALIZE INPUTS
# ============================================================

for frame in [
    point_states,
    point_contributions,
    fixed_monthly_inference,
    ae2_default_gate,
]:
    frame[
        "target_date"
    ] = pd.to_datetime(
        frame[
            "target_date"
        ],
        errors="raise",
    )

    frame[
        "lead_months"
    ] = pd.to_numeric(
        frame[
            "lead_months"
        ],
        errors="raise",
    ).astype(int)

    for identifier_column in [
        "input_kind",
        "scenario",
    ]:
        frame[
            identifier_column
        ] = (
            frame[
                identifier_column
            ]
            .astype(str)
            .str.strip()
        )


for frame in [
    point_states,
    point_contributions,
]:
    for identifier_column in [
        "point_id",
        "series_id",
    ]:
        frame[
            identifier_column
        ] = (
            frame[
                identifier_column
            ]
            .astype(str)
            .str.strip()
        )


point_states[
    "drought_rank_score"
] = pd.to_numeric(
    point_states[
        "drought_rank_score"
    ],
    errors="raise",
)


for action_column in [
    "reference_action",
    "scenario_action",
]:
    point_contributions[
        action_column
    ] = pd.to_numeric(
        point_contributions[
            action_column
        ],
        errors="raise",
    )


point_contributions[
    "scenario_conditioning_value"
] = pd.to_numeric(
    point_contributions[
        "scenario_conditioning_value"
    ],
    errors="raise",
)


for boolean_column in [
    "within_AE1_horizon",
]:
    point_contributions[
        boolean_column
    ] = coerce_boolean(
        point_contributions[
            boolean_column
        ]
    )


for boolean_column in [
    "within_AE1_horizon",
    "AE3_exploratory_gate",
    "AE3_confirmatory_gate",
]:
    fixed_monthly_inference[
        boolean_column
    ] = coerce_boolean(
        fixed_monthly_inference[
            boolean_column
        ]
    )


AE2_CANDIDATE_COLUMNS = [
    "pointwise_magnitude_candidate",
    "pointwise_directional_candidate",
    "joint_magnitude_candidate",
    "joint_directional_candidate",
]

missing_ae2_columns = [
    column
    for column in AE2_CANDIDATE_COLUMNS
    if column
    not in ae2_default_gate.columns
]

if missing_ae2_columns:
    raise ValueError(
        "The AE2 monthly gate is missing required candidate "
        f"columns: {missing_ae2_columns}"
    )

for boolean_column in (
    AE2_CANDIDATE_COLUMNS
):
    ae2_default_gate[
        boolean_column
    ] = coerce_boolean(
        ae2_default_gate[
            boolean_column
        ]
    )


if not point_states[
    "drought_rank_score"
].between(
    0.0,
    1.0,
    inclusive="both",
).all():
    raise ValueError(
        "Drought-rank scores fall outside [0, 1]."
    )


# ============================================================
# 8. BUILD ALIGNED SCORE AND ORIGINAL-ACTION MATRICES
# ============================================================

component_data: dict[
    str,
    dict[str, Any],
] = {}

for component in COMPONENT_ORDER:
    component_states = point_states[
        point_states[
            "input_kind"
        ].eq(component)
    ].copy()

    score_matrices: dict[
        str,
        np.ndarray,
    ] = {}

    scenario_indices: dict[
        str,
        pd.MultiIndex,
    ] = {}

    metadata_reference: pd.DataFrame | None = None

    for scenario in SCENARIO_ORDER:
        scenario_frame = component_states[
            component_states[
                "scenario"
            ].eq(scenario)
        ].copy()

        pivot = (
            scenario_frame.pivot(
                index=[
                    "point_id",
                    "series_id",
                ],
                columns="lead_months",
                values="drought_rank_score",
            )
            .reindex(
                columns=list(
                    range(1, 85)
                )
            )
            .sort_index()
        )

        if pivot.isna().any().any():
            raise RuntimeError(
                f"Incomplete drought-score matrix for "
                f"{component} / {scenario}."
            )

        scenario_indices[
            scenario
        ] = pivot.index

        score_matrices[
            scenario
        ] = pivot.to_numpy(
            dtype=float
        )

        metadata = (
            scenario_frame.groupby(
                "lead_months",
                dropna=False,
            )
            .agg(
                target_date=(
                    "target_date",
                    "first",
                ),
            )
            .reindex(
                range(1, 85)
            )
            .reset_index()
        )

        metadata[
            "target_date"
        ] = pd.to_datetime(
            metadata[
                "target_date"
            ],
            errors="raise",
        )

        if metadata_reference is None:
            metadata_reference = metadata

        else:
            if not (
                metadata_reference[
                    "target_date"
                ].to_numpy()
                ==
                metadata[
                    "target_date"
                ].to_numpy()
            ).all():
                raise RuntimeError(
                    f"Target-date metadata differ across scenarios "
                    f"for {component}."
                )

    reference_index = scenario_indices[
        "Base"
    ]

    for scenario in SCENARIO_ORDER:
        if not scenario_indices[
            scenario
        ].equals(
            reference_index
        ):
            raise RuntimeError(
                f"Point ordering differs across scenarios "
                f"for {component}."
            )

    n_points = int(
        len(
            reference_index
        )
    )

    if (
        n_points
        != EXPECTED_CONTROL_POINTS[
            component
        ]
    ):
        raise RuntimeError(
            f"Unexpected point count for {component}. "
            f"Expected {EXPECTED_CONTROL_POINTS[component]}; "
            f"observed {n_points}."
        )

    component_contributions = (
        point_contributions[
            point_contributions[
                "input_kind"
            ].eq(component)
            &
            point_contributions[
                "scenario"
            ].isin(
                NON_BASE_SCENARIOS
            )
        ]
        .copy()
    )

    original_reference_indices: dict[
        str,
        np.ndarray,
    ] = {}

    original_scenario_indices: dict[
        str,
        np.ndarray,
    ] = {}

    for scenario in NON_BASE_SCENARIOS:
        scenario_contributions = (
            component_contributions[
                component_contributions[
                    "scenario"
                ].eq(scenario)
            ]
        )

        reference_action_pivot = (
            scenario_contributions.pivot(
                index=[
                    "point_id",
                    "series_id",
                ],
                columns="lead_months",
                values="reference_action",
            )
            .reindex(
                index=reference_index,
                columns=list(
                    range(1, 85)
                ),
            )
        )

        scenario_action_pivot = (
            scenario_contributions.pivot(
                index=[
                    "point_id",
                    "series_id",
                ],
                columns="lead_months",
                values="scenario_action",
            )
            .reindex(
                index=reference_index,
                columns=list(
                    range(1, 85)
                ),
            )
        )

        if (
            reference_action_pivot.isna().any().any()
            or scenario_action_pivot.isna().any().any()
        ):
            raise RuntimeError(
                f"Incomplete original-action matrices for "
                f"{component} / {scenario}."
            )

        original_reference_indices[
            scenario
        ] = actions_to_indices(
            reference_action_pivot.to_numpy(
                dtype=float
            ),
            ACTION_LEVELS,
        )

        original_scenario_indices[
            scenario
        ] = actions_to_indices(
            scenario_action_pivot.to_numpy(
                dtype=float
            ),
            ACTION_LEVELS,
        )

    if not np.array_equal(
        original_reference_indices[
            "Favorable"
        ],
        original_reference_indices[
            "Unfavorable"
        ],
    ):
        raise RuntimeError(
            f"Original Base-policy actions differ between scenarios "
            f"for {component}."
        )

    assert metadata_reference is not None

    component_data[
        component
    ] = {
        "point_index": reference_index,
        "n_points": n_points,
        "horizon": int(
            EXPECTED_HORIZONS[
                component
            ]
        ),
        "metadata": metadata_reference,
        "scores": score_matrices,
        "original_reference_action_index": (
            original_reference_indices[
                "Favorable"
            ]
        ),
        "original_scenario_action_index": (
            original_scenario_indices
        ),
    }


# ============================================================
# 9. VALIDATE CENTRAL ESTIMATES
# ============================================================

point_central = (
    point_contributions.loc[
        point_contributions[
            "scenario"
        ].isin(
            NON_BASE_SCENARIOS
        )
    ]
    .groupby(
        [
            "input_kind",
            "scenario",
            "lead_months",
            "target_date",
        ],
        dropna=False,
    )[
        "scenario_conditioning_value"
    ]
    .mean()
    .reset_index(
        name="point_contribution_mean"
    )
)

central_validation = point_central.merge(
    fixed_monthly_inference[
        [
            "input_kind",
            "scenario",
            "lead_months",
            "target_date",
            "scenario_conditioning_value",
        ]
    ],
    on=[
        "input_kind",
        "scenario",
        "lead_months",
        "target_date",
    ],
    how="inner",
    validate="one_to_one",
)

maximum_central_reconstruction_difference = float(
    (
        central_validation[
            "point_contribution_mean"
        ]
        - central_validation[
            "scenario_conditioning_value"
        ]
    )
    .abs()
    .max()
)

if (
    maximum_central_reconstruction_difference
    > 1e-10
):
    raise RuntimeError(
        "Point contributions do not reconstruct the canonical "
        "AE3 central estimates.\n"
        "Maximum difference: "
        f"{maximum_central_reconstruction_difference:.3e}"
    )


# ============================================================
# 10. POLICY-RESELECTION BOOTSTRAP
# ============================================================

component_seed_map = {
    component: int(
        BOOTSTRAP_SEED
        + 100_003
        * component_index
    )
    for component_index, component
    in enumerate(
        COMPONENT_ORDER
    )
}

bootstrap_weights: dict[
    str,
    np.ndarray,
] = {}

bootstrap_scv: dict[
    tuple[str, str],
    np.ndarray,
] = {}

bootstrap_policy_value: dict[
    tuple[str, str],
    np.ndarray,
] = {}

bootstrap_action_changed: dict[
    tuple[str, str],
    np.ndarray,
] = {}

bootstrap_action_increased: dict[
    tuple[str, str],
    np.ndarray,
] = {}

bootstrap_action_decreased: dict[
    tuple[str, str],
    np.ndarray,
] = {}

bootstrap_reference_action_mean: dict[
    tuple[str, str],
    np.ndarray,
] = {}

bootstrap_scenario_action_mean: dict[
    tuple[str, str],
    np.ndarray,
] = {}

bootstrap_reference_reselection: dict[
    tuple[str, str],
    np.ndarray,
] = {}

bootstrap_scenario_reselection: dict[
    tuple[str, str],
    np.ndarray,
] = {}

bootstrap_cross_scenario_agreement: dict[
    str,
    np.ndarray,
] = {}

bootstrap_cross_scenario_action_difference: dict[
    str,
    np.ndarray,
] = {}


for component in COMPONENT_ORDER:
    data = component_data[
        component
    ]

    n_points = int(
        data[
            "n_points"
        ]
    )

    base_scores = data[
        "scores"
    ][
        "Base"
    ]

    base_losses = decision_loss_cube(
        drought_scores=base_scores,
        actions=ACTION_LEVELS,
        drought_score_threshold=(
            DROUGHT_SCORE_THRESHOLD
        ),
        action_effectiveness=(
            ACTION_EFFECTIVENESS
        ),
        action_cost_ratio=(
            ACTION_COST_RATIO
        ),
    )

    scenario_losses = {
        scenario: decision_loss_cube(
            drought_scores=data[
                "scores"
            ][
                scenario
            ],
            actions=ACTION_LEVELS,
            drought_score_threshold=(
                DROUGHT_SCORE_THRESHOLD
            ),
            action_effectiveness=(
                ACTION_EFFECTIVENESS
            ),
            action_cost_ratio=(
                ACTION_COST_RATIO
            ),
        )
        for scenario
        in NON_BASE_SCENARIOS
    }

    rng = np.random.default_rng(
        component_seed_map[
            component
        ]
    )

    weights = generate_valid_multinomial_weights(
        rng=rng,
        n_bootstrap=BOOTSTRAP_REPLICATES,
        n_points=n_points,
    )

    bootstrap_weights[
        component
    ] = weights

    for scenario in NON_BASE_SCENARIOS:
        bootstrap_scv[
            (
                component,
                scenario,
            )
        ] = np.empty(
            (
                BOOTSTRAP_REPLICATES,
                84,
            ),
            dtype=np.float64,
        )

        bootstrap_policy_value[
            (
                component,
                scenario,
            )
        ] = np.empty(
            (
                BOOTSTRAP_REPLICATES,
                84,
            ),
            dtype=np.float64,
        )

        bootstrap_action_changed[
            (
                component,
                scenario,
            )
        ] = np.empty(
            (
                BOOTSTRAP_REPLICATES,
                84,
            ),
            dtype=np.float64,
        )

        bootstrap_action_increased[
            (
                component,
                scenario,
            )
        ] = np.empty(
            (
                BOOTSTRAP_REPLICATES,
                84,
            ),
            dtype=np.float64,
        )

        bootstrap_action_decreased[
            (
                component,
                scenario,
            )
        ] = np.empty(
            (
                BOOTSTRAP_REPLICATES,
                84,
            ),
            dtype=np.float64,
        )

        bootstrap_reference_action_mean[
            (
                component,
                scenario,
            )
        ] = np.empty(
            (
                BOOTSTRAP_REPLICATES,
                84,
            ),
            dtype=np.float64,
        )

        bootstrap_scenario_action_mean[
            (
                component,
                scenario,
            )
        ] = np.empty(
            (
                BOOTSTRAP_REPLICATES,
                84,
            ),
            dtype=np.float64,
        )

        bootstrap_reference_reselection[
            (
                component,
                scenario,
            )
        ] = np.empty(
            (
                BOOTSTRAP_REPLICATES,
                84,
            ),
            dtype=np.float64,
        )

        bootstrap_scenario_reselection[
            (
                component,
                scenario,
            )
        ] = np.empty(
            (
                BOOTSTRAP_REPLICATES,
                84,
            ),
            dtype=np.float64,
        )

    bootstrap_cross_scenario_agreement[
        component
    ] = np.empty(
        (
            BOOTSTRAP_REPLICATES,
            84,
        ),
        dtype=np.float64,
    )

    bootstrap_cross_scenario_action_difference[
        component
    ] = np.empty(
        (
            BOOTSTRAP_REPLICATES,
            84,
        ),
        dtype=np.float64,
    )

    original_reference_index = data[
        "original_reference_action_index"
    ]

    for chunk_start in range(
        0,
        BOOTSTRAP_REPLICATES,
        BOOTSTRAP_CHUNK_SIZE,
    ):
        chunk_stop = min(
            chunk_start
            + BOOTSTRAP_CHUNK_SIZE,
            BOOTSTRAP_REPLICATES,
        )

        weight_chunk = weights[
            chunk_start:chunk_stop
        ].astype(
            np.float64
        )

        chunk_size = int(
            len(
                weight_chunk
            )
        )

        if not np.allclose(
            weight_chunk.sum(
                axis=1
            ),
            n_points,
            atol=0.0,
            rtol=0.0,
        ):
            raise RuntimeError(
                f"Bootstrap weights do not sum to n for {component}."
            )

        total_base_loss = np.einsum(
            "bn,nma->bma",
            weight_chunk,
            base_losses,
            optimize=True,
        )

        excluded_base_loss = (
            total_base_loss[
                :,
                np.newaxis,
                :,
                :,
            ]
            - weight_chunk[
                :,
                :,
                np.newaxis,
                np.newaxis,
            ]
            * base_losses[
                np.newaxis,
                :,
                :,
                :,
            ]
        )

        reference_action_index = np.argmin(
            excluded_base_loss,
            axis=3,
        ).astype(
            np.int16
        )

        reference_action = ACTION_LEVELS[
            reference_action_index
        ]

        weight_cube = weight_chunk[
            :,
            :,
            np.newaxis,
        ]

        selected_scenario_indices: dict[
            str,
            np.ndarray,
        ] = {}

        for scenario in NON_BASE_SCENARIOS:
            losses = scenario_losses[
                scenario
            ]

            total_scenario_loss = np.einsum(
                "bn,nma->bma",
                weight_chunk,
                losses,
                optimize=True,
            )

            excluded_scenario_loss = (
                total_scenario_loss[
                    :,
                    np.newaxis,
                    :,
                    :,
                ]
                - weight_chunk[
                    :,
                    :,
                    np.newaxis,
                    np.newaxis,
                ]
                * losses[
                    np.newaxis,
                    :,
                    :,
                    :,
                ]
            )

            scenario_action_index = np.argmin(
                excluded_scenario_loss,
                axis=3,
            ).astype(
                np.int16
            )

            selected_scenario_indices[
                scenario
            ] = scenario_action_index

            scenario_action = ACTION_LEVELS[
                scenario_action_index
            ]

            broadcast_losses = np.broadcast_to(
                losses[
                    np.newaxis,
                    :,
                    :,
                    :,
                ],
                (
                    chunk_size,
                    n_points,
                    84,
                    len(
                        ACTION_LEVELS
                    ),
                ),
            )

            heldout_reference_loss = np.take_along_axis(
                broadcast_losses,
                reference_action_index[
                    :,
                    :,
                    :,
                    np.newaxis,
                ],
                axis=3,
            )[
                :,
                :,
                :,
                0,
            ]

            heldout_scenario_loss = np.take_along_axis(
                broadcast_losses,
                scenario_action_index[
                    :,
                    :,
                    :,
                    np.newaxis,
                ],
                axis=3,
            )[
                :,
                :,
                :,
                0,
            ]

            heldout_no_action_loss = (
                broadcast_losses[
                    :,
                    :,
                    :,
                    0,
                ]
            )

            heldout_scv = (
                heldout_reference_loss
                - heldout_scenario_loss
            )

            heldout_policy_value = (
                heldout_no_action_loss
                - heldout_scenario_loss
            )

            action_changed = (
                scenario_action_index
                != reference_action_index
            )

            action_increased = (
                scenario_action
                > reference_action
                + NUMERICAL_ATOL
            )

            action_decreased = (
                scenario_action
                < reference_action
                - NUMERICAL_ATOL
            )

            original_scenario_index = data[
                "original_scenario_action_index"
            ][
                scenario
            ]

            reference_reselected = (
                reference_action_index
                != original_reference_index[
                    np.newaxis,
                    :,
                    :,
                ]
            )

            scenario_reselected = (
                scenario_action_index
                != original_scenario_index[
                    np.newaxis,
                    :,
                    :,
                ]
            )

            key = (
                component,
                scenario,
            )

            bootstrap_scv[
                key
            ][
                chunk_start:chunk_stop
            ] = (
                np.sum(
                    weight_cube
                    * heldout_scv,
                    axis=1,
                )
                / n_points
            )

            bootstrap_policy_value[
                key
            ][
                chunk_start:chunk_stop
            ] = (
                np.sum(
                    weight_cube
                    * heldout_policy_value,
                    axis=1,
                )
                / n_points
            )

            bootstrap_action_changed[
                key
            ][
                chunk_start:chunk_stop
            ] = (
                np.sum(
                    weight_cube
                    * action_changed,
                    axis=1,
                )
                / n_points
            )

            bootstrap_action_increased[
                key
            ][
                chunk_start:chunk_stop
            ] = (
                np.sum(
                    weight_cube
                    * action_increased,
                    axis=1,
                )
                / n_points
            )

            bootstrap_action_decreased[
                key
            ][
                chunk_start:chunk_stop
            ] = (
                np.sum(
                    weight_cube
                    * action_decreased,
                    axis=1,
                )
                / n_points
            )

            bootstrap_reference_action_mean[
                key
            ][
                chunk_start:chunk_stop
            ] = (
                np.sum(
                    weight_cube
                    * reference_action,
                    axis=1,
                )
                / n_points
            )

            bootstrap_scenario_action_mean[
                key
            ][
                chunk_start:chunk_stop
            ] = (
                np.sum(
                    weight_cube
                    * scenario_action,
                    axis=1,
                )
                / n_points
            )

            bootstrap_reference_reselection[
                key
            ][
                chunk_start:chunk_stop
            ] = (
                np.sum(
                    weight_cube
                    * reference_reselected,
                    axis=1,
                )
                / n_points
            )

            bootstrap_scenario_reselection[
                key
            ][
                chunk_start:chunk_stop
            ] = (
                np.sum(
                    weight_cube
                    * scenario_reselected,
                    axis=1,
                )
                / n_points
            )

        favorable_index = (
            selected_scenario_indices[
                "Favorable"
            ]
        )

        unfavorable_index = (
            selected_scenario_indices[
                "Unfavorable"
            ]
        )

        favorable_action = ACTION_LEVELS[
            favorable_index
        ]

        unfavorable_action = ACTION_LEVELS[
            unfavorable_index
        ]

        bootstrap_cross_scenario_agreement[
            component
        ][
            chunk_start:chunk_stop
        ] = (
            np.sum(
                weight_cube
                * (
                    favorable_index
                    == unfavorable_index
                ),
                axis=1,
            )
            / n_points
        )

        bootstrap_cross_scenario_action_difference[
            component
        ][
            chunk_start:chunk_stop
        ] = (
            np.sum(
                weight_cube
                * np.abs(
                    favorable_action
                    - unfavorable_action
                ),
                axis=1,
            )
            / n_points
        )


# ============================================================
# 11. MONTHLY POLICY-RESELECTION INFERENCE
# ============================================================

monthly_records: list[
    dict[str, Any]
] = []

critical_value_records: list[
    dict[str, Any]
] = []

scenario_standardized_errors: dict[
    tuple[str, str],
    np.ndarray,
] = {}

scenario_bootstrap_mean: dict[
    tuple[str, str],
    np.ndarray,
] = {}

scenario_bootstrap_se: dict[
    tuple[str, str],
    np.ndarray,
] = {}


for component in COMPONENT_ORDER:
    horizon = int(
        EXPECTED_HORIZONS[
            component
        ]
    )

    metadata = component_data[
        component
    ][
        "metadata"
    ]

    for scenario in NON_BASE_SCENARIOS:
        key = (
            component,
            scenario,
        )

        bootstrap_values = bootstrap_scv[
            key
        ]

        (
            standardized_errors,
            bootstrap_mean,
            bootstrap_se,
        ) = centered_standardized_errors(
            bootstrap_values
        )

        scenario_standardized_errors[
            key
        ] = standardized_errors

        scenario_bootstrap_mean[
            key
        ] = bootstrap_mean

        scenario_bootstrap_se[
            key
        ] = bootstrap_se

        pointwise_lower = linear_quantile(
            bootstrap_values,
            LOWER_QUANTILE,
            axis=0,
        )

        pointwise_upper = linear_quantile(
            bootstrap_values,
            UPPER_QUANTILE,
            axis=0,
        )

        policy_bootstrap = (
            bootstrap_policy_value[
                key
            ]
        )

        policy_lower = linear_quantile(
            policy_bootstrap,
            LOWER_QUANTILE,
            axis=0,
        )

        policy_upper = linear_quantile(
            policy_bootstrap,
            UPPER_QUANTILE,
            axis=0,
        )

        scenario_max_statistic = (
            standardized_errors[
                :,
                :horizon,
            ].max(
                axis=1
            )
        )

        scenario_critical_value = float(
            linear_quantile(
                scenario_max_statistic,
                CONFIDENCE_LEVEL,
            )
        )

        critical_value_records.append(
            {
                "input_kind": component,
                "scope": (
                    "scenario_within_component"
                ),
                "scenario": scenario,
                "Rk_months": horizon,

                "critical_value": (
                    scenario_critical_value
                ),

                "confidence_level": (
                    CONFIDENCE_LEVEL
                ),

                "n_bootstrap": (
                    BOOTSTRAP_REPLICATES
                ),

                "n_months_in_family": horizon,
                "n_scenarios_in_family": 1,

                "centering": (
                    "bootstrap_mean"
                ),

                "method": (
                    "centered_max_t"
                ),
            }
        )

        observed_frame = (
            fixed_monthly_inference[
                fixed_monthly_inference[
                    "input_kind"
                ].eq(component)
                &
                fixed_monthly_inference[
                    "scenario"
                ].eq(scenario)
            ]
            .sort_values(
                "lead_months"
            )
            .reset_index(
                drop=True
            )
        )

        if len(
            observed_frame
        ) != 84:
            raise RuntimeError(
                f"Expected 84 observed AE3 months for "
                f"{component} / {scenario}."
            )

        observed_values = observed_frame[
            "scenario_conditioning_value"
        ].to_numpy(
            dtype=float
        )

        scenario_band_lower = (
            observed_values
            - scenario_critical_value
            * bootstrap_se
        )

        scenario_band_upper = (
            observed_values
            + scenario_critical_value
            * bootstrap_se
        )

        for month_index in range(84):
            monthly_records.append(
                {
                    "input_kind": component,
                    "scenario": scenario,

                    "lead_months": int(
                        month_index + 1
                    ),

                    "target_date": pd.Timestamp(
                        metadata.loc[
                            month_index,
                            "target_date",
                        ]
                    ),

                    "trustworthy_horizon_months": (
                        horizon
                    ),

                    "within_AE1_horizon": bool(
                        month_index
                        < horizon
                    ),

                    "n_control_points": int(
                        component_data[
                            component
                        ][
                            "n_points"
                        ]
                    ),

                    "n_bootstrap": (
                        BOOTSTRAP_REPLICATES
                    ),

                    "component_bootstrap_seed": (
                        component_seed_map[
                            component
                        ]
                    ),

                    "scenario_conditioning_value": float(
                        observed_values[
                            month_index
                        ]
                    ),

                    "reselection_bootstrap_mean": float(
                        bootstrap_mean[
                            month_index
                        ]
                    ),

                    "reselection_bootstrap_bias": float(
                        bootstrap_mean[
                            month_index
                        ]
                        - observed_values[
                            month_index
                        ]
                    ),

                    "reselection_bootstrap_se": float(
                        bootstrap_se[
                            month_index
                        ]
                    ),

                    "reselection_pointwise_lower": float(
                        pointwise_lower[
                            month_index
                        ]
                    ),

                    "reselection_pointwise_upper": float(
                        pointwise_upper[
                            month_index
                        ]
                    ),

                    "reselection_scenario_band_lower": float(
                        scenario_band_lower[
                            month_index
                        ]
                    ),

                    "reselection_scenario_band_upper": float(
                        scenario_band_upper[
                            month_index
                        ]
                    ),

                    "bootstrap_fraction_scv_positive": float(
                        np.mean(
                            bootstrap_values[
                                :,
                                month_index,
                            ]
                            > 0
                        )
                    ),

                    "bootstrap_fraction_scv_negative": float(
                        np.mean(
                            bootstrap_values[
                                :,
                                month_index,
                            ]
                            < 0
                        )
                    ),

                    "policy_value_vs_no_action_bootstrap_mean": float(
                        policy_bootstrap[
                            :,
                            month_index,
                        ].mean()
                    ),

                    "policy_value_vs_no_action_pointwise_lower": float(
                        policy_lower[
                            month_index
                        ]
                    ),

                    "policy_value_vs_no_action_pointwise_upper": float(
                        policy_upper[
                            month_index
                        ]
                    ),

                    "bootstrap_mean_action_changed_fraction": float(
                        bootstrap_action_changed[
                            key
                        ][
                            :,
                            month_index,
                        ].mean()
                    ),

                    "bootstrap_mean_action_increased_fraction": float(
                        bootstrap_action_increased[
                            key
                        ][
                            :,
                            month_index,
                        ].mean()
                    ),

                    "bootstrap_mean_action_decreased_fraction": float(
                        bootstrap_action_decreased[
                            key
                        ][
                            :,
                            month_index,
                        ].mean()
                    ),

                    "bootstrap_mean_reference_action": float(
                        bootstrap_reference_action_mean[
                            key
                        ][
                            :,
                            month_index,
                        ].mean()
                    ),

                    "bootstrap_mean_scenario_action": float(
                        bootstrap_scenario_action_mean[
                            key
                        ][
                            :,
                            month_index,
                        ].mean()
                    ),

                    "bootstrap_mean_reference_policy_reselection_fraction": float(
                        bootstrap_reference_reselection[
                            key
                        ][
                            :,
                            month_index,
                        ].mean()
                    ),

                    "bootstrap_mean_scenario_policy_reselection_fraction": float(
                        bootstrap_scenario_reselection[
                            key
                        ][
                            :,
                            month_index,
                        ].mean()
                    ),

                    "inference_scope": (
                        INFERENCE_SCOPE
                    ),
                }
            )


AE3_RESELECTION_MONTHLY = pd.DataFrame(
    monthly_records
)

AE3_RESELECTION_CRITICAL_VALUES = pd.DataFrame(
    critical_value_records
)


# ============================================================
# 12. JOINT COMPONENT-WISE SIMULTANEOUS BANDS
# ============================================================

joint_critical_records: list[
    dict[str, Any]
] = []

for component in COMPONENT_ORDER:
    horizon = int(
        EXPECTED_HORIZONS[
            component
        ]
    )

    favorable_error = (
        scenario_standardized_errors[
            (
                component,
                "Favorable",
            )
        ]
    )

    unfavorable_error = (
        scenario_standardized_errors[
            (
                component,
                "Unfavorable",
            )
        ]
    )

    joint_max_statistic = np.maximum(
        favorable_error[
            :,
            :horizon,
        ].max(
            axis=1
        ),
        unfavorable_error[
            :,
            :horizon,
        ].max(
            axis=1
        ),
    )

    joint_critical_value = float(
        linear_quantile(
            joint_max_statistic,
            CONFIDENCE_LEVEL,
        )
    )

    joint_critical_records.append(
        {
            "input_kind": component,

            "scope": (
                "joint_scenarios_within_component"
            ),

            "scenario": (
                "Favorable_and_Unfavorable"
            ),

            "Rk_months": horizon,

            "critical_value": (
                joint_critical_value
            ),

            "confidence_level": (
                CONFIDENCE_LEVEL
            ),

            "n_bootstrap": (
                BOOTSTRAP_REPLICATES
            ),

            "n_months_in_family": horizon,
            "n_scenarios_in_family": 2,

            "centering": (
                "bootstrap_mean"
            ),

            "method": (
                "joint_centered_max_t"
            ),
        }
    )

    for scenario in NON_BASE_SCENARIOS:
        key = (
            component,
            scenario,
        )

        component_mask = (
            AE3_RESELECTION_MONTHLY[
                "input_kind"
            ].eq(component)
            &
            AE3_RESELECTION_MONTHLY[
                "scenario"
            ].eq(scenario)
        )

        ordered_indices = (
            AE3_RESELECTION_MONTHLY.loc[
                component_mask
            ]
            .sort_values(
                "lead_months"
            )
            .index
            .to_numpy()
        )

        observed = (
            AE3_RESELECTION_MONTHLY.loc[
                ordered_indices,
                "scenario_conditioning_value",
            ]
            .to_numpy(
                dtype=float
            )
        )

        standard_error = (
            scenario_bootstrap_se[
                key
            ]
        )

        AE3_RESELECTION_MONTHLY.loc[
            ordered_indices,
            "reselection_joint_band_lower",
        ] = (
            observed
            - joint_critical_value
            * standard_error
        )

        AE3_RESELECTION_MONTHLY.loc[
            ordered_indices,
            "reselection_joint_band_upper",
        ] = (
            observed
            + joint_critical_value
            * standard_error
        )


AE3_RESELECTION_CRITICAL_VALUES = pd.concat(
    [
        AE3_RESELECTION_CRITICAL_VALUES,
        pd.DataFrame(
            joint_critical_records
        ),
    ],
    ignore_index=True,
)


# ============================================================
# 13. RESELECTION EVIDENCE FLAGS
# ============================================================

AE3_RESELECTION_MONTHLY[
    "scenario_value_pointwise_positive"
] = (
    AE3_RESELECTION_MONTHLY[
        "reselection_pointwise_lower"
    ]
    > 0
)

AE3_RESELECTION_MONTHLY[
    "scenario_value_scenario_band_positive"
] = (
    AE3_RESELECTION_MONTHLY[
        "reselection_scenario_band_lower"
    ]
    > 0
)

AE3_RESELECTION_MONTHLY[
    "scenario_value_joint_band_positive"
] = (
    AE3_RESELECTION_MONTHLY[
        "reselection_joint_band_lower"
    ]
    > 0
)

AE3_RESELECTION_MONTHLY[
    "policy_value_pointwise_positive"
] = (
    AE3_RESELECTION_MONTHLY[
        "policy_value_vs_no_action_pointwise_lower"
    ]
    > 0
)

AE3_RESELECTION_MONTHLY[
    "AE3_exploratory_gate"
] = (
    AE3_RESELECTION_MONTHLY[
        "scenario_value_pointwise_positive"
    ]
)

AE3_RESELECTION_MONTHLY[
    "AE3_confirmatory_gate"
] = (
    AE3_RESELECTION_MONTHLY[
        "scenario_value_joint_band_positive"
    ]
)


# ============================================================
# 14. FIXED-CONTRIBUTION VERSUS RESELECTION COMPARISON
# ============================================================

comparison_keys = [
    "input_kind",
    "scenario",
    "lead_months",
    "target_date",
]

fixed_comparison_columns = [
    "input_kind",
    "scenario",
    "lead_months",
    "target_date",
    "within_AE1_horizon",

    "scenario_conditioning_value",

    "scenario_value_pointwise_lower",
    "scenario_value_pointwise_upper",

    "scenario_value_joint_band_lower",
    "scenario_value_joint_band_upper",

    "AE3_exploratory_gate",
    "AE3_confirmatory_gate",
]

fixed_for_comparison = (
    fixed_monthly_inference[
        fixed_comparison_columns
    ]
    .rename(
        columns={
            "scenario_value_pointwise_lower": (
                "fixed_pointwise_lower"
            ),

            "scenario_value_pointwise_upper": (
                "fixed_pointwise_upper"
            ),

            "scenario_value_joint_band_lower": (
                "fixed_joint_band_lower"
            ),

            "scenario_value_joint_band_upper": (
                "fixed_joint_band_upper"
            ),

            "AE3_exploratory_gate": (
                "fixed_exploratory_gate"
            ),

            "AE3_confirmatory_gate": (
                "fixed_confirmatory_gate"
            ),
        }
    )
)

reselection_for_comparison = (
    AE3_RESELECTION_MONTHLY[
        [
            "input_kind",
            "scenario",
            "lead_months",
            "target_date",

            "reselection_pointwise_lower",
            "reselection_pointwise_upper",

            "reselection_joint_band_lower",
            "reselection_joint_band_upper",

            "AE3_exploratory_gate",
            "AE3_confirmatory_gate",

            "reselection_bootstrap_mean",
            "reselection_bootstrap_bias",
            "reselection_bootstrap_se",

            "bootstrap_mean_reference_policy_reselection_fraction",
            "bootstrap_mean_scenario_policy_reselection_fraction",
        ]
    ]
    .rename(
        columns={
            "AE3_exploratory_gate": (
                "reselection_exploratory_gate"
            ),

            "AE3_confirmatory_gate": (
                "reselection_confirmatory_gate"
            ),
        }
    )
)

AE3_FIXED_VS_RESELECTION_MONTHLY = (
    fixed_for_comparison.merge(
        reselection_for_comparison,
        on=comparison_keys,
        how="inner",
        validate="one_to_one",
    )
)

expected_comparison_rows = (
    len(
        COMPONENT_ORDER
    )
    * len(
        NON_BASE_SCENARIOS
    )
    * 84
)

if (
    len(
        AE3_FIXED_VS_RESELECTION_MONTHLY
    )
    != expected_comparison_rows
):
    raise RuntimeError(
        "Unexpected fixed-versus-reselection comparison row count."
    )


AE3_FIXED_VS_RESELECTION_MONTHLY[
    "fixed_pointwise_width"
] = (
    AE3_FIXED_VS_RESELECTION_MONTHLY[
        "fixed_pointwise_upper"
    ]
    - AE3_FIXED_VS_RESELECTION_MONTHLY[
        "fixed_pointwise_lower"
    ]
)

AE3_FIXED_VS_RESELECTION_MONTHLY[
    "reselection_pointwise_width"
] = (
    AE3_FIXED_VS_RESELECTION_MONTHLY[
        "reselection_pointwise_upper"
    ]
    - AE3_FIXED_VS_RESELECTION_MONTHLY[
        "reselection_pointwise_lower"
    ]
)

AE3_FIXED_VS_RESELECTION_MONTHLY[
    "fixed_joint_width"
] = (
    AE3_FIXED_VS_RESELECTION_MONTHLY[
        "fixed_joint_band_upper"
    ]
    - AE3_FIXED_VS_RESELECTION_MONTHLY[
        "fixed_joint_band_lower"
    ]
)

AE3_FIXED_VS_RESELECTION_MONTHLY[
    "reselection_joint_width"
] = (
    AE3_FIXED_VS_RESELECTION_MONTHLY[
        "reselection_joint_band_upper"
    ]
    - AE3_FIXED_VS_RESELECTION_MONTHLY[
        "reselection_joint_band_lower"
    ]
)

AE3_FIXED_VS_RESELECTION_MONTHLY[
    "exploratory_gate_lost_after_reselection"
] = (
    AE3_FIXED_VS_RESELECTION_MONTHLY[
        "fixed_exploratory_gate"
    ]
    &
    ~AE3_FIXED_VS_RESELECTION_MONTHLY[
        "reselection_exploratory_gate"
    ]
)

AE3_FIXED_VS_RESELECTION_MONTHLY[
    "exploratory_gate_gained_after_reselection"
] = (
    ~AE3_FIXED_VS_RESELECTION_MONTHLY[
        "fixed_exploratory_gate"
    ]
    &
    AE3_FIXED_VS_RESELECTION_MONTHLY[
        "reselection_exploratory_gate"
    ]
)

AE3_FIXED_VS_RESELECTION_MONTHLY[
    "confirmatory_gate_lost_after_reselection"
] = (
    AE3_FIXED_VS_RESELECTION_MONTHLY[
        "fixed_confirmatory_gate"
    ]
    &
    ~AE3_FIXED_VS_RESELECTION_MONTHLY[
        "reselection_confirmatory_gate"
    ]
)

AE3_FIXED_VS_RESELECTION_MONTHLY[
    "confirmatory_gate_gained_after_reselection"
] = (
    ~AE3_FIXED_VS_RESELECTION_MONTHLY[
        "fixed_confirmatory_gate"
    ]
    &
    AE3_FIXED_VS_RESELECTION_MONTHLY[
        "reselection_confirmatory_gate"
    ]
)


comparison_within_ae1 = (
    AE3_FIXED_VS_RESELECTION_MONTHLY[
        AE3_FIXED_VS_RESELECTION_MONTHLY[
            "within_AE1_horizon"
        ]
    ]
    .copy()
)

AE3_FIXED_VS_RESELECTION_SUMMARY = (
    comparison_within_ae1.groupby(
        [
            "input_kind",
            "scenario",
        ],
        dropna=False,
    )
    .agg(
        n_months=(
            "lead_months",
            "size",
        ),

        n_fixed_exploratory_months=(
            "fixed_exploratory_gate",
            "sum",
        ),

        n_reselection_exploratory_months=(
            "reselection_exploratory_gate",
            "sum",
        ),

        n_fixed_confirmatory_months=(
            "fixed_confirmatory_gate",
            "sum",
        ),

        n_reselection_confirmatory_months=(
            "reselection_confirmatory_gate",
            "sum",
        ),

        n_exploratory_lost_after_reselection=(
            "exploratory_gate_lost_after_reselection",
            "sum",
        ),

        n_exploratory_gained_after_reselection=(
            "exploratory_gate_gained_after_reselection",
            "sum",
        ),

        n_confirmatory_lost_after_reselection=(
            "confirmatory_gate_lost_after_reselection",
            "sum",
        ),

        n_confirmatory_gained_after_reselection=(
            "confirmatory_gate_gained_after_reselection",
            "sum",
        ),

        mean_fixed_pointwise_width=(
            "fixed_pointwise_width",
            "mean",
        ),

        mean_reselection_pointwise_width=(
            "reselection_pointwise_width",
            "mean",
        ),

        mean_fixed_joint_width=(
            "fixed_joint_width",
            "mean",
        ),

        mean_reselection_joint_width=(
            "reselection_joint_width",
            "mean",
        ),

        mean_reselection_bootstrap_bias=(
            "reselection_bootstrap_bias",
            "mean",
        ),

        maximum_absolute_reselection_bootstrap_bias=(
            "reselection_bootstrap_bias",
            lambda values: float(
                np.max(
                    np.abs(
                        values
                    )
                )
            ),
        ),

        mean_reference_policy_reselection_fraction=(
            "bootstrap_mean_reference_policy_reselection_fraction",
            "mean",
        ),

        mean_scenario_policy_reselection_fraction=(
            "bootstrap_mean_scenario_policy_reselection_fraction",
            "mean",
        ),
    )
    .reset_index()
)


# ============================================================
# 15. POLICY-RESELECTION STABILITY SUMMARY
# ============================================================

AE3_RESELECTION_STABILITY_SUMMARY = (
    AE3_RESELECTION_MONTHLY[
        AE3_RESELECTION_MONTHLY[
            "within_AE1_horizon"
        ]
    ]
    .groupby(
        [
            "input_kind",
            "scenario",
        ],
        dropna=False,
    )
    .agg(
        Rk_months=(
            "trustworthy_horizon_months",
            "first",
        ),

        n_months=(
            "lead_months",
            "size",
        ),

        mean_reference_policy_reselection_fraction=(
            "bootstrap_mean_reference_policy_reselection_fraction",
            "mean",
        ),

        maximum_reference_policy_reselection_fraction=(
            "bootstrap_mean_reference_policy_reselection_fraction",
            "max",
        ),

        mean_scenario_policy_reselection_fraction=(
            "bootstrap_mean_scenario_policy_reselection_fraction",
            "mean",
        ),

        maximum_scenario_policy_reselection_fraction=(
            "bootstrap_mean_scenario_policy_reselection_fraction",
            "max",
        ),

        mean_bootstrap_action_changed_fraction=(
            "bootstrap_mean_action_changed_fraction",
            "mean",
        ),

        mean_bootstrap_action_increased_fraction=(
            "bootstrap_mean_action_increased_fraction",
            "mean",
        ),

        mean_bootstrap_action_decreased_fraction=(
            "bootstrap_mean_action_decreased_fraction",
            "mean",
        ),

        mean_bootstrap_reference_action=(
            "bootstrap_mean_reference_action",
            "mean",
        ),

        mean_bootstrap_scenario_action=(
            "bootstrap_mean_scenario_action",
            "mean",
        ),

        mean_reselection_bootstrap_se=(
            "reselection_bootstrap_se",
            "mean",
        ),

        maximum_reselection_bootstrap_se=(
            "reselection_bootstrap_se",
            "max",
        ),
    )
    .reset_index()
)


# ============================================================
# 16. OBSERVED AND BOOTSTRAP CROSS-SCENARIO ACTION AGREEMENT
# ============================================================

observed_scenario_actions = (
    point_contributions.loc[
        point_contributions[
            "scenario"
        ].isin(
            NON_BASE_SCENARIOS
        ),
        [
            "input_kind",
            "scenario",
            "point_id",
            "series_id",
            "lead_months",
            "target_date",
            "scenario_action",
            "within_AE1_horizon",
        ],
    ]
    .pivot(
        index=[
            "input_kind",
            "point_id",
            "series_id",
            "lead_months",
            "target_date",
            "within_AE1_horizon",
        ],
        columns="scenario",
        values="scenario_action",
    )
    .reset_index()
)

observed_scenario_actions[
    "actions_equal"
] = np.isclose(
    observed_scenario_actions[
        "Favorable"
    ],
    observed_scenario_actions[
        "Unfavorable"
    ],
    atol=NUMERICAL_ATOL,
    rtol=0.0,
)

observed_scenario_actions[
    "absolute_action_difference"
] = (
    observed_scenario_actions[
        "Favorable"
    ]
    - observed_scenario_actions[
        "Unfavorable"
    ]
).abs()

observed_scenario_actions[
    "favorable_action_greater"
] = (
    observed_scenario_actions[
        "Favorable"
    ]
    >
    observed_scenario_actions[
        "Unfavorable"
    ]
    + NUMERICAL_ATOL
)

observed_scenario_actions[
    "unfavorable_action_greater"
] = (
    observed_scenario_actions[
        "Unfavorable"
    ]
    >
    observed_scenario_actions[
        "Favorable"
    ]
    + NUMERICAL_ATOL
)


observed_agreement_monthly = (
    observed_scenario_actions.groupby(
        [
            "input_kind",
            "lead_months",
            "target_date",
            "within_AE1_horizon",
        ],
        dropna=False,
    )
    .agg(
        n_control_points=(
            "point_id",
            "nunique",
        ),

        observed_action_agreement_fraction=(
            "actions_equal",
            "mean",
        ),

        observed_mean_absolute_action_difference=(
            "absolute_action_difference",
            "mean",
        ),

        observed_fraction_favorable_action_greater=(
            "favorable_action_greater",
            "mean",
        ),

        observed_fraction_unfavorable_action_greater=(
            "unfavorable_action_greater",
            "mean",
        ),
    )
    .reset_index()
)


agreement_bootstrap_records: list[
    dict[str, Any]
] = []

for component in COMPONENT_ORDER:
    metadata = component_data[
        component
    ][
        "metadata"
    ]

    agreement_array = (
        bootstrap_cross_scenario_agreement[
            component
        ]
    )

    difference_array = (
        bootstrap_cross_scenario_action_difference[
            component
        ]
    )

    agreement_lower = linear_quantile(
        agreement_array,
        LOWER_QUANTILE,
        axis=0,
    )

    agreement_upper = linear_quantile(
        agreement_array,
        UPPER_QUANTILE,
        axis=0,
    )

    difference_lower = linear_quantile(
        difference_array,
        LOWER_QUANTILE,
        axis=0,
    )

    difference_upper = linear_quantile(
        difference_array,
        UPPER_QUANTILE,
        axis=0,
    )

    for month_index in range(84):
        agreement_bootstrap_records.append(
            {
                "input_kind": component,

                "lead_months": int(
                    month_index + 1
                ),

                "target_date": pd.Timestamp(
                    metadata.loc[
                        month_index,
                        "target_date",
                    ]
                ),

                "bootstrap_action_agreement_mean": float(
                    agreement_array[
                        :,
                        month_index,
                    ].mean()
                ),

                "bootstrap_action_agreement_lower": float(
                    agreement_lower[
                        month_index
                    ]
                ),

                "bootstrap_action_agreement_upper": float(
                    agreement_upper[
                        month_index
                    ]
                ),

                "bootstrap_mean_absolute_action_difference": float(
                    difference_array[
                        :,
                        month_index,
                    ].mean()
                ),

                "bootstrap_absolute_action_difference_lower": float(
                    difference_lower[
                        month_index
                    ]
                ),

                "bootstrap_absolute_action_difference_upper": float(
                    difference_upper[
                        month_index
                    ]
                ),
            }
        )


agreement_bootstrap_monthly = pd.DataFrame(
    agreement_bootstrap_records
)

AE3_CROSS_SCENARIO_ACTION_AGREEMENT = (
    observed_agreement_monthly.merge(
        agreement_bootstrap_monthly,
        on=[
            "input_kind",
            "lead_months",
            "target_date",
        ],
        how="inner",
        validate="one_to_one",
    )
)

AE3_CROSS_SCENARIO_ACTION_AGREEMENT_SUMMARY = (
    AE3_CROSS_SCENARIO_ACTION_AGREEMENT[
        AE3_CROSS_SCENARIO_ACTION_AGREEMENT[
            "within_AE1_horizon"
        ]
    ]
    .groupby(
        "input_kind",
        dropna=False,
    )
    .agg(
        Rk_months=(
            "lead_months",
            "size",
        ),

        mean_observed_action_agreement_fraction=(
            "observed_action_agreement_fraction",
            "mean",
        ),

        minimum_observed_action_agreement_fraction=(
            "observed_action_agreement_fraction",
            "min",
        ),

        mean_bootstrap_action_agreement=(
            "bootstrap_action_agreement_mean",
            "mean",
        ),

        minimum_bootstrap_action_agreement=(
            "bootstrap_action_agreement_mean",
            "min",
        ),

        mean_observed_absolute_action_difference=(
            "observed_mean_absolute_action_difference",
            "mean",
        ),

        mean_bootstrap_absolute_action_difference=(
            "bootstrap_mean_absolute_action_difference",
            "mean",
        ),

        mean_fraction_favorable_action_greater=(
            "observed_fraction_favorable_action_greater",
            "mean",
        ),

        mean_fraction_unfavorable_action_greater=(
            "observed_fraction_unfavorable_action_greater",
            "mean",
        ),
    )
    .reset_index()
)


# ============================================================
# 17. FINAL AE1–AE2–AE3 INTERSECTIONS
# ============================================================

ae2_candidates = (
    ae2_default_gate.loc[
        ae2_default_gate[
            "scenario"
        ].isin(
            NON_BASE_SCENARIOS
        ),
        [
            "input_kind",
            "scenario",
            "lead_months",
            "target_date",
        ]
        + AE2_CANDIDATE_COLUMNS,
    ]
    .copy()
)

fixed_ae3_gate = (
    fixed_monthly_inference.loc[
        fixed_monthly_inference[
            "within_AE1_horizon"
        ],
        [
            "input_kind",
            "scenario",
            "lead_months",
            "target_date",
            "AE3_exploratory_gate",
            "AE3_confirmatory_gate",
        ],
    ]
    .copy()
)

reselection_ae3_gate = (
    AE3_RESELECTION_MONTHLY.loc[
        AE3_RESELECTION_MONTHLY[
            "within_AE1_horizon"
        ],
        [
            "input_kind",
            "scenario",
            "lead_months",
            "target_date",
            "AE3_exploratory_gate",
            "AE3_confirmatory_gate",
        ],
    ]
    .copy()
)


AE_FULL_INTERSECTION_FIXED = build_final_intersection(
    ae3_monthly=fixed_ae3_gate,
    ae2_candidates=ae2_candidates,
    version_label=(
        "fixed_contribution_bootstrap"
    ),
)

AE_FULL_INTERSECTION_RESELECTION = build_final_intersection(
    ae3_monthly=reselection_ae3_gate,
    ae2_candidates=ae2_candidates,
    version_label=(
        "policy_reselection_bootstrap"
    ),
)


expected_intersection_rows = (
    len(
        NON_BASE_SCENARIOS
    )
    * sum(
        EXPECTED_HORIZONS.values()
    )
)

for version_name, frame in {
    "fixed": AE_FULL_INTERSECTION_FIXED,
    "reselection": AE_FULL_INTERSECTION_RESELECTION,
}.items():
    if len(
        frame
    ) != expected_intersection_rows:
        raise RuntimeError(
            f"Unexpected {version_name} final-intersection row count."
        )


(
    AE_FULL_RUNS_FIXED_REBUILT,
    AE_FULL_PERSISTENCE_FIXED_REBUILT,
    AE_FULL_PERSISTENCE_MONTHLY_FIXED,
) = summarize_final_persistence(
    intersection=(
        AE_FULL_INTERSECTION_FIXED
    ),
    version_label=(
        "fixed_contribution_bootstrap"
    ),
)


(
    AE_FULL_RUNS_RESELECTION,
    AE_FULL_PERSISTENCE_RESELECTION,
    AE_FULL_PERSISTENCE_MONTHLY_RESELECTION,
) = summarize_final_persistence(
    intersection=(
        AE_FULL_INTERSECTION_RESELECTION
    ),
    version_label=(
        "policy_reselection_bootstrap"
    ),
)


# ============================================================
# 18. PERSISTENCE COMPARISON
# ============================================================

persistence_merge_keys = [
    "input_kind",
    "scenario",
    "gate_type",
    "persistence_months",
]

fixed_persistence_for_comparison = (
    AE_FULL_PERSISTENCE_FIXED_REBUILT.drop(
        columns=[
            "inference_version",
        ]
    )
    .rename(
        columns={
            column: (
                f"fixed_{column}"
            )
            for column
            in AE_FULL_PERSISTENCE_FIXED_REBUILT.columns
            if column
            not in persistence_merge_keys
            + [
                "inference_version",
            ]
        }
    )
)

reselection_persistence_for_comparison = (
    AE_FULL_PERSISTENCE_RESELECTION.drop(
        columns=[
            "inference_version",
        ]
    )
    .rename(
        columns={
            column: (
                f"reselection_{column}"
            )
            for column
            in AE_FULL_PERSISTENCE_RESELECTION.columns
            if column
            not in persistence_merge_keys
            + [
                "inference_version",
            ]
        }
    )
)

AE_FULL_PERSISTENCE_COMPARISON = (
    fixed_persistence_for_comparison.merge(
        reselection_persistence_for_comparison,
        on=persistence_merge_keys,
        how="inner",
        validate="one_to_one",
    )
)

AE_FULL_PERSISTENCE_COMPARISON[
    "emergence_status_changed"
] = (
    AE_FULL_PERSISTENCE_COMPARISON[
        "fixed_emergence_detected"
    ]
    != AE_FULL_PERSISTENCE_COMPARISON[
        "reselection_emergence_detected"
    ]
)

AE_FULL_PERSISTENCE_COMPARISON[
    "longest_run_change_months"
] = (
    AE_FULL_PERSISTENCE_COMPARISON[
        "reselection_longest_run_months"
    ]
    - AE_FULL_PERSISTENCE_COMPARISON[
        "fixed_longest_run_months"
    ]
)


# ============================================================
# 19. NUMERICAL VALIDATION
# ============================================================

for component in COMPONENT_ORDER:
    weights = bootstrap_weights[
        component
    ]

    expected_sum = int(
        EXPECTED_CONTROL_POINTS[
            component
        ]
    )

    if not np.all(
        weights.sum(
            axis=1
        )
        == expected_sum
    ):
        raise RuntimeError(
            f"Bootstrap weight sums are invalid for {component}."
        )

    if np.any(
        np.count_nonzero(
            weights,
            axis=1,
        )
        < 2
    ):
        raise RuntimeError(
            f"Invalid single-point bootstrap replicate for {component}."
        )


for array_name, array_dictionary in {
    "SCV": bootstrap_scv,
    "policy value": bootstrap_policy_value,
    "action changed": bootstrap_action_changed,
    "reference reselection": bootstrap_reference_reselection,
    "scenario reselection": bootstrap_scenario_reselection,
}.items():
    for key, values in array_dictionary.items():
        if not np.isfinite(
            values
        ).all():
            raise RuntimeError(
                f"Non-finite {array_name} bootstrap values for {key}."
            )


if AE3_RESELECTION_MONTHLY[
    [
        "reselection_pointwise_lower",
        "reselection_pointwise_upper",
        "reselection_scenario_band_lower",
        "reselection_scenario_band_upper",
        "reselection_joint_band_lower",
        "reselection_joint_band_upper",
    ]
].isna().any().any():
    raise RuntimeError(
        "Missing AE3 policy-reselection intervals were generated."
    )


maximum_absolute_reselection_bias = float(
    AE3_RESELECTION_MONTHLY[
        "reselection_bootstrap_bias"
    ].abs().max()
)

maximum_mean_reference_reselection_fraction = float(
    AE3_RESELECTION_MONTHLY[
        "bootstrap_mean_reference_policy_reselection_fraction"
    ].max()
)

maximum_mean_scenario_reselection_fraction = float(
    AE3_RESELECTION_MONTHLY[
        "bootstrap_mean_scenario_policy_reselection_fraction"
    ].max()
)


# ============================================================
# 20. SAVE COMPRESSED BOOTSTRAP ARRAYS
# ============================================================

BOOTSTRAP_ARRAYS_PATH = (
    RESELECTION_DIR
    / "AE3_policy_reselection_bootstrap_arrays.npz"
)

npz_payload: dict[
    str,
    np.ndarray,
] = {}

for component in COMPONENT_ORDER:
    safe_component = (
        component.lower()
    )

    npz_payload[
        f"{safe_component}_weights"
    ] = bootstrap_weights[
        component
    ]

    npz_payload[
        f"{safe_component}_cross_scenario_agreement"
    ] = bootstrap_cross_scenario_agreement[
        component
    ].astype(
        np.float32
    )

    npz_payload[
        f"{safe_component}_cross_scenario_action_difference"
    ] = bootstrap_cross_scenario_action_difference[
        component
    ].astype(
        np.float32
    )

    for scenario in NON_BASE_SCENARIOS:
        safe_scenario = (
            scenario.lower()
        )

        key = (
            component,
            scenario,
        )

        npz_payload[
            f"{safe_component}_{safe_scenario}_scv"
        ] = bootstrap_scv[
            key
        ].astype(
            np.float32
        )

        npz_payload[
            f"{safe_component}_{safe_scenario}_policy_value"
        ] = bootstrap_policy_value[
            key
        ].astype(
            np.float32
        )

        npz_payload[
            f"{safe_component}_{safe_scenario}_action_changed"
        ] = bootstrap_action_changed[
            key
        ].astype(
            np.float32
        )

        npz_payload[
            f"{safe_component}_{safe_scenario}_reference_reselection"
        ] = bootstrap_reference_reselection[
            key
        ].astype(
            np.float32
        )

        npz_payload[
            f"{safe_component}_{safe_scenario}_scenario_reselection"
        ] = bootstrap_scenario_reselection[
            key
        ].astype(
            np.float32
        )


np.savez_compressed(
    BOOTSTRAP_ARRAYS_PATH,
    **npz_payload,
)


