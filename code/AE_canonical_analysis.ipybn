                "sheet_name": "S21_AE3_Monthly",
                "section": "Authoritative monthly AE3 source data",
            },
            {
                "kind": "table",
                "table_id": "Table S22",
                "sheet_name": "S22_AE2_Monthly",
                "section": "Monthly AE2 source data",
            },
            {
                "kind": "table",
                "table_id": "Table S23",
                "sheet_name": "S23_FinalIntersect",
                "section": "Final monthly AE1–AE2–AE3 intersection",
            },
            {
                "kind": "custom",
                "item_id": "Data Dictionary",
                "sheet_name": "DATA_DICTIONARY",
                "title": (
                    "Data dictionary and analytical terminology"
                ),
                "caption": (
                    "Definitions used across the source-data workbook."
                ),
                "note": (
                    "Column-specific definitions remain in the canonical "
                    "code and repository documentation."
                ),
                "source": str(
                    DATA_DICTIONARY_SOURCE_PATH
                ),
                "source_path": (
                    DATA_DICTIONARY_SOURCE_PATH
                    if DATA_DICTIONARY_SOURCE_PATH.is_file()
                    else None
                ),
                "frame": normalize_dates(
                    TABLE_DATA_DICTIONARY
                ),
            },
            {
                "kind": "custom",
                "item_id": "Figure Data Index",
                "sheet_name": "FIGURE_DATA_INDEX",
                "title": (
                    "Planned figure source-data mapping"
                ),
                "caption": (
                    "Mapping between planned supplementary figures and "
                    "canonical machine-readable tables."
                ),
                "note": (
                    "Figure-specific filtered datasets will be added only "
                    "after the final figures are frozen."
                ),
                "source": "Cell 07B editorial plan",
                "frame": SUPPLEMENTARY_FIGURE_INDEX,
            },
        ],
    },
]


# ============================================================
# 10. PREPARE PACKAGE ITEMS
# ============================================================

def prepare_package_items(
    package_definition: dict[str, Any],
) -> list[dict[str, Any]]:
    """Load all tables and metadata for one workbook."""
    prepared_items = []

    for item in package_definition[
        "items"
    ]:
        prepared_item = dict(
            item
        )

        if item[
            "kind"
        ] == "table":
            table_id = str(
                item[
                    "table_id"
                ]
            )

            frame, source_path = load_table(
                table_id
            )

            metadata = metadata_lookup.get(
                table_id,
                {},
            )

            prepared_item[
                "item_id"
            ] = table_id

            prepared_item[
                "frame"
            ] = frame

            prepared_item[
                "source_path"
            ] = source_path

            prepared_item[
                "title"
            ] = metadata.get(
                "title",
                table_id,
            )

            prepared_item[
                "caption"
            ] = metadata.get(
                "caption",
                item.get(
                    "section",
                    "",
                ),
            )

            prepared_item[
                "note"
            ] = metadata.get(
                "note",
                (
                    "Canonical table generated in Cell 07 from the "
                    "authoritative analysis outputs."
                ),
            )

            prepared_item[
                "source"
            ] = metadata.get(
                "source",
                "",
            )

        else:
            prepared_item[
                "frame"
            ] = normalize_dates(
                prepared_item[
                    "frame"
                ]
            )

            prepared_item.setdefault(
                "source_path",
                None,
            )

        frame = prepared_item[
            "frame"
        ]

        if len(
            frame
        ) > 1_048_000:
            raise RuntimeError(
                f"{prepared_item['item_id']} exceeds the Excel row limit."
            )

        if len(
            frame.columns
        ) > 16_000:
            raise RuntimeError(
                f"{prepared_item['item_id']} exceeds the Excel column limit."
            )

        prepared_items.append(
            prepared_item
        )

    return prepared_items


PREPARED_PACKAGES = []

for package_definition in PACKAGE_DEFINITIONS:
    prepared_package = dict(
        package_definition
    )

    prepared_package[
        "prepared_items"
    ] = prepare_package_items(
        package_definition
    )

    PREPARED_PACKAGES.append(
        prepared_package
    )


# ============================================================
# 11. WORKSHEET WRITERS
# ============================================================

def write_dataframe_sheet(
    workbook: Workbook,
    requested_sheet_name: str,
    title: str,
    caption: str,
    note: str,
    source: str,
    frame: pd.DataFrame,
) -> str:
    """Write a professionally formatted table worksheet."""
    existing_names = set(
        workbook.sheetnames
    )

    sheet_name = make_unique_sheet_name(
        requested_sheet_name,
        existing_names,
    )

    worksheet = workbook.create_sheet(
        title=sheet_name
    )

    worksheet.sheet_view.showGridLines = False

    n_columns = max(
        1,
        len(
            frame.columns
        ),
    )

    final_column = get_column_letter(
        n_columns
    )

    worksheet.merge_cells(
        f"A1:{final_column}1"
    )

    worksheet.merge_cells(
        f"A2:{final_column}2"
    )

    worksheet.merge_cells(
        f"A3:{final_column}3"
    )

    worksheet.merge_cells(
        f"A4:{final_column}4"
    )

    worksheet["A1"] = title
    worksheet["A2"] = caption
    worksheet["A3"] = note
    worksheet["A4"] = (
        f"Source: {source}"
        if source
        else "Source: canonical analysis workflow"
    )

    worksheet["A1"].font = Font(
        name="Calibri",
        size=14,
        bold=True,
        color=COLORS[
            "white"
        ],
    )

    worksheet["A1"].fill = PatternFill(
        fill_type="solid",
        fgColor=COLORS[
            "dark_blue"
        ],
    )

    worksheet["A1"].alignment = Alignment(
        horizontal="left",
        vertical="center",
    )

    worksheet["A2"].font = Font(
        name="Calibri",
        size=11,
        italic=True,
        color=COLORS[
            "black"
        ],
    )

    worksheet["A2"].fill = PatternFill(
        fill_type="solid",
        fgColor=COLORS[
            "light_blue"
        ],
    )

    worksheet["A2"].alignment = Alignment(
        horizontal="left",
        vertical="center",
        wrap_text=True,
    )

    worksheet["A3"].font = Font(
        name="Calibri",
        size=10,
        color="7F6000",
    )

    worksheet["A3"].fill = PatternFill(
        fill_type="solid",
        fgColor=COLORS[
            "yellow"
        ],
    )

    worksheet["A3"].alignment = Alignment(
        horizontal="left",
        vertical="center",
        wrap_text=True,
    )

    worksheet["A4"].font = Font(
        name="Calibri",
        size=9,
        italic=True,
        color=COLORS[
            "gray"
        ],
    )

    worksheet["A4"].fill = PatternFill(
        fill_type="solid",
        fgColor=COLORS[
            "light_gray"
        ],
    )

    worksheet["A4"].alignment = Alignment(
        horizontal="left",
        vertical="center",
        wrap_text=True,
    )

    worksheet.row_dimensions[
        1
    ].height = 25

    worksheet.row_dimensions[
        2
    ].height = 35

    worksheet.row_dimensions[
        3
    ].height = 45

    worksheet.row_dimensions[
        4
    ].height = 28

    header_row = 6
    first_data_row = 7

    for column_index, column_name in enumerate(
        frame.columns,
        start=1,
    ):
        cell = worksheet.cell(
            row=header_row,
            column=column_index,
            value=str(
                column_name
            ),
        )

        cell.font = Font(
            name="Calibri",
            size=10,
            bold=True,
            color=COLORS[
                "white"
            ],
        )

        cell.fill = PatternFill(
            fill_type="solid",
            fgColor=COLORS[
                "medium_blue"
            ],
        )

        cell.alignment = Alignment(
            horizontal="center",
            vertical="center",
            wrap_text=True,
        )

        cell.border = Border(
            bottom=MEDIUM_BLUE,
        )

    for row_index, row_values in enumerate(
        frame.itertuples(
            index=False,
            name=None,
        ),
        start=first_data_row,
    ):
        row_fill = (
            COLORS[
                "white"
            ]
            if (
                row_index
                - first_data_row
            )
            % 2
            == 0
            else COLORS[
                "very_light_gray"
            ]
        )

        for column_index, value in enumerate(
            row_values,
            start=1,
        ):
            safe_value = excel_safe(
                value
            )

            cell = worksheet.cell(
                row=row_index,
                column=column_index,
                value=safe_value,
            )

            cell.font = Font(
                name="Calibri",
                size=10,
                color=COLORS[
                    "black"
                ],
            )

            cell.fill = PatternFill(
                fill_type="solid",
                fgColor=row_fill,
            )

            numeric_value = (
                isinstance(
                    safe_value,
                    (
                        int,
                        float,
                    ),
                )
                and not isinstance(
                    safe_value,
                    bool,
                )
            )

            cell.alignment = Alignment(
                horizontal=(
                    "right"
                    if numeric_value
                    else "left"
                ),
                vertical="top",
                wrap_text=True,
            )

    for column_index, column_name in enumerate(
        frame.columns,
        start=1,
    ):
        number_format = infer_number_format(
            str(
                column_name
            ),
            frame[
                column_name
            ],
        )

        for row_index in range(
            first_data_row,
            first_data_row
            + len(
                frame
            ),
        ):
            worksheet.cell(
                row=row_index,
                column=column_index,
            ).number_format = (
                number_format
            )

        worksheet.column_dimensions[
            get_column_letter(
                column_index
            )
        ].width = estimate_column_width(
            str(
                column_name
            ),
            frame[
                column_name
            ],
        )

    worksheet.row_dimensions[
        header_row
    ].height = 44

    worksheet.freeze_panes = (
        f"A{first_data_row}"
    )

    if len(
        frame.columns
    ) > 0:
        last_filter_row = max(
            header_row,
            first_data_row
            + len(
                frame
            )
            - 1,
        )

        worksheet.auto_filter.ref = (
            f"A{header_row}:"
            f"{final_column}"
            f"{last_filter_row}"
        )

    worksheet.print_title_rows = (
        f"1:{header_row}"
    )

    worksheet.page_setup.orientation = (
        "landscape"
        if len(
            frame.columns
        ) > 7
        else "portrait"
    )

    worksheet.page_setup.fitToWidth = 1
    worksheet.page_setup.fitToHeight = 0

    worksheet.sheet_properties.pageSetUpPr.fitToPage = True

    return sheet_name


def write_readme_sheet(
    workbook: Workbook,
    package: dict[str, Any],
    contents_frame: pd.DataFrame,
) -> None:
    """Write a detailed README as the first worksheet."""
    worksheet = workbook.create_sheet(
        title="README",
        index=0,
    )

    worksheet.sheet_view.showGridLines = False

    worksheet.merge_cells(
        "A1:F1"
    )

    worksheet["A1"] = package[
        "title"
    ]

    worksheet["A1"].font = Font(
        name="Calibri",
        size=17,
        bold=True,
        color=COLORS[
            "white"
        ],
    )

    worksheet["A1"].fill = PatternFill(
        fill_type="solid",
        fgColor=COLORS[
            "dark_blue"
        ],
    )

    worksheet["A1"].alignment = Alignment(
        horizontal="left",
        vertical="center",
    )

    worksheet.row_dimensions[
        1
    ].height = 30

    current_row = 3

    metadata_rows = [
        (
            "Purpose",
            package[
                "purpose"
            ],
        ),
        (
            "Suggested manuscript description",
            package[
                "manuscript_description"
            ],
        ),
        (
            "Status",
            package[
                "status"
            ],
        ),
        (
            "Exclusions",
            package[
                "exclusions"
            ],
        ),
        (
            "Package version",
            PACKAGE_VERSION,
        ),
        (
            "Generated UTC",
            GENERATED_UTC,
        ),
        (
            "Canonical run directory",
            str(
                RUN_DIR
            ),
        ),
        (
            "Forecast SHA-256",
            str(
                FORECAST_SHA256
            ),
        ),
        (
            "Authoritative AE3 inference",
            (
                "Policy-reselection bootstrap from Cell 06"
            ),
        ),
        (
            "Main inferential constraint",
            (
                "No component retains family-wise confirmatory full "
                "actionable emergence after policy reselection."
            ),
        ),
        (
            "Repository scope",
            (
                "Code, raw CSV files, detailed point-level outputs, "
                "bootstrap arrays, execution logs, and provenance files "
                "should be released through GitHub and an archival "
                "repository such as Zenodo."
            ),
        ),
    ]

    for label, value in metadata_rows:
        worksheet.cell(
            row=current_row,
            column=1,
            value=label,
        ).font = Font(
            name="Calibri",
            size=10,
            bold=True,
            color=COLORS[
                "dark_blue"
            ],
        )

        worksheet.cell(
            row=current_row,
            column=1,
        ).fill = PatternFill(
            fill_type="solid",
            fgColor=COLORS[
                "light_blue"
            ],
        )

        worksheet.merge_cells(
            start_row=current_row,
            start_column=2,
            end_row=current_row,
            end_column=6,
        )

        value_cell = worksheet.cell(
            row=current_row,
            column=2,
            value=value,
        )

        value_cell.font = Font(
            name="Calibri",
            size=10,
            color=COLORS[
                "black"
            ],
        )

        value_cell.alignment = Alignment(
            horizontal="left",
            vertical="top",
            wrap_text=True,
        )

        if label in {
            "Status",
            "Exclusions",
            "Main inferential constraint",
        }:
            value_cell.fill = PatternFill(
                fill_type="solid",
                fgColor=COLORS[
                    "yellow"
                ],
            )

        worksheet.row_dimensions[
            current_row
        ].height = 35

        current_row += 1

    current_row += 1

    worksheet.merge_cells(
        start_row=current_row,
        start_column=1,
        end_row=current_row,
        end_column=6,
    )

    worksheet.cell(
        row=current_row,
        column=1,
        value="Analytical hierarchy",
    ).font = Font(
        name="Calibri",
        size=12,
        bold=True,
        color=COLORS[
            "white"
        ],
    )

    worksheet.cell(
        row=current_row,
        column=1,
    ).fill = PatternFill(
        fill_type="solid",
        fgColor=COLORS[
            "teal"
        ],
    )

    current_row += 1

    hierarchy_rows = [
        (
            "AE1",
            (
                "Inherited trustworthy horizons: Aquifer 48 months, "
                "Reservoir 36 months, River 24 months."
            ),
        ),
        (
            "AE2",
            (
                "Forecast-relative drought-rank separation with trajectory "
                "bootstrap and pointwise/joint simultaneous inference."
            ),
        ),
        (
            "AE3 central effects",
            (
                "Leave-one-control-point-out decision experiment using a "
                "normalised graded action-loss model."
            ),
        ),
        (
            "AE3 confirmatory inference",
            (
                "Policy-reselection bootstrap; this supersedes the "
                "fixed-contribution bootstrap."
            ),
        ),
        (
            "Final persistence",
            (
                "Consecutive runs are evaluated only after the final "
                "monthly AE2–AE3 intersection."
            ),
        ),
    ]

    for term, definition in hierarchy_rows:
        worksheet.cell(
            row=current_row,
            column=1,
            value=term,
        ).font = Font(
            name="Calibri",
            size=10,
            bold=True,
            color=COLORS[
                "dark_green"
            ],
        )

        worksheet.merge_cells(
            start_row=current_row,
            start_column=2,
            end_row=current_row,
            end_column=6,
        )

        worksheet.cell(
            row=current_row,
            column=2,
            value=definition,
        ).alignment = Alignment(
            horizontal="left",
            vertical="top",
            wrap_text=True,
        )

        worksheet.row_dimensions[
            current_row
        ].height = 32

        current_row += 1

    current_row += 1

    worksheet.merge_cells(
        start_row=current_row,
        start_column=1,
        end_row=current_row,
        end_column=6,
    )

    worksheet.cell(
        row=current_row,
        column=1,
        value="Workbook contents",
    ).font = Font(
        name="Calibri",
        size=12,
        bold=True,
        color=COLORS[
            "white"
        ],
    )

    worksheet.cell(
        row=current_row,
        column=1,
    ).fill = PatternFill(
        fill_type="solid",
        fgColor=COLORS[
            "medium_blue"
        ],
    )

    current_row += 1

    content_headers = [
        "Order",
        "Worksheet",
        "Item ID",
        "Title",
        "Rows",
        "Role",
    ]

    for column_index, header in enumerate(
        content_headers,
        start=1,
    ):
        cell = worksheet.cell(
            row=current_row,
            column=column_index,
            value=header,
        )

        cell.font = Font(
            name="Calibri",
            size=10,
            bold=True,
            color=COLORS[
                "white"
            ],
        )

        cell.fill = PatternFill(
            fill_type="solid",
            fgColor=COLORS[
                "medium_blue"
            ],
        )

        cell.alignment = Alignment(
            horizontal="center",
            vertical="center",
            wrap_text=True,
        )

    current_row += 1

    for row in contents_frame.itertuples(
        index=False
    ):
        values = [
            row.order,
            row.worksheet,
            row.item_id,
            row.title,
            row.rows,
            row.role,
        ]

        for column_index, value in enumerate(
            values,
            start=1,
        ):
            cell = worksheet.cell(
                row=current_row,
                column=column_index,
                value=excel_safe(
                    value
                ),
            )

            cell.alignment = Alignment(
                horizontal=(
                    "right"
                    if column_index
                    in {
                        1,
                        5,
                    }
                    else "left"
                ),
                vertical="top",
                wrap_text=True,
            )

        current_row += 1

    worksheet.column_dimensions[
        "A"
    ].width = 31

    worksheet.column_dimensions[
        "B"
    ].width = 28

    worksheet.column_dimensions[
        "C"
    ].width = 22

    worksheet.column_dimensions[
        "D"
    ].width = 52

    worksheet.column_dimensions[
        "E"
    ].width = 12

    worksheet.column_dimensions[
        "F"
    ].width = 32

    worksheet.freeze_panes = "A3"

    worksheet.page_setup.orientation = "landscape"
    worksheet.page_setup.fitToWidth = 1
    worksheet.page_setup.fitToHeight = 0


def write_contents_sheet(
    workbook: Workbook,
    contents_frame: pd.DataFrame,
) -> None:
    """Write a compact navigation and provenance sheet."""
    write_dataframe_sheet(
        workbook=workbook,
        requested_sheet_name="CONTENTS",
        title="Workbook contents and source overview",
        caption=(
            "Navigation table for all included worksheets."
        ),
        note=(
            "The SOURCE_MANIFEST worksheet records the source-file "
            "hashes used to construct this workbook."
        ),
        source="Cell 07B editorial packaging",
        frame=contents_frame,
    )


# ============================================================
# 12. WORKBOOK BUILDER
# ============================================================

def build_workbook(
    package: dict[str, Any],
) -> tuple[
    Path,
    pd.DataFrame,
]:
    """Build and save one supplementary-material workbook."""
    workbook = Workbook()

    default_sheet = workbook.active

    workbook.remove(
        default_sheet
    )

    source_manifest_records = []
    content_records = []

    resolved_sheet_names = []

    for order, item in enumerate(
        package[
            "prepared_items"
        ],
        start=1,
    ):
        frame = item[
            "frame"
        ]

        source_path = item.get(
            "source_path"
        )

        source_hash = (
            sha256_file(
                source_path
            )
            if (
                isinstance(
                    source_path,
                    Path,
                )
                and source_path.is_file()
            )
            else None
        )

        resolved_sheet_name = (
            sanitize_sheet_name(
                item[
                    "sheet_name"
                ]
            )
        )

        resolved_sheet_names.append(
            resolved_sheet_name
        )

        content_records.append(
            {
                "order": int(
                    order
                ),
                "worksheet": (
                    resolved_sheet_name
                ),
                "item_id": item[
                    "item_id"
                ],
                "title": item[
                    "title"
                ],
                "rows": int(
                    len(
                        frame
                    )
                ),
                "columns": int(
                    len(
                        frame.columns
                    )
                ),
                "role": (
                    item.get(
                        "section"
                    )
                    or item.get(
                        "kind",
                        "",
                    )
                ),
                "source": item.get(
                    "source",
                    "",
                ),
            }
        )

        source_manifest_records.append(
            {
                "worksheet": (
                    resolved_sheet_name
                ),
                "item_id": item[
                    "item_id"
                ],
                "title": item[
                    "title"
                ],
                "source_description": item.get(
                    "source",
                    "",
                ),
                "source_path": (
                    str(
                        source_path
                    )
                    if source_path
                    is not None
                    else ""
                ),
                "source_sha256": (
                    source_hash
                    if source_hash
                    is not None
                    else ""
                ),
                "rows": int(
                    len(
                        frame
                    )
                ),
                "columns": int(
                    len(
                        frame.columns
                    )
                ),
                "generated_utc": (
                    GENERATED_UTC
                ),
                "forecast_sha256": str(
                    FORECAST_SHA256
                ),
            }
        )

    contents_frame = pd.DataFrame(
        content_records
    )

    source_manifest_frame = pd.DataFrame(
        source_manifest_records
    )

    write_readme_sheet(
        workbook=workbook,
        package=package,
        contents_frame=contents_frame,
    )

    write_contents_sheet(
        workbook=workbook,
        contents_frame=contents_frame,
    )

    for item in package[
        "prepared_items"
    ]:
        write_dataframe_sheet(
            workbook=workbook,
            requested_sheet_name=item[
                "sheet_name"
            ],
            title=(
                f"{item['item_id']} — "
                f"{item['title']}"
            ),
            caption=item.get(
                "caption",
                "",
            ),
            note=item.get(
                "note",
                "",
            ),
            source=item.get(
                "source",
                "",
            ),
            frame=item[
                "frame"
            ],
        )

    write_dataframe_sheet(
        workbook=workbook,
        requested_sheet_name=(
            "SOURCE_MANIFEST"
        ),
        title=(
            "Source manifest and reproducibility hashes"
        ),
        caption=(
            "Canonical source path, dimensions, and SHA-256 hash "
            "for every imported table."
        ),
        note=(
            "Custom editorial guide sheets have no external source-file "
            "hash and are identified by their source descriptions."
        ),
        source="Cell 07B",
        frame=source_manifest_frame,
    )

    workbook.properties.title = package[
        "title"
    ]

    workbook.properties.subject = (
        "Supplementary material for the Actionable Emergence analysis"
    )

    workbook.properties.creator = (
        "Canonical AE analysis workflow"
    )

    workbook.properties.description = (
        package[
            "purpose"
        ]
    )

    workbook.properties.keywords = (
        "hydrology, actionable emergence, AE1, AE2, AE3, "
        "supplementary material"
    )

    workbook.properties.created = datetime.now(
        timezone.utc
    ).replace(
        tzinfo=None
    )

    output_path = (
        OUTPUT_DIR
        / package[
            "filename"
        ]
    )

    workbook.save(
        output_path
    )

    return (
        output_path,
        source_manifest_frame,
    )


