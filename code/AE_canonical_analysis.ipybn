# 22. HUMAN-READABLE REPORT
# ============================================================

print("=" * 100)
print("CELL 04 — AE3 CROSS-VALIDATED DECISION VALUE")
print("=" * 100)

if ARCHIVE_DIRECTORY is not None:
    print("\nSuperseded AE3 outputs archived at:")
    print(ARCHIVE_DIRECTORY)


print("\nDECISION DESIGN")
print("-" * 100)
print(
    f"Components:                    {', '.join(COMPONENT_ORDER)}"
)
print(
    f"Actions:                       {ACTION_LEVELS.tolist()}"
)
print(
    "Loss:                          "
    "max(0, q - pi - eta*a)^2 + gamma*a^2"
)
print(
    f"Default drought threshold:     {DEFAULT_DROUGHT_SCORE_THRESHOLD:.2f}"
)
print(
    f"Default action effectiveness:  {DEFAULT_ACTION_EFFECTIVENESS:.2f}"
)
print(
    f"Default action-cost ratio:     {DEFAULT_ACTION_COST_RATIO:.2f}"
)
print(
    "Decision validation:           Leave-one-control-point-out"
)
print(
    f"Bootstrap replicates:          {BOOTSTRAP_REPLICATES:,}"
)
print(
    f"Inference scope:               {AE3_INFERENCE_SCOPE}"
)


print("\nMERGE VALIDATION")
print("-" * 100)
print(
    f"Expected inference rows:       {expected_inference_rows}"
)
print(
    f"Observed inference rows:       {len(AE3_MONTHLY_INFERENCE)}"
)
