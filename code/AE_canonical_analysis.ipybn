# ============================================================
# 19. NORMALIZE AE2 SENSITIVITY
# ============================================================

def normalize_ae2_sensitivity(
    frame: pd.DataFrame,
) -> tuple[
    pd.DataFrame,
    str,
]:
    """
    Normalize the canonical AE2 sensitivity table.

    Output columns
    --------------
    input_kind
    scenario
    criterion
    effect_threshold_pp
    persistence_months
    longest_run_months
    inference_scope
    """
    data = frame.copy()

    component_column = first_existing_column(
        data,
        [
            "input_kind",
            "component",
        ],
    )

    scenario_column = first_existing_column(
        data,
        [
            "scenario",
        ],
    )

    threshold_column = first_existing_column(
        data,
        [
            "effect_threshold_pp",
            "practical_effect_threshold_pp",
            "delta_threshold_pp",
            "minimum_effect_pp",
            "delta_pp",
            "effect_size_threshold_pp",
        ],
    )

    persistence_column = first_existing_column(
        data,
        [
            "persistence_months",
            "required_persistence_months",
            "persistence_requirement_months",
            "run_length_months",
        ],
    )

    scope_column = first_existing_column(
        data,
        [
            "inference_scope",
            "scope",
            "band_scope",
            "inference_level",
            "inference_type",
        ],
    )

    criterion_column = first_existing_column(
        data,
        [
            "gate_type",
            "criterion",
            "emergence_type",
            "direction_mode",
            "effect_type",
        ],
    )

    if (
        component_column is None
        or scenario_column is None
        or threshold_column is None
        or persistence_column is None
    ):
        raise KeyError(
            "Could not normalize the AE2 sensitivity table.\n"
            f"Available columns: {list(data.columns)}"
        )

    scope_label = (
        "Joint simultaneous AE2 inference"
    )

    # Prefer explicit joint-simultaneous rows.
    if scope_column is not None:
        normalized_scope = (
            data[
                scope_column
            ]
            .astype(
                str
            )
            .str.lower()
        )

        joint_mask = (
            normalized_scope.str.contains(
                "joint",
                na=False,
            )
        )

        if not joint_mask.any():
            raise RuntimeError(
                "Figure 7 requires joint-simultaneous AE2 "
                "sensitivity, but no joint rows were found in "
                f"column '{scope_column}'."
            )

        data = data.loc[
            joint_mask
        ].copy()

    elif criterion_column is not None:
        criterion_text = (
            data[
                criterion_column
            ]
            .astype(
                str
            )
            .str.lower()
        )

        joint_mask = (
            criterion_text.str.contains(
                "joint",
                na=False,
            )
        )

        if joint_mask.any():
            data = data.loc[
                joint_mask
            ].copy()

    longest_run_column = first_existing_column(
        data,
        [
            "longest_run_months",
            "maximum_run_months",
            "max_run_months",
            "longest_qualifying_run_months",
        ],
    )

    if longest_run_column is None:
        longest_run_column = resolve_column(
            data,
            required_tokens=[
                "longest",
                "run",
            ],
            prefer_tokens=[
                "month",
            ],
            required=False,
        )

    # Long-format sensitivity table.
    if (
        criterion_column is not None
        and longest_run_column
        is not None
    ):
        criterion_text = (
            data[
                criterion_column
            ]
            .astype(
                str
            )
            .str.lower()
        )

        criterion_values = np.where(
            criterion_text.str.contains(
                "direction",
                na=False,
            ),
            "directional",
            "magnitude",
        )

        output = pd.DataFrame(
            {
                "input_kind": (
                    data[
                        component_column
                    ]
                    .astype(
                        str
                    )
                    .str.strip()
                ),
                "scenario": (
                    data[
                        scenario_column
                    ]
                    .astype(
                        str
                    )
                    .str.strip()
                ),
                "criterion": (
                    criterion_values
                ),
                "effect_threshold_pp": (
                    pd.to_numeric(
                        data[
                            threshold_column
                        ],
                        errors="raise",
                    )
                ),
                "persistence_months": (
                    pd.to_numeric(
                        data[
                            persistence_column
                        ],
                        errors="raise",
                    ).astype(
                        int
                    )
                ),
                "longest_run_months": (
                    pd.to_numeric(
                        data[
                            longest_run_column
                        ],
                        errors="raise",
                    )
                ),
                "inference_scope": (
                    scope_label
                ),
            }
        )

        return (
            output,
            scope_label,
        )

    # Wide-format sensitivity table.
    magnitude_run_column = resolve_column(
        data,
        required_tokens=[
            "magnitude",
            "longest",
            "run",
        ],
        required=False,
    )

    directional_run_column = resolve_column(
        data,
        required_tokens=[
            "directional",
            "longest",
            "run",
        ],
        required=False,
    )

    if (
        magnitude_run_column is None
        or directional_run_column
        is None
    ):
        raise KeyError(
            "Could not identify both magnitude and directional "
            "longest-run columns in the AE2 sensitivity table.\n"
            f"Available columns: {list(data.columns)}"
        )

    records = []

    for criterion_name, result_column in [
        (
            "magnitude",
            magnitude_run_column,
        ),
        (
            "directional",
            directional_run_column,
        ),
    ]:
        temporary = pd.DataFrame(
            {
                "input_kind": (
                    data[
                        component_column
                    ]
                    .astype(
                        str
                    )
                    .str.strip()
                ),
                "scenario": (
                    data[
                        scenario_column
                    ]
                    .astype(
                        str
                    )
                    .str.strip()
                ),
                "criterion": (
                    criterion_name
                ),
                "effect_threshold_pp": (
                    pd.to_numeric(
                        data[
                            threshold_column
                        ],
                        errors="raise",
                    )
                ),
                "persistence_months": (
                    pd.to_numeric(
                        data[
                            persistence_column
                        ],
                        errors="raise",
                    ).astype(
                        int
                    )
                ),
                "longest_run_months": (
                    pd.to_numeric(
                        data[
                            result_column
                        ],
                        errors="raise",
                    )
                ),
                "inference_scope": (
                    scope_label
                ),
            }
        )

        records.append(
            temporary
        )

    return (
        pd.concat(
            records,
            ignore_index=True,
        ),
        scope_label,
    )


(
    FIGURE_7_RAW_DATA,
    FIGURE_7_SCOPE_LABEL,
) = normalize_ae2_sensitivity(
    AE2_SENSITIVITY
)

FIGURE_7_RAW_DATA = (
    FIGURE_7_RAW_DATA.loc[
        FIGURE_7_RAW_DATA[
            "input_kind"
        ].isin(
            COMPONENT_ORDER
        )
        &
        FIGURE_7_RAW_DATA[
            "scenario"
        ].isin(
            SCENARIO_ORDER
        )
        &
        FIGURE_7_RAW_DATA[
            "criterion"
        ].isin(
            [
                "magnitude",
                "directional",
            ]
        )
    ]
    .copy()
)


# ============================================================
# 20. FIGURE 7 GRID AND PERSISTENCE VALIDATION
# ============================================================

effect_thresholds = sorted(
    FIGURE_7_RAW_DATA[
        "effect_threshold_pp"
    ]
    .dropna()
    .unique()
    .tolist()
)

persistence_levels = sorted(
    FIGURE_7_RAW_DATA[
        "persistence_months"
    ]
    .dropna()
    .unique()
    .tolist()
)

row_keys = [
    (
        component,
        scenario,
    )
    for component in COMPONENT_ORDER
    for scenario in SCENARIO_ORDER
]

column_keys = [
    (
        float(
            threshold
        ),
        int(
            persistence
        ),
    )
    for threshold in effect_thresholds
    for persistence in persistence_levels
]


figure_7_records = []

for component, scenario in row_keys:
    for threshold, persistence in column_keys:
        for criterion in [
            "magnitude",
            "directional",
        ]:
            subset = FIGURE_7_RAW_DATA.loc[
                FIGURE_7_RAW_DATA[
                    "input_kind"
                ].eq(
                    component
                )
                &
                FIGURE_7_RAW_DATA[
                    "scenario"
                ].eq(
                    scenario
                )
                &
                np.isclose(
                    FIGURE_7_RAW_DATA[
                        "effect_threshold_pp"
                    ],
                    threshold,
                    atol=NUMERICAL_ATOL,
                    rtol=0.0,
                )
                &
                FIGURE_7_RAW_DATA[
                    "persistence_months"
                ].eq(
                    persistence
                )
                &
                FIGURE_7_RAW_DATA[
                    "criterion"
                ].eq(
                    criterion
                )
            ]

            if subset.empty:
                raw_longest_run = 0.0
            else:
                raw_longest_run = float(
                    subset[
                        "longest_run_months"
                    ].max()
                )

            displayed_run = (
                raw_longest_run
                if raw_longest_run
                >= persistence
                else 0.0
            )

            figure_7_records.append(
                {
                    "input_kind": (
                        component
                    ),
                    "scenario": (
                        scenario
                    ),
                    "criterion": (
                        criterion
                    ),
                    "effect_threshold_pp": (
                        threshold
                    ),
                    "persistence_months": (
                        persistence
                    ),
                    "raw_longest_run_months": (
                        raw_longest_run
                    ),
                    "displayed_longest_run_months": (
                        displayed_run
                    ),
                    "inference_scope": (
                        FIGURE_7_SCOPE_LABEL
                    ),
                }
            )


FIGURE_7_DATA = pd.DataFrame(
    figure_7_records
)

invalid_figure_7_rows = (
    FIGURE_7_DATA.loc[
        (
            FIGURE_7_DATA[
                "displayed_longest_run_months"
            ]
            > 0
        )
        &
        (
            FIGURE_7_DATA[
                "displayed_longest_run_months"
            ]
            <
            FIGURE_7_DATA[
                "persistence_months"
            ]
        )
    ]
)

if not invalid_figure_7_rows.empty:
    raise RuntimeError(
        "Figure 7 validation failed: at least one displayed "
        "run is shorter than the required persistence."
    )


FIGURE_7_DATA_PATH = (
    FIGURE_DATA_DIR
    / "Figure_7_AE2_joint_sensitivity_data.csv"
)

FIGURE_7_DATA.to_csv(
    FIGURE_7_DATA_PATH,
    index=False,
)


# ============================================================
# 21. FIGURE 7 — JOINT AE2 SENSITIVITY
# ============================================================

maximum_displayed_run = max(
    1.0,
    float(
        FIGURE_7_DATA[
            "displayed_longest_run_months"
        ].max()
    ),
)

sensitivity_cmap = (
    LinearSegmentedColormap.from_list(
        "ae2_joint_sensitivity",
        [
            "#F4F4F4",
            "#F4D9AE",
            "#E9B44C",
            "#A36407",
        ],
    )
)

figure_7, axes_7 = plt.subplots(
    nrows=1,
    ncols=2,
    figsize=FIGURE_SIZES[
        "Figure_7"
    ],
    sharey=False,
)

criterion_titles = {
    "magnitude": (
        "Magnitude-based AE2"
    ),
    "directional": (
        "Direction-consistent AE2"
    ),
}

row_labels_7 = [
    (
        f"{component} — "
        f"{scenario}"
    )
    for component, scenario
    in row_keys
]

column_labels_7 = [
    (
        rf"$\delta={threshold:g}$"
        "\n"
        rf"$r={persistence}$"
    )
    for threshold, persistence
    in column_keys
]


for axis_index, criterion in enumerate(
    [
        "magnitude",
        "directional",
    ]
):
    axis = axes_7[
        axis_index
    ]

    value_matrix = np.zeros(
        (
            len(
                row_keys
            ),
            len(
                column_keys
            ),
        ),
        dtype=float,
    )

    for row_index, (
        component,
        scenario,
    ) in enumerate(
        row_keys
    ):
        for column_index, (
            threshold,
            persistence,
        ) in enumerate(
            column_keys
        ):
            match = FIGURE_7_DATA.loc[
                FIGURE_7_DATA[
                    "input_kind"
                ].eq(
                    component
                )
                &
                FIGURE_7_DATA[
                    "scenario"
                ].eq(
                    scenario
                )
                &
                FIGURE_7_DATA[
                    "criterion"
                ].eq(
                    criterion
                )
                &
                np.isclose(
                    FIGURE_7_DATA[
                        "effect_threshold_pp"
                    ],
                    threshold,
                    atol=NUMERICAL_ATOL,
                    rtol=0.0,
                )
                &
                FIGURE_7_DATA[
                    "persistence_months"
                ].eq(
                    persistence
                )
            ]

            if not match.empty:
                value_matrix[
                    row_index,
                    column_index,
                ] = float(
                    match[
                        "displayed_longest_run_months"
                    ].iloc[
                        0
                    ]
                )

    image_7 = axis.imshow(
        value_matrix,
        cmap=sensitivity_cmap,
        vmin=0,
        vmax=maximum_displayed_run,
        aspect="auto",
        interpolation="nearest",
    )

    axis.set_xticks(
        np.arange(
            len(
                column_keys
            )
        )
    )

    axis.set_xticklabels(
        column_labels_7,
        rotation=90,
        ha="center",
        va="top",
        fontsize=7.0,
    )

    axis.set_yticks(
        np.arange(
            len(
                row_keys
            )
        )
    )

    if axis_index == 0:
        axis.set_yticklabels(
            row_labels_7,
            fontsize=8,
        )

    else:
        axis.set_yticklabels(
            []
        )

        axis.tick_params(
            axis="y",
            left=False,
            labelleft=False,
        )

    for row_index in range(
        value_matrix.shape[
            0
        ]
    ):
        for column_index in range(
            value_matrix.shape[
                1
            ]
        ):
            value = value_matrix[
                row_index,
                column_index,
            ]

            text_color = (
                "white"
                if value
                > (
                    0.55
                    * maximum_displayed_run
                )
                else "black"
            )

            axis.text(
                column_index,
                row_index,
                str(
                    int(
                        round(
                            value
                        )
                    )
                ),
                ha="center",
                va="center",
                fontsize=7.5,
                color=text_color,
                fontweight=(
                    "bold"
                    if value > 0
                    else "normal"
                ),
            )

    axis.set_xticks(
        np.arange(
            -0.5,
            len(
                column_keys
            ),
            1,
        ),
        minor=True,
    )

    axis.set_yticks(
        np.arange(
            -0.5,
            len(
                row_keys
            ),
            1,
        ),
        minor=True,
    )

    axis.grid(
        which="minor",
        color="white",
        linestyle="-",
        linewidth=1.5,
    )

    axis.tick_params(
        which="minor",
        bottom=False,
        left=False,
    )

    # Visual separators between delta groups.
    for separator_index in range(
        len(
            persistence_levels
        ),
        len(
            column_keys
        ),
        len(
            persistence_levels
        ),
    ):
        axis.axvline(
            separator_index
            - 0.5,
            color="#B7B7B7",
            linewidth=1.2,
            zorder=5,
        )

    for spine in axis.spines.values():
        spine.set_visible(
            False
        )

    axis.set_title(
        criterion_titles[
            criterion
        ],
        fontweight="bold",
    )

    add_panel_label(
        axis,
        (
            "a"
            if axis_index == 0
            else "b"
        ),
        x=-0.15,
        y=1.07,
    )


colorbar_axis_7 = figure_7.add_axes(
    [
        0.92,
        0.22,
        0.018,
        0.54,
    ]
)

colorbar_7 = figure_7.colorbar(
    image_7,
    cax=colorbar_axis_7,
)

colorbar_7.set_label(
    (
        "Longest qualifying run "
        "(months)"
    ),
    fontsize=8,
)

figure_7.suptitle(
    (
        "AE2 joint-emergence sensitivity to practical "
        "effect threshold and persistence"
    ),
    x=0.02,
    y=0.985,
    ha="left",
    fontweight="bold",
)

figure_7.text(
    0.5,
    0.055,
    (
        "Effect threshold and persistence requirement"
    ),
    ha="center",
    va="center",
    fontsize=9,
)

figure_7.text(
    0.02,
    0.012,
    (
        "Inference source: joint simultaneous AE2 inference. "
        "A run is displayed only when its duration meets the "
        "corresponding persistence requirement."
    ),
    ha="left",
    va="bottom",
    fontsize=7.3,
    color="#555555",
)

figure_7.subplots_adjust(
    left=0.25,
    right=0.89,
    top=0.87,
    bottom=0.19,
    wspace=0.13,
)


