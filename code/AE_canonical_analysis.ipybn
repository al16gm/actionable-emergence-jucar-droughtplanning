    )
    * sum(
        EXPECTED_HORIZONS.values()
    )
)

if len(
    MONTHLY_AE1
) != expected_monthly_ae1_rows:
    raise RuntimeError(
        "Unexpected AE3 monthly rows within AE1.\n"
        f"Expected: {expected_monthly_ae1_rows}\n"
        f"Observed: {len(MONTHLY_AE1)}"
    )


# ============================================================
# 9. POOLED RUV
# ============================================================

monthly_point_value = (
    POINT_AE1.groupby(
        [
            "input_kind",
            "scenario",
            "lead_months",
            "target_date",
        ],
        dropna=False,
    )
    .agg(
        n_control_points=(
            "point_id",
            "nunique",
        ),

        mean_scenario_conditioning_value=(
            "scenario_conditioning_value",
            "mean",
        ),

        sum_scenario_conditioning_value=(
            "scenario_conditioning_value",
            "sum",
        ),

        sum_reference_regret=(
            "reference_regret",
            "sum",
        ),

        mean_policy_value_vs_no_action=(
            "policy_value_vs_no_action",
            "mean",
        ),

        sum_policy_value_vs_no_action=(
            "policy_value_vs_no_action",
            "sum",
        ),

        sum_no_action_regret=(
            "no_action_regret",
            "sum",
        ),
    )
    .reset_index()
)


pooled_ruv_records: list[
    dict[str, Any]
] = []

for (
    component,
    scenario,
), group in POINT_AE1.groupby(
    [
        "input_kind",
        "scenario",
    ],
    dropna=False,
):
    monthly_group = (
        monthly_point_value[
            monthly_point_value[
                "input_kind"
            ].eq(component)
            &
            monthly_point_value[
                "scenario"
            ].eq(scenario)
        ]
    )

    total_scenario_value = float(
        group[
            "scenario_conditioning_value"
        ].sum()
    )

    total_reference_regret = float(
        group[
            "reference_regret"
        ].sum()
    )

    total_policy_value = float(
        group[
            "policy_value_vs_no_action"
        ].sum()
    )

    total_no_action_regret = float(
        group[
            "no_action_regret"
        ].sum()
    )

    pooled_ruv_records.append(
        {
            "input_kind": component,
            "scenario": scenario,

            "Rk_months": int(
                EXPECTED_HORIZONS[
                    component
                ]
            ),

            "n_control_points": int(
                group[
                    "point_id"
                ].nunique()
            ),

            "n_point_months": int(
                len(group)
            ),

            "sum_scenario_conditioning_value": (
                total_scenario_value
            ),

            "sum_reference_policy_regret": (
                total_reference_regret
            ),

            "pooled_ruv_scenario_conditioning": (
                safe_ratio(
                    total_scenario_value,
                    total_reference_regret,
                )
            ),

            "mean_scenario_conditioning_value_per_point_month": float(
                group[
                    "scenario_conditioning_value"
                ].mean()
            ),

            "sum_policy_value_vs_no_action": (
                total_policy_value
            ),

            "sum_no_action_regret": (
                total_no_action_regret
            ),

            "pooled_ruv_policy_vs_no_action": (
                safe_ratio(
                    total_policy_value,
                    total_no_action_regret,
                )
            ),

            "mean_policy_value_per_point_month": float(
                group[
                    "policy_value_vs_no_action"
                ].mean()
            ),

            "n_months_positive_mean_scenario_value": int(
                (
                    monthly_group[
                        "mean_scenario_conditioning_value"
                    ]
                    > NUMERICAL_ATOL
                ).sum()
            ),

            "n_months_negative_mean_scenario_value": int(
                (
                    monthly_group[
                        "mean_scenario_conditioning_value"
                    ]
                    < -NUMERICAL_ATOL
                ).sum()
            ),

            "n_months_zero_mean_scenario_value": int(
                np.isclose(
                    monthly_group[
                        "mean_scenario_conditioning_value"
                    ],
                    0.0,
                    atol=NUMERICAL_ATOL,
                    rtol=0.0,
                ).sum()
            ),

            "n_months_positive_reference_regret": int(
                (
                    monthly_group[
                        "sum_reference_regret"
                    ]
                    > NUMERICAL_ATOL
                ).sum()
            ),

            "n_months_positive_no_action_regret": int(
                (
                    monthly_group[
                        "sum_no_action_regret"
                    ]
                    > NUMERICAL_ATOL
                ).sum()
            ),

            "fraction_point_months_positive_scenario_value": float(
                (
                    group[
                        "scenario_conditioning_value"
                    ]
                    > NUMERICAL_ATOL
                ).mean()
            ),

            "fraction_point_months_negative_scenario_value": float(
                (
                    group[
                        "scenario_conditioning_value"
                    ]
                    < -NUMERICAL_ATOL
                ).mean()
            ),
        }
    )

AE3_POOLED_RUV = pd.DataFrame(
    pooled_ruv_records
)


# ============================================================
# 10. REBUILD RAW MONTHLY AE2–AE3 INTERSECTIONS
# ============================================================

ae2_candidates = (
    ae2_default_gate.loc[
        ae2_default_gate[
            "scenario"
        ].isin(
            SCENARIO_ORDER
        ),
        [
            "input_kind",
            "scenario",
            "lead_months",
            "target_date",
        ]
        + required_ae2_candidate_columns,
    ]
    .copy()
)

ae3_gates = (
    MONTHLY_AE1[
        [
            "input_kind",
            "scenario",
            "lead_months",
            "target_date",
            "trustworthy_horizon_months",
            "n_control_points",
            "scenario_conditioning_value",
            "policy_value_vs_no_action",
            "AE3_exploratory_gate",
            "AE3_confirmatory_gate",
        ]
    ]
    .copy()
)

AE_FULL_MONTHLY_CANDIDATES = (
    ae3_gates.merge(
        ae2_candidates,
        on=[
            "input_kind",
            "scenario",
            "lead_months",
            "target_date",
        ],
        how="inner",
        validate="one_to_one",
    )
    .sort_values(
        [
            "input_kind",
            "scenario",
            "lead_months",
        ]
    )
    .reset_index(
        drop=True
    )
)

if (
    len(
        AE_FULL_MONTHLY_CANDIDATES
    )
    != expected_monthly_ae1_rows
):
    raise RuntimeError(
        "Unexpected number of monthly AE2–AE3 intersection rows.\n"
        f"Expected: {expected_monthly_ae1_rows}\n"
        f"Observed: {len(AE_FULL_MONTHLY_CANDIDATES)}"
    )


for gate_name, gate_spec in (
    FULL_GATE_SPECS.items()
):
    AE_FULL_MONTHLY_CANDIDATES[
        f"full_{gate_name}_candidate"
    ] = (
        AE_FULL_MONTHLY_CANDIDATES[
            gate_spec[
                "ae2_column"
            ]
        ]
        &
        AE_FULL_MONTHLY_CANDIDATES[
            gate_spec[
                "ae3_column"
            ]
        ]
    )


# ============================================================
# 11. FINAL-INTERSECTION RUN CATALOG AND PERSISTENCE
# ============================================================

run_catalog_records: list[
    dict[str, Any]
] = []

persistence_summary_records: list[
    dict[str, Any]
] = []

persistence_monthly_records: list[
    dict[str, Any]
] = []


for (
    component,
    scenario,
), group in AE_FULL_MONTHLY_CANDIDATES.groupby(
    [
        "input_kind",
        "scenario",
    ],
    dropna=False,
):
    group = (
        group.sort_values(
            "lead_months"
        )
        .reset_index(
            drop=True
        )
    )

    leads = group[
        "lead_months"
    ].to_numpy(
        dtype=int
    )

    dates = group[
        "target_date"
    ].to_numpy()

    for gate_name in (
        FULL_GATE_SPECS
    ):
        candidate_column = (
            f"full_{gate_name}_candidate"
        )

        candidate_mask = group[
            candidate_column
        ].to_numpy(
            dtype=bool
        )

        runs = extract_consecutive_runs(
            mask=candidate_mask,
            leads=leads,
            dates=dates,
        )

        for run in runs:
            run_catalog_records.append(
                {
                    "input_kind": component,
                    "scenario": scenario,
                    "gate_type": gate_name,

                    "run_id": int(
                        run[
                            "run_id"
                        ]
                    ),

                    "start_lead": int(
                        run[
                            "start_lead"
                        ]
                    ),

                    "end_lead": int(
                        run[
                            "end_lead"
                        ]
                    ),

                    "start_date": (
                        run[
                            "start_date"
                        ]
                    ),

                    "end_date": (
                        run[
                            "end_date"
                        ]
                    ),

                    "length_months": int(
                        run[
                            "length_months"
                        ]
                    ),

                    "qualifies_r1": bool(
                        run[
                            "length_months"
                        ]
                        >= 1
                    ),

                    "qualifies_r3": bool(
                        run[
                            "length_months"
                        ]
                        >= 3
                    ),

                    "qualifies_r6": bool(
                        run[
                            "length_months"
                        ]
                        >= 6
                    ),
                }
            )

        for persistence in (
            FINAL_PERSISTENCE_LEVELS
        ):
            qualifying_runs = [
                run
                for run in runs
                if run[
                    "length_months"
                ]
                >= persistence
            ]

            longest_run = max(
                (
                    run[
                        "length_months"
                    ]
                    for run in runs
                ),
                default=0,
            )

            qualifying_membership = np.zeros(
                len(group),
                dtype=bool,
            )

            qualifying_run_ids = np.zeros(
                len(group),
                dtype=int,
            )

            qualifying_id = 0

            for run in qualifying_runs:
                qualifying_id += 1

                start_position = int(
                    run[
                        "start_position"
                    ]
                )

                end_position = int(
                    run[
                        "end_position"
                    ]
                )

                qualifying_membership[
                    start_position:end_position + 1
                ] = True

                qualifying_run_ids[
                    start_position:end_position + 1
                ] = qualifying_id

            first_run = (
                qualifying_runs[0]
                if qualifying_runs
                else None
            )

            persistence_summary_records.append(
                {
                    "input_kind": component,
                    "scenario": scenario,
                    "gate_type": gate_name,

                    "persistence_months": int(
                        persistence
                    ),

                    "Rk_months": int(
                        EXPECTED_HORIZONS[
                            component
                        ]
                    ),

                    "n_control_points": int(
                        group[
                            "n_control_points"
                        ].iloc[0]
                    ),

                    "n_candidate_months": int(
                        candidate_mask.sum()
                    ),

                    "n_all_runs": int(
                        len(runs)
                    ),

                    "n_qualifying_runs": int(
                        len(
                            qualifying_runs
                        )
                    ),

                    "longest_run_months": int(
                        longest_run
                    ),

                    "emergence_detected": bool(
                        qualifying_runs
                    ),

                    "n_months_in_qualifying_runs": int(
                        qualifying_membership.sum()
                    ),

                    "first_start_lead": (
                        int(
                            first_run[
                                "start_lead"
                            ]
                        )
                        if first_run
                        is not None
                        else np.nan
                    ),

                    "first_end_lead": (
                        int(
                            first_run[
                                "end_lead"
                            ]
                        )
                        if first_run
                        is not None
                        else np.nan
                    ),

                    "first_start_date": (
                        first_run[
                            "start_date"
                        ]
                        if first_run
                        is not None
                        else pd.NaT
                    ),

                    "first_end_date": (
                        first_run[
                            "end_date"
                        ]
                        if first_run
                        is not None
                        else pd.NaT
                    ),
                }
            )

            for row_index, row in (
                group.iterrows()
            ):
                persistence_monthly_records.append(
                    {
                        "input_kind": component,
                        "scenario": scenario,
                        "gate_type": gate_name,

                        "persistence_months": int(
                            persistence
                        ),

                        "lead_months": int(
                            row[
                                "lead_months"
                            ]
                        ),

                        "target_date": pd.Timestamp(
                            row[
                                "target_date"
                            ]
                        ),

                        "candidate_month": bool(
                            candidate_mask[
                                row_index
                            ]
                        ),

                        "qualifying_run_member": bool(
                            qualifying_membership[
                                row_index
                            ]
                        ),

                        "qualifying_run_id": int(
                            qualifying_run_ids[
                                row_index
                            ]
                        ),
                    }
                )


AE_FULL_RUN_CATALOG = pd.DataFrame(
    run_catalog_records
)

AE_FULL_PERSISTENCE_SUMMARY = (
    pd.DataFrame(
        persistence_summary_records
    )
)

AE_FULL_PERSISTENCE_MONTHLY = (
    pd.DataFrame(
        persistence_monthly_records
    )
)


# ============================================================
# 12. PARAMETER-CONFIGURATION SUMMARY
# ============================================================

AE3_PARAMETER_CONFIG_SUMMARY = (
    SENSITIVITY_AE1.groupby(
        [
            "drought_score_threshold",
            "action_cost_ratio",
            "input_kind",
            "scenario",
        ],
        dropna=False,
    )
    .agg(
        Rk_months=(
            "trustworthy_horizon_months",
            "first",
        ),

        n_months=(
            "lead_months",
            "size",
        ),

        n_control_points=(
            "n_control_points",
            "first",
        ),

        mean_scenario_conditioning_value=(
            "scenario_conditioning_value",
            "mean",
        ),

        median_scenario_conditioning_value=(
            "scenario_conditioning_value",
            "median",
        ),

        minimum_scenario_conditioning_value=(
            "scenario_conditioning_value",
            "min",
        ),

        maximum_scenario_conditioning_value=(
            "scenario_conditioning_value",
            "max",
        ),

        mean_policy_value_vs_no_action=(
            "policy_value_vs_no_action",
            "mean",
        ),

        mean_action_disagreement_fraction=(
            "action_disagreement_fraction",
            "mean",
        ),

        pct_months_scenario_value_positive=(
            "scenario_conditioning_value",
            lambda values: float(
                100.0
                * (
                    values
                    > NUMERICAL_ATOL
                ).mean()
            ),
        ),

        pct_months_scenario_value_negative=(
            "scenario_conditioning_value",
            lambda values: float(
                100.0
                * (
                    values
                    < -NUMERICAL_ATOL
                ).mean()
            ),
        ),

        pct_months_policy_value_positive=(
            "policy_value_vs_no_action",
            lambda values: float(
                100.0
                * (
                    values
                    > NUMERICAL_ATOL
                ).mean()
            ),
        ),
    )
    .reset_index()
)


# ============================================================
# 13. MONTHLY ROBUSTNESS ACROSS THE NINE CONFIGURATIONS
# ============================================================

parameter_monthly_records: list[
    dict[str, Any]
] = []

for (
    component,
    scenario,
    lead,
    target_date,
), group in SENSITIVITY_AE1.groupby(
    [
        "input_kind",
        "scenario",
        "lead_months",
        "target_date",
    ],
    dropna=False,
):
    configuration_count = int(
        group[
            [
                "drought_score_threshold",
                "action_cost_ratio",
            ]
        ]
        .drop_duplicates()
        .shape[0]
    )

    values = group[
        "scenario_conditioning_value"
    ].to_numpy(
        dtype=float
    )

    policy_values = group[
        "policy_value_vs_no_action"
    ].to_numpy(
        dtype=float
    )

    minimum_value = float(
        np.min(
            values
        )
    )

    maximum_value = float(
        np.max(
            values
        )
    )

    parameter_monthly_records.append(
        {
            "input_kind": component,
            "scenario": scenario,

            "lead_months": int(
                lead
            ),

            "target_date": pd.Timestamp(
                target_date
            ),

            "n_parameter_configurations": (
                configuration_count
            ),

            "minimum_scenario_conditioning_value": (
                minimum_value
            ),

            "median_scenario_conditioning_value": float(
                np.median(
                    values
                )
            ),

            "maximum_scenario_conditioning_value": (
                maximum_value
            ),

            "mean_scenario_conditioning_value": float(
                np.mean(
                    values
                )
            ),

            "n_configurations_positive_scenario_value": int(
                np.sum(
                    values
                    > NUMERICAL_ATOL
                )
            ),

            "n_configurations_negative_scenario_value": int(
                np.sum(
                    values
                    < -NUMERICAL_ATOL
                )
            ),

            "n_configurations_zero_scenario_value": int(
                np.sum(
                    np.isclose(
                        values,
                        0.0,
                        atol=NUMERICAL_ATOL,
                        rtol=0.0,
                    )
                )
            ),

            "pct_configurations_positive_scenario_value": float(
                100.0
                * np.mean(
                    values
                    > NUMERICAL_ATOL
                )
            ),

            "all_configurations_positive_scenario_value": bool(
                np.all(
                    values
                    > NUMERICAL_ATOL
                )
            ),

            "all_configurations_nonnegative_scenario_value": bool(
                np.all(
                    values
                    >= -NUMERICAL_ATOL
                )
            ),

            "scenario_value_sign_stability": (
                classify_sign_stability(
                    minimum_value,
                    maximum_value,
                )
            ),

            "minimum_policy_value_vs_no_action": float(
                np.min(
                    policy_values
                )
            ),

            "median_policy_value_vs_no_action": float(
                np.median(
                    policy_values
                )
            ),

            "maximum_policy_value_vs_no_action": float(
                np.max(
                    policy_values
                )
            ),

            "all_configurations_positive_policy_value": bool(
                np.all(
                    policy_values
                    > NUMERICAL_ATOL
                )
            ),

            "all_configurations_nonnegative_policy_value": bool(
                np.all(
                    policy_values
                    >= -NUMERICAL_ATOL
                )
            ),
        }
    )

AE3_PARAMETER_ROBUSTNESS_MONTHLY = (
    pd.DataFrame(
        parameter_monthly_records
    )
)


# ============================================================
# 14. AGGREGATED PARAMETER ROBUSTNESS
# ============================================================

parameter_robustness_records: list[
    dict[str, Any]
] = []

for (
    component,
    scenario,
), config_group in AE3_PARAMETER_CONFIG_SUMMARY.groupby(
    [
        "input_kind",
        "scenario",
    ],
    dropna=False,
):
    monthly_group = (
        AE3_PARAMETER_ROBUSTNESS_MONTHLY[
            AE3_PARAMETER_ROBUSTNESS_MONTHLY[
                "input_kind"
            ].eq(component)
            &
            AE3_PARAMETER_ROBUSTNESS_MONTHLY[
                "scenario"
            ].eq(scenario)
        ]
    )

    configuration_count = int(
        config_group[
            [
                "drought_score_threshold",
                "action_cost_ratio",
            ]
        ]
        .drop_duplicates()
        .shape[0]
    )

    minimum_index = (
        config_group[
            "mean_scenario_conditioning_value"
        ].idxmin()
    )

    maximum_index = (
        config_group[
            "mean_scenario_conditioning_value"
        ].idxmax()
    )

    minimum_row = config_group.loc[
        minimum_index
    ]

    maximum_row = config_group.loc[
        maximum_index
    ]

    configuration_values = config_group[
        "mean_scenario_conditioning_value"
    ].to_numpy(
        dtype=float
    )

    parameter_robustness_records.append(
        {
            "input_kind": component,
            "scenario": scenario,

            "n_parameter_configurations": (
                configuration_count
            ),

            "n_configurations_positive_mean_scenario_value": int(
                np.sum(
                    configuration_values
                    > NUMERICAL_ATOL
                )
            ),

            "n_configurations_negative_mean_scenario_value": int(
                np.sum(
                    configuration_values
                    < -NUMERICAL_ATOL
                )
            ),

            "pct_configurations_positive_mean_scenario_value": float(
                100.0
                * np.mean(
                    configuration_values
                    > NUMERICAL_ATOL
                )
            ),

            "minimum_configuration_mean_scenario_value": float(
                np.min(
                    configuration_values
                )
            ),

            "median_configuration_mean_scenario_value": float(
                np.median(
                    configuration_values
                )
            ),

            "maximum_configuration_mean_scenario_value": float(
                np.max(
                    configuration_values
                )
            ),

            "mean_across_configuration_means": float(
                np.mean(
                    configuration_values
                )
            ),

            "configuration_mean_sign_stability": (
                classify_sign_stability(
                    float(
                        np.min(
                            configuration_values
                        )
                    ),
                    float(
                        np.max(
                            configuration_values
                        )
                    ),
                )
            ),

            "least_favourable_pi": float(
                minimum_row[
                    "drought_score_threshold"
                ]
            ),

            "least_favourable_gamma": float(
                minimum_row[
                    "action_cost_ratio"
                ]
            ),

            "least_favourable_mean_scenario_value": float(
                minimum_row[
                    "mean_scenario_conditioning_value"
                ]
            ),

            "most_favourable_pi": float(
                maximum_row[
                    "drought_score_threshold"
                ]
            ),

            "most_favourable_gamma": float(
                maximum_row[
                    "action_cost_ratio"
                ]
            ),

            "most_favourable_mean_scenario_value": float(
                maximum_row[
                    "mean_scenario_conditioning_value"
                ]
            ),

            "minimum_configuration_mean_policy_value": float(
                config_group[
                    "mean_policy_value_vs_no_action"
                ].min()
            ),

            "median_configuration_mean_policy_value": float(
                config_group[
                    "mean_policy_value_vs_no_action"
                ].median()
            ),

            "maximum_configuration_mean_policy_value": float(
                config_group[
                    "mean_policy_value_vs_no_action"
                ].max()
            ),

            "n_months_all_configurations_positive_scenario_value": int(
                monthly_group[
                    "all_configurations_positive_scenario_value"
                ].sum()
            ),

            "n_months_all_configurations_nonnegative_scenario_value": int(
                monthly_group[
                    "all_configurations_nonnegative_scenario_value"
                ].sum()
            ),

            "n_months_mixed_scenario_value_sign": int(
                monthly_group[
                    "scenario_value_sign_stability"
                ].eq(
                    "mixed_sign"
                ).sum()
            ),

            "n_months_all_configurations_positive_policy_value": int(
                monthly_group[
                    "all_configurations_positive_policy_value"
                ].sum()
            ),

            "mean_action_disagreement_fraction_across_configurations": float(
                config_group[
                    "mean_action_disagreement_fraction"
                ].mean()
            ),

            "minimum_action_disagreement_fraction_across_configurations": float(
                config_group[
                    "mean_action_disagreement_fraction"
                ].min()
            ),

            "maximum_action_disagreement_fraction_across_configurations": float(
                config_group[
                    "mean_action_disagreement_fraction"
                ].max()
            ),
        }
    )

AE3_PARAMETER_ROBUSTNESS_SUMMARY = (
    pd.DataFrame(
        parameter_robustness_records
    )
)


# ============================================================
# 15. ACTION-TRANSITION VARIABLES
# ============================================================

ACTION_DATA = POINT_AE1.copy()

ACTION_DATA[
    "action_delta"
] = (
    ACTION_DATA[
        "scenario_action"
    ]
    - ACTION_DATA[
        "reference_action"
    ]
)

ACTION_DATA[
    "action_increased"
] = (
    ACTION_DATA[
        "action_delta"
    ]
    > NUMERICAL_ATOL
)

ACTION_DATA[
    "action_decreased"
] = (
    ACTION_DATA[
        "action_delta"
    ]
    < -NUMERICAL_ATOL
)

ACTION_DATA[
    "action_unchanged"
] = np.isclose(
    ACTION_DATA[
        "action_delta"
    ],
    0.0,
    atol=NUMERICAL_ATOL,
    rtol=0.0,
)

ACTION_DATA[
    "action_change_direction"
] = np.select(
    [
        ACTION_DATA[
            "action_increased"
        ],
        ACTION_DATA[
            "action_decreased"
        ],
    ],
    [
        "increase",
        "decrease",
    ],
    default="unchanged",
)

ACTION_DATA[
    "action_transition"
] = [
    transition_label(
        reference_action,
        scenario_action,
    )
    for (
        reference_action,
        scenario_action,
    ) in zip(
        ACTION_DATA[
            "reference_action"
        ],
        ACTION_DATA[
            "scenario_action"
        ],
    )
]

ACTION_DATA[
    "scenario_value_positive"
] = (
    ACTION_DATA[
        "scenario_conditioning_value"
    ]
    > NUMERICAL_ATOL
)

ACTION_DATA[
    "scenario_value_negative"
] = (
    ACTION_DATA[
        "scenario_conditioning_value"
    ]
    < -NUMERICAL_ATOL
)

ACTION_DATA[
    "scenario_value_zero"
] = np.isclose(
    ACTION_DATA[
        "scenario_conditioning_value"
    ],
    0.0,
    atol=NUMERICAL_ATOL,
    rtol=0.0,
)


# ============================================================
# 16. ACTION-TRANSITION TABLE
# ============================================================

AE3_ACTION_TRANSITIONS = (
    ACTION_DATA.groupby(
        [
            "input_kind",
            "scenario",
            "reference_action",
            "scenario_action",
            "action_transition",
            "action_change_direction",
        ],
        dropna=False,
    )
    .agg(
        n_point_months=(
            "point_id",
            "size",
        ),

        n_unique_points=(
            "point_id",
            "nunique",
        ),

        n_unique_months=(
            "lead_months",
            "nunique",
        ),

        mean_action_delta=(
            "action_delta",
            "mean",
        ),

        sum_scenario_conditioning_value=(
            "scenario_conditioning_value",
            "sum",
        ),

        mean_scenario_conditioning_value=(
            "scenario_conditioning_value",
            "mean",
        ),

        sum_policy_value_vs_no_action=(
            "policy_value_vs_no_action",
            "sum",
        ),

        mean_policy_value_vs_no_action=(
            "policy_value_vs_no_action",
            "mean",
        ),

        n_positive_scenario_value=(
            "scenario_value_positive",
            "sum",
        ),

        n_negative_scenario_value=(
            "scenario_value_negative",
            "sum",
        ),

        n_zero_scenario_value=(
            "scenario_value_zero",
            "sum",
        ),
    )
    .reset_index()
)

transition_totals = (
    AE3_ACTION_TRANSITIONS.groupby(
        [
            "input_kind",
            "scenario",
        ],
        dropna=False,
    )[
        "n_point_months"
    ]
    .sum()
    .reset_index(
        name="total_point_months"
    )
)

AE3_ACTION_TRANSITIONS = (
    AE3_ACTION_TRANSITIONS.merge(
        transition_totals,
        on=[
            "input_kind",
            "scenario",
        ],
        how="left",
        validate="many_to_one",
    )
)

AE3_ACTION_TRANSITIONS[
    "fraction_of_component_scenario_point_months"
] = (
    AE3_ACTION_TRANSITIONS[
        "n_point_months"
    ]
    / AE3_ACTION_TRANSITIONS[
        "total_point_months"
    ]
)


# ============================================================
# 17. MONTHLY ACTION DIAGNOSTICS
# ============================================================

AE3_ACTION_MONTHLY = (
    ACTION_DATA.groupby(
        [
            "input_kind",
            "scenario",
            "lead_months",
            "target_date",
        ],
        dropna=False,
    )
    .agg(
        n_control_points=(
            "point_id",
            "nunique",
        ),

        mean_reference_action=(
            "reference_action",
            "mean",
        ),

        mean_scenario_action=(
            "scenario_action",
            "mean",
        ),

        mean_action_delta=(
            "action_delta",
            "mean",
        ),

        action_changed_fraction=(
            "action_changed",
            "mean",
        ),

        action_increased_fraction=(
            "action_increased",
            "mean",
        ),

        action_decreased_fraction=(
            "action_decreased",
            "mean",
        ),

        action_unchanged_fraction=(
            "action_unchanged",
            "mean",
        ),

        mean_scenario_conditioning_value=(
            "scenario_conditioning_value",
            "mean",
        ),

        sum_scenario_conditioning_value=(
            "scenario_conditioning_value",
            "sum",
        ),

        mean_policy_value_vs_no_action=(
            "policy_value_vs_no_action",
            "mean",
        ),

        fraction_points_positive_scenario_value=(
            "scenario_value_positive",
            "mean",
        ),

        fraction_points_negative_scenario_value=(
            "scenario_value_negative",
            "mean",
        ),

        fraction_points_zero_scenario_value=(
            "scenario_value_zero",
            "mean",
        ),
    )
    .reset_index()
)

AE3_ACTION_MONTHLY[
    "monthly_scenario_value_positive"
] = (
    AE3_ACTION_MONTHLY[
        "mean_scenario_conditioning_value"
    ]
    > NUMERICAL_ATOL
)

AE3_ACTION_MONTHLY[
    "monthly_scenario_value_negative"
] = (
    AE3_ACTION_MONTHLY[
        "mean_scenario_conditioning_value"
    ]
    < -NUMERICAL_ATOL
)

AE3_ACTION_MONTHLY[
    "monthly_scenario_value_zero"
] = np.isclose(
    AE3_ACTION_MONTHLY[
        "mean_scenario_conditioning_value"
    ],
    0.0,
    atol=NUMERICAL_ATOL,
    rtol=0.0,
)

AE3_NEGATIVE_SCENARIO_VALUE_MONTHS = (
    AE3_ACTION_MONTHLY.loc[
        AE3_ACTION_MONTHLY[
            "monthly_scenario_value_negative"
        ]
    ]
    .sort_values(
        [
            "input_kind",
            "scenario",
            "mean_scenario_conditioning_value",
        ]
    )
    .reset_index(
        drop=True
    )
)


# ============================================================
# 18. AGGREGATED ACTION SUMMARY
# ============================================================

action_summary_records: list[
    dict[str, Any]
] = []

for (
    component,
    scenario,
), group in ACTION_DATA.groupby(
    [
        "input_kind",
        "scenario",
    ],
    dropna=False,
):
    monthly_group = (
        AE3_ACTION_MONTHLY[
            AE3_ACTION_MONTHLY[
                "input_kind"
            ].eq(component)
            &
            AE3_ACTION_MONTHLY[
                "scenario"
            ].eq(scenario)
        ]
    )

    changed = group[
        "action_changed"
    ].to_numpy(
        dtype=bool
    )

    increased = group[
        "action_increased"
    ].to_numpy(
        dtype=bool
    )

    decreased = group[
        "action_decreased"
    ].to_numpy(
        dtype=bool
    )

    unchanged = group[
        "action_unchanged"
    ].to_numpy(
        dtype=bool
    )

    transition_counts = (
        group[
            "action_transition"
        ]
        .value_counts()
    )

    most_common_transition = str(
        transition_counts.index[0]
    )

    action_summary_records.append(
        {
            "input_kind": component,
            "scenario": scenario,

            "Rk_months": int(
                EXPECTED_HORIZONS[
                    component
                ]
            ),

            "n_control_points": int(
                group[
                    "point_id"
                ].nunique()
            ),

            "n_point_months": int(
                len(group)
            ),

            "n_months": int(
                monthly_group[
                    "lead_months"
                ].nunique()
            ),

            "fraction_point_months_action_changed": float(
                np.mean(
                    changed
                )
            ),

            "fraction_point_months_action_increased": float(
                np.mean(
                    increased
                )
            ),

            "fraction_point_months_action_decreased": float(
                np.mean(
                    decreased
                )
            ),

            "fraction_point_months_action_unchanged": float(
                np.mean(
                    unchanged
                )
            ),

            "mean_reference_action": float(
                group[
                    "reference_action"
                ].mean()
            ),

            "mean_scenario_action": float(
                group[
                    "scenario_action"
                ].mean()
            ),

            "mean_action_delta": float(
                group[
                    "action_delta"
                ].mean()
            ),

            "n_months_with_any_action_change": int(
                (
                    monthly_group[
                        "action_changed_fraction"
                    ]
                    > NUMERICAL_ATOL
                ).sum()
            ),

            "n_months_majority_points_changed": int(
                (
                    monthly_group[
                        "action_changed_fraction"
                    ]
                    > 0.5
                ).sum()
            ),

            "n_months_mean_scenario_value_positive": int(
                monthly_group[
                    "monthly_scenario_value_positive"
                ].sum()
            ),

            "n_months_mean_scenario_value_negative": int(
                monthly_group[
                    "monthly_scenario_value_negative"
                ].sum()
            ),

            "n_months_mean_scenario_value_zero": int(
                monthly_group[
                    "monthly_scenario_value_zero"
                ].sum()
            ),

            "sum_scenario_value_all_point_months": float(
                group[
                    "scenario_conditioning_value"
                ].sum()
            ),

            "sum_scenario_value_changed_actions": float(
                group.loc[
                    changed,
                    "scenario_conditioning_value",
                ].sum()
            ),

            "sum_scenario_value_unchanged_actions": float(
                group.loc[
                    unchanged,
                    "scenario_conditioning_value",
                ].sum()
            ),

            "sum_scenario_value_action_increases": float(
                group.loc[
                    increased,
                    "scenario_conditioning_value",
                ].sum()
            ),

            "sum_scenario_value_action_decreases": float(
                group.loc[
                    decreased,
                    "scenario_conditioning_value",
                ].sum()
            ),

            "mean_scenario_value_changed_actions": (
                float(
                    group.loc[
                        changed,
                        "scenario_conditioning_value",
                    ].mean()
                )
                if np.any(
                    changed
                )
                else np.nan
            ),

            "mean_scenario_value_action_increases": (
                float(
                    group.loc[
                        increased,
                        "scenario_conditioning_value",
                    ].mean()
                )
                if np.any(
                    increased
                )
                else np.nan
            ),

            "mean_scenario_value_action_decreases": (
                float(
                    group.loc[
                        decreased,
                        "scenario_conditioning_value",
                    ].mean()
                )
                if np.any(
                    decreased
                )
                else np.nan
            ),

            "fraction_point_months_negative_scenario_value": float(
                group[
                    "scenario_value_negative"
                ].mean()
            ),

            "fraction_point_months_positive_scenario_value": float(
                group[
                    "scenario_value_positive"
                ].mean()
            ),

            "n_distinct_action_transitions": int(
                group[
                    "action_transition"
                ].nunique()
            ),

            "most_common_action_transition": (
                most_common_transition
            ),

            "most_common_transition_fraction": float(
                transition_counts.iloc[0]
                / len(group)
            ),
        }
    )

AE3_ACTION_SUMMARY = pd.DataFrame(
    action_summary_records
)


# ============================================================
# 19. CONSOLIDATED COMPONENT–SCENARIO SUMMARY
# ============================================================

persistence_default = (
    AE_FULL_PERSISTENCE_SUMMARY.loc[
        AE_FULL_PERSISTENCE_SUMMARY[
            "persistence_months"
        ].eq(
            DEFAULT_FINAL_PERSISTENCE
        )
    ]
    .copy()
)

persistence_detected_wide = (
    persistence_default.pivot(
        index=[
            "input_kind",
            "scenario",
        ],
        columns="gate_type",
        values="emergence_detected",
    )
    .add_prefix(
        "full_AE_r3_detected_"
    )
    .reset_index()
)

persistence_longest_wide = (
    persistence_default.pivot(
        index=[
            "input_kind",
            "scenario",
        ],
        columns="gate_type",
        values="longest_run_months",
    )
    .add_prefix(
        "full_AE_longest_run_"
    )
    .reset_index()
)

persistence_first_lead_wide = (
    persistence_default.pivot(
        index=[
            "input_kind",
            "scenario",
        ],
        columns="gate_type",
        values="first_start_lead",
    )
    .add_prefix(
        "full_AE_r3_first_lead_"
    )
    .reset_index()
)

AE3_CONSOLIDATED_SUMMARY = (
    AE3_POOLED_RUV.merge(
        AE3_PARAMETER_ROBUSTNESS_SUMMARY,
        on=[
            "input_kind",
            "scenario",
        ],
        how="inner",
        validate="one_to_one",
        suffixes=(
            "",
            "_parameter",
        ),
    )
    .merge(
        AE3_ACTION_SUMMARY,
        on=[
            "input_kind",
            "scenario",
        ],
        how="inner",
        validate="one_to_one",
        suffixes=(
            "",
            "_action",
        ),
    )
    .merge(
        persistence_detected_wide,
        on=[
            "input_kind",
            "scenario",
        ],
        how="left",
        validate="one_to_one",
    )
    .merge(
        persistence_longest_wide,
        on=[
            "input_kind",
            "scenario",
        ],
        how="left",
        validate="one_to_one",
    )
    .merge(
        persistence_first_lead_wide,
        on=[
            "input_kind",
            "scenario",
        ],
        how="left",
        validate="one_to_one",
    )
    .sort_values(
        [
            "input_kind",
            "scenario",
        ]
    )
    .reset_index(
        drop=True
    )
)


# ============================================================
# 20. VALIDATION
# ============================================================

expected_group_count = (
    len(
        COMPONENT_ORDER
    )
    * len(
        SCENARIO_ORDER
    )
)

if len(
    AE3_POOLED_RUV
) != expected_group_count:
    raise RuntimeError(
        "Unexpected pooled-RUV group count."
    )

if len(
    AE3_PARAMETER_ROBUSTNESS_SUMMARY
) != expected_group_count:
    raise RuntimeError(
        "Unexpected parameter-robustness group count."
    )

if len(
    AE3_ACTION_SUMMARY
) != expected_group_count:
    raise RuntimeError(
        "Unexpected action-summary group count."
    )

if len(
    AE3_CONSOLIDATED_SUMMARY
) != expected_group_count:
    raise RuntimeError(
        "Unexpected consolidated-summary group count."
    )


parameter_counts = (
    AE3_PARAMETER_CONFIG_SUMMARY.groupby(
        [
            "input_kind",
            "scenario",
        ],
        dropna=False,
    )
    .size()
)

if not (
    parameter_counts
    == EXPECTED_PARAMETER_CONFIGURATIONS
).all():
    raise RuntimeError(
        "Each component–scenario combination must contain "
        f"{EXPECTED_PARAMETER_CONFIGURATIONS} parameter configurations."
    )


observed_actions = np.unique(
    np.concatenate(
        [
            ACTION_DATA[
                "reference_action"
            ].to_numpy(
                dtype=float
            ),

            ACTION_DATA[
                "scenario_action"
            ].to_numpy(
                dtype=float
            ),

            ACTION_DATA[
                "perfect_action"
            ].to_numpy(
                dtype=float
            ),
        ]
    )
)

for observed_action in observed_actions:
    if not np.any(
        np.isclose(
            observed_action,
            ALLOWED_ACTIONS,
            atol=NUMERICAL_ATOL,
            rtol=0.0,
        )
    ):
        raise RuntimeError(
            "An unexpected action level was found: "
            f"{observed_action}"
        )


transition_total = int(
    AE3_ACTION_TRANSITIONS[
        "n_point_months"
    ].sum()
)

if transition_total != len(
    ACTION_DATA
):
    raise RuntimeError(
        "Action-transition counts do not reconstruct "
        "the point-level AE3 data."
    )


minimum_regret_denominator = float(
    AE3_POOLED_RUV[
        "sum_reference_policy_regret"
    ].min()
)

minimum_no_action_denominator = float(
    AE3_POOLED_RUV[
        "sum_no_action_regret"
    ].min()
)

if (
    minimum_regret_denominator
    < -NUMERICAL_ATOL
    or minimum_no_action_denominator
    < -NUMERICAL_ATOL
):
    raise RuntimeError(
        "A pooled regret denominator is negative."
    )


# ============================================================
# 21. OUTPUT PATHS
# ============================================================

CONFIG_PATH = (
    Path(PATHS["provenance"])
    / "canonical_configuration_amended_cell05.json"
)

SCOPE_PATH = (
    Path(PATHS["provenance"])
    / "analysis_scope_amendment_cell05.json"
)

POOLED_RUV_PATH = (
    CONSOLIDATION_DIR
    / "AE3_pooled_RUV_summary.csv"
)

FULL_MONTHLY_CANDIDATES_PATH = (
    CONSOLIDATION_DIR
    / "AE_full_intersection_monthly_candidates.csv"
)

FULL_RUN_CATALOG_PATH = (
    CONSOLIDATION_DIR
    / "AE_full_intersection_run_catalog.csv"
)

FULL_PERSISTENCE_SUMMARY_PATH = (
    CONSOLIDATION_DIR
    / "AE_full_intersection_persistence_summary.csv"
)

FULL_PERSISTENCE_MONTHLY_PATH = (
    CONSOLIDATION_DIR
    / "AE_full_intersection_persistence_monthly.csv"
)

PARAMETER_CONFIG_SUMMARY_PATH = (
    CONSOLIDATION_DIR
    / "AE3_parameter_configuration_summary.csv"
)

PARAMETER_ROBUSTNESS_MONTHLY_PATH = (
    CONSOLIDATION_DIR
    / "AE3_parameter_robustness_monthly.csv"
)

PARAMETER_ROBUSTNESS_SUMMARY_PATH = (
    CONSOLIDATION_DIR
    / "AE3_parameter_robustness_summary.csv"
)

ACTION_TRANSITIONS_PATH = (
    CONSOLIDATION_DIR
    / "AE3_action_transition_table.csv"
)

ACTION_MONTHLY_PATH = (
    CONSOLIDATION_DIR
    / "AE3_action_monthly_diagnostics.csv"
)

ACTION_SUMMARY_PATH = (
    CONSOLIDATION_DIR
    / "AE3_action_summary.csv"
)

NEGATIVE_MONTHS_PATH = (
    CONSOLIDATION_DIR
    / "AE3_negative_scenario_value_months.csv"
)

CONSOLIDATED_SUMMARY_PATH = (
    CONSOLIDATION_DIR
    / "AE3_consolidated_summary.csv"
)

OUTPUT_REGISTRY_PATH = (
    CONSOLIDATION_DIR
    / "cell05_output_registry.csv"
)

CELL05_REPORT_PATH = (
    Path(PATHS["logs"])
    / "cell05_ae3_consolidation_report.json"
)


# ============================================================
# 22. WRITE OUTPUTS
# ============================================================

CONFIG_AMENDED_HASH = sha256_json(
    CONFIG_AMENDED
)

with CONFIG_PATH.open(
    "w",
    encoding="utf-8",
) as handle:
    json.dump(
        CONFIG_AMENDED,
        handle,
        ensure_ascii=False,
        indent=2,
        sort_keys=True,
        default=str,
    )


AE3_POOLED_RUV.to_csv(
    POOLED_RUV_PATH,
    index=False,
)

AE_FULL_MONTHLY_CANDIDATES.to_csv(
    FULL_MONTHLY_CANDIDATES_PATH,
    index=False,
    date_format="%Y-%m-%d",
)

AE_FULL_RUN_CATALOG.to_csv(
    FULL_RUN_CATALOG_PATH,
    index=False,
    date_format="%Y-%m-%d",
)

AE_FULL_PERSISTENCE_SUMMARY.to_csv(
    FULL_PERSISTENCE_SUMMARY_PATH,
    index=False,
    date_format="%Y-%m-%d",
)

AE_FULL_PERSISTENCE_MONTHLY.to_csv(
    FULL_PERSISTENCE_MONTHLY_PATH,
    index=False,
    date_format="%Y-%m-%d",
)

AE3_PARAMETER_CONFIG_SUMMARY.to_csv(
    PARAMETER_CONFIG_SUMMARY_PATH,
    index=False,
)

AE3_PARAMETER_ROBUSTNESS_MONTHLY.to_csv(
    PARAMETER_ROBUSTNESS_MONTHLY_PATH,
    index=False,
    date_format="%Y-%m-%d",
)

AE3_PARAMETER_ROBUSTNESS_SUMMARY.to_csv(
    PARAMETER_ROBUSTNESS_SUMMARY_PATH,
    index=False,
)

AE3_ACTION_TRANSITIONS.to_csv(
    ACTION_TRANSITIONS_PATH,
    index=False,
)

AE3_ACTION_MONTHLY.to_csv(
    ACTION_MONTHLY_PATH,
    index=False,
    date_format="%Y-%m-%d",
)

AE3_ACTION_SUMMARY.to_csv(
    ACTION_SUMMARY_PATH,
    index=False,
)

AE3_NEGATIVE_SCENARIO_VALUE_MONTHS.to_csv(
    NEGATIVE_MONTHS_PATH,
    index=False,
    date_format="%Y-%m-%d",
)

AE3_CONSOLIDATED_SUMMARY.to_csv(
    CONSOLIDATED_SUMMARY_PATH,
    index=False,
)


# ============================================================
# 23. OUTPUT REGISTRY WITH HASHES
# ============================================================

output_paths = {
    "pooled_ruv": POOLED_RUV_PATH,
    "full_monthly_candidates": (
        FULL_MONTHLY_CANDIDATES_PATH
    ),
    "full_run_catalog": (
        FULL_RUN_CATALOG_PATH
    ),
    "full_persistence_summary": (
        FULL_PERSISTENCE_SUMMARY_PATH
    ),
    "full_persistence_monthly": (
        FULL_PERSISTENCE_MONTHLY_PATH
    ),
    "parameter_configuration_summary": (
        PARAMETER_CONFIG_SUMMARY_PATH
    ),
    "parameter_robustness_monthly": (
        PARAMETER_ROBUSTNESS_MONTHLY_PATH
    ),
    "parameter_robustness_summary": (
        PARAMETER_ROBUSTNESS_SUMMARY_PATH
    ),
    "action_transitions": (
        ACTION_TRANSITIONS_PATH
    ),
    "action_monthly": (
        ACTION_MONTHLY_PATH
    ),
    "action_summary": (
        ACTION_SUMMARY_PATH
    ),
    "negative_scenario_value_months": (
        NEGATIVE_MONTHS_PATH
    ),
    "consolidated_summary": (
        CONSOLIDATED_SUMMARY_PATH
    ),
}

output_registry_records = []

for output_name, output_path in (
    output_paths.items()
):
    output_registry_records.append(
        {
            "output_name": output_name,
            "path": str(
                output_path
            ),
            "size_bytes": int(
                output_path.stat().st_size
            ),
            "sha256": sha256_file(
                output_path
            ),
        }
