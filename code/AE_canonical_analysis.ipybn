## AE_canonical_analysis

# =========================================
# CELL DIAG-AE-ALL — Deep diagnostic of AE_forecast_scenarios_ALL.csv
# Purpose: fully characterize the raw scenario-conditioned forecast file
# before recomputing AE2/AE3 quantities, so nothing is assumed.
# =========================================

import pandas as pd
import numpy as np
from pathlib import Path

pd.set_option("display.max_columns", 50)
pd.set_option("display.width", 160)

# ---------- 1) LOAD ----------
# Option A: manual upload widget (Colab)
try:
    from google.colab import files
    print("Upload AE_forecast_scenarios_ALL.csv now...")
    uploaded = files.upload()
    fname = list(uploaded.keys())[0]
    path = fname
except Exception:
    # Option B: fallback if already on disk / Drive
    path = "/content/AE_forecast_scenarios_ALL.csv"
    print(f"Not in Colab upload mode, trying local path: {path}")

df = pd.read_csv(path)
print(f"\nLoaded: {path}  | shape = {df.shape}")

# ---------- 2) BASIC SCHEMA ----------
print("\n" + "="*90)
print("SCHEMA")
print("="*90)
print(df.dtypes)
print("\nMissing values per column:")
print(df.isna().sum())

expected_cols = ["target_date","lead_months","point_id","series_id","input_kind",
                  "scenario","model_family","model","feature_set","y_hat","dy_hat"]
missing_expected = [c for c in expected_cols if c not in df.columns]
extra_cols = [c for c in df.columns if c not in expected_cols]
print(f"\nMissing expected columns: {missing_expected}")
print(f"Extra/unexpected columns: {extra_cols}")

df["target_date"] = pd.to_datetime(df["target_date"], errors="coerce")
n_bad_dates = df["target_date"].isna().sum()
print(f"\nRows with unparseable target_date: {n_bad_dates}")

# ---------- 3) KEY CATEGORICAL VALUES (do not assume naming) ----------
print("\n" + "="*90)
print("CATEGORICAL VALUES — DO NOT ASSUME, VERIFY EXACT STRINGS")
print("="*90)
for col in ["input_kind","scenario","model_family","model","feature_set"]:
    if col in df.columns:
        vc = df[col].value_counts(dropna=False)
        print(f"\n--- {col} ---")
        print(vc)

# ---------- 4) DATE / LEAD STRUCTURE ----------
print("\n" + "="*90)
print("TEMPORAL STRUCTURE")
print("="*90)
print("target_date range:", df["target_date"].min(), "to", df["target_date"].max())
print("lead_months range:", df["lead_months"].min(), "to", df["lead_months"].max())
print("Unique lead_months values (sorted):")
leads_sorted = sorted(df["lead_months"].dropna().unique().tolist())
print(leads_sorted)
print(f"n unique lead_months = {len(leads_sorted)}  (contiguous 1..N? {leads_sorted == list(range(int(min(leads_sorted)), int(max(leads_sorted))+1))})")

# ---------- 5) SERIES / POINT COVERAGE PER INPUT_KIND x SCENARIO x MODEL_FAMILY ----------
print("\n" + "="*90)
print("COVERAGE: n_series and n_rows per (input_kind, scenario, model_family)")
print("="*90)
cov = (df.groupby(["input_kind","scenario","model_family"], dropna=False)
         .agg(n_rows=("y_hat","size"),
              n_series=("series_id","nunique"),
              n_points=("point_id","nunique"),
              date_min=("target_date","min"),
              date_max=("target_date","max"),
              lead_min=("lead_months","min"),
              lead_max=("lead_months","max"))
         .reset_index())
print(cov.to_string(index=False))

# ---------- 6) SERIES CONSISTENCY: same series_id set across scenarios? ----------
print("\n" + "="*90)
print("SERIES CONSISTENCY ACROSS SCENARIOS (per input_kind, model_family=EXOG)")
print("="*90)
if "EXOG" in df["model_family"].astype(str).str.upper().unique():
    exog = df[df["model_family"].astype(str).str.upper().eq("EXOG")].copy()
    for ik, g in exog.groupby("input_kind"):
        scen_sets = {s: set(gs["series_id"].unique()) for s, gs in g.groupby("scenario")}
        scens = list(scen_sets.keys())
        print(f"\n{ik}: scenarios = {scens}")
        for s in scens:
            print(f"  {s}: n_series = {len(scen_sets[s])}")
        if len(scens) >= 2:
            base_key = [s for s in scens if s.lower()=="base"]
            if base_key:
                base_set = scen_sets[base_key[0]]
                for s in scens:
                    if s.lower() != "base":
                        diff = base_set.symmetric_difference(scen_sets[s])
                        print(f"  Symmetric diff (Base vs {s}): {len(diff)} series" + (f" -> {list(diff)[:10]}" if diff else ""))

# ---------- 7) DUPLICATES ----------
print("\n" + "="*90)
print("DUPLICATE CHECK")
print("="*90)
key_cols = ["point_id","series_id","input_kind","scenario","model_family","target_date","lead_months"]
key_cols = [c for c in key_cols if c in df.columns]
dupe_mask = df.duplicated(subset=key_cols, keep=False)
print(f"Duplicate rows on key {key_cols}: {dupe_mask.sum()}")
if dupe_mask.sum() > 0:
    print(df[dupe_mask].sort_values(key_cols).head(20))

# ---------- 8) y_hat / dy_hat SANITY ----------
print("\n" + "="*90)
print("y_hat / dy_hat DESCRIPTIVE STATS BY input_kind")
print("="*90)
print(df.groupby("input_kind")[["y_hat","dy_hat"]].describe().T)

n_negative_y = (df["y_hat"] < 0).sum()
print(f"\nRows with negative y_hat: {n_negative_y}")
if n_negative_y > 0:
    print(df[df["y_hat"]<0].groupby("input_kind").size())

n_nan_y = df["y_hat"].isna().sum()
n_nan_dy = df["dy_hat"].isna().sum()
print(f"\nNaN y_hat: {n_nan_y}  |  NaN dy_hat: {n_nan_dy}")

# ---------- 9) MODEL / FEATURE_SET MAPPING PER (input_kind, model_family) ----------
print("\n" + "="*90)
print("MODEL / FEATURE_SET USED PER (input_kind, model_family)")
print("="*90)
mm = (df.groupby(["input_kind","model_family","model","feature_set"], dropna=False)
        .size().reset_index(name="n_rows"))
print(mm.to_string(index=False))

# ---------- 10) MONTHLY SEASONAL SANITY: month distribution ----------
print("\n" + "="*90)
print("MONTH DISTRIBUTION (sanity check for target_date parsing)")
print("="*90)
df["month"] = df["target_date"].dt.month
print(df["month"].value_counts().sort_index())

# ---------- 11) SAMPLE ROWS PER GROUP ----------
print("\n" + "="*90)
print("SAMPLE ROWS (3 per input_kind x scenario, EXOG only)")
print("="*90)
if "EXOG" in df["model_family"].astype(str).str.upper().unique():
    exog = df[df["model_family"].astype(str).str.upper().eq("EXOG")].copy()
    sample = exog.groupby(["input_kind","scenario"], group_keys=False).apply(lambda g: g.head(3))
    print(sample[["input_kind","scenario","point_id","target_date","lead_months","y_hat","dy_hat"]].to_string(index=False))

# ---------- 12) QUICK RAW-SIGNAL CHECK: mean y_hat by scenario vs Base, per input_kind, lead<=Rk ----------
print("\n" + "="*90)
print("RAW SIGNAL CHECK: mean y_hat per scenario vs Base (EXOG only), by input_kind and lead bucket")
print("="*90)
if "EXOG" in df["model_family"].astype(str).str.upper().unique():
    exog = df[df["model_family"].astype(str).str.upper().eq("EXOG")].copy()
    Rk = {"Aquifer": 48, "Reservoir": 36, "River": 24}
    for ik, Rk_h in Rk.items():
        sub = exog[(exog["input_kind"]==ik) & (exog["lead_months"]<=Rk_h)]
        if sub.empty:
            continue
        piv = sub.groupby(["lead_months","scenario"])["y_hat"].mean().unstack()
        if "Base" in piv.columns:
            for scen in piv.columns:
                if scen.lower() == "base":
                    continue
                delta = (piv[scen] - piv["Base"])
                pct_positive = (delta > 0).mean() * 100
                print(f"{ik} | {scen} vs Base | within Rk={Rk_h}: "
                      f"mean_delta_yhat={delta.mean():.4f}, "
                      f"%months_yhat_higher_than_base={pct_positive:.1f}%")

# ---------- 13) EXPORT DIAGNOSTIC SUMMARY TO TEXT FOR SHARING ----------
print("\n" + "="*90)
print("DONE. Copy the full output above and share it back.")
print("="*90)

# =========================================
# CELL DIAG-AE-EXTENDED — Scenario integrity, paired deltas,
# forcing audit, and hindcast-residual discovery
#
# Purpose
# -------
# Determine whether the existing scenario-conditioned forecasts can be
# reused to rebuild AE2/AE3, or whether upstream EXOG forecasts must be
# regenerated.
#
# Main outputs
# ------------
# /content/ae_diagnostics_extended/
#   01_temporal_alignment.csv
#   02_grid_completeness_by_point.csv
#   03_scenario_key_alignment_summary.csv
#   04_scenario_key_mismatches.csv
#   05_fav_unfav_equality_summary.csv
#   06_fav_unfav_divergence_by_point.csv
#   07_paired_scenario_delta_summary.csv
#   08_paired_scenario_delta_by_lead.csv
#   09_paired_scenario_delta_by_point.csv
#   10_forcing_candidate_inventory.csv
#   11_forcing_direction_audit.csv
#   12_hindcast_candidate_inventory.csv
#   13_hindcast_residual_summary.csv
#   diagnostic_manifest.json
#
# This cell is diagnostic only. It does not overwrite forecasts or AE outputs.
# =========================================

from __future__ import annotations

import hashlib
import json
import os
import re
import warnings
from datetime import datetime
from pathlib import Path
from typing import Any, Iterable

import numpy as np
import pandas as pd

pd.set_option("display.max_columns", 100)
pd.set_option("display.width", 180)
pd.set_option("display.max_rows", 100)

warnings.filterwarnings(
    "ignore",
    message="DataFrameGroupBy.apply operated on the grouping columns",
)

# ---------------------------------------------------------------------
# 0. CONFIGURATION
# ---------------------------------------------------------------------

OUT_DIR = Path("/content/ae_diagnostics_extended")
OUT_DIR.mkdir(parents=True, exist_ok=True)

SEARCH_ROOTS = [
    Path("/content"),
    Path("/content/drive/MyDrive"),
]

FORECAST_FILENAMES = [
    "AE_forecast_scenarios_ALL.csv",
    "AE_forecast_with_sigma.csv",
    "forecast_2024_2030_ENDO_EXOG.csv",
]

RELIABLE_HORIZONS = {
    "Aquifer": 48,
    "Reservoir": 36,
    "River": 24,
}

SCENARIO_ORDER = ["Base", "Favorable", "Unfavorable"]

# Numerical equality used only to identify scenario trajectories that are
# effectively indistinguishable up to floating-point precision.
ABS_TOL = 1e-10
REL_TOL = 1e-8

# Limit filesystem inspection to avoid reading a large Google Drive
# indiscriminately.
MAX_FILESYSTEM_CANDIDATES = 40
MAX_FILE_SIZE_TO_FULLY_LOAD_MB = 100

REQUIRED_FORECAST_COLUMNS = [
    "target_date",
    "lead_months",
    "point_id",
    "series_id",
    "input_kind",
    "scenario",
    "model_family",
    "model",
    "feature_set",
    "y_hat",
    "dy_hat",
]


# ---------------------------------------------------------------------
# 1. GENERAL HELPERS
# ---------------------------------------------------------------------

def now_iso() -> str:
    return datetime.now().isoformat(timespec="seconds")


def display_table(obj: Any, n: int = 20) -> None:
    """Display a DataFrame in Colab/Jupyter, with a text fallback."""
    if isinstance(obj, pd.DataFrame):
        obj = obj.head(n)

    try:
        display(obj)  # noqa: F821 - available in Jupyter/Colab
    except NameError:
        print(obj)


def normalize_token(value: Any) -> str:
    """Normalize labels for robust matching."""
    text = str(value).strip().lower()
    text = (
        text.replace("á", "a")
        .replace("é", "e")
        .replace("í", "i")
        .replace("ó", "o")
        .replace("ú", "u")
        .replace("ñ", "n")
    )
    text = re.sub(r"[^a-z0-9]+", "_", text)
    return text.strip("_")


def standardize_scenario(value: Any) -> str:
    token = normalize_token(value)

    mapping = {
        "base": "Base",
        "baseline": "Base",
        "reference": "Base",
        "referencia": "Base",
        "favorable": "Favorable",
        "favourable": "Favorable",
        "optimistic": "Favorable",
        "unfavorable": "Unfavorable",
        "unfavourable": "Unfavorable",
        "desfavorable": "Unfavorable",
        "pessimistic": "Unfavorable",
    }
    return mapping.get(token, str(value).strip())


def sha256_file(path: Path, chunk_size: int = 1024 * 1024) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while True:
            chunk = handle.read(chunk_size)
            if not chunk:
                break
            digest.update(chunk)
    return digest.hexdigest()


def locate_file_by_name(
    filenames: Iterable[str],
    roots: Iterable[Path],
) -> Path | None:
    """Locate the first matching file, preferring /content over Drive."""
    for filename in filenames:
        direct_candidates = [
            Path("/content") / filename,
            Path.cwd() / filename,
            Path("/content/ae_exports") / filename,
            Path("/content/cell7_outputs") / filename,
        ]
        for candidate in direct_candidates:
            if candidate.exists():
                return candidate.resolve()

    for root in roots:
        if not root.exists():
            continue
        for filename in filenames:
            matches = list(root.rglob(filename))
            if matches:
                return matches[0].resolve()

    return None


def read_tabular_file(path: Path, nrows: int | None = None) -> pd.DataFrame:
    suffix = path.suffix.lower()

    if suffix == ".csv":
        return pd.read_csv(path, nrows=nrows)

    if suffix == ".parquet":
        data = pd.read_parquet(path)
        return data if nrows is None else data.head(nrows)

    if suffix in {".xlsx", ".xls"}:
        return pd.read_excel(path, nrows=nrows)

    raise ValueError(f"Unsupported tabular extension: {suffix}")


def month_difference(date_series: pd.Series, origin: pd.Timestamp) -> pd.Series:
    """Return one-based monthly lead relative to origin."""
    return (
        (date_series.dt.year - origin.year) * 12
        + (date_series.dt.month - origin.month)
        + 1
    )


def safe_divide(
    numerator: pd.Series | np.ndarray,
    denominator: pd.Series | np.ndarray,
    epsilon: float = 1e-12,
) -> np.ndarray:
    num = np.asarray(numerator, dtype=float)
    den = np.asarray(denominator, dtype=float)
    den = np.where(np.abs(den) < epsilon, np.nan, den)
    return num / den


def robust_scale(values: pd.Series) -> float:
    """
    Estimate a robust local scale.

    Priority:
      1. IQR / 1.349
      2. MAD * 1.4826
      3. Standard deviation
      4. Median absolute magnitude
    """
    x = pd.to_numeric(values, errors="coerce").dropna().to_numpy(float)

    if x.size == 0:
        return np.nan

    q25, q75 = np.quantile(x, [0.25, 0.75])
    iqr_scale = (q75 - q25) / 1.349

    median = np.median(x)
    mad_scale = 1.4826 * np.median(np.abs(x - median))

    std_scale = np.std(x, ddof=1) if x.size > 1 else np.nan
    magnitude_scale = np.median(np.abs(x))

    for candidate in [
        iqr_scale,
        mad_scale,
        std_scale,
        magnitude_scale,
    ]:
        if np.isfinite(candidate) and candidate > 1e-12:
            return float(candidate)

    return 1.0


def longest_consecutive_run(values: Iterable[int]) -> int:
    ordered = sorted(set(int(v) for v in values))

    if not ordered:
        return 0

    longest = 1
    current = 1

    for previous, current_value in zip(ordered[:-1], ordered[1:]):
        if current_value == previous + 1:
            current += 1
            longest = max(longest, current)
        else:
            current = 1

    return longest


# ---------------------------------------------------------------------
# 2. LOAD AND STANDARDIZE FORECAST FILE
# ---------------------------------------------------------------------

forecast_path = locate_file_by_name(
    filenames=FORECAST_FILENAMES,
    roots=SEARCH_ROOTS,
)

if forecast_path is None:
    try:
        from google.colab import files  # type: ignore

        print("Upload AE_forecast_scenarios_ALL.csv")
        uploaded = files.upload()

        if not uploaded:
            raise FileNotFoundError("No file was uploaded.")

        uploaded_name = next(iter(uploaded))
        forecast_path = Path(uploaded_name).resolve()

    except Exception as exc:
        raise FileNotFoundError(
            "Could not locate AE_forecast_scenarios_ALL.csv. "
            "Upload it or place it under /content."
        ) from exc

forecast = pd.read_csv(forecast_path)

missing_columns = [
    column
    for column in REQUIRED_FORECAST_COLUMNS
    if column not in forecast.columns
]

if missing_columns:
    raise ValueError(
        f"Forecast file is missing required columns: {missing_columns}"
    )

forecast = forecast[REQUIRED_FORECAST_COLUMNS].copy()

forecast["target_date"] = pd.to_datetime(
    forecast["target_date"],
    errors="coerce",
)

forecast["lead_months"] = pd.to_numeric(
    forecast["lead_months"],
    errors="coerce",
).astype("Int64")

forecast["y_hat"] = pd.to_numeric(
    forecast["y_hat"],
    errors="coerce",
)

forecast["dy_hat"] = pd.to_numeric(
    forecast["dy_hat"],
    errors="coerce",
)

forecast["scenario_original"] = forecast["scenario"].astype(str)
forecast["scenario"] = forecast["scenario"].map(standardize_scenario)
forecast["model_family"] = (
    forecast["model_family"]
    .astype(str)
    .str.strip()
    .str.upper()
)

forecast["input_kind"] = forecast["input_kind"].astype(str).str.strip()
forecast["point_id"] = forecast["point_id"].astype(str).str.strip()
forecast["series_id"] = forecast["series_id"].astype(str).str.strip()

if forecast["target_date"].isna().any():
    raise ValueError(
        f"{forecast['target_date'].isna().sum()} rows contain invalid dates."
    )

if forecast["lead_months"].isna().any():
    raise ValueError(
        f"{forecast['lead_months'].isna().sum()} rows contain invalid leads."
    )

forecast["lead_months"] = forecast["lead_months"].astype(int)
forecast["month"] = forecast["target_date"].dt.month

forecast_hash = sha256_file(forecast_path)

print("=" * 100)
print("EXTENDED AE DIAGNOSTIC")
print("=" * 100)
print(f"Timestamp: {now_iso()}")
print(f"Forecast file: {forecast_path}")
print(f"SHA-256: {forecast_hash}")
print(f"Shape: {forecast.shape}")
print(f"Scenarios: {sorted(forecast['scenario'].unique())}")
print(f"Components: {sorted(forecast['input_kind'].unique())}")


# ---------------------------------------------------------------------
# 3. TEMPORAL ALIGNMENT
# ---------------------------------------------------------------------

print("\n" + "=" * 100)
print("1. TEMPORAL ALIGNMENT: target_date versus lead_months")
print("=" * 100)

forecast_origin = forecast["target_date"].min()
forecast["lead_reconstructed"] = month_difference(
    forecast["target_date"],
    forecast_origin,
).astype(int)

forecast["lead_date_match"] = (
    forecast["lead_months"] == forecast["lead_reconstructed"]
)

temporal_alignment = (
    forecast.groupby(
        ["input_kind", "scenario", "model_family"],
        dropna=False,
    )
    .agg(
        n_rows=("lead_months", "size"),
        n_mismatches=("lead_date_match", lambda x: int((~x).sum())),
        lead_min=("lead_months", "min"),
        lead_max=("lead_months", "max"),
        date_min=("target_date", "min"),
        date_max=("target_date", "max"),
    )
    .reset_index()
)

temporal_alignment["alignment_ok"] = (
    temporal_alignment["n_mismatches"] == 0
)

temporal_alignment.to_csv(
    OUT_DIR / "01_temporal_alignment.csv",
    index=False,
)

display_table(temporal_alignment, n=50)

n_temporal_mismatches = int((~forecast["lead_date_match"]).sum())
print(f"\nTotal lead/date mismatches: {n_temporal_mismatches:,}")


# ---------------------------------------------------------------------
# 4. GRID COMPLETENESS BY POINT
# ---------------------------------------------------------------------

print("\n" + "=" * 100)
print("2. GRID COMPLETENESS BY POINT")
print("=" * 100)

all_expected_leads = set(
    range(
        int(forecast["lead_months"].min()),
        int(forecast["lead_months"].max()) + 1,
    )
)

grid_rows: list[dict[str, Any]] = []

for group_keys, group in forecast.groupby(
    ["input_kind", "scenario", "model_family", "point_id", "series_id"],
    dropna=False,
):
    input_kind, scenario, model_family, point_id, series_id = group_keys

    observed_leads = set(group["lead_months"].astype(int))
    missing_leads = sorted(all_expected_leads - observed_leads)
    duplicate_leads = int(group["lead_months"].duplicated().sum())

    grid_rows.append(
        {
            "input_kind": input_kind,
            "scenario": scenario,
            "model_family": model_family,
            "point_id": point_id,
            "series_id": series_id,
            "n_rows": int(len(group)),
            "lead_min": int(group["lead_months"].min()),
            "lead_max": int(group["lead_months"].max()),
            "n_missing_leads_1_84": int(len(missing_leads)),
            "missing_leads": ",".join(map(str, missing_leads)),
            "n_duplicate_leads": duplicate_leads,
            "longest_observed_consecutive_run": longest_consecutive_run(
                observed_leads
            ),
            "complete_1_84": len(missing_leads) == 0
            and duplicate_leads == 0,
        }
    )

grid_completeness = pd.DataFrame(grid_rows)

grid_completeness.to_csv(
    OUT_DIR / "02_grid_completeness_by_point.csv",
    index=False,
)

grid_summary = (
    grid_completeness.groupby(
        ["input_kind", "scenario", "model_family"],
        dropna=False,
    )
    .agg(
        n_points=("point_id", "nunique"),
        n_complete_points=("complete_1_84", "sum"),
        n_incomplete_points=(
            "complete_1_84",
            lambda x: int((~x).sum()),
        ),
        total_missing_point_leads=("n_missing_leads_1_84", "sum"),
        max_missing_leads_one_point=("n_missing_leads_1_84", "max"),
    )
    .reset_index()
)

display_table(grid_summary, n=50)


# ---------------------------------------------------------------------
# 5. EXACT KEY ALIGNMENT ACROSS EXOG SCENARIOS
# ---------------------------------------------------------------------

print("\n" + "=" * 100)
print("3. EXACT EXOG KEY ALIGNMENT ACROSS SCENARIOS")
print("=" * 100)

exog = forecast[
    forecast["model_family"].eq("EXOG")
].copy()

PAIR_KEY = [
    "input_kind",
    "point_id",
    "series_id",
    "target_date",
    "lead_months",
]

alignment_rows: list[dict[str, Any]] = []
mismatch_frames: list[pd.DataFrame] = []

for input_kind, component in exog.groupby("input_kind"):
    component_scenarios = set(component["scenario"].unique())

    if "Base" not in component_scenarios:
        alignment_rows.append(
            {
                "input_kind": input_kind,
                "scenario_compared": None,
                "n_base_keys": 0,
                "n_scenario_keys": 0,
                "n_missing_from_scenario": np.nan,
                "n_extra_in_scenario": np.nan,
                "keys_identical": False,
                "note": "Base scenario missing",
            }
        )
        continue

    base_keys = (
        component.loc[
            component["scenario"].eq("Base"),
            PAIR_KEY,
        ]
        .drop_duplicates()
        .set_index(PAIR_KEY)
        .index
    )

    for scenario in ["Favorable", "Unfavorable"]:
        scenario_subset = component[
            component["scenario"].eq(scenario)
        ]

        if scenario_subset.empty:
            alignment_rows.append(
                {
                    "input_kind": input_kind,
                    "scenario_compared": scenario,
                    "n_base_keys": len(base_keys),
                    "n_scenario_keys": 0,
                    "n_missing_from_scenario": len(base_keys),
                    "n_extra_in_scenario": 0,
                    "keys_identical": False,
                    "note": f"{scenario} scenario missing",
                }
            )
            continue

        scenario_keys = (
            scenario_subset[PAIR_KEY]
            .drop_duplicates()
            .set_index(PAIR_KEY)
            .index
        )

        missing_from_scenario = base_keys.difference(scenario_keys)
        extra_in_scenario = scenario_keys.difference(base_keys)

        alignment_rows.append(
            {
                "input_kind": input_kind,
                "scenario_compared": scenario,
                "n_base_keys": int(len(base_keys)),
                "n_scenario_keys": int(len(scenario_keys)),
                "n_missing_from_scenario": int(
                    len(missing_from_scenario)
                ),
                "n_extra_in_scenario": int(
                    len(extra_in_scenario)
                ),
                "keys_identical": (
                    len(missing_from_scenario) == 0
                    and len(extra_in_scenario) == 0
                ),
                "note": "",
            }
        )

        if len(missing_from_scenario) > 0:
            missing_frame = missing_from_scenario.to_frame(index=False)
            missing_frame["scenario_compared"] = scenario
            missing_frame["mismatch_type"] = "missing_from_scenario"
            mismatch_frames.append(missing_frame)

        if len(extra_in_scenario) > 0:
            extra_frame = extra_in_scenario.to_frame(index=False)
            extra_frame["scenario_compared"] = scenario
            extra_frame["mismatch_type"] = "extra_in_scenario"
            mismatch_frames.append(extra_frame)

scenario_alignment = pd.DataFrame(alignment_rows)

scenario_alignment.to_csv(
    OUT_DIR / "03_scenario_key_alignment_summary.csv",
    index=False,
)

if mismatch_frames:
    scenario_key_mismatches = pd.concat(
        mismatch_frames,
        ignore_index=True,
    )
else:
    scenario_key_mismatches = pd.DataFrame(
        columns=PAIR_KEY + ["scenario_compared", "mismatch_type"]
    )

scenario_key_mismatches.to_csv(
    OUT_DIR / "04_scenario_key_mismatches.csv",
    index=False,
)

display_table(scenario_alignment, n=50)

key_alignment_ok = bool(
    scenario_alignment["keys_identical"].all()
) if not scenario_alignment.empty else False

print(f"\nAll EXOG scenario keys aligned: {key_alignment_ok}")


# ---------------------------------------------------------------------
# 6. FAVORABLE VERSUS UNFAVORABLE EQUALITY AND DIVERGENCE
# ---------------------------------------------------------------------

print("\n" + "=" * 100)
print("4. FAVORABLE–UNFAVORABLE EQUALITY AND DIVERGENCE")
print("=" * 100)

fav = exog[
    exog["scenario"].eq("Favorable")
][PAIR_KEY + ["y_hat", "dy_hat"]].copy()

unfav = exog[
    exog["scenario"].eq("Unfavorable")
][PAIR_KEY + ["y_hat", "dy_hat"]].copy()

fav_unfav = fav.merge(
    unfav,
    on=PAIR_KEY,
    how="outer",
    suffixes=("_fav", "_unfav"),
    indicator=True,
)

fav_unfav["abs_diff_y"] = (
    fav_unfav["y_hat_fav"] - fav_unfav["y_hat_unfav"]
).abs()

fav_unfav["abs_diff_dy"] = (
    fav_unfav["dy_hat_fav"] - fav_unfav["dy_hat_unfav"]
).abs()

scale_y = np.maximum(
    fav_unfav["y_hat_fav"].abs(),
    fav_unfav["y_hat_unfav"].abs(),
)

scale_dy = np.maximum(
    fav_unfav["dy_hat_fav"].abs(),
    fav_unfav["dy_hat_unfav"].abs(),
)

fav_unfav["y_exact_equal"] = (
    fav_unfav["y_hat_fav"] == fav_unfav["y_hat_unfav"]
)

fav_unfav["dy_exact_equal"] = (
    fav_unfav["dy_hat_fav"] == fav_unfav["dy_hat_unfav"]
)

fav_unfav["y_close_equal"] = (
    fav_unfav["abs_diff_y"]
    <= ABS_TOL + REL_TOL * scale_y
)

fav_unfav["dy_close_equal"] = (
    fav_unfav["abs_diff_dy"]
    <= ABS_TOL + REL_TOL * scale_dy
)

fav_unfav["within_Rk"] = fav_unfav.apply(
    lambda row: (
        row["lead_months"]
        <= RELIABLE_HORIZONS.get(row["input_kind"], 0)
    ),
    axis=1,
)

equality_summary_rows: list[dict[str, Any]] = []

for (input_kind, within_rk), group in fav_unfav.groupby(
    ["input_kind", "within_Rk"],
    dropna=False,
):
    matched = group[group["_merge"].eq("both")].copy()

    n_rows = len(group)
    n_matched = len(matched)

    equality_summary_rows.append(
        {
            "input_kind": input_kind,
            "analysis_window": (
                "within_Rk" if within_rk else "outside_Rk"
            ),
            "n_rows_union": int(n_rows),
            "n_matched_pairs": int(n_matched),
            "n_unmatched": int(n_rows - n_matched),
            "pct_y_exact_equal": (
                100.0 * matched["y_exact_equal"].mean()
                if n_matched
                else np.nan
            ),
            "pct_y_close_equal": (
                100.0 * matched["y_close_equal"].mean()
                if n_matched
                else np.nan
            ),
            "pct_dy_exact_equal": (
                100.0 * matched["dy_exact_equal"].mean()
                if n_matched
                else np.nan
            ),
            "mean_abs_diff_y": (
                matched["abs_diff_y"].mean()
                if n_matched
                else np.nan
            ),
            "median_abs_diff_y": (
                matched["abs_diff_y"].median()
                if n_matched
                else np.nan
            ),
            "max_abs_diff_y": (
                matched["abs_diff_y"].max()
                if n_matched
                else np.nan
            ),
        }
    )

fav_unfav_equality_summary = pd.DataFrame(
    equality_summary_rows
)

fav_unfav_equality_summary.to_csv(
    OUT_DIR / "05_fav_unfav_equality_summary.csv",
    index=False,
)

divergence_rows: list[dict[str, Any]] = []

matched_fu = fav_unfav[
    fav_unfav["_merge"].eq("both")
].copy()

for group_keys, group in matched_fu.groupby(
    ["input_kind", "point_id", "series_id"],
    dropna=False,
):
    input_kind, point_id, series_id = group_keys
    group = group.sort_values("lead_months")

    divergent = group[~group["y_close_equal"]]

    first_divergence_lead = (
        int(divergent["lead_months"].min())
        if not divergent.empty
        else np.nan
    )

    first_divergence_date = (
        divergent.loc[
            divergent["lead_months"].idxmin(),
            "target_date",
        ]
        if not divergent.empty
        else pd.NaT
    )

    rk = RELIABLE_HORIZONS.get(input_kind, 0)
    within_rk = group[group["lead_months"] <= rk]

    divergence_rows.append(
        {
            "input_kind": input_kind,
            "point_id": point_id,
            "series_id": series_id,
            "n_matched_rows": int(len(group)),
            "first_divergence_lead": first_divergence_lead,
            "first_divergence_date": first_divergence_date,
            "never_diverges": divergent.empty,
            "pct_equal_all_leads": 100.0 * group["y_close_equal"].mean(),
            "pct_equal_within_Rk": (
                100.0 * within_rk["y_close_equal"].mean()
                if len(within_rk)
                else np.nan
            ),
            "mean_abs_diff_y_all": group["abs_diff_y"].mean(),
            "mean_abs_diff_y_within_Rk": (
                within_rk["abs_diff_y"].mean()
                if len(within_rk)
                else np.nan
            ),
            "max_abs_diff_y": group["abs_diff_y"].max(),
        }
    )

fav_unfav_divergence_by_point = pd.DataFrame(
    divergence_rows
)

fav_unfav_divergence_by_point.to_csv(
    OUT_DIR / "06_fav_unfav_divergence_by_point.csv",
    index=False,
)

display_table(fav_unfav_equality_summary, n=50)

print("\nPoints that never separate Favorable and Unfavorable:")
never_diverge_summary = (
    fav_unfav_divergence_by_point.groupby("input_kind")
    .agg(
        n_points=("point_id", "nunique"),
        n_never_diverge=("never_diverges", "sum"),
        pct_never_diverge=(
            "never_diverges",
            lambda x: 100.0 * x.mean(),
        ),
    )
    .reset_index()
)

display_table(never_diverge_summary, n=20)


# ---------------------------------------------------------------------
# 7. PAIRED SCENARIO DELTAS VERSUS BASE
# ---------------------------------------------------------------------

print("\n" + "=" * 100)
print("5. PAIRED POINT-LEVEL SCENARIO DELTAS VERSUS BASE")
print("=" * 100)

base_exog = exog[
    exog["scenario"].eq("Base")
][PAIR_KEY + ["y_hat", "dy_hat"]].copy()

base_exog = base_exog.rename(
    columns={
        "y_hat": "y_hat_base",
        "dy_hat": "dy_hat_base",
    }
)

# Robust point-specific scale estimated from Base trajectories.
point_scale_rows: list[dict[str, Any]] = []

for group_keys, group in base_exog.groupby(
    ["input_kind", "point_id", "series_id"],
    dropna=False,
):
    input_kind, point_id, series_id = group_keys

    point_scale_rows.append(
        {
            "input_kind": input_kind,
            "point_id": point_id,
            "series_id": series_id,
            "base_location_median": float(
                group["y_hat_base"].median()
            ),
            "base_scale_robust": robust_scale(
                group["y_hat_base"]
            ),
        }
    )

point_scales = pd.DataFrame(point_scale_rows)

paired_frames: list[pd.DataFrame] = []

for scenario in ["Favorable", "Unfavorable"]:
    scenario_data = exog[
        exog["scenario"].eq(scenario)
    ][PAIR_KEY + ["y_hat", "dy_hat"]].copy()

    scenario_data = scenario_data.rename(
        columns={
            "y_hat": "y_hat_scenario",
            "dy_hat": "dy_hat_scenario",
        }
    )

    paired = base_exog.merge(
        scenario_data,
        on=PAIR_KEY,
        how="inner",
        validate="one_to_one",
    )

    paired["scenario"] = scenario
    paired["delta_y"] = (
        paired["y_hat_scenario"] - paired["y_hat_base"]
    )
    paired["delta_dy"] = (
        paired["dy_hat_scenario"] - paired["dy_hat_base"]
    )
    paired["abs_delta_y"] = paired["delta_y"].abs()

    paired = paired.merge(
        point_scales,
        on=["input_kind", "point_id", "series_id"],
        how="left",
        validate="many_to_one",
    )

    paired["delta_y_standardized"] = safe_divide(
        paired["delta_y"],
        paired["base_scale_robust"],
    )

    # Relative change is secondary because forecasts close to zero can
    # generate unstable percentages. A point-specific lower denominator
    # bound is therefore used.
    relative_denominator = np.maximum.reduce(
        [
            paired["y_hat_base"].abs().to_numpy(float),
            (
                0.10
                * paired["base_scale_robust"].to_numpy(float)
            ),
            np.full(len(paired), 1e-8),
        ]
    )

    paired["delta_y_relative_pct"] = (
        100.0
        * paired["delta_y"].to_numpy(float)
        / relative_denominator
    )

    paired["within_Rk"] = paired.apply(
        lambda row: (
            row["lead_months"]
            <= RELIABLE_HORIZONS.get(row["input_kind"], 0)
        ),
        axis=1,
    )

    # Directional interpretation assumes that larger y_hat corresponds
    # to greater water availability. This is exported as an explicit
    # assumption, not imposed as a data correction.
    expected_sign = 1 if scenario == "Favorable" else -1

    paired["expected_availability_sign"] = expected_sign

    paired["direction_consistent"] = (
        np.sign(paired["delta_y"]) == expected_sign
    )

    paired["direction_neutral"] = np.isclose(
        paired["delta_y"],
        0.0,
        atol=ABS_TOL,
        rtol=REL_TOL,
    )

    paired_frames.append(paired)

paired_deltas = pd.concat(
    paired_frames,
    ignore_index=True,
)

# Component-level summary within Rk.
summary_rows: list[dict[str, Any]] = []

for (input_kind, scenario), group in paired_deltas[
    paired_deltas["within_Rk"]
].groupby(["input_kind", "scenario"]):
    summary_rows.append(
        {
            "input_kind": input_kind,
            "scenario": scenario,
            "Rk_months": RELIABLE_HORIZONS.get(input_kind),
            "n_paired_rows": int(len(group)),
            "n_points": int(group["point_id"].nunique()),
            "mean_delta_y": float(group["delta_y"].mean()),
            "median_delta_y": float(group["delta_y"].median()),
            "q05_delta_y": float(group["delta_y"].quantile(0.05)),
            "q25_delta_y": float(group["delta_y"].quantile(0.25)),
            "q75_delta_y": float(group["delta_y"].quantile(0.75)),
            "q95_delta_y": float(group["delta_y"].quantile(0.95)),
            "mean_standardized_delta": float(
                group["delta_y_standardized"].mean()
            ),
            "median_standardized_delta": float(
                group["delta_y_standardized"].median()
            ),
            "pct_rows_delta_positive": float(
                100.0 * (group["delta_y"] > 0).mean()
            ),
            "pct_rows_delta_negative": float(
                100.0 * (group["delta_y"] < 0).mean()
            ),
            "pct_rows_direction_consistent": float(
                100.0 * group["direction_consistent"].mean()
            ),
            "pct_rows_direction_neutral": float(
                100.0 * group["direction_neutral"].mean()
            ),
        }
    )

paired_delta_summary = pd.DataFrame(summary_rows)

paired_delta_summary.to_csv(
    OUT_DIR / "07_paired_scenario_delta_summary.csv",
    index=False,
)

# Lead-level summaries preserve monthly direction.
paired_delta_by_lead = (
    paired_deltas.groupby(
        ["input_kind", "scenario", "lead_months", "target_date"],
        dropna=False,
    )
    .agg(
        n_points=("point_id", "nunique"),
        mean_delta_y=("delta_y", "mean"),
        median_delta_y=("delta_y", "median"),
        mean_standardized_delta=(
            "delta_y_standardized",
            "mean",
        ),
        median_standardized_delta=(
            "delta_y_standardized",
            "median",
        ),
        pct_points_delta_positive=(
            "delta_y",
            lambda x: 100.0 * (x > 0).mean(),
        ),
        pct_points_delta_negative=(
            "delta_y",
            lambda x: 100.0 * (x < 0).mean(),
        ),
        pct_points_direction_consistent=(
            "direction_consistent",
            lambda x: 100.0 * x.mean(),
        ),
    )
    .reset_index()
)

paired_delta_by_lead["within_Rk"] = (
    paired_delta_by_lead.apply(
        lambda row: (
            row["lead_months"]
            <= RELIABLE_HORIZONS.get(row["input_kind"], 0)
        ),
        axis=1,
    )
)

paired_delta_by_lead.to_csv(
    OUT_DIR / "08_paired_scenario_delta_by_lead.csv",
    index=False,
)

# Point-level summaries identify which stations drive aggregate behaviour.
paired_delta_by_point = (
    paired_deltas[
        paired_deltas["within_Rk"]
    ]
    .groupby(
        ["input_kind", "scenario", "point_id", "series_id"],
        dropna=False,
    )
    .agg(
        n_months=("lead_months", "size"),
        mean_delta_y=("delta_y", "mean"),
        median_delta_y=("delta_y", "median"),
        mean_standardized_delta=(
            "delta_y_standardized",
            "mean",
        ),
        median_standardized_delta=(
            "delta_y_standardized",
            "median",
        ),
        pct_months_delta_positive=(
            "delta_y",
            lambda x: 100.0 * (x > 0).mean(),
        ),
        pct_months_delta_negative=(
            "delta_y",
            lambda x: 100.0 * (x < 0).mean(),
        ),
        pct_months_direction_consistent=(
            "direction_consistent",
            lambda x: 100.0 * x.mean(),
        ),
        max_abs_delta_y=("abs_delta_y", "max"),
    )
    .reset_index()
)

paired_delta_by_point.to_csv(
    OUT_DIR / "09_paired_scenario_delta_by_point.csv",
    index=False,
)

display_table(paired_delta_summary, n=50)

print("\nMonthly basin-level direction within Rk:")

monthly_direction_summary = (
    paired_delta_by_lead[
        paired_delta_by_lead["within_Rk"]
    ]
    .assign(
        monthly_mean_positive=lambda x: x["mean_delta_y"] > 0,
        monthly_mean_negative=lambda x: x["mean_delta_y"] < 0,
    )
    .groupby(["input_kind", "scenario"])
    .agg(
        n_months=("lead_months", "size"),
        pct_months_mean_positive=(
            "monthly_mean_positive",
            lambda x: 100.0 * x.mean(),
        ),
        pct_months_mean_negative=(
            "monthly_mean_negative",
            lambda x: 100.0 * x.mean(),
        ),
        mean_of_monthly_mean_delta=(
            "mean_delta_y",
            "mean",
        ),
        median_of_monthly_median_delta=(
            "median_delta_y",
            "median",
        ),
    )
    .reset_index()
)

display_table(monthly_direction_summary, n=50)


# ---------------------------------------------------------------------
# 8. DISCOVER POTENTIAL SCENARIO-FORCING DATASETS
# ---------------------------------------------------------------------

print("\n" + "=" * 100)
print("6. SCENARIO-FORCING DATASET DISCOVERY")
print("=" * 100)

FORCING_FILENAME_TERMS = [
    "scenario",
    "escenario",
    "climate",
    "clima",
    "weather",
    "meteo",
    "precip",
    "temperature",
    "temperatura",
    "demand",
    "demanda",
    "forcing",
    "exog",
]

FORCING_COLUMN_TERMS = [
    "precip",
    "rain",
    "temperature",
    "temperatura",
    "tmax",
    "tmin",
    "pet",
    "eto",
    "evap",
    "demand",
    "demanda",
    "withdrawal",
    "consumption",
    "recharge",
    "runoff",
    "inflow",
    "supply",
    "humidity",
    "soil_moisture",
]

# Expected direction under the explicit assumption that Favorable should
# reduce drought pressure and Unfavorable should increase it.
#
# +1 means expected to increase in Favorable and decrease in Unfavorable.
# -1 means expected to decrease in Favorable and increase in Unfavorable.
EXPECTED_FORCING_DIRECTION = {
    "precip": +1,
    "rain": +1,
    "recharge": +1,
    "runoff": +1,
    "inflow": +1,
    "supply": +1,
    "humidity": +1,
    "soil_moisture": +1,
    "temperature": -1,
    "temperatura": -1,
    "tmax": -1,
    "tmin": -1,
    "pet": -1,
    "eto": -1,
    "evap": -1,
    "demand": -1,
    "demanda": -1,
    "withdrawal": -1,
    "consumption": -1,
}


def find_column_by_tokens(
    columns: Iterable[Any],
    candidate_tokens: Iterable[str],
) -> str | None:
    normalized = {
        normalize_token(column): str(column)
        for column in columns
    }

    # Prefer exact normalized matches.
    for token in candidate_tokens:
        token_norm = normalize_token(token)
        if token_norm in normalized:
            return normalized[token_norm]

    # Then allow substring matches.
    for normalized_column, original_column in normalized.items():
        for token in candidate_tokens:
            if normalize_token(token) in normalized_column:
                return original_column

    return None


def forcing_variable_direction(column_name: str) -> int | None:
    token = normalize_token(column_name)

    for term, expected_direction in EXPECTED_FORCING_DIRECTION.items():
        if normalize_token(term) in token:
            return expected_direction

    return None


def inspect_forcing_dataframe(
    data: pd.DataFrame,
    source_name: str,
    source_type: str,
) -> tuple[dict[str, Any], list[dict[str, Any]]]:
    columns = list(data.columns)

    scenario_column = find_column_by_tokens(
        columns,
        ["scenario", "escenario"],
    )

    date_column = find_column_by_tokens(
        columns,
        [
            "target_date",
            "date",
            "fecha",
            "time",
            "timestamp",
        ],
    )

    forcing_columns = [
        column
        for column in columns
        if forcing_variable_direction(str(column)) is not None
        and pd.api.types.is_numeric_dtype(data[column])
    ]

    inventory_record = {
        "source_name": source_name,
        "source_type": source_type,
        "n_rows": int(len(data)),
        "n_columns": int(data.shape[1]),
        "scenario_column": scenario_column,
        "date_column": date_column,
        "n_forcing_numeric_columns": int(len(forcing_columns)),
        "forcing_columns": ",".join(map(str, forcing_columns)),
        "usable_for_direction_audit": (
            scenario_column is not None
            and len(forcing_columns) > 0
        ),
    }

    audit_records: list[dict[str, Any]] = []

    if scenario_column is None or not forcing_columns:
        return inventory_record, audit_records

    temp = data.copy()
    temp["_scenario_std"] = temp[scenario_column].map(
        standardize_scenario
    )

    if date_column is not None:
        temp["_audit_date"] = pd.to_datetime(
            temp[date_column],
            errors="coerce",
        )
        valid_date_mask = (
            temp["_audit_date"].isna()
            | (
                (temp["_audit_date"] >= pd.Timestamp("2024-01-01"))
                & (
                    temp["_audit_date"]
                    <= pd.Timestamp("2030-12-31")
                )
            )
        )
        temp = temp[valid_date_mask].copy()

    scenario_values = set(temp["_scenario_std"].dropna().unique())

    if "Base" not in scenario_values:
        return inventory_record, audit_records

    means = temp.groupby("_scenario_std")[forcing_columns].mean()

    for variable in forcing_columns:
        expected_direction = forcing_variable_direction(variable)
        base_mean = means.loc["Base", variable]

        for scenario in ["Favorable", "Unfavorable"]:
            if scenario not in means.index:
                continue

            scenario_mean = means.loc[scenario, variable]
            delta = scenario_mean - base_mean

            if scenario == "Favorable":
                expected_sign = expected_direction
            else:
                expected_sign = -expected_direction

            observed_sign = (
                0
                if np.isclose(delta, 0.0, atol=ABS_TOL, rtol=REL_TOL)
                else int(np.sign(delta))
            )

            audit_records.append(
                {
                    "source_name": source_name,
                    "source_type": source_type,
                    "scenario_column": scenario_column,
                    "variable": variable,
                    "scenario": scenario,
                    "base_mean": base_mean,
                    "scenario_mean": scenario_mean,
                    "delta_vs_base": delta,
                    "expected_sign": expected_sign,
                    "observed_sign": observed_sign,
                    "direction_consistent": (
                        observed_sign == expected_sign
                    ),
                    "direction_neutral": observed_sign == 0,
                    "interpretation_rule": (
                        "Heuristic drought-pressure direction; "
                        "must be confirmed against variable definition."
                    ),
                }
            )

    return inventory_record, audit_records


forcing_inventory_records: list[dict[str, Any]] = []
forcing_audit_records: list[dict[str, Any]] = []

# Inspect in-memory DataFrames first.
for variable_name, object_value in list(globals().items()):
    if not isinstance(object_value, pd.DataFrame):
        continue

    if variable_name in {
        "forecast",
        "exog",
        "fav",
        "unfav",
        "fav_unfav",
        "matched_fu",
        "base_exog",
        "paired_deltas",
    }:
        continue

    try:
        inventory_record, audit_records = inspect_forcing_dataframe(
            data=object_value,
            source_name=variable_name,
            source_type="in_memory_dataframe",
        )

        if (
            inventory_record["scenario_column"] is not None
            or inventory_record["n_forcing_numeric_columns"] > 0
        ):
            forcing_inventory_records.append(inventory_record)
            forcing_audit_records.extend(audit_records)

    except Exception as exc:
        forcing_inventory_records.append(
            {
                "source_name": variable_name,
                "source_type": "in_memory_dataframe",
                "n_rows": len(object_value),
                "n_columns": object_value.shape[1],
                "scenario_column": None,
                "date_column": None,
                "n_forcing_numeric_columns": 0,
                "forcing_columns": "",
                "usable_for_direction_audit": False,
                "inspection_error": str(exc),
            }
        )

# Discover likely forcing files by filename.
forcing_file_candidates: list[Path] = []

for root in SEARCH_ROOTS:
    if not root.exists():
        continue

    for current_root, directory_names, filenames in os.walk(root):
        # Avoid scanning notebook caches and sample data.
        directory_names[:] = [
            name
            for name in directory_names
            if not name.startswith(".")
            and name not in {
                "sample_data",
                "__pycache__",
                ".ipynb_checkpoints",
            }
        ]

        for filename in filenames:
            suffix = Path(filename).suffix.lower()

            if suffix not in {".csv", ".parquet", ".xlsx", ".xls"}:
                continue

            normalized_filename = normalize_token(filename)

            if any(
                normalize_token(term) in normalized_filename
                for term in FORCING_FILENAME_TERMS
            ):
                candidate = Path(current_root) / filename

                if candidate.resolve() == forecast_path.resolve():
                    continue

                forcing_file_candidates.append(candidate)

                if (
                    len(forcing_file_candidates)
                    >= MAX_FILESYSTEM_CANDIDATES
                ):
                    break

        if len(forcing_file_candidates) >= MAX_FILESYSTEM_CANDIDATES:
            break

    if len(forcing_file_candidates) >= MAX_FILESYSTEM_CANDIDATES:
        break

for candidate_path in forcing_file_candidates:
    try:
        file_size_mb = candidate_path.stat().st_size / 1024**2

        if file_size_mb <= MAX_FILE_SIZE_TO_FULLY_LOAD_MB:
            candidate_data = read_tabular_file(candidate_path)
        else:
            candidate_data = read_tabular_file(
                candidate_path,
                nrows=5000,
            )

        inventory_record, audit_records = inspect_forcing_dataframe(
            data=candidate_data,
            source_name=str(candidate_path),
            source_type="file",
        )

        inventory_record["file_size_mb"] = file_size_mb
        inventory_record["fully_loaded"] = (
            file_size_mb <= MAX_FILE_SIZE_TO_FULLY_LOAD_MB
        )

        if (
            inventory_record["scenario_column"] is not None
            or inventory_record["n_forcing_numeric_columns"] > 0
        ):
            forcing_inventory_records.append(inventory_record)
            forcing_audit_records.extend(audit_records)

    except Exception as exc:
        forcing_inventory_records.append(
            {
                "source_name": str(candidate_path),
                "source_type": "file",
                "n_rows": np.nan,
                "n_columns": np.nan,
                "scenario_column": None,
                "date_column": None,
                "n_forcing_numeric_columns": 0,
                "forcing_columns": "",
                "usable_for_direction_audit": False,
                "inspection_error": str(exc),
            }
        )

forcing_inventory = pd.DataFrame(forcing_inventory_records)
forcing_direction_audit = pd.DataFrame(forcing_audit_records)

forcing_inventory.to_csv(
    OUT_DIR / "10_forcing_candidate_inventory.csv",
    index=False,
)

forcing_direction_audit.to_csv(
    OUT_DIR / "11_forcing_direction_audit.csv",
    index=False,
)

if forcing_inventory.empty:
    print(
        "No candidate forcing dataset was found. "
        "Scenario labels and input directions cannot yet be validated."
    )
else:
    display_table(
        forcing_inventory.sort_values(
            "usable_for_direction_audit",
            ascending=False,
        ),
        n=50,
    )

if not forcing_direction_audit.empty:
    print("\nForcing direction audit:")
    display_table(forcing_direction_audit, n=100)

    forcing_direction_summary = (
        forcing_direction_audit.groupby(
            ["source_name", "scenario"],
            dropna=False,
        )
        .agg(
            n_variables=("variable", "size"),
            n_direction_consistent=(
                "direction_consistent",
                "sum",
            ),
            n_direction_inconsistent=(
                "direction_consistent",
                lambda x: int((~x).sum()),
            ),
            n_direction_neutral=(
                "direction_neutral",
                "sum",
            ),
        )
        .reset_index()
    )

    display_table(forcing_direction_summary, n=100)
else:
    print(
        "\nNo dataset with scenario labels and recognizable numeric "
        "forcing variables was available for a direction audit."
    )


# ---------------------------------------------------------------------
# 9. DISCOVER HINDCAST / RESIDUAL DATASETS
# ---------------------------------------------------------------------

print("\n" + "=" * 100)
print("7. HINDCAST AND RESIDUAL DATASET DISCOVERY")
print("=" * 100)

POINT_TOKENS = [
    "point_id",
    "control_point",
    "station",
    "site",
    "gauge",
    "series_id",
]

LEAD_TOKENS = [
    "lead_months",
    "lead",
    "horizon",
    "step",
]

TRUE_TOKENS = [
    "y_true",
    "value_true",
    "y_obs",
    "observed",
    "obs",
    "truth",
    "target",
]

PRED_TOKENS = [
    "y_pred",
    "y_hat",
    "prediction",
    "forecast",
    "pred",
]

INPUT_TOKENS = [
    "input_kind",
    "input",
    "component",
    "variable_type",
]

DATE_TOKENS = [
    "target_date",
    "date",
    "fecha",
    "time",
    "timestamp",
]

HINDCAST_FILENAME_TERMS = [
    "hindcast",
    "backtest",
    "residual",
    "resid",
    "prediction",
    "pred",
    "cv",
    "validation",
]


def score_hindcast_schema(
    data: pd.DataFrame,
) -> dict[str, Any]:
    columns = list(data.columns)

    point_column = find_column_by_tokens(columns, POINT_TOKENS)
    lead_column = find_column_by_tokens(columns, LEAD_TOKENS)
    true_column = find_column_by_tokens(columns, TRUE_TOKENS)
    pred_column = find_column_by_tokens(columns, PRED_TOKENS)
    input_column = find_column_by_tokens(columns, INPUT_TOKENS)
    date_column = find_column_by_tokens(columns, DATE_TOKENS)

    score = 0
    score += 3 if true_column else 0
    score += 3 if pred_column else 0
    score += 2 if lead_column else 0
    score += 2 if point_column else 0
    score += 1 if input_column else 0
    score += 1 if date_column else 0

    return {
        "score": score,
        "point_column": point_column,
        "lead_column": lead_column,
        "true_column": true_column,
        "pred_column": pred_column,
        "input_column": input_column,
        "date_column": date_column,
        "has_minimum_residual_schema": (
            true_column is not None
            and pred_column is not None
            and lead_column is not None
        ),
    }


hindcast_candidate_records: list[dict[str, Any]] = []
hindcast_data_sources: list[tuple[str, str, pd.DataFrame, dict[str, Any]]] = []

# Inspect in-memory DataFrames.
for variable_name, object_value in list(globals().items()):
    if not isinstance(object_value, pd.DataFrame):
        continue

    if variable_name in {
        "forecast",
        "exog",
        "fav",
        "unfav",
        "fav_unfav",
        "base_exog",
        "paired_deltas",
    }:
        continue

    schema = score_hindcast_schema(object_value)

    if schema["score"] < 4:
        continue

    record = {
        "source_name": variable_name,
        "source_type": "in_memory_dataframe",
        "n_rows": int(len(object_value)),
        "n_columns": int(object_value.shape[1]),
        **schema,
        "fully_loaded": True,
    }

    hindcast_candidate_records.append(record)

    if schema["has_minimum_residual_schema"]:
        hindcast_data_sources.append(
            (
                variable_name,
                "in_memory_dataframe",
                object_value.copy(),
                schema,
            )
        )

# Find likely hindcast files.
hindcast_file_candidates: list[Path] = []

for root in SEARCH_ROOTS:
    if not root.exists():
        continue

    for current_root, directory_names, filenames in os.walk(root):
        directory_names[:] = [
            name
            for name in directory_names
            if not name.startswith(".")
            and name not in {
                "sample_data",
                "__pycache__",
                ".ipynb_checkpoints",
            }
        ]

        for filename in filenames:
            suffix = Path(filename).suffix.lower()

            if suffix not in {".csv", ".parquet", ".xlsx", ".xls"}:
                continue

            normalized_filename = normalize_token(filename)

            if any(
                normalize_token(term) in normalized_filename
                for term in HINDCAST_FILENAME_TERMS
            ):
                candidate = Path(current_root) / filename
                hindcast_file_candidates.append(candidate)

                if (
                    len(hindcast_file_candidates)
                    >= MAX_FILESYSTEM_CANDIDATES
                ):
                    break

        if len(hindcast_file_candidates) >= MAX_FILESYSTEM_CANDIDATES:
            break

    if len(hindcast_file_candidates) >= MAX_FILESYSTEM_CANDIDATES:
        break

for candidate_path in hindcast_file_candidates:
    try:
        file_size_mb = candidate_path.stat().st_size / 1024**2
        sample = read_tabular_file(candidate_path, nrows=5000)
        schema = score_hindcast_schema(sample)

        if schema["score"] < 4:
            continue

        record = {
            "source_name": str(candidate_path),
            "source_type": "file",
            "n_rows": np.nan,
            "n_columns": int(sample.shape[1]),
            **schema,
            "file_size_mb": file_size_mb,
            "fully_loaded": False,
        }

        hindcast_candidate_records.append(record)

        if (
            schema["has_minimum_residual_schema"]
            and file_size_mb <= MAX_FILE_SIZE_TO_FULLY_LOAD_MB
        ):
            full_data = read_tabular_file(candidate_path)
            full_schema = score_hindcast_schema(full_data)

            hindcast_data_sources.append(
                (
                    str(candidate_path),
                    "file",
                    full_data,
                    full_schema,
                )
            )

            record["n_rows"] = int(len(full_data))
            record["fully_loaded"] = True

    except Exception as exc:
        hindcast_candidate_records.append(
            {
                "source_name": str(candidate_path),
                "source_type": "file",
                "n_rows": np.nan,
                "n_columns": np.nan,
                "score": 0,
                "point_column": None,
                "lead_column": None,
                "true_column": None,
                "pred_column": None,
                "input_column": None,
                "date_column": None,
                "has_minimum_residual_schema": False,
                "fully_loaded": False,
                "inspection_error": str(exc),
            }
        )

hindcast_inventory = pd.DataFrame(hindcast_candidate_records)

if not hindcast_inventory.empty:
    hindcast_inventory = hindcast_inventory.sort_values(
        ["has_minimum_residual_schema", "score", "n_rows"],
        ascending=[False, False, False],
        na_position="last",
    ).reset_index(drop=True)

hindcast_inventory.to_csv(
    OUT_DIR / "12_hindcast_candidate_inventory.csv",
    index=False,
)

if hindcast_inventory.empty:
    print("No likely hindcast/residual dataset was discovered.")
else:
    display_table(hindcast_inventory, n=100)


# ---------------------------------------------------------------------
# 10. RESIDUAL SUMMARY FOR USABLE HINDCAST CANDIDATES
# ---------------------------------------------------------------------

residual_summary_frames: list[pd.DataFrame] = []

for (
    source_name,
    source_type,
    hindcast_data,
    schema,
) in hindcast_data_sources:
    true_column = schema["true_column"]
    pred_column = schema["pred_column"]
    lead_column = schema["lead_column"]
    point_column = schema["point_column"]
    input_column = schema["input_column"]

    if true_column is None or pred_column is None or lead_column is None:
        continue

    temp = hindcast_data.copy()

    temp["_y_true"] = pd.to_numeric(
        temp[true_column],
        errors="coerce",
    )

    temp["_y_pred"] = pd.to_numeric(
        temp[pred_column],
        errors="coerce",
    )

    temp["_lead"] = pd.to_numeric(
        temp[lead_column],
        errors="coerce",
    )

    temp = temp.dropna(
        subset=["_y_true", "_y_pred", "_lead"]
    ).copy()

    if temp.empty:
        continue

    # Explicit convention:
    # residual = observation - prediction
    temp["_residual"] = temp["_y_true"] - temp["_y_pred"]

    if input_column is not None:
        temp["_input_kind"] = temp[input_column].astype(str)
    else:
        temp["_input_kind"] = "Unknown"

    if point_column is not None:
        temp["_point_id"] = temp[point_column].astype(str)
    else:
        temp["_point_id"] = "Unknown"

    grouping_columns = ["_input_kind", "_lead"]

    summary = (
        temp.groupby(grouping_columns, dropna=False)
        .agg(
            n_residuals=("_residual", "size"),
            n_points=("_point_id", "nunique"),
            residual_mean=("_residual", "mean"),
            residual_median=("_residual", "median"),
            residual_sd=("_residual", "std"),
            residual_mad=(
                "_residual",
                lambda x: (
                    1.4826
                    * np.median(
                        np.abs(
                            np.asarray(x, dtype=float)
                            - np.median(
                                np.asarray(x, dtype=float)
                            )
                        )
                    )
                ),
            ),
            rmse=(
                "_residual",
                lambda x: float(
                    np.sqrt(
                        np.mean(
                            np.square(
                                np.asarray(x, dtype=float)
                            )
                        )
                    )
                ),
            ),
            mae=(
                "_residual",
                lambda x: float(
                    np.mean(
                        np.abs(
                            np.asarray(x, dtype=float)
                        )
                    )
                ),
            ),
            residual_q025=(
                "_residual",
                lambda x: float(np.quantile(x, 0.025)),
            ),
            residual_q975=(
                "_residual",
                lambda x: float(np.quantile(x, 0.975)),
            ),
        )
        .reset_index()
        .rename(
            columns={
                "_input_kind": "input_kind",
                "_lead": "lead_months",
            }
        )
    )

    summary.insert(0, "source_name", source_name)
    summary.insert(1, "source_type", source_type)
    summary["residual_definition"] = "y_true - y_pred"
    summary["rmse_to_sd_ratio"] = safe_divide(
        summary["rmse"],
        summary["residual_sd"],
    )

    residual_summary_frames.append(summary)

if residual_summary_frames:
    hindcast_residual_summary = pd.concat(
        residual_summary_frames,
        ignore_index=True,
    )
else:
    hindcast_residual_summary = pd.DataFrame(
        columns=[
            "source_name",
            "source_type",
            "input_kind",
            "lead_months",
            "n_residuals",
            "n_points",
            "residual_mean",
            "residual_median",
            "residual_sd",
            "residual_mad",
            "rmse",
            "mae",
            "residual_q025",
            "residual_q975",
            "residual_definition",
            "rmse_to_sd_ratio",
        ]
    )

hindcast_residual_summary.to_csv(
    OUT_DIR / "13_hindcast_residual_summary.csv",
    index=False,
)

if hindcast_residual_summary.empty:
    print(
        "\nNo fully readable dataset with y_true, y_pred and lead was "
        "available. AE2 uncertainty cannot yet be rebuilt from raw "
        "hindcast residuals."
    )
else:
    print("\nHindcast residual summary:")
    display_table(hindcast_residual_summary, n=100)


# ---------------------------------------------------------------------
# 11. FINAL DECISION FLAGS AND MANIFEST
# ---------------------------------------------------------------------

print("\n" + "=" * 100)
print("8. DIAGNOSTIC DECISION SUMMARY")
print("=" * 100)

forcing_audit_available = not forcing_direction_audit.empty
hindcast_residuals_available = not hindcast_residual_summary.empty

fav_unfav_within_rk = fav_unfav_equality_summary[
    fav_unfav_equality_summary["analysis_window"].eq("within_Rk")
].copy()

high_fu_equality_components = []

if not fav_unfav_within_rk.empty:
    high_fu_equality_components = (
        fav_unfav_within_rk.loc[
            fav_unfav_within_rk["pct_y_close_equal"] >= 95.0,
            "input_kind",
        ]
        .astype(str)
        .tolist()
    )

direction_flagged = bool(
    (
        paired_delta_summary["pct_rows_direction_consistent"]
        < 50.0
    ).any()
) if not paired_delta_summary.empty else True

diagnostic_flags = {
    "forecast_file": str(forecast_path),
    "forecast_sha256": forecast_hash,
    "timestamp": now_iso(),
    "n_forecast_rows": int(len(forecast)),
    "lead_date_alignment_ok": n_temporal_mismatches == 0,
    "scenario_key_alignment_ok": key_alignment_ok,
    "forcing_direction_audit_available": forcing_audit_available,
    "hindcast_residuals_available": hindcast_residuals_available,
    "components_with_ge_95pct_fav_unfav_equality_within_Rk": (
        high_fu_equality_components
    ),
    "scenario_output_direction_flagged": direction_flagged,
    "can_rebuild_AE2_from_raw_residuals": (
        key_alignment_ok
        and n_temporal_mismatches == 0
        and hindcast_residuals_available
    ),
    "can_validate_scenario_labels_and_forcing_signs": (
        forcing_audit_available
    ),
}

manifest = {
    "diagnostic_flags": diagnostic_flags,
    "configuration": {
        "reliable_horizons": RELIABLE_HORIZONS,
        "absolute_equality_tolerance": ABS_TOL,
        "relative_equality_tolerance": REL_TOL,
        "expected_forcing_direction_rules": (
            EXPECTED_FORCING_DIRECTION
        ),
        "residual_definition": "y_true - y_pred",
    },
    "outputs": sorted(
        str(path)
        for path in OUT_DIR.glob("*")
        if path.is_file()
    ),
}

manifest_path = OUT_DIR / "diagnostic_manifest.json"

with manifest_path.open("w", encoding="utf-8") as handle:
    json.dump(
        manifest,
        handle,
        ensure_ascii=False,
        indent=2,
        default=str,
    )

for flag_name, flag_value in diagnostic_flags.items():
    print(f"- {flag_name}: {flag_value}")

print("\nInterpretation:")
if not diagnostic_flags["lead_date_alignment_ok"]:
    print(
        "  [BLOCKER] target_date and lead_months are not aligned."
    )

if not diagnostic_flags["scenario_key_alignment_ok"]:
    print(
        "  [BLOCKER] Base, Favorable and Unfavorable do not contain "
        "the same point-date keys."
    )

if high_fu_equality_components:
    print(
        "  [REVIEW] Favorable and Unfavorable are effectively equal "
        f"for at least 95% of rows within Rk in: "
        f"{high_fu_equality_components}."
    )

if direction_flagged:
    print(
        "  [REVIEW] At least one component/scenario has less than "
        "50% point-level directional consistency under the assumption "
        "that higher y_hat means greater water availability."
    )

if not forcing_audit_available:
    print(
        "  [MISSING INPUT] No scenario-forcing table was found. "
        "Scenario construction, labels and physical perturbation signs "
        "remain unverified."
    )

if not hindcast_residuals_available:
    print(
        "  [MISSING INPUT] No usable hindcast residual dataset was "
        "found. A rebuilt AE2 would still require an RMSE-derived proxy "
        "unless raw hindcasts are supplied."
    )

if (
    diagnostic_flags["lead_date_alignment_ok"]
    and diagnostic_flags["scenario_key_alignment_ok"]
):
    print(
        "  [PASS] The forecast output is structurally suitable for "
        "paired downstream analysis."
    )

if (
    diagnostic_flags["can_rebuild_AE2_from_raw_residuals"]
    and diagnostic_flags[
        "can_validate_scenario_labels_and_forcing_signs"
    ]
):
    print(
        "  [READY] Inputs are sufficient to rebuild AE2 rigorously "
        "without retraining the forecasting models."
    )
else:
    print(
        "  [NOT YET READY] Forecast outputs can be reused, but the "
        "missing forcing and/or hindcast evidence must be resolved "
        "before deciding whether EXOG forecasts themselves require "
        "regeneration."
    )

print(f"\nAll diagnostic outputs saved to: {OUT_DIR}")
print(f"Manifest: {manifest_path}")

# ============================================================
# CELL 00 — CANONICAL CONFIGURATION, PATHS, AND PROVENANCE
#
# Purpose
# -------
# Create a single reproducible configuration for the complete
# downstream Actionable Emergence pipeline.
#
# This cell:
#   1. Locates and freezes the validated forecast input.
#   2. Verifies its canonical SHA-256 hash.
#   3. Centralizes all AE1, AE2, and AE3 parameters.
#   4. Separates the AE3 trigger diagnostic from the
#      graded expected-utility experiment.
#   5. Creates a versioned, non-destructive output directory.
#   6. Writes an initial provenance manifest.
#
# This cell does NOT:
#   - modify the forecast file;
#   - retrain forecasting models;
#   - compute AE1, AE2, or AE3;
#   - infer hindcast residuals automatically;
#   - reuse legacy AE outputs as analytical inputs.
# ============================================================

from __future__ import annotations

import hashlib
import json
import os
import platform
import random
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Iterable

import numpy as np
import pandas as pd


# ============================================================
# 1. USER-EDITABLE OPTIONS
# ============================================================

# Set an explicit path only when automatic discovery fails.
# Example:
# USER_FORECAST_PATH = "/content/AE_forecast_scenarios_ALL.csv"
USER_FORECAST_PATH: str | None = None

# Optional explicit AE1 inputs. These are not required in Cell 00.
USER_AE1_SKILL_BY_LEAD_PATH: str | None = None
USER_AE1_HORIZON_REFERENCE_PATH: str | None = None

# Output location. When None, the cell uses Google Drive if already
# mounted; otherwise it uses /content.
USER_OUTPUT_ROOT: str | None = None

# Attempt to mount Google Drive when running in Colab.
MOUNT_GOOGLE_DRIVE = True

# Recursively search Google Drive for exact candidate filenames.
# Set to False if Drive is very large and file discovery is slow.
SEARCH_GOOGLE_DRIVE_RECURSIVELY = True

# The canonical forecast hash confirmed by the diagnostic audit.
EXPECTED_FORECAST_SHA256 = (
    "e4e08302fd160ed26d603f93ba2af0cb2978f55e6e8b294753b1c4bc228dc011"
)

# A hash mismatch is treated as a hard error because downstream
# reproducibility depends on an immutable forecast input.
STRICT_FORECAST_HASH = True


# ============================================================
# 2. PIPELINE IDENTITY
# ============================================================

PROJECT_NAME = "Actionable Emergence — JRBD"
PIPELINE_NAME = "canonical_ae_downstream_pipeline"
PIPELINE_VERSION = "1.0.0"
MANUSCRIPT_ANALYSIS_WINDOW = "2024-01 to 2030-12"

UTC_NOW = datetime.now(timezone.utc)
RUN_TIMESTAMP_UTC = UTC_NOW.isoformat(timespec="seconds")
RUN_TIMESTAMP_COMPACT = UTC_NOW.strftime("%Y%m%dT%H%M%SZ")


# ============================================================
# 3. REPRODUCIBILITY SEEDS
# ============================================================

GLOBAL_RANDOM_SEED = 123
AE2_BOOTSTRAP_SEED = 123
AE3_MONTE_CARLO_SEED = 123

random.seed(GLOBAL_RANDOM_SEED)
np.random.seed(GLOBAL_RANDOM_SEED)


# ============================================================
