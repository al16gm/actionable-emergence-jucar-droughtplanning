        ),

        "decision_validation": (
            "leave_one_control_point_out"
        ),

        "default_parameters": {
            "pi": (
                DEFAULT_DROUGHT_SCORE_THRESHOLD
            ),
            "eta": (
                DEFAULT_ACTION_EFFECTIVENESS
            ),
