            "lead_months",
            "target_date",
        ]
    ]
    .drop_duplicates()
    .sort_values(
        "lead_months"
    )
    .reset_index(
        drop=True
    )
)

if len(
    MASTER_DATES
) != TOTAL_FORECAST_MONTHS:
