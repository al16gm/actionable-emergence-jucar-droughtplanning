    )

    axis_6b.set_title(
        (
            "Persistent exploratory windows "
            "after policy reselection"
        ),
        loc="left",
        fontweight="bold",
    )

    add_panel_label(
        axis_6b,
        "b",
        x=-0.19,
        y=1.10,
    )

    axis_6b.legend(
        handles=[
            Patch(
                facecolor=SCENARIO_COLORS[
                    "Favorable"
                ],
                edgecolor=SCENARIO_COLORS[
                    "Favorable"
