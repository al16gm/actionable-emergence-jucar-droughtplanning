        ]

        horizon = EXPECTED_HORIZONS[
            component
        ]

        boundary_date = pd.Timestamp(
            panel.loc[
                panel[
                    "lead_months"
                ].eq(
                    horizon
                ),
                "target_date",
            ].iloc[
                0
            ]
        )

        shade_start = (
