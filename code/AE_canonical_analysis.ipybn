    f"{CONFIG['ae3_expected_utility']['voi_definition']}"
)
print(
    "VoI gate threshold:      "
    f"{CONFIG['ae3_expected_utility']['voi_positive_threshold']}"
)
print(
    "Full AE component:       "
    f"{CONFIG['full_ae']['components_with_full_ae_evaluation']}"
)

print("\nPROVENANCE OUTPUTS")
print("-" * 100)
print(f"Configuration:           {CONFIG_PATH}")
print(f"Initial manifest:        {MANIFEST_PATH}")
print(f"Input registry:          {INPUT_REGISTRY_PATH}")
print(f"Configuration SHA-256:   {CONFIG_HASH}")

print("\nSTATUS")
print("-" * 100)

if FORECAST_HASH_MATCH:
    print("[PASS] Canonical forecast input is frozen and verified.")
else:
    print("[FAIL] Forecast hash does not match the canonical input.")

if AE1_SKILL_BY_LEAD_PATH is None:
    print(
        "[NOTICE] AE1 skill-by-lead input was not found. "
        "Cell 02 will need either this file or an explicitly "
        "validated alternative."
    )
else:
    print("[PASS] AE1 skill-by-lead candidate is available.")

print(
    "[PASS] Legacy AE2/AE3 outputs are registered only for "
    "comparison and cannot be silently reused as upstream inputs."
)
print(
    "[PASS] AE3 trigger and AE3 expected-utility analyses are "
    "configured as separate experiments."
)
print(
    "[PASS] VoI is configured as an expected-utility difference "
    "with a zero-benefit reference at VoI = 0."
)
print(
    "[PASS] Unsupported block-bootstrap and full-ensemble claims "
    "are disabled by default."
)

print("\nCELL 00 COMPLETED SUCCESSFULLY")
print("=" * 100)

# ============================================================
# CELL 01 — FORECAST VALIDATION AND INHERITED AE1 GATE
#
# Purpose
# -------
# 1. Revalidate the only available canonical input:
#      AE_forecast_scenarios_ALL.csv
# 2. Create a clean normalized forecast table for all subsequent cells.
# 3. Audit temporal coverage, scenario pairing, and y_hat/dy_hat coherence.
# 4. Reapply the externally validated AE1 reliability horizons:
#      Aquifer   = 48 months
#      Reservoir = 36 months
#      River     = 24 months
# 5. Record explicitly that AE1 skill is inherited from the prior
#    peer-reviewed study and is not re-estimated from this forecast file.
#
# Scientific limitation
# ---------------------
# KGE and NSE cannot be recomputed from prospective forecasts alone
# because this file contains no observed outcomes or hindcast residuals.
#
# This cell does NOT:
#   - calculate KGE or NSE;
#   - infer pseudo-observations;
#   - use ENDO–EXOG agreement as a substitute for observed skill;
#   - calculate AE2 or AE3;
#   - read legacy AE outputs.
# ============================================================

from __future__ import annotations

import json
import shutil
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

import numpy as np
import pandas as pd


# ============================================================
# 1. REQUIRE CELL 00
# ============================================================

REQUIRED_CELL00_OBJECTS = [
    "FORECAST_PATH",
    "FORECAST_SHA256",
    "EXPECTED_FORECAST_SHA256",
    "CONFIG_HASH",
    "RUN_DIR",
    "PATHS",
    "CONFIG",
    "RUN_CONTEXT",
    "MANIFEST_PATH",
    "sha256_file",
]

missing_cell00_objects = [
    name
    for name in REQUIRED_CELL00_OBJECTS
    if name not in globals()
]

if missing_cell00_objects:
    raise RuntimeError(
        "Cell 00 must be executed before Cell 01. "
        f"Missing objects: {missing_cell00_objects}"
    )


# ============================================================
# 2. SCIENTIFIC SCOPE
# ============================================================

# These reliability horizons are inherited from the validated
# peer-reviewed forecasting study. They are not estimated in this cell.
AE1_HORIZONS_MONTHS = {
    "Aquifer": 48,
    "Reservoir": 36,
    "River": 24,
}

AE1_SOURCE_TYPE = "inherited_from_prior_peer_reviewed_validation"

# Add the complete bibliographic reference or DOI when finalising
# the reproducibility package.
PRIOR_PUBLICATION_REFERENCE = (
    "Previously peer-reviewed and validated forecasting study"
)

AE1_REESTIMATED_FROM_THIS_CSV = False
AE1_GATE_REAPPLIED = True

EXPECTED_COMPONENTS = [
    "Aquifer",
    "Reservoir",
    "River",
]

EXPECTED_SCENARIOS = [
    "Base",
    "Favorable",
    "Unfavorable",
]

EXPECTED_MODEL_FAMILIES = [
    "ENDO",
    "EXOG",
]

EXPECTED_SCENARIO_MODEL_COMBINATIONS = {
    ("Base", "ENDO"),
    ("Base", "EXOG"),
    ("Favorable", "EXOG"),
    ("Unfavorable", "EXOG"),
}

EXPECTED_LEADS = list(range(1, 85))

CORE_COLUMNS = [
    "target_date",
    "lead_months",
    "point_id",
    "series_id",
    "input_kind",
    "scenario",
    "model_family",
    "model",
    "feature_set",
    "y_hat",
    "dy_hat",
]

UNIQUE_ROW_KEY = [
    "point_id",
    "series_id",
    "input_kind",
    "scenario",
    "model_family",
    "target_date",
    "lead_months",
]

PAIRED_EXOG_KEY = [
    "input_kind",
    "point_id",
    "series_id",
    "target_date",
    "lead_months",
]

DY_ABSOLUTE_TOLERANCE = 1e-8
DY_RELATIVE_TOLERANCE = 1e-6


# ============================================================
# 3. HELPERS
# ============================================================

def utc_now_iso() -> str:
    """Return the current UTC timestamp."""
    return datetime.now(
        timezone.utc
    ).isoformat(timespec="seconds")


def display_frame(
    frame: pd.DataFrame,
    n: int = 50,
) -> None:
    """Display a DataFrame with a plain-text fallback."""
    try:
        display(frame.head(n))
    except NameError:
        print(
            frame.head(n).to_string(
                index=False
            )
        )


def normalize_scenario(
    value: Any,
) -> str:
    """Standardize scenario labels."""
    token = str(value).strip().lower()

    mapping = {
        "base": "Base",
        "baseline": "Base",
        "reference": "Base",
        "favorable": "Favorable",
        "favourable": "Favorable",
        "unfavorable": "Unfavorable",
        "unfavourable": "Unfavorable",
        "desfavorable": "Unfavorable",
    }

    return mapping.get(
        token,
        str(value).strip(),
    )


def update_json_file(
    path: Path,
    updates: dict[str, Any],
) -> None:
    """Update a JSON file without dropping existing content."""
    if path.exists():
        with path.open(
            "r",
            encoding="utf-8",
        ) as handle:
            payload = json.load(handle)
    else:
        payload = {}

    payload.update(updates)

    with path.open(
        "w",
        encoding="utf-8",
    ) as handle:
        json.dump(
            payload,
            handle,
            ensure_ascii=False,
            indent=2,
            sort_keys=True,
            default=str,
        )


def serialize_leads(
    leads: list[int],
) -> str:
    """Serialize a list of leads for CSV output."""
    return ",".join(
        str(int(lead))
        for lead in leads
    )


# ============================================================
# 4. RELOAD AND VERIFY THE IMMUTABLE FORECAST
# ============================================================

print("=" * 100)
print("CELL 01 — FORECAST VALIDATION AND INHERITED AE1 GATE")
print("=" * 100)

forecast_path = Path(
    FORECAST_PATH
).resolve()

observed_hash = sha256_file(
    forecast_path
)

if observed_hash != EXPECTED_FORECAST_SHA256:
    raise RuntimeError(
        "The canonical forecast file changed after Cell 00.\n"
        f"Expected SHA-256: {EXPECTED_FORECAST_SHA256}\n"
        f"Observed SHA-256: {observed_hash}\n"
        f"Path: {forecast_path}"
    )

forecast_raw = pd.read_csv(
    forecast_path
)

missing_columns = [
    column
    for column in CORE_COLUMNS
    if column not in forecast_raw.columns
]

unexpected_columns = [
    column
    for column in forecast_raw.columns
    if column not in CORE_COLUMNS
]

if missing_columns:
    raise ValueError(
        "The forecast input is missing required columns: "
        f"{missing_columns}"
    )

forecast = forecast_raw[
    CORE_COLUMNS
].copy()


# ============================================================
# 5. STANDARDIZE TYPES AND LABELS
# ============================================================

forecast["target_date"] = pd.to_datetime(
    forecast["target_date"],
    errors="coerce",
)

forecast["lead_months"] = pd.to_numeric(
    forecast["lead_months"],
    errors="coerce",
)

forecast["y_hat"] = pd.to_numeric(
    forecast["y_hat"],
    errors="coerce",
)

forecast["dy_hat"] = pd.to_numeric(
    forecast["dy_hat"],
    errors="coerce",
)

forecast["point_id"] = (
    forecast["point_id"]
    .astype(str)
    .str.strip()
)

forecast["series_id"] = (
    forecast["series_id"]
    .astype(str)
    .str.strip()
)

forecast["input_kind"] = (
    forecast["input_kind"]
    .astype(str)
    .str.strip()
)

forecast["scenario"] = (
    forecast["scenario"]
    .map(normalize_scenario)
)

forecast["model_family"] = (
    forecast["model_family"]
    .astype(str)
    .str.strip()
    .str.upper()
)

forecast["model"] = (
    forecast["model"]
    .astype(str)
    .str.strip()
)

forecast["feature_set"] = (
    forecast["feature_set"]
    .astype(str)
    .str.strip()
)

invalid_core_counts = (
    forecast[
        [
            "target_date",
            "lead_months",
            "y_hat",
            "dy_hat",
        ]
    ]
    .isna()
    .sum()
)

if int(invalid_core_counts.sum()) > 0:
    raise ValueError(
        "The forecast contains invalid core values:\n"
        f"{invalid_core_counts}"
    )

forecast["lead_months"] = (
    forecast["lead_months"]
    .astype(int)
)

forecast["calendar_month"] = (
    forecast["target_date"]
    .dt.month
)

forecast["calendar_year"] = (
    forecast["target_date"]
    .dt.year
)


# ============================================================
# 6. CATEGORICAL VALIDATION
# ============================================================

observed_components = sorted(
    forecast["input_kind"]
    .unique()
    .tolist()
)

observed_scenarios = sorted(
    forecast["scenario"]
    .unique()
    .tolist()
)

observed_model_families = sorted(
    forecast["model_family"]
    .unique()
    .tolist()
)

if observed_components != sorted(
    EXPECTED_COMPONENTS
):
    raise ValueError(
        "Unexpected input_kind values.\n"
        f"Expected: {sorted(EXPECTED_COMPONENTS)}\n"
        f"Observed: {observed_components}"
    )

if observed_scenarios != sorted(
    EXPECTED_SCENARIOS
):
    raise ValueError(
        "Unexpected scenario values.\n"
        f"Expected: {sorted(EXPECTED_SCENARIOS)}\n"
        f"Observed: {observed_scenarios}"
    )

if observed_model_families != sorted(
    EXPECTED_MODEL_FAMILIES
):
    raise ValueError(
        "Unexpected model families.\n"
        f"Expected: {sorted(EXPECTED_MODEL_FAMILIES)}\n"
        f"Observed: {observed_model_families}"
    )

observed_combinations = set(
    forecast[
        [
            "scenario",
            "model_family",
        ]
    ]
    .drop_duplicates()
    .itertuples(
        index=False,
        name=None,
    )
)

unexpected_combinations = (
    observed_combinations
    - EXPECTED_SCENARIO_MODEL_COMBINATIONS
)

missing_combinations = (
    EXPECTED_SCENARIO_MODEL_COMBINATIONS
    - observed_combinations
)

if unexpected_combinations:
    raise ValueError(
        "Unexpected scenario/model-family combinations: "
        f"{sorted(unexpected_combinations)}"
    )

if missing_combinations:
    raise ValueError(
        "Missing scenario/model-family combinations: "
        f"{sorted(missing_combinations)}"
    )


# ============================================================
# 7. TEMPORAL VALIDATION
# ============================================================

observed_leads = sorted(
    forecast["lead_months"]
    .unique()
    .tolist()
)

if observed_leads != EXPECTED_LEADS:
    missing_leads = sorted(
        set(EXPECTED_LEADS)
        - set(observed_leads)
    )

    extra_leads = sorted(
        set(observed_leads)
        - set(EXPECTED_LEADS)
    )

    raise ValueError(
        "The global monthly lead sequence is not 1..84.\n"
        f"Missing leads: {missing_leads}\n"
        f"Extra leads: {extra_leads}"
    )

forecast_origin = forecast[
    "target_date"
].min()

forecast["lead_reconstructed"] = (
    (
        forecast["target_date"].dt.year
        - forecast_origin.year
    )
    * 12
    + (
        forecast["target_date"].dt.month
        - forecast_origin.month
    )
    + 1
).astype(int)

forecast["lead_date_match"] = (
    forecast["lead_months"]
    == forecast["lead_reconstructed"]
)

n_lead_date_mismatches = int(
    (~forecast["lead_date_match"]).sum()
)

if n_lead_date_mismatches > 0:
    raise ValueError(
        f"Found {n_lead_date_mismatches} "
        "lead/date mismatches."
    )

n_non_month_start_dates = int(
    (
        forecast["target_date"].dt.day
        != 1
    ).sum()
)

if n_non_month_start_dates > 0:
    raise ValueError(
        f"Found {n_non_month_start_dates} dates "
        "that are not the first day of a month."
    )


# ============================================================
# 8. DUPLICATE AND IDENTIFIER VALIDATION
# ============================================================

duplicate_mask = forecast.duplicated(
    subset=UNIQUE_ROW_KEY,
    keep=False,
)

n_duplicate_rows = int(
    duplicate_mask.sum()
)

if n_duplicate_rows > 0:
    duplicate_output = (
        forecast.loc[
            duplicate_mask,
            UNIQUE_ROW_KEY + ["y_hat", "dy_hat"],
        ]
        .sort_values(UNIQUE_ROW_KEY)
    )

    duplicate_output.to_csv(
        PATHS["validation"]
        / "forecast_duplicate_rows.csv",
        index=False,
    )

    raise ValueError(
        f"Found {n_duplicate_rows} duplicate forecast rows."
    )

point_series_mapping = (
    forecast.groupby(
        [
            "input_kind",
            "point_id",
        ],
        dropna=False,
    )
    .agg(
        n_series_ids=(
            "series_id",
            "nunique",
        ),
        series_ids=(
            "series_id",
            lambda values: "|".join(
                sorted(
                    set(
                        values.astype(str)
                    )
                )
            ),
        ),
    )
    .reset_index()
)

n_points_with_multiple_series_ids = int(
    (
        point_series_mapping["n_series_ids"]
        > 1
    ).sum()
)

series_point_mapping = (
    forecast.groupby(
        [
            "input_kind",
            "series_id",
        ],
        dropna=False,
    )
    .agg(
        n_point_ids=(
            "point_id",
            "nunique",
        ),
        point_ids=(
            "point_id",
            lambda values: "|".join(
                sorted(
                    set(
                        values.astype(str)
                    )
                )
            ),
        ),
    )
    .reset_index()
)

n_series_with_multiple_point_ids = int(
    (
        series_point_mapping["n_point_ids"]
        > 1
    ).sum()
)


# ============================================================
# 9. GROUP COVERAGE
# ============================================================

group_coverage = (
    forecast.groupby(
        [
            "input_kind",
            "scenario",
            "model_family",
        ],
        dropna=False,
    )
    .agg(
        n_rows=("y_hat", "size"),
        n_points=("point_id", "nunique"),
        n_series=("series_id", "nunique"),
        date_min=("target_date", "min"),
        date_max=("target_date", "max"),
        lead_min=("lead_months", "min"),
        lead_max=("lead_months", "max"),
        y_hat_min=("y_hat", "min"),
        y_hat_max=("y_hat", "max"),
        y_hat_mean=("y_hat", "mean"),
        dy_hat_min=("dy_hat", "min"),
        dy_hat_max=("dy_hat", "max"),
        dy_hat_mean=("dy_hat", "mean"),
    )
    .reset_index()
)

expected_lead_set = set(
    EXPECTED_LEADS
)

point_coverage_records: list[
    dict[str, Any]
] = []

for (
    input_kind,
    scenario,
    model_family,
    point_id,
    series_id,
), group in forecast.groupby(
    [
        "input_kind",
        "scenario",
        "model_family",
        "point_id",
        "series_id",
    ],
    dropna=False,
):
    observed_point_leads = set(
        group["lead_months"]
        .astype(int)
        .tolist()
    )

    missing_point_leads = sorted(
        expected_lead_set
        - observed_point_leads
    )

    point_coverage_records.append(
        {
            "input_kind": input_kind,
            "scenario": scenario,
            "model_family": model_family,
            "point_id": point_id,
            "series_id": series_id,
            "n_rows": int(len(group)),
            "lead_min": int(
                group["lead_months"].min()
            ),
            "lead_max": int(
                group["lead_months"].max()
            ),
            "n_missing_leads": int(
                len(missing_point_leads)
            ),
            "missing_leads": serialize_leads(
                missing_point_leads
            ),
            "complete_leads_1_84": (
                len(missing_point_leads)
                == 0
            ),
        }
    )

point_coverage = pd.DataFrame(
    point_coverage_records
)

point_coverage_summary = (
    point_coverage.groupby(
        [
            "input_kind",
            "scenario",
            "model_family",
        ],
        dropna=False,
    )
    .agg(
        n_points=("point_id", "nunique"),
        n_complete_points=(
            "complete_leads_1_84",
            "sum",
        ),
        n_incomplete_points=(
            "complete_leads_1_84",
            lambda values: int(
                (~values).sum()
            ),
        ),
        total_missing_point_leads=(
            "n_missing_leads",
            "sum",
        ),
        maximum_missing_leads_one_point=(
            "n_missing_leads",
            "max",
        ),
    )
    .reset_index()
)


# ============================================================
# 10. EXACT EXOG SCENARIO ALIGNMENT
# ============================================================

exog = forecast[
    forecast["model_family"].eq("EXOG")
].copy()

scenario_alignment_records: list[
    dict[str, Any]
] = []

scenario_mismatch_frames: list[
    pd.DataFrame
] = []

for input_kind, component in exog.groupby(
    "input_kind"
):
    base_index = (
        component.loc[
            component["scenario"].eq("Base"),
            PAIRED_EXOG_KEY,
        ]
        .drop_duplicates()
        .set_index(PAIRED_EXOG_KEY)
        .index
    )

    for scenario in [
        "Favorable",
        "Unfavorable",
    ]:
        scenario_index = (
            component.loc[
                component["scenario"].eq(scenario),
                PAIRED_EXOG_KEY,
            ]
            .drop_duplicates()
            .set_index(PAIRED_EXOG_KEY)
            .index
        )

        missing_from_scenario = (
            base_index.difference(
                scenario_index
            )
        )

        extra_in_scenario = (
            scenario_index.difference(
                base_index
            )
        )

        keys_identical = (
            len(missing_from_scenario) == 0
            and len(extra_in_scenario) == 0
        )

        scenario_alignment_records.append(
            {
                "input_kind": input_kind,
                "scenario": scenario,
                "n_base_keys": int(
                    len(base_index)
                ),
                "n_scenario_keys": int(
                    len(scenario_index)
                ),
                "n_missing_from_scenario": int(
                    len(missing_from_scenario)
                ),
                "n_extra_in_scenario": int(
                    len(extra_in_scenario)
                ),
                "keys_identical": keys_identical,
            }
        )

        if len(missing_from_scenario) > 0:
            missing_frame = (
                missing_from_scenario
                .to_frame(index=False)
            )

            missing_frame[
                "scenario"
            ] = scenario

            missing_frame[
                "mismatch_type"
            ] = "missing_from_scenario"

            scenario_mismatch_frames.append(
                missing_frame
            )

        if len(extra_in_scenario) > 0:
            extra_frame = (
                extra_in_scenario
                .to_frame(index=False)
            )

            extra_frame[
                "scenario"
            ] = scenario

            extra_frame[
                "mismatch_type"
            ] = "extra_in_scenario"

            scenario_mismatch_frames.append(
                extra_frame
            )

scenario_alignment = pd.DataFrame(
    scenario_alignment_records
)

all_scenario_keys_aligned = bool(
    scenario_alignment[
        "keys_identical"
    ].all()
)

if not all_scenario_keys_aligned:
    if scenario_mismatch_frames:
        scenario_mismatches = pd.concat(
            scenario_mismatch_frames,
            ignore_index=True,
        )

        scenario_mismatches.to_csv(
            PATHS["validation"]
            / "forecast_scenario_key_mismatches.csv",
            index=False,
        )

    raise ValueError(
        "Base, Favorable, and Unfavorable "
        "do not contain identical EXOG keys."
    )


# ============================================================
# 11. y_hat / dy_hat INTERNAL COHERENCE
# ============================================================

dy_work = forecast.sort_values(
    [
        "input_kind",
        "scenario",
        "model_family",
        "point_id",
        "series_id",
        "lead_months",
    ]
).copy()

dy_group_columns = [
    "input_kind",
    "scenario",
    "model_family",
    "point_id",
    "series_id",
]

dy_work["previous_y_hat"] = (
    dy_work.groupby(
        dy_group_columns,
        dropna=False,
    )["y_hat"]
    .shift(1)
)

dy_work["previous_lead"] = (
    dy_work.groupby(
        dy_group_columns,
        dropna=False,
    )["lead_months"]
    .shift(1)
)

dy_work["is_consecutive_lead"] = (
    dy_work["lead_months"]
    - dy_work["previous_lead"]
    == 1
)

dy_work["y_hat_monthly_increment"] = (
    dy_work["y_hat"]
    - dy_work["previous_y_hat"]
)

dy_work["dy_hat_error"] = (
    dy_work["dy_hat"]
    - dy_work["y_hat_monthly_increment"]
)

dy_check = dy_work[
    dy_work["is_consecutive_lead"]
].copy()

dy_check["dy_hat_matches_increment"] = (
    np.isclose(
        dy_check["dy_hat"],
        dy_check[
            "y_hat_monthly_increment"
        ],
        atol=DY_ABSOLUTE_TOLERANCE,
        rtol=DY_RELATIVE_TOLERANCE,
    )
)

dy_consistency_summary = (
    dy_check.groupby(
        [
            "input_kind",
            "scenario",
            "model_family",
        ],
        dropna=False,
    )
    .agg(
        n_consecutive_pairs=(
            "dy_hat_error",
            "size",
        ),
        n_matching_pairs=(
            "dy_hat_matches_increment",
            "sum",
        ),
        pct_matching_pairs=(
            "dy_hat_matches_increment",
            lambda values: float(
                100.0
                * values.mean()
            ),
        ),
        mean_error=(
            "dy_hat_error",
            "mean",
        ),
        mean_absolute_error=(
            "dy_hat_error",
            lambda values: float(
                np.mean(
                    np.abs(values)
                )
            ),
        ),
        maximum_absolute_error=(
            "dy_hat_error",
            lambda values: float(
                np.max(
                    np.abs(values)
                )
            ),
        ),
    )
    .reset_index()
)

all_dy_pairs_match = bool(
    dy_check[
        "dy_hat_matches_increment"
    ].all()
)


# ============================================================
# 12. PHYSICAL-RANGE DIAGNOSTICS
# ============================================================

physical_range_summary = (
    forecast.groupby(
        "input_kind",
        dropna=False,
    )
    .agg(
        n_rows=("y_hat", "size"),
        y_hat_min=("y_hat", "min"),
        y_hat_q01=(
            "y_hat",
            lambda values: float(
                values.quantile(0.01)
            ),
        ),
        y_hat_median=("y_hat", "median"),
        y_hat_q99=(
            "y_hat",
            lambda values: float(
                values.quantile(0.99)
            ),
        ),
        y_hat_max=("y_hat", "max"),
        n_negative_y_hat=(
            "y_hat",
            lambda values: int(
                (values < 0).sum()
            ),
        ),
        pct_negative_y_hat=(
            "y_hat",
            lambda values: float(
                100.0
                * (values < 0).mean()
            ),
        ),
    )
    .reset_index()
)

# Negative values are reported, not automatically clipped.
forecast["negative_y_hat"] = (
    forecast["y_hat"] < 0
)


# ============================================================
# 13. CREATE THE INHERITED AE1 HORIZON TABLE
# ============================================================

ae1_horizon_records: list[
    dict[str, Any]
] = []

for input_kind in EXPECTED_COMPONENTS:
    ae1_horizon_records.append(
        {
            "input_kind": input_kind,
            "trustworthy_horizon_months": int(
                AE1_HORIZONS_MONTHS[
                    input_kind
                ]
            ),
            "source_type": AE1_SOURCE_TYPE,
            "source_reference": (
                PRIOR_PUBLICATION_REFERENCE
            ),
            "reestimated_from_current_forecast": False,
            "kge_available_in_current_input": False,
            "nse_available_in_current_input": False,
            "interpretation": (
                "Externally validated reliability horizon "
                "reapplied as a downstream analysis gate."
            ),
        }
    )

AE1_HORIZONS = pd.DataFrame(
    ae1_horizon_records
)


# ============================================================
# 14. CREATE MONTHLY AE1 GATE
# ============================================================

availability = (
    forecast.groupby(
        [
            "input_kind",
            "lead_months",
            "scenario",
            "model_family",
        ],
        dropna=False,
    )
    .agg(
        n_rows=("y_hat", "size"),
        n_points=("point_id", "nunique"),
        n_series=("series_id", "nunique"),
        target_date=(
            "target_date",
            "first",
        ),
    )
    .reset_index()
)

availability_lookup = {
    (
        row.input_kind,
        int(row.lead_months),
        row.scenario,
        row.model_family,
    ): {
        "n_rows": int(row.n_rows),
        "n_points": int(row.n_points),
        "n_series": int(row.n_series),
        "target_date": row.target_date,
    }
    for row in availability.itertuples(
        index=False
    )
}

ae1_gate_records: list[
    dict[str, Any]
] = []

for input_kind in EXPECTED_COMPONENTS:
    horizon = int(
        AE1_HORIZONS_MONTHS[
            input_kind
        ]
    )

    for lead_months in EXPECTED_LEADS:
        base_exog = availability_lookup.get(
            (
                input_kind,
                lead_months,
                "Base",
                "EXOG",
            ),
            {},
        )

        base_endo = availability_lookup.get(
            (
                input_kind,
                lead_months,
                "Base",
                "ENDO",
            ),
            {},
        )

        favorable_exog = (
            availability_lookup.get(
                (
                    input_kind,
                    lead_months,
                    "Favorable",
                    "EXOG",
                ),
                {},
            )
        )

        unfavorable_exog = (
            availability_lookup.get(
                (
                    input_kind,
                    lead_months,
                    "Unfavorable",
                    "EXOG",
                ),
                {},
            )
        )

        target_date = (
            base_exog.get("target_date")
            or base_endo.get("target_date")
        )

        n_base_exog = int(
            base_exog.get(
                "n_points",
                0,
            )
        )

        n_favorable_exog = int(
            favorable_exog.get(
                "n_points",
                0,
            )
        )

        n_unfavorable_exog = int(
            unfavorable_exog.get(
                "n_points",
                0,
            )
        )

        paired_scenario_data_available = (
            n_base_exog > 0
            and n_base_exog
            == n_favorable_exog
            == n_unfavorable_exog
        )

        within_horizon = (
            lead_months <= horizon
        )

        ae1_gate_records.append(
            {
                "input_kind": input_kind,
                "lead_months": lead_months,
                "target_date": target_date,
                "trustworthy_horizon_months": horizon,
                "within_inherited_AE1_horizon": within_horizon,
                "n_points_base_endo": int(
                    base_endo.get(
                        "n_points",
                        0,
                    )
                ),
                "n_points_base_exog": n_base_exog,
                "n_points_favorable_exog": n_favorable_exog,
                "n_points_unfavorable_exog": n_unfavorable_exog,
                "paired_scenario_data_available": (
                    paired_scenario_data_available
                ),
                "AE1_gate_pass": (
                    within_horizon
                    and paired_scenario_data_available
                ),
                "AE1_gate_source": AE1_SOURCE_TYPE,
                "AE1_reestimated": False,
            }
        )

AE1_GATE_BY_LEAD = pd.DataFrame(
    ae1_gate_records
)

AE1_GATE_BY_LEAD["target_date"] = (
    pd.to_datetime(
        AE1_GATE_BY_LEAD[
            "target_date"
        ]
    )
)

ae1_gate_summary = (
    AE1_GATE_BY_LEAD.groupby(
        "input_kind",
        dropna=False,
    )
    .agg(
        trustworthy_horizon_months=(
            "trustworthy_horizon_months",
            "first",
        ),
        n_months_total=(
            "lead_months",
            "size",
        ),
        n_months_within_horizon=(
            "within_inherited_AE1_horizon",
            "sum",
        ),
        n_months_with_paired_data=(
            "paired_scenario_data_available",
            "sum",
        ),
        n_months_passing_AE1_gate=(
            "AE1_gate_pass",
            "sum",
        ),
        minimum_base_exog_points=(
            "n_points_base_exog",
            "min",
        ),
        maximum_base_exog_points=(
            "n_points_base_exog",
            "max",
        ),
    )
    .reset_index()
)


# ============================================================
# 15. NORMALIZED CANONICAL FORECAST
# ============================================================

FC_CANONICAL = (
    forecast.drop(
        columns=[
            "lead_reconstructed",
            "lead_date_match",
        ]
    )
    .sort_values(
        [
            "input_kind",
            "model_family",
            "scenario",
            "point_id",
            "series_id",
            "lead_months",
        ]
    )
    .reset_index(drop=True)
)

# Add the inherited reliability horizon and monthly gate.
FC_CANONICAL = FC_CANONICAL.merge(
    AE1_GATE_BY_LEAD[
        [
            "input_kind",
            "lead_months",
            "trustworthy_horizon_months",
            "within_inherited_AE1_horizon",
            "AE1_gate_pass",
        ]
    ],
    on=[
        "input_kind",
        "lead_months",
    ],
    how="left",
    validate="many_to_one",
)

if FC_CANONICAL[
    "AE1_gate_pass"
].isna().any():
    raise RuntimeError(
        "AE1 gate could not be assigned "
        "to all forecast rows."
    )


# ============================================================
# 16. OUTPUT PATHS
# ============================================================

FORECAST_CANONICAL_PATH = (
    PATHS["validation"]
    / "AE_forecast_scenarios_canonical.csv"
)

FORECAST_ORIGINAL_COPY_PATH = (
    PATHS["validation"]
    / "AE_forecast_scenarios_ALL_original.csv"
)

GROUP_COVERAGE_PATH = (
    PATHS["validation"]
    / "forecast_group_coverage.csv"
)

POINT_COVERAGE_PATH = (
