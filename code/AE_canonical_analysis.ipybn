        axis.plot(
            dates,
            panel[
                "scenario_conditioning_value"
            ],
            color=component_color,
            linewidth=1.7,
            zorder=4,
        )

        pointwise_mask = (
            panel[
                "scenario_value_pointwise_positive"
            ].to_numpy(
                dtype=bool
            )
            &
            panel[
                "within_AE1_horizon"
            ].to_numpy(
                dtype=bool
            )
        )

        joint_mask = (
            panel[
                "scenario_value_joint_band_positive"
            ].to_numpy(
                dtype=bool
            )
            &
            panel[
                "within_AE1_horizon"
            ].to_numpy(
                dtype=bool
            )
        )

        axis.scatter(
            dates.loc[
                pointwise_mask
            ],
            panel.loc[
                pointwise_mask,
                "scenario_conditioning_value",
            ],
            s=16,
            facecolor=EXPLORATORY_COLOR,
            edgecolor="white",
            linewidth=0.45,
            zorder=6,
        )

        if joint_mask.any():
            axis.scatter(
                dates.loc[
                    joint_mask
                ],
                panel.loc[
                    joint_mask,
                    "scenario_conditioning_value",
                ],
                s=20,
                marker="D",
                facecolor=CONFIRMATORY_COLOR,
                edgecolor="white",
                linewidth=0.45,
                zorder=7,
            )

        axis.axhline(
            0,
            color=ZERO_COLOR,
            linewidth=0.9,
            zorder=3,
        )

        axis.axvline(
            boundary_date,
            color=REFERENCE_COLOR,
            linewidth=1.0,
            linestyle=(
                0,
                (
                    4,
                    3,
                ),
            ),
            zorder=5,
        )

        axis.set_ylim(
            FIGURE_5_COMMON_Y_LIMITS
        )

        axis.grid(
            axis="y",
            color=GRIDLINE_COLOR,
            linewidth=0.6,
            alpha=0.75,
        )

        if row_index == 0:
            axis.set_title(
                component,
                color=component_color,
                fontweight="bold",
            )

        if column_index == 0:
            axis.set_ylabel(
                (
                    f"{scenario}\n"
                    "Scenario-conditioning value"
                )
            )
        else:
            axis.tick_params(
                axis="y",
                labelleft=False,
            )

        if row_index == 1:
            axis.set_xlabel(
                "Target month"
            )

        format_biennial_year_axis(
            axis
        )

        axis.text(
            0.02,
            0.95,
            rf"$R_k={horizon}$",
            transform=axis.transAxes,
            ha="left",
            va="top",
            fontsize=7.4,
            color="#444444",
        )

        add_panel_label(
            axis,
            panel_labels_5[
                row_index
                * 3
                + column_index
            ],
            x=-0.20,
            y=1.09,
        )


