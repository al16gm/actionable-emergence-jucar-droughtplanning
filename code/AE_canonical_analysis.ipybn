    / "analysis_scope_amendment_cell04.json"
)

POINT_CONTRIBUTIONS_PATH = (
    AE3_DIR
    / "AE3_cross_validated_point_contributions.csv"
)

MONTHLY_DEFAULT_PATH = (
    AE3_DIR
    / "AE3_monthly_default_decision_value.csv"
)

BOOTSTRAP_INFERENCE_PATH = (
    AE3_DIR
    / "AE3_monthly_bootstrap_inference.csv"
)

BOOTSTRAP_CRITICAL_VALUES_PATH = (
    AE3_DIR
    / "AE3_simultaneous_band_critical_values.csv"
)

DEFAULT_SUMMARY_PATH = (
    AE3_DIR
    / "AE3_default_summary_within_AE1.csv"
)

SENSITIVITY_MONTHLY_PATH = (
    AE3_DIR
    / "AE3_parameter_sensitivity_monthly.csv"
)

SENSITIVITY_SUMMARY_PATH = (
    AE3_DIR
    / "AE3_parameter_sensitivity_summary.csv"
)

