print("\nCELL 01 COMPLETED SUCCESSFULLY")
print("=" * 100)

# ============================================================
# CELL 02 — CANONICAL AE2 DROUGHT-RANK PREPARATION
#
# Primary formulation
# -------------------
# 1. Select a constant EXOG control-point panel with complete
#    Base, Favorable and Unfavorable trajectories for leads 1–84.
#
# 2. Remove the Base seasonal cycle separately for every point:
#
#       residual(i,t,s)
#       =
#       y_hat(i,t,s)
#       -
#       median_Base(i, calendar_month(t))
#
# 3. Build one empirical reference distribution per point using
#    all 84 Base seasonal residuals.
#
# 4. Evaluate every scenario residual with a tie-aware midrank CDF:
#
#       drought_rank_score = 1 - F_Base_point(residual)
#
#    Higher scores indicate relatively lower hydrological states
#    and therefore greater drought pressure.
#
# 5. Calculate paired point-level scenario-minus-Base differences.
#
# Scientific interpretation
# -------------------------
# This is a forecast-relative drought-rank score.
# It is not a calibrated probability of future observed drought.
#
# This cell:
#   - uses y_hat only;
#   - excludes dy_hat;
#   - excludes completely flat Base residual references;
#   - retains a binary lower-tail measure only as sensitivity;
#   - prepares the paired trajectories required by Cell 03.
#
# This cell does not:
#   - calculate bootstrap confidence intervals;
#   - determine persistent emergence;
#   - calculate AE3;
#   - use legacy AE2 results as analytical inputs.
# ============================================================

from __future__ import annotations

import copy
import hashlib
import json
import shutil
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

import numpy as np
import pandas as pd


# ============================================================
# 1. REQUIRE CELLS 00 AND 01
# ============================================================

REQUIRED_OBJECTS = [
    "PATHS",
    "RUN_DIR",
    "RUN_CONTEXT",
    "MANIFEST_PATH",
    "CONFIG",
    "FORECAST_SHA256",
    "EXPECTED_FORECAST_SHA256",
    "AE1_HORIZON_TABLE",
    "AE1_GATE",
]

missing_objects = [
    name
    for name in REQUIRED_OBJECTS
    if name not in globals()
]

if missing_objects:
    raise RuntimeError(
        "Cells 00 and 01 must be executed before Cell 02. "
        f"Missing objects: {missing_objects}"
    )

if "FC_CANONICAL" not in globals():
    canonical_path = (
        Path(PATHS["validation"])
        / "AE_forecast_scenarios_canonical.csv"
    )

    if not canonical_path.is_file():
        raise RuntimeError(
            "FC_CANONICAL is not in memory and the canonical "
            "forecast file was not found."
        )

    FC_CANONICAL = pd.read_csv(
        canonical_path,
        dtype={
            "point_id": str,
            "series_id": str,
        },
    )

    FC_CANONICAL["target_date"] = pd.to_datetime(
        FC_CANONICAL["target_date"],
        errors="raise",
    )


# ============================================================
# 2. ARCHIVE SUPERSEDED AE2 OUTPUTS
# ============================================================

AE2_DIR = Path(PATHS["ae2"])
AE2_DIR.mkdir(
    parents=True,
    exist_ok=True,
)

existing_ae2_files = [
    path
    for path in AE2_DIR.iterdir()
    if path.is_file()
]

ARCHIVE_DIRECTORY: Path | None = None

if existing_ae2_files:
    archive_timestamp = datetime.now(
        timezone.utc
    ).strftime("%Y%m%dT%H%M%S%fZ")

    ARCHIVE_DIRECTORY = (
        AE2_DIR
        / "_superseded_cell02"
        / archive_timestamp
    )

    ARCHIVE_DIRECTORY.mkdir(
        parents=True,
        exist_ok=False,
    )

    for old_path in existing_ae2_files:
        shutil.move(
            str(old_path),
            str(
                ARCHIVE_DIRECTORY
                / old_path.name
            ),
        )


# ============================================================
# 3. CONFIGURATION
# ============================================================

AE2_PRIMARY_METRIC = (
    "forecast_relative_seasonally_adjusted_drought_rank_score"
)

AE2_MODEL_FAMILY = "EXOG"
AE2_REFERENCE_SCENARIO = "Base"
AE2_BINARY_TAIL_QUANTILE = 0.20

AE2_BOOTSTRAP_REPLICATES = 5000
AE2_BOOTSTRAP_SEED = 123
AE2_CONFIDENCE_LEVEL = 0.95

EFFECT_THRESHOLDS_PP = [
    0.5,
    1.0,
    1.5,
]

PERSISTENCE_MONTHS = [
    1,
    3,
    6,
]

EXPECTED_DIRECTION = {
    "Favorable": "negative",
    "Unfavorable": "positive",
}

EXPECTED_SCENARIOS = [
    "Base",
    "Favorable",
    "Unfavorable",
]

EXPECTED_LEADS = list(
    range(1, 85)
)

EXPECTED_LEAD_SET = set(
    EXPECTED_LEADS
)

EXPECTED_COMPLETE_PANEL_SIZES = {
    "Aquifer": 22,
    "Reservoir": 24,
    "River": 54,
}

MINIMUM_INFORMATIVE_POINTS = 10
NUMERICAL_ATOL = 1e-12
NUMERICAL_RTOL = 1e-10


# ============================================================
# 4. CONFIGURATION AMENDMENT
# ============================================================

CONFIG_AMENDED = copy.deepcopy(
    CONFIG
)

CONFIG_AMENDED["ae2"] = {
    "primary_metric": AE2_PRIMARY_METRIC,
    "primary_metric_unit": "rank_score_percentage_points",

    "input_variable": "y_hat",
