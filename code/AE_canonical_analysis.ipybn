# ============================================================
# 19. PREPARE FIGURE 6 MATRIX
# ============================================================

table_1_required_columns = [
    "Component",
    "Scenario",
    "AE1 horizon (months)",
    "AE2 joint-significant months",
    "AE3 pointwise-positive months",
    "Persistent exploratory magnitude (r=3)",
    "Persistent exploratory directional (r=3)",
    "Persistent confirmatory magnitude (r=3)",
    "Persistent confirmatory directional (r=3)",
    "Final evidence class",
]

missing_table_1_columns = [
    column
    for column in table_1_required_columns
    if column not in FIGURE_6_MATRIX_DATA.columns
]

if missing_table_1_columns:
    raise ValueError(
        "Paper Table 1 is missing columns required by Figure 6: "
        f"{missing_table_1_columns}"
    )


component_rank = {
    component: index
    for index, component in enumerate(
        COMPONENT_ORDER
    )
}

scenario_rank = {
    scenario: index
    for index, scenario in enumerate(
        SCENARIO_ORDER
    )
}

FIGURE_6_MATRIX_DATA[
    "_component_rank"
] = FIGURE_6_MATRIX_DATA[
    "Component"
].map(
    component_rank
)

FIGURE_6_MATRIX_DATA[
    "_scenario_rank"
] = FIGURE_6_MATRIX_DATA[
    "Scenario"
].map(
    scenario_rank
)

FIGURE_6_MATRIX_DATA = (
    FIGURE_6_MATRIX_DATA.sort_values(
        [
            "_component_rank",
            "_scenario_rank",
        ]
    )
    .reset_index(
        drop=True
    )
)


matrix_column_labels = [
    "AE1\nhorizon",
    "AE2 joint\nmonths",
    "AE3 pointwise\nmonths",
    "Persistent\nexploratory\nmagnitude",
    "Persistent\nexploratory\ndirectional",
    "Persistent\nconfirmatory\nmagnitude",
    "Persistent\nconfirmatory\ndirectional",
]

matrix_values = np.zeros(
    (
        len(
            FIGURE_6_MATRIX_DATA
        ),
        len(
            matrix_column_labels
        ),
    ),
    dtype=float,
)

matrix_annotations = np.empty(
    matrix_values.shape,
    dtype=object,
)

for row_index, row in FIGURE_6_MATRIX_DATA.iterrows():
    ae1_horizon = int(
        row[
            "AE1 horizon (months)"
        ]
    )

    ae2_joint = int(
        row[
            "AE2 joint-significant months"
        ]
    )

    ae3_pointwise = int(
        row[
            "AE3 pointwise-positive months"
        ]
    )

    exploratory_magnitude = (
        str(
            row[
                "Persistent exploratory magnitude (r=3)"
            ]
        )
        .strip()
        .lower()
        == "yes"
    )

    exploratory_directional = (
        str(
            row[
                "Persistent exploratory directional (r=3)"
            ]
        )
        .strip()
        .lower()
        == "yes"
    )

    confirmatory_magnitude = (
        str(
            row[
                "Persistent confirmatory magnitude (r=3)"
            ]
        )
        .strip()
        .lower()
        == "yes"
    )

    confirmatory_directional = (
        str(
            row[
                "Persistent confirmatory directional (r=3)"
            ]
        )
        .strip()
        .lower()
        == "yes"
    )

    matrix_values[
        row_index,
        0,
    ] = 0.45

    matrix_values[
        row_index,
        1,
    ] = (
        1.0
        if ae2_joint > 0
        else 0.0
    )

    matrix_values[
        row_index,
        2,
    ] = (
        1.0
        if ae3_pointwise > 0
        else 0.0
    )

    matrix_values[
        row_index,
        3,
    ] = (
        1.0
        if exploratory_magnitude
        else 0.0
    )

    matrix_values[
        row_index,
        4,
    ] = (
        1.0
        if exploratory_directional
        else 0.0
    )

    matrix_values[
        row_index,
        5,
    ] = (
        2.0
        if confirmatory_magnitude
        else 0.0
    )

    matrix_values[
        row_index,
        6,
    ] = (
        2.0
        if confirmatory_directional
        else 0.0
    )

    matrix_annotations[
        row_index,
        :
    ] = [
        str(
            ae1_horizon
        ),
        str(
            ae2_joint
        ),
        str(
            ae3_pointwise
        ),
        (
            "Yes"
            if exploratory_magnitude
            else "No"
        ),
        (
            "Yes"
            if exploratory_directional
            else "No"
        ),
        (
            "Yes"
            if confirmatory_magnitude
            else "No"
        ),
        (
            "Yes"
            if confirmatory_directional
            else "No"
        ),
    ]


evidence_cmap = ListedColormap(
    [
        "#F0F0F0",
        EXPLORATORY_COLOR,
        CONFIRMATORY_COLOR,
    ]
)

evidence_norm = BoundaryNorm(
    [
        -0.1,
        0.25,
        1.5,
        2.5,
    ],
    evidence_cmap.N,
)


# ============================================================
# 20. GENERATE FIGURE 6
# ============================================================

figure_6 = plt.figure(
    figsize=FIGURE_SIZES[
        "Figure_6"
    ]
)

grid_spec = figure_6.add_gridspec(
    nrows=2,
    ncols=1,
    height_ratios=[
        1.45,
        1.0,
    ],
    hspace=0.43,
)

axis_6a = figure_6.add_subplot(
    grid_spec[
        0,
