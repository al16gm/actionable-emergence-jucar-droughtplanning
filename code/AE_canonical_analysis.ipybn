                row[
                    "Window"
                ]
            ),
            ha="center",
            va="center",
            fontsize=8,
            color="white",
            fontweight="bold",
        )

    axis_6b.set_yticks(
        [
            1,
            0,
        ]
    )

    axis_6b.set_yticklabels(
        [
            "Reservoir — Favorable",
            "Reservoir — Unfavorable",
        ],
        fontsize=8,
    )

    x_start = (
        windows[
            "Start date"
        ].min()
        - pd.offsets.MonthBegin(
            2
        )
    )

    x_end = (
        windows[
            "End date"
        ].max()
        + pd.offsets.MonthEnd(
