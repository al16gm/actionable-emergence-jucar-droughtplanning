def utc_now_iso() -> str:
    """Return the current UTC timestamp."""
    return datetime.now(
        timezone.utc
    ).isoformat(
        timespec="seconds"
    )


def sha256_file(
    path: Path,
    chunk_size: int = 1024 * 1024,
) -> str:
    """Return a SHA-256 file hash."""
    digest = hashlib.sha256()

    with path.open(
        "rb",
    ) as handle:
        while True:
            chunk = handle.read(
                chunk_size
            )

            if not chunk:
                break

            digest.update(
                chunk
            )

    return digest.hexdigest()


def sha256_json(
    payload: dict[str, Any],
) -> str:
    """Return a deterministic JSON SHA-256 hash."""
    serialized = json.dumps(
        payload,
        ensure_ascii=False,
        sort_keys=True,
        separators=(",", ":"),
        default=str,
    ).encode(
        "utf-8"
    )

    return hashlib.sha256(
        serialized
    ).hexdigest()


def update_json_file(
    path: Path,
    updates: dict[str, Any],
) -> None:
    """Update a JSON file while preserving existing fields."""
    if path.exists():
        with path.open(
            "r",
            encoding="utf-8",
        ) as handle:
            payload = json.load(
                handle
            )
    else:
        payload = {}

    payload.update(
        updates
    )

    with path.open(
        "w",
        encoding="utf-8",
    ) as handle:
        json.dump(
            payload,
            handle,
            ensure_ascii=False,
            indent=2,
            sort_keys=True,
            default=str,
        )


def normalize_name(
    value: str,
) -> str:
    """Normalize names for flexible column matching."""
    return re.sub(
        r"[^a-z0-9]+",
        "_",
        str(
            value
        ).strip().lower(),
    ).strip(
        "_"
    )


def coerce_boolean(
    values: pd.Series,
) -> pd.Series:
    """Convert Boolean-like values to bool."""
    if pd.api.types.is_bool_dtype(
        values
    ):
        return values.astype(
            bool
        )

    mapping = {
        "true": True,
        "false": False,
        "1": True,
        "0": False,
        "yes": True,
        "no": False,
    }

    normalized = (
        values.astype(
            str
        )
        .str.strip()
        .str.lower()
        .map(
            mapping
        )
    )

    if normalized.isna().any():
        invalid_examples = (
            values.loc[
                normalized.isna()
            ]
            .drop_duplicates()
            .head(
                10
            )
            .tolist()
        )

        raise ValueError(
            "Could not convert a column to Boolean. "
            f"Examples: {invalid_examples}"
        )

    return normalized.astype(
        bool
    )


def normalize_dates(
    frame: pd.DataFrame,
) -> pd.DataFrame:
    """Parse known date columns."""
    output = frame.copy()

    for column in output.columns:
        normalized_column = normalize_name(
            column
        )

        is_date_column = (
            normalized_column
            == "date"
            or normalized_column.endswith(
                "_date"
            )
            or normalized_column
            in {
                "target_date",
                "start_date",
                "end_date",
            }
        )

        if not is_date_column:
            continue

        converted = pd.to_datetime(
            output[
                column
            ],
            errors="coerce",
        )

        original_count = int(
            output[
                column
            ].notna().sum()
        )

        converted_count = int(
            converted.notna().sum()
        )

        if (
            original_count == 0
            or original_count
            == converted_count
        ):
            output[
                column
            ] = converted

    return output


def load_frame(
    global_names: list[str],
    candidate_paths: list[Path],
    dtype: dict[str, Any] | None = None,
) -> tuple[
    pd.DataFrame,
    str,
]:
    """Load a DataFrame from memory or canonical CSV."""
    for global_name in global_names:
        if (
            global_name in globals()
            and isinstance(
                globals()[
                    global_name
                ],
                pd.DataFrame,
            )
        ):
            return (
                normalize_dates(
                    globals()[
                        global_name
                    ].copy()
                ),
                f"global:{global_name}",
            )

    for candidate_path in candidate_paths:
        if candidate_path.is_file():
            return (
                normalize_dates(
                    pd.read_csv(
                        candidate_path,
                        dtype=dtype,
                    )
                ),
                str(
                    candidate_path
                ),
            )

    raise FileNotFoundError(
        "Required canonical table was not found.\n"
        f"Globals checked: {global_names}\n"
        "Paths checked:\n"
        + "\n".join(
            str(
                path
            )
            for path in candidate_paths
        )
    )


def resolve_column(
    frame: pd.DataFrame,
    exact_candidates: Iterable[str] = (),
    required_tokens: Iterable[str] = (),
    excluded_tokens: Iterable[str] = (),
    prefer_tokens: Iterable[str] = (),
    required: bool = True,
) -> str | None:
    """Resolve a column using exact and token-based matching."""
    normalized_lookup = {
        normalize_name(
            column
        ): column
        for column in frame.columns
    }

    for candidate in exact_candidates:
        normalized_candidate = normalize_name(
            candidate
        )

        if normalized_candidate in normalized_lookup:
            return normalized_lookup[
                normalized_candidate
            ]

    normalized_required = [
        normalize_name(
            token
        )
        for token in required_tokens
    ]

    normalized_excluded = [
        normalize_name(
            token
        )
        for token in excluded_tokens
    ]

    normalized_preferred = [
        normalize_name(
            token
        )
        for token in prefer_tokens
    ]

    matches = []

    for column in frame.columns:
        normalized_column = normalize_name(
            column
        )

        if not all(
            token in normalized_column
            for token in normalized_required
        ):
            continue

        if any(
            token in normalized_column
            for token in normalized_excluded
        ):
            continue

        score = sum(
            token in normalized_column
            for token in normalized_preferred
        )

        score -= (
            0.001
            * len(
                normalized_column
            )
        )

        matches.append(
            (
                score,
                column,
            )
        )

    if matches:
        matches.sort(
            key=lambda item: item[
                0
            ],
            reverse=True,
        )

        return matches[
            0
        ][
            1
        ]

    if required:
        raise KeyError(
            "Could not resolve a required column.\n"
            f"Exact candidates: {list(exact_candidates)}\n"
            f"Required tokens: {list(required_tokens)}\n"
            f"Excluded tokens: {list(excluded_tokens)}\n"
            f"Available columns: {list(frame.columns)}"
        )

    return None


def first_existing_column(
    frame: pd.DataFrame,
    candidates: list[str],
) -> str | None:
    """Return the first matching normalized column."""
    normalized_lookup = {
        normalize_name(
            column
        ): column
        for column in frame.columns
    }

    for candidate in candidates:
        normalized_candidate = normalize_name(
            candidate
        )

        if normalized_candidate in normalized_lookup:
            return normalized_lookup[
                normalized_candidate
            ]

    return None


def finite_axis_limits(
    arrays: list[np.ndarray],
    include_zero: bool = True,
    padding_fraction: float = 0.08,
) -> tuple[
    float,
    float,
]:
    """Return stable numeric axis limits."""
    finite_values: list[
        float
    ] = []

    for array in arrays:
        values = np.asarray(
            array,
            dtype=float,
        )

        finite_values.extend(
            values[
                np.isfinite(
                    values
                )
            ].tolist()
        )

    if include_zero:
        finite_values.append(
            0.0
        )

    if not finite_values:
        return (
            -1.0,
            1.0,
        )

    minimum = float(
        np.min(
            finite_values
        )
    )

    maximum = float(
        np.max(
            finite_values
        )
    )

    if math.isclose(
        minimum,
        maximum,
        abs_tol=NUMERICAL_ATOL,
    ):
        expansion = max(
            1.0,
            abs(
                minimum
            )
            * 0.1,
        )

        return (
            minimum - expansion,
            maximum + expansion,
        )

    span = maximum - minimum

    padding = (
        padding_fraction
        * span
    )

    return (
        minimum - padding,
        maximum + padding,
    )


def add_panel_label(
    axis: plt.Axes,
    label: str,
    x: float = -0.18,
    y: float = 1.08,
) -> None:
    """Add a panel identifier outside the plotting region."""
    axis.text(
        x,
        y,
        label,
        transform=axis.transAxes,
        fontsize=11,
        fontweight="bold",
        va="top",
        ha="left",
        clip_on=False,
    )


def format_biennial_year_axis(
    axis: plt.Axes,
) -> None:
    """Format a monthly date axis with labels every two years."""
    axis.xaxis.set_major_locator(
        mdates.YearLocator(
            base=2
        )
    )

    axis.xaxis.set_major_formatter(
        mdates.DateFormatter(
            "%Y"
        )
    )

    axis.tick_params(
        axis="x",
        rotation=0,
    )


def export_figure(
    figure: plt.Figure,
    figure_id: str,
    filename_stem: str,
) -> list[dict[str, Any]]:
    """Export a figure in all required publication formats."""
    output_records = []

    for output_format in OUTPUT_FORMATS:
        output_path = (
            MAIN_FIGURES_DIR
            / f"{filename_stem}.{output_format}"
        )

        save_kwargs: dict[
            str,
            Any,
        ] = {
            "format": output_format,
            "bbox_inches": "tight",
            "pad_inches": 0.04,
            "facecolor": "white",
        }

        if output_format == "png":
            save_kwargs[
                "dpi"
            ] = PNG_DPI

        elif output_format == "tiff":
            save_kwargs[
                "dpi"
            ] = TIFF_DPI

            save_kwargs[
                "pil_kwargs"
            ] = {
                "compression": "tiff_lzw",
            }

        figure.savefig(
            output_path,
            **save_kwargs,
        )

        output_records.append(
            {
                "figure_id": figure_id,
                "format": output_format,
                "path": str(
                    output_path
                ),
                "size_bytes": int(
                    output_path.stat().st_size
                ),
                "sha256": sha256_file(
                    output_path
                ),
            }
        )

    return output_records


def parse_yes_no(
    value: Any,
) -> bool:
    """Parse strict yes/no values."""
    normalized = str(
        value
    ).strip().lower()

    return normalized in {
        "yes",
        "true",
        "1",
    }


def evidence_level(
    value: Any,
) -> str:
    """Return none, exploratory, or confirmatory evidence."""
    normalized = str(
        value
    ).strip().lower()

    if (
        "confirm"
        in normalized
    ):
        return "confirmatory"

    if (
        "explor"
        in normalized
        or normalized
        in {
            "yes",
            "true",
            "1",
        }
    ):
        return "exploratory"

    return "none"


