    index=False,
)

AE_FULL_SYNTHESIS_DEFAULT.to_csv(
    FULL_SYNTHESIS_PATH,
    index=False,
    date_format="%Y-%m-%d",
)

AE_FULL_SYNTHESIS_SUMMARY.to_csv(
    FULL_SYNTHESIS_SUMMARY_PATH,
    index=False,
    date_format="%Y-%m-%d",
)


# ============================================================
# 20. SCOPE, REPORT, AND MANIFEST
# ============================================================

scope_amendment = {
    "created_utc": utc_now_iso(),
    "forecast_sha256": FORECAST_SHA256,
