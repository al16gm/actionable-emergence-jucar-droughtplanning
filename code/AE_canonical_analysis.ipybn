# ============================================================
# 5. HELPERS
# ============================================================

def utc_now_iso() -> str:
    """Return the current UTC timestamp."""
    return datetime.now(
        timezone.utc
    ).isoformat(
        timespec="seconds"
    )


def display_frame(
    frame: pd.DataFrame,
    n: int = 50,
) -> None:
    """Display a DataFrame with a text fallback."""
    try:
        display(
            frame.head(n)
        )
    except NameError:
        print(
            frame.head(n).to_string(
                index=False
            )
        )


def sha256_json(
    payload: dict[str, Any],
) -> str:
    """Return a deterministic JSON SHA-256 hash."""
    serialized = json.dumps(
        payload,
        sort_keys=True,
        ensure_ascii=False,
        separators=(",", ":"),
        default=str,
    ).encode("utf-8")

    return hashlib.sha256(
        serialized
    ).hexdigest()


def sha256_file(
    path: Path,
    chunk_size: int = 1024 * 1024,
) -> str:
    """Return the SHA-256 hash of a file."""
    digest = hashlib.sha256()

    with path.open(
        "rb",
    ) as handle:
        while True:
            chunk = handle.read(
                chunk_size
            )

            if not chunk:
                break

            digest.update(
                chunk
            )

    return digest.hexdigest()


def update_json_file(
    path: Path,
    updates: dict[str, Any],
) -> None:
    """Update a JSON file while preserving existing fields."""
    if path.exists():
        with path.open(
            "r",
            encoding="utf-8",
        ) as handle:
            payload = json.load(
                handle
            )
    else:
        payload = {}

    payload.update(
        updates
    )

    with path.open(
        "w",
        encoding="utf-8",
    ) as handle:
        json.dump(
            payload,
            handle,
            ensure_ascii=False,
            indent=2,
            sort_keys=True,
            default=str,
        )


def load_frame(
    global_names: list[str],
    path: Path,
    dtype: dict[str, Any] | None = None,
) -> pd.DataFrame:
    """Load a DataFrame from memory or from its canonical CSV."""
    for global_name in global_names:
        if global_name in globals():
            value = globals()[
                global_name
            ]

            if isinstance(
                value,
                pd.DataFrame,
            ):
                return value.copy()

    if path.is_file():
        return pd.read_csv(
            path,
            dtype=dtype,
        )

    raise FileNotFoundError(
        "Required table source was not found.\n"
        f"Globals checked: {global_names}\n"
        f"Path checked: {path}"
    )


def coerce_boolean(
    values: pd.Series,
) -> pd.Series:
    """Normalize Boolean-like values."""
    if pd.api.types.is_bool_dtype(
        values
    ):
        return values.astype(bool)

    mapping = {
        "true": True,
        "false": False,
        "1": True,
        "0": False,
    }

    normalized = (
        values.astype(str)
        .str.strip()
        .str.lower()
        .map(mapping)
    )

    if normalized.isna().any():
        raise ValueError(
            "Could not convert all values to Boolean."
        )

    return normalized.astype(bool)


def yes_no(
    values: pd.Series,
) -> pd.Series:
    """Convert Boolean values to publication labels."""
    return np.where(
        values.astype(bool),
        "Yes",
        "No",
    )


def safe_ratio(
    numerator: float,
    denominator: float,
) -> float:
    """Return a ratio when the denominator is positive."""
    if (
        not np.isfinite(
            numerator
        )
        or not np.isfinite(
            denominator
        )
        or denominator
        <= NUMERICAL_ATOL
    ):
        return np.nan

    return float(
        numerator
        / denominator
    )


def evidence_class(
    row: pd.Series,
) -> str:
    """Classify the strongest persistent full-AE evidence."""
    if bool(
        row[
            "confirmatory_directional_detected"
        ]
    ):
        return (
            "Confirmatory persistent, directional"
        )

    if bool(
        row[
            "confirmatory_magnitude_detected"
        ]
    ):
        return (
            "Confirmatory persistent, magnitude only"
        )

    if bool(
        row[
            "exploratory_directional_detected"
        ]
    ):
        return (
            "Exploratory persistent, directional"
        )

    if bool(
        row[
            "exploratory_magnitude_detected"
        ]
    ):
        return (
            "Exploratory persistent, magnitude only"
        )

    return "No persistent full AE"


def excel_safe(
    value: Any,
) -> Any:
    """Convert pandas and NumPy values to Excel-safe Python values."""
    if value is None:
        return None

    if isinstance(
        value,
        pd.Timestamp,
    ):
        if pd.isna(
            value
        ):
            return None

        return value.to_pydatetime()

    if isinstance(
        value,
        np.generic,
    ):
        value = value.item()

    if isinstance(
        value,
        float,
    ) and (
        math.isnan(
            value
        )
        or math.isinf(
            value
        )
    ):
        return None

    if isinstance(
        value,
        (
            list,
            tuple,
            dict,
        ),
    ):
        return json.dumps(
            value,
            ensure_ascii=False,
            default=str,
        )

    try:
        if pd.isna(
            value
        ):
            return None
    except (
        TypeError,
        ValueError,
    ):
        pass

    return value


def infer_excel_number_format(
    column_name: str,
    series: pd.Series,
) -> str:
    """Infer a readable Excel number format."""
    normalized = (
        column_name.lower()
        .replace("–", "-")
    )

    if (
        "date" in normalized
        or "start" in normalized
        and pd.api.types.is_datetime64_any_dtype(
            series
        )
    ):
        return "yyyy-mm-dd"

    if pd.api.types.is_bool_dtype(
        series
    ):
        return "General"

    if not pd.api.types.is_numeric_dtype(
        series
    ):
        return "General"

    non_missing = pd.to_numeric(
        series,
        errors="coerce",
    ).dropna()

    maximum_absolute = (
        float(
            non_missing.abs().max()
        )
        if not non_missing.empty
        else 0.0
    )

    if (
        "fraction" in normalized
        or "agreement" in normalized
        or "proportion" in normalized
    ) and maximum_absolute <= 1.000001:
        return "0.0%"

    if (
        "pct" in normalized
        or "(%)" in normalized
        or "percent" in normalized
    ):
        return "0.0"

    if "ruv" in normalized:
        return "0.000"

    if (
        "scv" in normalized
        or "conditioning value" in normalized
        or "utility value" in normalized
        or "regret" in normalized
        or "loss" in normalized
        or "bootstrap bias" in normalized
        or "band width" in normalized
    ):
        return "0.000000"

    if (
        "(pp)" in normalized
        or normalized.endswith(
            "_pp"
        )
        or "delta rank" in normalized
    ):
        return "0.00"

    if (
        "factor" in normalized
        or "inflation" in normalized
    ):
        return "0.00x"

    if pd.api.types.is_integer_dtype(
        series
    ):
        return "0"

    return "0.000"


def write_dataframe_sheet(
    workbook: Workbook,
    sheet_name: str,
    title: str,
    caption: str,
    note: str,
    frame: pd.DataFrame,
) -> None:
    """Write and format one publication table worksheet."""
    worksheet = workbook.create_sheet(
        title=sheet_name[:31]
    )

    worksheet.sheet_view.showGridLines = False

    n_columns = max(
        1,
        len(
            frame.columns
        ),
    )

    last_column_letter = get_column_letter(
        n_columns
    )

    worksheet.merge_cells(
        f"A1:{last_column_letter}1"
    )

    worksheet.merge_cells(
        f"A2:{last_column_letter}2"
    )

    worksheet.merge_cells(
        f"A3:{last_column_letter}3"
    )

    worksheet["A1"] = title
    worksheet["A2"] = caption
    worksheet["A3"] = note

    worksheet["A1"].font = Font(
        name="Calibri",
        size=14,
        bold=True,
        color="FFFFFF",
    )

    worksheet["A1"].fill = PatternFill(
        fill_type="solid",
        fgColor="17365D",
    )

    worksheet["A1"].alignment = Alignment(
        horizontal="left",
        vertical="center",
    )

    worksheet["A2"].font = Font(
        name="Calibri",
        size=11,
        italic=True,
        color="1F1F1F",
    )

    worksheet["A2"].fill = PatternFill(
        fill_type="solid",
        fgColor="D9EAF7",
    )

    worksheet["A2"].alignment = Alignment(
        horizontal="left",
        vertical="center",
        wrap_text=True,
    )

    worksheet["A3"].font = Font(
        name="Calibri",
        size=10,
        color="7F6000",
    )

    worksheet["A3"].fill = PatternFill(
        fill_type="solid",
        fgColor="FFF2CC",
    )

    worksheet["A3"].alignment = Alignment(
        horizontal="left",
        vertical="center",
        wrap_text=True,
    )

    worksheet.row_dimensions[1].height = 24
    worksheet.row_dimensions[2].height = 34
    worksheet.row_dimensions[3].height = 48

    header_row = 5
    data_start_row = 6

    thin_blue = Side(
        style="thin",
        color="5B9BD5",
    )

    for column_index, column_name in enumerate(
        frame.columns,
        start=1,
    ):
        cell = worksheet.cell(
            row=header_row,
            column=column_index,
            value=str(
                column_name
            ),
        )

        cell.font = Font(
            name="Calibri",
            size=10,
            bold=True,
            color="FFFFFF",
        )

        cell.fill = PatternFill(
            fill_type="solid",
            fgColor="2F75B5",
        )

        cell.alignment = Alignment(
            horizontal="center",
            vertical="center",
            wrap_text=True,
        )

        cell.border = Border(
            bottom=thin_blue,
        )

    for row_offset, row_values in enumerate(
        frame.itertuples(
            index=False,
            name=None,
        ),
        start=data_start_row,
    ):
        alternating_fill = (
            "F3F6F9"
            if (
                row_offset
                - data_start_row
            )
            % 2
            else "FFFFFF"
        )

        for column_index, value in enumerate(
            row_values,
            start=1,
        ):
            cell = worksheet.cell(
                row=row_offset,
                column=column_index,
                value=excel_safe(
                    value
                ),
            )

            cell.font = Font(
                name="Calibri",
                size=10,
                color="000000",
            )

            cell.fill = PatternFill(
                fill_type="solid",
                fgColor=alternating_fill,
            )

            cell.alignment = Alignment(
                horizontal=(
                    "right"
                    if isinstance(
                        excel_safe(
                            value
                        ),
                        (
                            int,
                            float,
                        ),
                    )
                    and not isinstance(
                        excel_safe(
                            value
                        ),
                        bool,
                    )
                    else "left"
                ),
                vertical="top",
                wrap_text=True,
            )

    for column_index, column_name in enumerate(
        frame.columns,
        start=1,
    ):
        number_format = infer_excel_number_format(
            str(
                column_name
            ),
            frame[
                column_name
            ],
        )

        for row_index in range(
            data_start_row,
            data_start_row
            + len(
                frame
            ),
        ):
            worksheet.cell(
                row=row_index,
                column=column_index,
            ).number_format = (
                number_format
            )

        values_as_text = [
            str(
                column_name
            )
        ]

        values_as_text.extend(
            [
                ""
                if pd.isna(
                    value
                )
                else str(
                    value
                )
                for value in frame[
                    column_name
                ].head(
                    500
                )
            ]
        )

        maximum_width = max(
            len(
                value
            )
            for value
            in values_as_text
        )

        worksheet.column_dimensions[
            get_column_letter(
                column_index
            )
        ].width = min(
            max(
                maximum_width
                + 2,
                11,
            ),
            36,
        )

    worksheet.freeze_panes = (
        f"A{data_start_row}"
    )

    if len(
        frame
    ) > 0:
        worksheet.auto_filter.ref = (
            f"A{header_row}:"
            f"{last_column_letter}"
            f"{data_start_row + len(frame) - 1}"
        )

    worksheet.row_dimensions[
        header_row
    ].height = 42

    worksheet.print_title_rows = (
        f"1:{header_row}"
    )

    worksheet.page_setup.orientation = (
        "landscape"
        if len(
            frame.columns
        ) > 7
        else "portrait"
    )

    worksheet.page_setup.fitToWidth = 1
    worksheet.page_setup.fitToHeight = 0


def write_readme_sheet(
    workbook: Workbook,
    workbook_title: str,
    table_specs: list[dict[str, Any]],
    definitions: list[tuple[str, str]],
) -> None:
    """Write a workbook README sheet."""
    worksheet = workbook.create_sheet(
        title="README",
        index=0,
    )

    worksheet.sheet_view.showGridLines = False

    worksheet["A1"] = workbook_title

    worksheet["A1"].font = Font(
        name="Calibri",
        size=16,
        bold=True,
        color="FFFFFF",
    )

    worksheet["A1"].fill = PatternFill(
        fill_type="solid",
        fgColor="17365D",
    )

    worksheet.merge_cells(
        "A1:E1"
    )

    worksheet["A3"] = "Inferential hierarchy"
    worksheet["A3"].font = Font(
        bold=True,
        color="FFFFFF",
    )
    worksheet["A3"].fill = PatternFill(
        fill_type="solid",
        fgColor="2F75B5",
    )

    hierarchy_lines = [
        (
            "AE2 inference",
            "Paired complete-control-point trajectory bootstrap "
            "from Cell 03.",
        ),
        (
            "AE3 central effects",
            "Leave-one-control-point-out central estimates "
            "from Cell 04.",
        ),
        (
            "AE3 confirmatory inference",
            "Policy-reselection bootstrap from Cell 06.",
        ),
        (
            "Fixed-contribution bootstrap",
            "Sensitivity analysis only; not used for final "
            "confirmatory claims.",
        ),
        (
            "Pooled RUV",
            "Ratio of aggregated utility value to aggregated "
            "regret from Cell 05.",
        ),
    ]

    current_row = 4

    for term, definition in hierarchy_lines:
        worksheet.cell(
            row=current_row,
            column=1,
            value=term,
        ).font = Font(
            bold=True
        )

        worksheet.cell(
            row=current_row,
            column=2,
            value=definition,
        ).alignment = Alignment(
            wrap_text=True,
            vertical="top",
        )

        current_row += 1

    current_row += 1

    worksheet.cell(
        row=current_row,
        column=1,
        value="Tables",
    ).font = Font(
        bold=True,
        color="FFFFFF",
    )

    worksheet.cell(
        row=current_row,
        column=1,
    ).fill = PatternFill(
        fill_type="solid",
        fgColor="2F75B5",
    )

    current_row += 1

    headers = [
        "Table ID",
        "Worksheet",
        "Title",
        "Role",
        "Primary source",
    ]

    for column_index, header in enumerate(
        headers,
        start=1,
    ):
        cell = worksheet.cell(
            row=current_row,
            column=column_index,
            value=header,
        )

        cell.font = Font(
            bold=True,
            color="FFFFFF",
        )

        cell.fill = PatternFill(
            fill_type="solid",
            fgColor="5B9BD5",
        )

    current_row += 1

    for specification in table_specs:
        values = [
            specification[
                "table_id"
            ],
            specification[
                "sheet_name"
            ],
            specification[
                "title"
            ],
            specification[
                "role"
            ],
            specification[
                "source"
            ],
        ]

        for column_index, value in enumerate(
            values,
            start=1,
        ):
            worksheet.cell(
                row=current_row,
                column=column_index,
                value=value,
            ).alignment = Alignment(
                wrap_text=True,
                vertical="top",
            )

        current_row += 1

    current_row += 1

    worksheet.cell(
        row=current_row,
        column=1,
        value="Definitions",
    ).font = Font(
        bold=True,
        color="FFFFFF",
    )

    worksheet.cell(
        row=current_row,
        column=1,
    ).fill = PatternFill(
        fill_type="solid",
        fgColor="2F75B5",
    )

    current_row += 1

    for term, definition in definitions:
        worksheet.cell(
            row=current_row,
            column=1,
            value=term,
        ).font = Font(
            bold=True
        )

        worksheet.cell(
            row=current_row,
            column=2,
            value=definition,
        ).alignment = Alignment(
            wrap_text=True,
            vertical="top",
        )

        current_row += 1

    widths = {
        "A": 30,
        "B": 28,
        "C": 48,
        "D": 30,
        "E": 46,
    }

    for column_letter, width in widths.items():
        worksheet.column_dimensions[
            column_letter
        ].width = width

    worksheet.freeze_panes = "A3"


def write_workbook(
    output_path: Path,
    workbook_title: str,
    table_specs: list[dict[str, Any]],
    definitions: list[tuple[str, str]],
) -> None:
    """Write a complete formatted publication workbook."""
    workbook = Workbook()

    default_sheet = workbook.active

    workbook.remove(
        default_sheet
    )

    write_readme_sheet(
        workbook=workbook,
        workbook_title=workbook_title,
        table_specs=table_specs,
        definitions=definitions,
    )

    for specification in table_specs:
        write_dataframe_sheet(
            workbook=workbook,
            sheet_name=specification[
                "sheet_name"
            ],
            title=(
                f"{specification['table_id']}. "
                f"{specification['title']}"
            ),
            caption=specification[
                "caption"
            ],
            note=specification[
                "note"
            ],
            frame=specification[
                "frame"
            ],
        )

    workbook.properties.title = (
        workbook_title
    )

    workbook.properties.creator = (
        "Canonical AE analysis workflow"
    )

    workbook.properties.description = (
        "Publication tables generated from Cells 00–06."
    )

    workbook.save(
        output_path
    )


def write_latex_table(
    frame: pd.DataFrame,
    output_path: Path,
    caption: str,
    label: str,
) -> None:
    """Write a landscape-ready LaTeX table."""
    latex_frame = frame.copy()

    for column in latex_frame.columns:
        if pd.api.types.is_datetime64_any_dtype(
            latex_frame[
                column
            ]
        ):
            latex_frame[
                column
            ] = (
                latex_frame[
                    column
                ]
                .dt.strftime(
                    "%Y-%m-%d"
                )
            )

    latex_frame = latex_frame.replace(
        {
            np.nan: "--",
            pd.NaT: "--",
        }
    )

    tabular = latex_frame.to_latex(
        index=False,
        escape=True,
        na_rep="--",
        float_format=lambda value: (
            f"{value:.4f}"
        ),
        longtable=False,
        bold_rows=False,
    )

    latex_document = (
        "\\begin{table*}[htbp]\n"
        "\\centering\n"
        f"\\caption{{{caption}}}\n"
        f"\\label{{{label}}}\n"
        "\\resizebox{\\textwidth}{!}{%\n"
        f"{tabular}"
        "}\n"
        "\\end{table*}\n"
    )

    output_path.write_text(
        latex_document,
        encoding="utf-8",
    )


