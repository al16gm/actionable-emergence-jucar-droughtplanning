    / "forecast_scenario_key_alignment.csv"
)

POINT_SERIES_MAPPING_PATH = (
    PATHS["validation"]
    / "forecast_point_series_mapping.csv"
)

SERIES_POINT_MAPPING_PATH = (
    PATHS["validation"]
    / "forecast_series_point_mapping.csv"
)

DY_CONSISTENCY_PATH = (
    PATHS["validation"]
    / "forecast_dy_hat_consistency.csv"
)

PHYSICAL_RANGE_PATH = (
    PATHS["validation"]
    / "forecast_physical_range_summary.csv"
)

AE1_HORIZONS_PATH = (
    PATHS["ae1"]
    / "AE1_reliability_horizons_inherited.csv"
)

AE1_GATE_PATH = (
    PATHS["ae1"]
    / "AE1_gate_by_month.csv"
)

AE1_GATE_SUMMARY_PATH = (
    PATHS["ae1"]
    / "AE1_gate_summary.csv"
)

SCOPE_AMENDMENT_PATH = (
    PATHS["provenance"]
    / "analysis_scope_amendment_cell01.json"
)

CELL01_REPORT_PATH = (
    PATHS["logs"]
    / "cell01_validation_report.json"
)


# ============================================================
# 17. WRITE OUTPUTS
# ============================================================

# Preserve a byte-for-byte copy of the original immutable input.
if not FORECAST_ORIGINAL_COPY_PATH.exists():
    shutil.copy2(
        forecast_path,
        FORECAST_ORIGINAL_COPY_PATH,
    )

copied_input_hash = sha256_file(
    FORECAST_ORIGINAL_COPY_PATH
)

if copied_input_hash != observed_hash:
    raise RuntimeError(
        "The copied canonical forecast does not "
        "match the original SHA-256 hash."
    )

FC_CANONICAL.to_csv(
    FORECAST_CANONICAL_PATH,
    index=False,
    date_format="%Y-%m-%d",
)

canonical_forecast_hash = sha256_file(
    FORECAST_CANONICAL_PATH
)

group_coverage.to_csv(
    GROUP_COVERAGE_PATH,
    index=False,
)

point_coverage.to_csv(
    POINT_COVERAGE_PATH,
    index=False,
)

point_coverage_summary.to_csv(
    POINT_COVERAGE_SUMMARY_PATH,
    index=False,
)

scenario_alignment.to_csv(
    SCENARIO_ALIGNMENT_PATH,
    index=False,
)

point_series_mapping.to_csv(
    POINT_SERIES_MAPPING_PATH,
    index=False,
)

series_point_mapping.to_csv(
    SERIES_POINT_MAPPING_PATH,
    index=False,
)

dy_consistency_summary.to_csv(
    DY_CONSISTENCY_PATH,
    index=False,
)

physical_range_summary.to_csv(
    PHYSICAL_RANGE_PATH,
    index=False,
)

AE1_HORIZONS.to_csv(
    AE1_HORIZONS_PATH,
    index=False,
)

AE1_GATE_BY_LEAD.to_csv(
    AE1_GATE_PATH,
    index=False,
    date_format="%Y-%m-%d",
)

ae1_gate_summary.to_csv(
    AE1_GATE_SUMMARY_PATH,
    index=False,
)


# ============================================================
# 18. SCOPE AMENDMENT
# ============================================================

scope_amendment = {
    "created_utc": utc_now_iso(),
    "parent_run_id": RUN_CONTEXT.get(
        "run_id"
    ),
    "parent_configuration_sha256": CONFIG_HASH,
    "forecast_sha256": observed_hash,
    "available_analytical_inputs": [
        "AE_forecast_scenarios_ALL.csv",
    ],
    "ae1": {
        "reestimated_from_current_input": False,
        "reason": (
            "The prospective forecast file contains no observed "
            "outcomes or hindcast predictions. Therefore KGE and "
            "NSE cannot be scientifically recomputed."
        ),
        "gate_reapplied": True,
        "source_type": AE1_SOURCE_TYPE,
        "source_reference": PRIOR_PUBLICATION_REFERENCE,
        "trustworthy_horizons_months": AE1_HORIZONS_MONTHS,
        "unsupported_substitutions": [
            "ENDO–EXOG agreement as observed forecast skill",
            "future scenario spread as hindcast uncertainty",
            "target_date as an observed hydrological value",
        ],
    },
    "ae2": {
        "will_be_recomputed_from_scratch": True,
        "input": str(
            FORECAST_CANONICAL_PATH
        ),
    },
    "ae3": {
        "will_be_recomputed_from_scratch": True,
        "input": str(
            FORECAST_CANONICAL_PATH
        ),
    },
}

with SCOPE_AMENDMENT_PATH.open(
    "w",
    encoding="utf-8",
) as handle:
    json.dump(
        scope_amendment,
        handle,
        ensure_ascii=False,
        indent=2,
        sort_keys=True,
        default=str,
    )


# ============================================================
# 19. CELL REPORT AND MANIFEST UPDATE
# ============================================================

cell01_report = {
    "completed_utc": utc_now_iso(),
    "forecast_path": str(
        forecast_path
    ),
    "forecast_sha256": observed_hash,
    "forecast_rows": int(
        len(FC_CANONICAL)
    ),
    "forecast_columns": int(
        FC_CANONICAL.shape[1]
    ),
    "canonical_forecast_path": str(
        FORECAST_CANONICAL_PATH
    ),
    "canonical_forecast_sha256": (
        canonical_forecast_hash
    ),
    "lead_date_mismatches": (
        n_lead_date_mismatches
    ),
    "duplicate_rows": (
        n_duplicate_rows
    ),
    "all_scenario_keys_aligned": (
        all_scenario_keys_aligned
    ),
    "points_with_multiple_series_ids": (
        n_points_with_multiple_series_ids
    ),
    "series_with_multiple_point_ids": (
        n_series_with_multiple_point_ids
    ),
    "all_dy_hat_values_match_y_hat_increments": (
        all_dy_pairs_match
    ),
    "ae1_reestimated": False,
    "ae1_gate_reapplied": True,
    "ae1_horizons_months": (
        AE1_HORIZONS_MONTHS
    ),
    "ae1_gate_path": str(
        AE1_GATE_PATH
    ),
    "scope_amendment_path": str(
        SCOPE_AMENDMENT_PATH
    ),
}

with CELL01_REPORT_PATH.open(
    "w",
    encoding="utf-8",
) as handle:
    json.dump(
        cell01_report,
        handle,
        ensure_ascii=False,
        indent=2,
        sort_keys=True,
        default=str,
    )

RUN_CONTEXT["cell_01"] = (
    cell01_report
)

RUN_CONTEXT[
    "scientific_scope"
][
    "ae1_reestimated_from_current_forecast"
] = False

RUN_CONTEXT[
    "scientific_scope"
][
    "ae1_gate_reapplied_from_prior_validation"
] = True

RUN_CONTEXT[
    "scientific_scope"
][
    "ae2_recalculated_from_scratch"
] = True

RUN_CONTEXT[
    "scientific_scope"
][
    "ae3_recalculated_from_scratch"
] = True

update_json_file(
    MANIFEST_PATH,
    RUN_CONTEXT,
)


# ============================================================
# 20. OBJECTS FOR LATER CELLS
# ============================================================

AE1_GATE = (
    AE1_GATE_BY_LEAD.copy()
)

AE1_HORIZON_TABLE = (
    AE1_HORIZONS.copy()
)

FORECAST_VALIDATION_PASSED = (
    True
)


