def utc_now_iso() -> str:
    """Return the current UTC timestamp."""
    return datetime.now(
        timezone.utc
    ).isoformat(timespec="seconds")


def display_frame(
    frame: pd.DataFrame,
    n: int = 50,
) -> None:
    """Display a DataFrame with a plain-text fallback."""
    try:
        display(
            frame.head(n)
        )
    except NameError:
        print(
            frame.head(n).to_string(
                index=False
            )
        )


def sha256_json(
    payload: dict[str, Any],
) -> str:
    """Return a deterministic SHA-256 hash."""
    serialized = json.dumps(
        payload,
        sort_keys=True,
        ensure_ascii=False,
        separators=(",", ":"),
        default=str,
    ).encode("utf-8")

    return hashlib.sha256(
        serialized
    ).hexdigest()


def sha256_file(
    path: Path,
    chunk_size: int = 1024 * 1024,
) -> str:
    """Return the SHA-256 hash of a file."""
    digest = hashlib.sha256()

    with path.open(
        "rb",
    ) as handle:
        while True:
            chunk = handle.read(
                chunk_size
            )

            if not chunk:
                break

            digest.update(
                chunk
            )

    return digest.hexdigest()


def update_json_file(
    path: Path,
    updates: dict[str, Any],
) -> None:
    """Update a JSON file while preserving existing fields."""
    if path.exists():
        with path.open(
            "r",
            encoding="utf-8",
        ) as handle:
            payload = json.load(
                handle
            )
    else:
        payload = {}

    payload.update(
        updates
    )

    with path.open(
        "w",
        encoding="utf-8",
    ) as handle:
        json.dump(
            payload,
            handle,
            ensure_ascii=False,
            indent=2,
            sort_keys=True,
            default=str,
        )


def coerce_boolean(
    values: pd.Series,
) -> pd.Series:
    """Normalize Boolean-like columns."""
    if pd.api.types.is_bool_dtype(
        values
    ):
        return values.astype(bool)

    mapping = {
        "true": True,
        "false": False,
        "1": True,
        "0": False,
    }

    normalized = (
        values.astype(str)
        .str.strip()
        .str.lower()
        .map(mapping)
    )

    if normalized.isna().any():
        raise ValueError(
            "Could not convert all values to Boolean."
        )

    return normalized.astype(bool)


def safe_ratio(
    numerator: float,
    denominator: float,
) -> float:
    """Return a ratio only when the denominator is positive."""
    if (
        not np.isfinite(numerator)
        or not np.isfinite(denominator)
        or denominator <= NUMERICAL_ATOL
    ):
        return np.nan

    return float(
        numerator
        / denominator
    )


def extract_consecutive_runs(
    mask: np.ndarray,
    leads: np.ndarray,
    dates: np.ndarray,
) -> list[dict[str, Any]]:
    """
    Extract consecutive True runs.

    Consecutiveness requires:
      - adjacent sorted rows;
      - lead(t+1) = lead(t) + 1.
    """
    mask = np.asarray(
        mask,
        dtype=bool,
    )

    leads = np.asarray(
        leads,
        dtype=int,
    )

    dates = pd.to_datetime(
        dates
    ).to_numpy()

    if not (
        len(mask)
        == len(leads)
        == len(dates)
    ):
        raise ValueError(
            "Run inputs have inconsistent lengths."
        )

    order = np.argsort(
        leads
    )

    sorted_mask = mask[
        order
    ]

    sorted_leads = leads[
        order
    ]

    sorted_dates = dates[
        order
    ]

    runs: list[
        dict[str, Any]
    ] = []

    index = 0
    run_id = 0

    while index < len(
        sorted_mask
    ):
        if not bool(
            sorted_mask[
                index
            ]
        ):
            index += 1
            continue

        start_index = index

        while (
            index + 1
            < len(
                sorted_mask
            )
            and bool(
                sorted_mask[
                    index + 1
                ]
            )
            and (
                sorted_leads[
                    index + 1
                ]
                == sorted_leads[
                    index
                ]
                + 1
            )
        ):
            index += 1

        end_index = index
        run_id += 1

        runs.append(
            {
                "run_id": int(
                    run_id
                ),

                "start_position": int(
                    start_index
                ),

                "end_position": int(
                    end_index
                ),

                "start_lead": int(
                    sorted_leads[
                        start_index
                    ]
                ),

                "end_lead": int(
                    sorted_leads[
                        end_index
                    ]
                ),

                "start_date": pd.Timestamp(
                    sorted_dates[
                        start_index
                    ]
                ),

                "end_date": pd.Timestamp(
                    sorted_dates[
                        end_index
                    ]
                ),

                "length_months": int(
                    end_index
                    - start_index
                    + 1
                ),
            }
        )

        index += 1

    return runs


def classify_sign_stability(
    minimum_value: float,
    maximum_value: float,
) -> str:
    """Classify sign stability across parameter configurations."""
    if minimum_value > NUMERICAL_ATOL:
        return "all_positive"

    if (
        minimum_value
        >= -NUMERICAL_ATOL
        and maximum_value
        > NUMERICAL_ATOL
    ):
        return "nonnegative_with_zeros"

    if maximum_value < -NUMERICAL_ATOL:
        return "all_negative"

    if (
        maximum_value
        <= NUMERICAL_ATOL
        and minimum_value
        < -NUMERICAL_ATOL
    ):
        return "nonpositive_with_zeros"

    if (
        abs(
            minimum_value
        )
        <= NUMERICAL_ATOL
        and abs(
            maximum_value
        )
        <= NUMERICAL_ATOL
    ):
        return "all_zero"

    return "mixed_sign"


def transition_label(
    reference_action: float,
    scenario_action: float,
) -> str:
    """Create a stable action-transition label."""
    return (
        f"{reference_action:.2f}"
        f"->{scenario_action:.2f}"
    )


