# ============================================================
# 6. GENERAL HELPERS
# ============================================================

def utc_now_iso() -> str:
    """Return the current UTC timestamp."""
    return datetime.now(
        timezone.utc
    ).isoformat(
        timespec="seconds"
    )


def sha256_file(
    path: Path,
    chunk_size: int = 1024 * 1024,
) -> str:
    """Return a SHA-256 file hash."""
    digest = hashlib.sha256()

    with path.open(
        "rb",
    ) as handle:
        while True:
            chunk = handle.read(
                chunk_size
            )

            if not chunk:
                break

            digest.update(
                chunk
            )

    return digest.hexdigest()


def sha256_json(
    payload: dict[str, Any],
) -> str:
    """Return a deterministic JSON SHA-256 hash."""
    serialized = json.dumps(
        payload,
        ensure_ascii=False,
        sort_keys=True,
        separators=(",", ":"),
        default=str,
    ).encode("utf-8")

    return hashlib.sha256(
        serialized
    ).hexdigest()


def update_json_file(
    path: Path,
    updates: dict[str, Any],
) -> None:
    """Update a JSON file while preserving existing fields."""
    if path.exists():
        with path.open(
            "r",
            encoding="utf-8",
        ) as handle:
            payload = json.load(
                handle
            )
    else:
        payload = {}

    payload.update(
        updates
    )

    with path.open(
        "w",
        encoding="utf-8",
    ) as handle:
        json.dump(
            payload,
            handle,
            ensure_ascii=False,
            indent=2,
            sort_keys=True,
            default=str,
        )


def display_frame(
    frame: pd.DataFrame,
    n: int = 40,
) -> None:
    """Display a DataFrame with a text fallback."""
    try:
        display(
            frame.head(n)
        )
    except NameError:
        print(
            frame.head(n).to_string(
                index=False
            )
        )


def normalize_name(
    value: str,
) -> str:
    """Normalize a column name for matching."""
    return re.sub(
        r"[^a-z0-9]+",
        "_",
        str(value).strip().lower(),
    ).strip("_")


def coerce_boolean(
    values: pd.Series,
) -> pd.Series:
    """Convert Boolean-like values to bool."""
    if pd.api.types.is_bool_dtype(
        values
    ):
        return values.astype(bool)

    mapping = {
        "true": True,
        "false": False,
        "1": True,
        "0": False,
        "yes": True,
        "no": False,
    }

    normalized = (
        values.astype(str)
        .str.strip()
        .str.lower()
        .map(mapping)
    )

    if normalized.isna().any():
        invalid_values = (
            values.loc[
                normalized.isna()
            ]
            .drop_duplicates()
            .head(10)
            .tolist()
        )

        raise ValueError(
            "Could not convert a column to Boolean. "
            f"Examples: {invalid_values}"
        )

    return normalized.astype(bool)


def normalize_dates(
    frame: pd.DataFrame,
) -> pd.DataFrame:
    """Parse known date columns."""
    output = frame.copy()

    for column in output.columns:
        normalized = normalize_name(
            column
        )

        is_date_column = (
            normalized == "date"
            or normalized.endswith(
                "_date"
            )
            or normalized
            in {
                "target_date",
                "start_date",
                "end_date",
                "forecast_start",
                "forecast_end",
                "first_start_date",
                "first_end_date",
            }
        )

        if not is_date_column:
            continue

        converted = pd.to_datetime(
            output[
                column
            ],
            errors="coerce",
        )

        original_non_missing = int(
            output[
                column
            ].notna().sum()
        )

        converted_non_missing = int(
            converted.notna().sum()
        )

        if (
            original_non_missing == 0
            or original_non_missing
            == converted_non_missing
        ):
            output[
                column
            ] = converted

    return output


def load_frame(
    global_names: list[str],
    candidate_paths: list[Path],
    dtype: dict[str, Any] | None = None,
) -> tuple[
    pd.DataFrame,
    str,
]:
    """Load a DataFrame from memory or canonical CSV."""
    for global_name in global_names:
        if (
            global_name in globals()
            and isinstance(
                globals()[
                    global_name
                ],
                pd.DataFrame,
            )
        ):
            return (
                normalize_dates(
                    globals()[
                        global_name
                    ].copy()
                ),
                f"global:{global_name}",
            )

    for candidate_path in candidate_paths:
        if candidate_path.is_file():
            return (
                normalize_dates(
                    pd.read_csv(
                        candidate_path,
                        dtype=dtype,
                    )
                ),
                str(
                    candidate_path
                ),
            )

    raise FileNotFoundError(
        "Required canonical table was not found.\n"
        f"Globals checked: {global_names}\n"
        "Paths checked:\n"
        + "\n".join(
            str(path)
            for path in candidate_paths
        )
    )


def resolve_column(
    frame: pd.DataFrame,
    exact_candidates: Iterable[str] = (),
    required_tokens: Iterable[str] = (),
    excluded_tokens: Iterable[str] = (),
    prefer_tokens: Iterable[str] = (),
    required: bool = True,
) -> str | None:
    """Resolve a column using exact and token-based matching."""
    normalized_to_original = {
        normalize_name(
            column
        ): column
        for column in frame.columns
    }

    for candidate in exact_candidates:
        normalized_candidate = normalize_name(
            candidate
        )

        if normalized_candidate in normalized_to_original:
            return normalized_to_original[
                normalized_candidate
            ]

    required_tokens_normalized = [
        normalize_name(
            token
        )
        for token in required_tokens
    ]

    excluded_tokens_normalized = [
        normalize_name(
            token
        )
        for token in excluded_tokens
    ]

    prefer_tokens_normalized = [
        normalize_name(
            token
        )
        for token in prefer_tokens
    ]

    matches = []

    for column in frame.columns:
        normalized_column = normalize_name(
            column
        )

        if not all(
            token in normalized_column
            for token in required_tokens_normalized
        ):
            continue

        if any(
            token in normalized_column
            for token in excluded_tokens_normalized
        ):
            continue

        score = sum(
            token in normalized_column
            for token in prefer_tokens_normalized
        )

        score -= 0.001 * len(
            normalized_column
        )

        matches.append(
            (
                score,
                column,
            )
        )

    if matches:
        matches.sort(
            key=lambda item: item[0],
            reverse=True,
        )

        return matches[
            0
        ][
            1
        ]

    if required:
        raise KeyError(
            "Could not resolve a required column.\n"
            f"Exact candidates: {list(exact_candidates)}\n"
            f"Required tokens: {list(required_tokens)}\n"
            f"Excluded tokens: {list(excluded_tokens)}\n"
            f"Available columns: {list(frame.columns)}"
        )

    return None


def finite_axis_limits(
    arrays: list[np.ndarray],
    include_zero: bool = True,
    padding_fraction: float = 0.08,
) -> tuple[
    float,
    float,
]:
    """Return stable axis limits for multiple numeric arrays."""
    finite_values = []

    for array in arrays:
        values = np.asarray(
            array,
            dtype=float,
        )

        finite_values.extend(
            values[
                np.isfinite(
                    values
                )
            ].tolist()
        )

    if include_zero:
        finite_values.append(
            0.0
        )

    if not finite_values:
        return (
            -1.0,
            1.0,
        )

    minimum = float(
        np.min(
            finite_values
        )
    )

    maximum = float(
        np.max(
            finite_values
        )
    )

    if math.isclose(
        minimum,
        maximum,
        abs_tol=NUMERICAL_ATOL,
    ):
        expansion = max(
            1.0,
            abs(
                minimum
            )
            * 0.1,
        )

        return (
            minimum - expansion,
            maximum + expansion,
        )

    span = maximum - minimum

    padding = (
        padding_fraction
        * span
    )

    return (
        minimum - padding,
        maximum + padding,
    )


def add_panel_label(
    axis: plt.Axes,
    label: str,
    x: float = -0.12,
    y: float = 1.08,
) -> None:
    """Add a bold panel label."""
    axis.text(
        x,
        y,
        label,
        transform=axis.transAxes,
        fontsize=11,
        fontweight="bold",
        va="top",
        ha="left",
    )


def add_ae1_boundary(
    axis: plt.Axes,
    dates: pd.Series,
    horizon: int,
    shade_outside: bool = True,
) -> pd.Timestamp:
    """Add the inherited AE1 boundary to a time-series axis."""
    ordered_dates = pd.Series(
        pd.to_datetime(
            dates
        )
    ).sort_values().reset_index(
        drop=True
    )

    if len(
        ordered_dates
    ) < horizon:
        raise RuntimeError(
            "The date series is shorter than the inherited AE1 horizon."
        )

    boundary_date = pd.Timestamp(
        ordered_dates.iloc[
            horizon - 1
        ]
    )

    axis.axvline(
        boundary_date,
        color="#4D4D4D",
        linewidth=0.9,
        linestyle=(0, (4, 3)),
        zorder=6,
    )

    if (
        shade_outside
        and len(
            ordered_dates
        )
        > horizon
    ):
        shade_start = boundary_date + pd.offsets.MonthBegin(
            1
        )

        shade_end = (
            pd.Timestamp(
                ordered_dates.iloc[
                    -1
                ]
            )
            + pd.offsets.MonthEnd(
                1
            )
        )

        axis.axvspan(
            shade_start,
            shade_end,
            color=OUTSIDE_AE1_COLOR,
            alpha=0.70,
            linewidth=0,
            zorder=0,
        )

    return boundary_date


def export_figure(
    figure: plt.Figure,
    figure_id: str,
    filename_stem: str,
) -> list[dict[str, Any]]:
    """Export a figure in all required publication formats."""
    output_records = []

    for output_format in OUTPUT_FORMATS:
        output_path = (
            MAIN_FIGURES_DIR
            / f"{filename_stem}.{output_format}"
        )

        save_kwargs: dict[
            str,
            Any,
        ] = {
            "format": output_format,
            "bbox_inches": "tight",
            "pad_inches": 0.04,
            "facecolor": "white",
        }

        if output_format == "png":
            save_kwargs[
                "dpi"
            ] = PNG_DPI

        elif output_format == "tiff":
            save_kwargs[
                "dpi"
            ] = TIFF_DPI

            save_kwargs[
                "pil_kwargs"
            ] = {
                "compression": "tiff_lzw",
            }

        figure.savefig(
            output_path,
            **save_kwargs,
        )

        output_records.append(
            {
                "figure_id": figure_id,
                "format": output_format,
                "path": str(
                    output_path
                ),
                "size_bytes": int(
                    output_path.stat().st_size
                ),
                "sha256": sha256_file(
                    output_path
                ),
            }
        )

    return output_records


def format_year_axis(
    axis: plt.Axes,
    show_minor_months: bool = False,
) -> None:
    """Format a monthly date axis using annual labels."""
    axis.xaxis.set_major_locator(
        mdates.YearLocator()
    )

    axis.xaxis.set_major_formatter(
        mdates.DateFormatter(
            "%Y"
        )
    )

    if show_minor_months:
        axis.xaxis.set_minor_locator(
            mdates.MonthLocator(
                bymonth=[
                    4,
                    7,
                    10,
                ]
            )
        )

    axis.tick_params(
        axis="x",
        rotation=0,
    )


