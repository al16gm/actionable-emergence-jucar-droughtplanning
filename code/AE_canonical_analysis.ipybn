FIGURE_CAPTIONS = {
    "Figure 3": (
        "Inherited AE1 forecast-skill assessment and trustworthy "
        "horizons. The original validated figure is retained from "
        "the prior multi-horizon forecasting analysis. The present "
        "study does not re-estimate the AE1 skill curves and applies "
        "the previously established horizons as fixed external gates: "
        "48 months for Aquifer, 36 months for Reservoir, and 24 months "
        "for River."
    ),

    "Figure 4": (
        "Forecast-relative scenario separation (AE2), expressed as "
        "the difference in seasonally adjusted drought-rank score "
        "between each non-Base scenario and Base. Solid lines show "
        "monthly central effects, shaded regions show 95% pointwise "
        "bootstrap intervals, and dashed lines show 95% joint "
        "component-wise simultaneous bands. Circles identify months "
        "whose pointwise intervals exclude zero, and diamonds identify "
        "months whose joint bands exclude zero. Vertical dashed lines "
        "delimit the inherited AE1 horizons; grey regions lie outside "
        "the reliability domain. Vertical scales differ between "
        "components but are identical between scenarios within each "
        "component."
    ),

    "Figure 5": (
        "Cross-validated scenario-conditioning value (AE3) after "
        "propagating discrete policy-selection uncertainty through "
        "the policy-reselection bootstrap. Positive values indicate "
        "lower held-out loss under the scenario-conditioned policy "
        "than under the Base-conditioned policy. All panels use the "
        "same vertical scale. Shaded regions show 95% pointwise "
        "bootstrap intervals and dashed lines show 95% joint "
        "component-wise simultaneous bands. Filled circles identify "
        "months with a positive pointwise lower bound. No month retains "
        "a positive joint simultaneous lower bound."
    ),

    "Figure 6": (
        "Integrated Actionable Emergence synthesis. Panel (a) "
        "summarizes the hierarchical AE1, AE2, and AE3 evidence by "
        "component and scenario. AE1 is shown as a neutral inherited "
        "reliability gate; joint AE2 evidence and confirmatory AE3 "
        "evidence are distinguished from exploratory pointwise AE3 "
        "evidence. Panel (b) shows persistent exploratory full-AE "
        "windows satisfying the three-month persistence requirement. "
        "Reservoir retains recurring summer windows in 2025 and 2026; "
        "directional consistency is present under Unfavorable but not "
        "under Favorable. No family-wise confirmatory full-AE window "
        "survives policy reselection."
    ),

    "Figure 7": (
        "Sensitivity of joint-simultaneous AE2 emergence to the "
        "practical effect threshold and persistence requirement. "
        "Panel (a) applies the magnitude criterion, whereas panel (b) "
        "also requires the prespecified scenario-consistent direction. "
        "Each cell reports the longest qualifying run only when its "
        "duration meets the corresponding persistence requirement; "
        "otherwise, the displayed value is zero."
    ),
}


