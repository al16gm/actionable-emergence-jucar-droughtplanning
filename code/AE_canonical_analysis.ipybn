# ============================================================
# 5. GENERAL HELPERS
# ============================================================

def sha256_file(
    path: Path,
    chunk_size: int = 1024 * 1024,
) -> str:
    """Return a file SHA-256 hash."""
    digest = hashlib.sha256()

    with path.open(
        "rb",
    ) as handle:
        while True:
            chunk = handle.read(
                chunk_size
            )

            if not chunk:
                break

            digest.update(
                chunk
            )

    return digest.hexdigest()


def utc_now_iso() -> str:
    """Return the current UTC timestamp."""
    return datetime.now(
        timezone.utc
    ).isoformat(
        timespec="seconds"
    )


def sanitize_sheet_name(
    value: str,
) -> str:
    """Return an Excel-compatible worksheet name."""
    sanitized = re.sub(
        r"[\[\]\:\*\?\/\\]",
        "_",
        str(value),
    )

    sanitized = sanitized.strip()

    if not sanitized:
        sanitized = "Sheet"

    return sanitized[:31]


def make_unique_sheet_name(
    requested_name: str,
    existing_names: set[str],
) -> str:
    """Return a unique Excel-compatible worksheet name."""
    base_name = sanitize_sheet_name(
        requested_name
    )

    candidate = base_name
    suffix = 1

    while candidate in existing_names:
        suffix_text = f"_{suffix}"

        candidate = (
            base_name[
                : 31 - len(suffix_text)
            ]
            + suffix_text
        )

        suffix += 1

    return candidate


def normalize_dates(
    frame: pd.DataFrame,
) -> pd.DataFrame:
    """Parse columns explicitly identified as dates."""
    output = frame.copy()

    for column in output.columns:
        normalized = str(
            column
        ).lower()

        is_date_column = (
            normalized == "date"
            or normalized.endswith(
                "_date"
            )
            or normalized.endswith(
                " date"
            )
            or normalized
            in {
                "target_date",
                "start_date",
                "end_date",
                "forecast_start",
                "forecast_end",
                "first_start_date",
                "first_end_date",
                "fixed_first_start_date",
                "fixed_first_end_date",
                "reselection_first_start_date",
                "reselection_first_end_date",
            }
        )

        if not is_date_column:
            continue

        converted = pd.to_datetime(
            output[
                column
            ],
            errors="coerce",
        )

        non_missing_original = int(
            output[
                column
            ].notna().sum()
        )

        non_missing_converted = int(
            converted.notna().sum()
        )

        if (
            non_missing_original == 0
            or non_missing_converted
            == non_missing_original
        ):
            output[
                column
            ] = converted

    return output


def excel_safe(
    value: Any,
) -> Any:
    """Convert pandas/NumPy values to Excel-safe Python values."""
    if value is None:
        return None

    if isinstance(
        value,
        np.generic,
    ):
        value = value.item()

    if isinstance(
        value,
        pd.Timestamp,
    ):
        if pd.isna(
            value
        ):
            return None

        if value.tzinfo is not None:
            value = value.tz_convert(
                None
            )

        return value.to_pydatetime()

    if isinstance(
        value,
        float,
    ):
        if (
            math.isnan(
                value
            )
            or math.isinf(
                value
            )
        ):
            return None

    if isinstance(
        value,
        (
            list,
            tuple,
            set,
            dict,
        ),
    ):
        return json.dumps(
            value,
            ensure_ascii=False,
            default=str,
        )

    try:
        missing = pd.isna(
            value
        )

        if isinstance(
            missing,
            (
                bool,
                np.bool_,
            ),
        ) and bool(
            missing
        ):
            return None

    except (
        TypeError,
        ValueError,
    ):
        pass

    return value


def infer_number_format(
    column_name: str,
    series: pd.Series,
) -> str:
    """Infer an appropriate Excel number format."""
    normalized = (
        str(
            column_name
        )
        .lower()
        .replace(
            "–",
            "-",
        )
    )

    if pd.api.types.is_datetime64_any_dtype(
        series
    ):
        return "yyyy-mm-dd"

    if pd.api.types.is_bool_dtype(
        series
    ):
        return "General"

    if not pd.api.types.is_numeric_dtype(
        series
    ):
        return "General"

    numeric_values = pd.to_numeric(
        series,
        errors="coerce",
    ).dropna()

    maximum_absolute = (
        float(
            numeric_values.abs().max()
        )
        if not numeric_values.empty
        else 0.0
    )

    if (
        (
            "fraction" in normalized
            or "proportion" in normalized
            or "agreement" in normalized
        )
        and maximum_absolute <= 1.000001
    ):
        return "0.0%"

    if (
        "pct" in normalized
        or "(%)" in normalized
        or "percent" in normalized
    ):
        return "0.0"

    if "ruv" in normalized:
        return "0.000"

    if (
        "scv" in normalized
        or "conditioning value" in normalized
        or "policy value" in normalized
        or "regret" in normalized
        or "loss" in normalized
        or "bootstrap bias" in normalized
        or "band width" in normalized
        or "lower bound" in normalized
        or "upper bound" in normalized
    ):
        return "0.000000"

    if (
        "(pp)" in normalized
        or normalized.endswith(
            "_pp"
        )
        or "delta drought" in normalized
        or "delta rank" in normalized
    ):
        return "0.00"

    if (
        "factor" in normalized
        or "inflation" in normalized
    ):
        return '0.00"x"'

    if pd.api.types.is_integer_dtype(
        series
    ):
        return "0"

    return "0.000"


def estimate_column_width(
    column_name: str,
    series: pd.Series,
    maximum_width: int = 42,
) -> float:
    """Estimate a readable worksheet column width."""
    sample_values = [
        str(
            column_name
        )
    ]

    sample_values.extend(
        [
            ""
            if pd.isna(
                value
            )
            else str(
                value
            )
            for value in series.head(
                300
            )
        ]
    )

    maximum_length = max(
        len(
            text
        )
        for text in sample_values
    )

    return float(
        min(
            max(
                maximum_length + 2,
                11,
            ),
            maximum_width,
        )
    )


# ============================================================
# 6. LOAD CELL 07 MANIFESTS AND METADATA
# ============================================================

if PAPER_MANIFEST_PATH.is_file():
    paper_manifest = pd.read_csv(
        PAPER_MANIFEST_PATH
    )
else:
    paper_manifest = pd.DataFrame()

if SUPPLEMENT_MANIFEST_PATH.is_file():
    supplementary_manifest = pd.read_csv(
        SUPPLEMENT_MANIFEST_PATH
    )
else:
    supplementary_manifest = pd.DataFrame()


manifest_frames = []

if not paper_manifest.empty:
    paper_manifest[
        "manifest_group"
    ] = "paper"

    manifest_frames.append(
        paper_manifest
    )

if not supplementary_manifest.empty:
    supplementary_manifest[
        "manifest_group"
    ] = "supplementary"

    manifest_frames.append(
        supplementary_manifest
    )

if manifest_frames:
    combined_manifest = pd.concat(
        manifest_frames,
        ignore_index=True,
    )
else:
    combined_manifest = pd.DataFrame(
        columns=[
            "table_id",
            "title",
            "source",
            "csv_path",
            "manifest_group",
        ]
    )


metadata_lookup: dict[
    str,
    dict[str, Any],
] = {}

for specification_variable in [
    "paper_table_specs",
    "supplementary_table_specs",
]:
    if specification_variable not in globals():
        continue

    for specification in globals()[
        specification_variable
    ]:
        table_id = str(
            specification[
                "table_id"
            ]
        )

        metadata_lookup[
            table_id
        ] = {
            "title": specification.get(
                "title",
                table_id,
            ),
            "caption": specification.get(
                "caption",
                "",
            ),
            "note": specification.get(
                "note",
                "",
            ),
            "source": specification.get(
                "source",
                "",
            ),
            "role": specification.get(
                "role",
                "",
            ),
        }


for row in combined_manifest.to_dict(
    orient="records"
):
    table_id = str(
        row.get(
            "table_id",
            "",
        )
    )

    if not table_id:
        continue

    metadata_lookup.setdefault(
        table_id,
        {},
    )

    metadata_lookup[
        table_id
    ].setdefault(
        "title",
        row.get(
            "title",
            table_id,
        ),
    )

    metadata_lookup[
        table_id
    ].setdefault(
        "source",
        row.get(
            "source",
            "",
        ),
    )

    metadata_lookup[
        table_id
    ].setdefault(
        "caption",
        "",
    )

    metadata_lookup[
        table_id
    ].setdefault(
        "note",
        "",
    )

    metadata_lookup[
        table_id
    ].setdefault(
        "role",
        row.get(
            "role",
            "",
        ),
    )


# ============================================================
# 7. SOURCE-TABLE LOADER
# ============================================================

def resolve_manifest_csv_path(
    table_id: str,
) -> Path:
    """Resolve a table CSV path using Cell 07 manifests."""
    matches = combined_manifest.loc[
        combined_manifest[
            "table_id"
        ].astype(str).eq(
            table_id
        )
    ]

    if matches.empty:
        raise FileNotFoundError(
            f"No manifest entry was found for {table_id}."
        )

    manifest_row = matches.iloc[
        0
    ]

    raw_path = Path(
        str(
            manifest_row[
                "csv_path"
            ]
        )
    )

    candidates = [
        raw_path,
        PAPER_CSV_DIR
        / raw_path.name,
        SUPPLEMENT_CSV_DIR
        / raw_path.name,
    ]

    for candidate in candidates:
        if candidate.is_file():
            return candidate

    raise FileNotFoundError(
        f"The source CSV for {table_id} was not found.\n"
        f"Candidates: {[str(path) for path in candidates]}"
    )


def load_table(
    table_id: str,
) -> tuple[
    pd.DataFrame,
    Path | None,
]:
    """Load a canonical Cell 07 table from memory or CSV."""
    if (
        "PAPER_TABLES" in globals()
        and isinstance(
            PAPER_TABLES,
            dict,
        )
        and table_id in PAPER_TABLES
    ):
        return (
            normalize_dates(
                PAPER_TABLES[
                    table_id
                ].copy()
            ),
            (
                resolve_manifest_csv_path(
                    table_id
                )
                if not combined_manifest.empty
                else None
            ),
        )

    if (
        "SUPPLEMENTARY_TABLES" in globals()
        and isinstance(
            SUPPLEMENTARY_TABLES,
            dict,
        )
        and table_id
        in SUPPLEMENTARY_TABLES
    ):
        return (
            normalize_dates(
                SUPPLEMENTARY_TABLES[
                    table_id
                ].copy()
            ),
            (
                resolve_manifest_csv_path(
                    table_id
                )
                if not combined_manifest.empty
                else None
            ),
        )

    csv_path = resolve_manifest_csv_path(
        table_id
    )

    frame = pd.read_csv(
        csv_path
    )

    return (
        normalize_dates(
            frame
        ),
        csv_path,
    )


